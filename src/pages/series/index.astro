---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/ui/Container.astro';
import { withBase } from '~/lib/site-config';
import { formatDateISO } from '~/lib/format';
import { listSeries } from '~/lib/series';

const posts = await getCollection('posts', ({ data }) =>
  import.meta.env.PROD ? data.draft !== true : true
);
const series = listSeries(posts);
---

<BaseLayout
  title="Series"
  description="Multi-part series — read each one in order, start to finish."
>
  <Container class="pt-12 pb-16">
    <header
      class="border-b border-dashed border-[var(--color-border-strong)] pb-6"
    >
      <p class="terminal-label">FileSystem/Series</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-5xl">
        <span class="text-[var(--color-accent)]">//</span> Series
      </h1>
      <p class="mt-3 text-[var(--color-fg-muted)]">
        {series.length} series — each meant to be read in order, part by part.
      </p>
    </header>

    <div class="mt-10 space-y-5">
      {
        series.map((s) => (
          <article class="rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-5">
            <div class="flex items-baseline justify-between gap-3">
              <a
                href={withBase(`/series/${s.id}`)}
                class="text-lg font-semibold tracking-tight hover:text-[var(--color-accent)]"
              >
                {s.meta.title}
              </a>
              <span class="shrink-0 font-mono text-xs text-[var(--color-accent)]">
                {s.count} parts
              </span>
            </div>
            <p class="mt-2 text-sm text-[var(--color-fg-muted)]">
              {s.meta.blurb}
            </p>
            <div class="mt-3 flex items-center gap-3 text-xs text-[var(--color-fg-subtle)]">
              <time datetime={s.started.toISOString()}>
                {formatDateISO(s.started)}
              </time>
              <span aria-hidden="true">→</span>
              <time datetime={s.latest.toISOString()}>
                {formatDateISO(s.latest)}
              </time>
              <a
                href={withBase(`/series/${s.id}`)}
                class="ml-auto tracking-wider uppercase hover:text-[var(--color-accent)]"
              >
                Read series {'>'}
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</BaseLayout>
