---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/ui/Container.astro';
import { withBase } from '~/lib/site-config';
import { SERIES, seriesParts } from '~/lib/series';

export const getStaticPaths = (async () => {
  const posts = await getCollection('posts', ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true
  );

  return Object.entries(SERIES)
    .map(([id, meta]) => ({ id, meta, parts: seriesParts(posts, id) }))
    .filter(({ parts }) => parts.length > 0)
    .map(({ id, meta, parts }) => ({
      params: { id },
      props: { id, meta, parts },
    }));
}) satisfies GetStaticPaths;

const { id, meta, parts } = Astro.props;
const groups = meta.sections?.map((section) => ({
  ...section,
  parts: parts.filter((part) => {
    const order = part.data.seriesOrder ?? 0;
    return order >= section.from && order <= section.to;
  }),
})) ?? [
  {
    title: null,
    description: null,
    from: 1,
    to: parts.length,
    parts,
  },
];
---

<BaseLayout
  title={`${meta.title} — Series`}
  description={meta.description ?? meta.blurb}
  lang={meta.lang}
>
  <Container class="pt-12 pb-16">
    <nav class="mb-6" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-xs text-[var(--color-fg-muted)]">
        <li>
          <a href={withBase('/')} class="hover:text-[var(--color-accent)]"
            >HOME</a
          >
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href={withBase('/series')} class="hover:text-[var(--color-accent)]"
            >SERIES</a
          >
        </li>
        <li aria-hidden="true">/</li>
        <li class="text-[var(--color-fg)] uppercase">{id}</li>
      </ol>
    </nav>

    <header
      class="border-b border-dashed border-[var(--color-border-strong)] pb-6"
    >
      <p class="terminal-label">
        Series · {parts.length}
        {meta.lang === 'vi' ? 'phần' : 'parts'}
      </p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
        {meta.title}
      </h1>
      <p class="mt-3 text-[var(--color-fg-muted)]">{meta.blurb}</p>
    </header>

    <div class="mt-10 space-y-10">
      {
        groups.map((group, groupIndex) => (
          <section
            aria-labelledby={group.title ? `section-${groupIndex}` : undefined}
          >
            {group.title && (
              <header class="mb-4 grid gap-2 sm:grid-cols-[minmax(0,1fr)_minmax(16rem,2fr)] sm:items-baseline sm:gap-6">
                <h2
                  id={`section-${groupIndex}`}
                  class="text-lg font-semibold tracking-tight"
                >
                  <span class="mr-2 font-mono text-sm text-[var(--color-accent)]">
                    {String(groupIndex + 1).padStart(2, '0')}
                  </span>
                  {group.title}
                </h2>
                <p class="text-sm text-[var(--color-fg-subtle)]">
                  {group.description}
                </p>
              </header>
            )}

            <ol class="divide-y divide-[var(--color-border)] border-y border-[var(--color-border)]">
              {group.parts.map((part) => (
                <li class="group relative flex flex-col gap-1.5 px-3 py-4 transition-colors hover:bg-[var(--color-surface)]">
                  <div class="flex items-baseline gap-3">
                    <span class="shrink-0 font-mono text-sm text-[var(--color-accent)]">
                      {String(part.data.seriesOrder).padStart(2, '0')}
                    </span>
                    <a
                      href={withBase(`/blog/${part.id}`)}
                      class="text-base leading-snug font-medium group-hover:text-[var(--color-accent)] after:absolute after:inset-0 after:content-['']"
                    >
                      {part.data.title}
                    </a>
                  </div>
                  <p class="pl-8 text-sm text-[var(--color-fg-subtle)]">
                    {part.data.description}
                  </p>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>

    <footer
      class="mt-12 border-t border-dashed border-[var(--color-border-strong)] pt-6"
    >
      <a
        href={withBase('/series')}
        class="inline-flex items-center gap-2 text-xs font-semibold tracking-[0.12em] text-[var(--color-accent)] uppercase hover:text-[var(--color-accent-hover)]"
      >
        <span aria-hidden="true">{'<'}</span>
        {meta.lang === 'vi' ? 'Tất_cả_series' : 'All_series'}
      </a>
    </footer>
  </Container>
</BaseLayout>
