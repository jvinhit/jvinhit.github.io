---
/**
 * Daily love board — trang private của chủ site (spec 005-daily-love-board).
 *
 * Cố ý KHÔNG dùng BaseLayout: tránh GA4, nav/footer của site, và OG/JSON-LD —
 * trang này không muốn được track hay share. Page tự render full HTML shell,
 * meta noindex, và bị loại khỏi sitemap trong astro.config.mjs. Theme pastel
 * riêng scoped trong page (không thêm token love vào @theme của global.css —
 * token global là của site).
 *
 * global.css vẫn được import để có Tailwind engine + focus ring; nền/font
 * dark-terminal của nó bị override trong <style> bên dưới.
 */
import '~/styles/global.css';
import { LOVE_CONFIG } from '~/lib/love-config';

// Bộ mood cho note hằng ngày — render tĩnh, script đọc lại từ data attribute.
const MOODS = ['🥰', '😄', '😌', '🥺', '😭', '😡'];

// Màu giấy cho sticky board — id lưu vào document, label cho aria-label.
const STICKY_COLORS = [
  { id: 'rose', label: 'hồng' },
  { id: 'mint', label: 'xanh bạc hà' },
  { id: 'lemon', label: 'vàng chanh' },
  { id: 'sky', label: 'xanh trời' },
];

// Favicon riêng (trái tim) dạng data URI — không đụng favicon.svg của site,
// và giữ page tự chứa, không cần thêm asset vào public/.
const heartFavicon =
  'data:image/svg+xml,' +
  encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16"><text x="0" y="13" font-size="13">💗</text></svg>`
  );
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#fff5f7" />
    <link rel="icon" type="image/svg+xml" href={heartFavicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Pacifico&family=Quicksand:wght@400;500;600;700&display=swap"
    />
    <title>Góc nhỏ của hai đứa ♡</title>
  </head>

  <body>
    <!-- Tim bay trang trí — thuần CSS, tắt khi prefers-reduced-motion -->
    <div class="love-hearts" aria-hidden="true">
      <span>💗</span><span>💕</span><span>🌸</span><span>💗</span><span>✨</span
      ><span>💕</span>
    </div>

    <main class="mx-auto w-full max-w-2xl px-4 py-8 sm:py-12">
      <header class="text-center">
        <p class="love-kicker">✿ ✿ ✿</p>
        <h1 class="love-title">Góc nhỏ của hai đứa</h1>
        <!-- Bộ đếm ngày bên nhau (AC-8) — script điền sau khi đăng nhập -->
        <p class="love-days" data-love-days hidden></p>
      </header>

      <!-- Cổng mật mã (AC-1..3) -->
      <section
        id="love-gate"
        class="love-card mt-8 sm:mt-10"
        aria-label="Mở khóa bằng mật mã"
      >
        <p class="love-lock" aria-hidden="true">🔐</p>
        <form data-love-login>
          <label class="love-label" for="love-email">Email của tụi mình</label>
          <input
            id="love-email"
            class="love-input"
            type="email"
            name="email"
            autocomplete="username"
            required
          />
          <label class="love-label" for="love-passphrase">
            Mật mã của tụi mình
          </label>
          <input
            id="love-passphrase"
            class="love-input"
            type="password"
            name="passphrase"
            autocomplete="current-password"
            required
          />
          <p class="love-error" data-love-error aria-live="polite"></p>
          <button class="love-button" type="submit">Mở cửa 💝</button>
        </form>
      </section>

      <!-- Board chính — hiện sau khi đăng nhập -->
      <section id="love-board" aria-label="Bảng ghi chú" hidden>
        <div class="love-board-bar">
          <p class="love-board-hello">Về nhà rồi nè 🏡</p>
          <button class="love-ghost-button" type="button" data-love-logout>
            Khóa cửa 🔒
          </button>
        </div>

        <!-- Composer note hằng ngày (AC-4..6) -->
        <form class="love-card mt-4" data-love-note-form>
          <h2 class="love-section-title">Hôm nay của tụi mình 🍡</h2>

          <div class="love-chip-row" role="group" aria-label="Ai đang viết?">
            {
              LOVE_CONFIG.profiles.map((profile) => (
                <button
                  type="button"
                  class="love-chip"
                  data-love-profile={profile.id}
                  aria-pressed="false"
                >
                  {profile.emoji} {profile.name}
                </button>
              ))
            }
          </div>

          <div class="love-chip-row" role="group" aria-label="Mood hôm nay">
            {
              MOODS.map((mood) => (
                <button
                  type="button"
                  class="love-chip love-chip--mood"
                  data-love-mood={mood}
                  aria-pressed="false"
                  aria-label={`Mood ${mood}`}
                >
                  {mood}
                </button>
              ))
            }
          </div>

          <label class="love-label" for="love-note-text"
            >Chuyện hôm nay 💬</label
          >
          <textarea
            id="love-note-text"
            class="love-input love-textarea"
            rows="3"
            placeholder="Hôm nay thương nhau chuyện gì…?"></textarea>

          <!-- Đính ảnh (AC-9) — nén client-side, lưu base64 trong document -->
          <div class="love-photo-row">
            <button
              type="button"
              class="love-ghost-button"
              data-love-photo-pick
            >
              📷 Thêm ảnh
            </button>
            <input type="file" accept="image/*" data-love-photo-input hidden />
            <span class="love-photo-preview" data-love-photo-preview hidden>
              <img data-love-photo-thumb alt="" />
              <button
                type="button"
                class="love-icon-button"
                data-love-photo-remove
                aria-label="Bỏ ảnh đã chọn"
              >
                ✖
              </button>
            </span>
          </div>

          <p class="love-error" data-love-note-error aria-live="polite"></p>
          <div class="love-composer-actions">
            <button class="love-button" type="submit" data-love-note-submit>
              Gửi thương 💌
            </button>
            <button
              class="love-ghost-button"
              type="button"
              data-love-note-cancel
              hidden
            >
              Thôi, không sửa nữa
            </button>
          </div>
        </form>

        <!-- Timeline gom theo ngày (AC-4, AC-5) -->
        <section class="mt-8" aria-label="Nhật ký">
          <h2 class="love-section-title">Nhật ký 📖</h2>
          <p class="love-error" data-love-notes-error aria-live="polite"></p>
          <p class="love-empty" data-love-empty hidden>
            Chưa có note nào hết — viết dòng đầu tiên đi nè 🥹
          </p>
          <div id="love-timeline"></div>
        </section>

        <!-- Sticky board (AC-7) — note tự do không gắn ngày -->
        <section class="mt-8" aria-label="Bảng dán">
          <h2 class="love-section-title">Bảng dán nho nhỏ 📌</h2>
          <form class="love-card mt-3" data-love-sticky-form>
            <label class="love-label" for="love-sticky-text">
              Dán một mẩu giấy 💭
            </label>
            <input
              id="love-sticky-text"
              class="love-input"
              type="text"
              maxlength="300"
              placeholder="Điều muốn ghim lại hoài…"
            />
            <div class="love-chip-row" role="group" aria-label="Màu giấy">
              {
                STICKY_COLORS.map((color) => (
                  <button
                    type="button"
                    class={`love-chip love-chip--paper love-paper--${color.id}`}
                    data-love-color={color.id}
                    aria-pressed="false"
                    aria-label={`Màu ${color.label}`}
                  />
                ))
              }
            </div>
            <p class="love-error" data-love-sticky-error aria-live="polite"></p>
            <button class="love-button" type="submit">Dán lên bảng 📌</button>
          </form>
          <p class="love-empty" data-love-sticky-empty hidden>
            Bảng còn trống trơn — dán mẩu giấy đầu tiên nè 📌
          </p>
          <div id="love-sticky-grid"></div>
        </section>
      </section>

      <!-- Hiện thay cho gate khi love-config.ts còn placeholder -->
      <section
        id="love-setup"
        class="love-card mt-8 text-center sm:mt-10"
        aria-label="Chưa cấu hình Firebase"
        hidden
      >
        <p class="love-lock" aria-hidden="true">🛠️</p>
        <h2 class="love-setup-title">Chưa nối với Firebase</h2>
        <p class="mt-3">
          Trang chưa có cấu hình nên chưa mở khóa được. Làm theo hướng dẫn từng
          bước trong
          <code>docs/specs/005-daily-love-board/firebase-setup.md</code>
          rồi điền <code>src/lib/love-config.ts</code> nhé 💌
        </p>
      </section>

      <noscript>
        <p class="love-card mt-8 text-center">
          Trang này cần JavaScript để mở khóa và tải ghi chú 🥺
        </p>
      </noscript>
    </main>
    <script>
      import { isLoveConfigured, LOVE_CONFIG } from '~/lib/love-config';
      import {
        firebaseErrorCode,
        loadFirebase,
        type LoveFirebase,
        type QuerySnapshot,
      } from '~/lib/love-firebase';
      import {
        compressImage,
        daysTogether,
        formatDateHeading,
        formatTimeVN,
        groupByDate,
        loginErrorMessage,
        noteFromDoc,
        stickyFromDoc,
        todayKeyVN,
        writeErrorMessage,
        type DayGroup,
        type LoveNote,
        type LoveSticky,
      } from '~/lib/love-board';

      /** querySelector bắt buộc — page tự sở hữu markup nên thiếu là bug. */
      function must<T extends HTMLElement>(selector: string): T {
        const node = document.querySelector<T>(selector);
        if (!node) throw new Error(`love-board: thiếu phần tử ${selector}`);
        return node;
      }

      const gate = must<HTMLElement>('#love-gate');
      const board = must<HTMLElement>('#love-board');
      const setup = must<HTMLElement>('#love-setup');
      const daysEl = must<HTMLParagraphElement>('[data-love-days]');
      const loginForm = must<HTMLFormElement>('[data-love-login]');
      const emailInput = must<HTMLInputElement>('#love-email');
      const passInput = must<HTMLInputElement>('#love-passphrase');
      const loginError = must<HTMLParagraphElement>('[data-love-error]');
      const loginButton = must<HTMLButtonElement>('[data-love-login] button');
      const logoutButton = must<HTMLButtonElement>('[data-love-logout]');
      const noteForm = must<HTMLFormElement>('[data-love-note-form]');
      const noteText = must<HTMLTextAreaElement>('#love-note-text');
      const noteError = must<HTMLParagraphElement>('[data-love-note-error]');
      const noteSubmit = must<HTMLButtonElement>('[data-love-note-submit]');
      const noteCancel = must<HTMLButtonElement>('[data-love-note-cancel]');
      const photoPick = must<HTMLButtonElement>('[data-love-photo-pick]');
      const photoInput = must<HTMLInputElement>('[data-love-photo-input]');
      const photoPreview = must<HTMLSpanElement>('[data-love-photo-preview]');
      const photoThumb = must<HTMLImageElement>('[data-love-photo-thumb]');
      const photoRemove = must<HTMLButtonElement>('[data-love-photo-remove]');
      const notesError = must<HTMLParagraphElement>('[data-love-notes-error]');
      const emptyEl = must<HTMLParagraphElement>('[data-love-empty]');
      const timeline = must<HTMLDivElement>('#love-timeline');
      const stickyForm = must<HTMLFormElement>('[data-love-sticky-form]');
      const stickyText = must<HTMLInputElement>('#love-sticky-text');
      const stickyError = must<HTMLParagraphElement>(
        '[data-love-sticky-error]'
      );
      const stickyEmpty = must<HTMLParagraphElement>(
        '[data-love-sticky-empty]'
      );
      const stickyGrid = must<HTMLDivElement>('#love-sticky-grid');

      if (!isLoveConfigured()) {
        // Config còn placeholder → thay gate bằng màn hướng dẫn setup,
        // không load SDK (đỡ 300KB vô ích).
        gate.hidden = true;
        setup.hidden = false;
      } else {
        // Email không hardcode trong repo — nhớ theo máy sau lần login đầu.
        try {
          const savedEmail = localStorage.getItem('love-email');
          if (savedEmail) emailInput.value = savedEmail;
        } catch {
          // localStorage bị chặn — người dùng gõ tay.
        }
        void initBoard();
      }

      async function initBoard(): Promise<void> {
        let fb: LoveFirebase;
        try {
          fb = await loadFirebase();
        } catch (err) {
          // SDK không tải được (mất mạng lúc mở trang) — báo trên gate;
          // loadFirebase không cache rejection nên lần sau reload sẽ retry.
          loginError.textContent =
            'Không tải được Firebase 📡 kiểm tra mạng rồi tải lại trang nhé.';
          console.error('love-board: load SDK fail', err);
          return;
        }

        // ---- composer state -------------------------------------------------
        const profileChips = Array.from(
          document.querySelectorAll<HTMLButtonElement>('[data-love-profile]')
        );
        const moodChips = Array.from(
          document.querySelectorAll<HTMLButtonElement>('[data-love-mood]')
        );
        const colorChips = Array.from(
          document.querySelectorAll<HTMLButtonElement>('[data-love-color]')
        );

        let activeProfile: string = LOVE_CONFIG.profiles[0].id;
        let activeMood = moodChips[0]?.dataset.loveMood ?? '🥰';
        let activeColor = colorChips[0]?.dataset.loveColor ?? 'rose';
        let editingId: string | null = null;
        /** Ảnh đang đính trong composer (từ nút 📷 hoặc từ note đang sửa). */
        let pendingImage: string | undefined;
        let notesUnsub: (() => void) | null = null;
        let stickyUnsub: (() => void) | null = null;

        wireChips(profileChips, 'loveProfile', readSavedProfile(), (value) => {
          activeProfile = value;
          try {
            localStorage.setItem('love-profile', value);
          } catch {
            // Safari private mode — picker vẫn chạy, chỉ không nhớ được.
          }
        });
        wireChips(moodChips, 'loveMood', activeMood, (value) => {
          activeMood = value;
        });
        wireChips(colorChips, 'loveColor', activeColor, (value) => {
          activeColor = value;
        });

        // ---- auth -----------------------------------------------------------
        // Nguồn sự thật duy nhất cho việc khóa/mở: auth state. Firebase tự
        // giữ phiên trong storage nên reload không phải nhập lại (AC-3).
        fb.authApi.onAuthStateChanged(fb.auth, (user) => {
          const loggedIn = user !== null;
          gate.hidden = loggedIn;
          board.hidden = !loggedIn;
          daysEl.hidden = !loggedIn;
          if (loggedIn) {
            const days = daysTogether(LOVE_CONFIG.anniversary);
            daysEl.textContent = `Bên nhau ${days} ngày 💞`;
            passInput.value = '';
            subscribeNotes();
            subscribeSticky();
          } else {
            notesUnsub?.();
            notesUnsub = null;
            stickyUnsub?.();
            stickyUnsub = null;
            timeline.replaceChildren();
            stickyGrid.replaceChildren();
          }
        });

        loginForm.addEventListener('submit', (event) => {
          event.preventDefault();
          void signIn();
        });

        logoutButton.addEventListener('click', () => {
          void fb.authApi.signOut(fb.auth);
        });

        async function signIn(): Promise<void> {
          loginError.textContent = '';
          loginButton.disabled = true;
          loginButton.textContent = 'Đang mở… 🗝️';
          const email = emailInput.value.trim();
          try {
            await fb.authApi.signInWithEmailAndPassword(
              fb.auth,
              email,
              passInput.value
            );
            try {
              localStorage.setItem('love-email', email);
            } catch {
              // Không nhớ được thì lần sau gõ lại — không chặn login.
            }
          } catch (err) {
            loginError.textContent = loginErrorMessage(firebaseErrorCode(err));
          } finally {
            loginButton.disabled = false;
            loginButton.textContent = 'Mở cửa 💝';
          }
        }

        // ---- notes: realtime read (AC-4, AC-5) ------------------------------
        function subscribeNotes(): void {
          if (notesUnsub) return;
          notesUnsub = fb.dbApi.onSnapshot(
            fb.dbApi.query(
              fb.dbApi.collection(fb.db, 'dailyNotes'),
              fb.dbApi.orderBy('createdAtMs', 'desc')
            ),
            (snap) => {
              notesError.textContent = '';
              renderTimeline(snap);
            },
            (err) => {
              const code = firebaseErrorCode(err);
              notesError.textContent =
                code === 'permission-denied'
                  ? 'Không đọc được nhật ký — kiểm tra UID trong Firestore Rules (firebase-setup.md, Bước 5).'
                  : `Không đọc được nhật ký (${code || 'lỗi lạ'}) — thử tải lại trang nhé.`;
            }
          );
        }

        function renderTimeline(snap: QuerySnapshot): void {
          const notes = snap.docs
            .map((docSnap) => noteFromDoc(docSnap.id, docSnap.data()))
            .filter((note): note is LoveNote => note !== null);
          emptyEl.hidden = notes.length > 0;
          timeline.replaceChildren(...groupByDate(notes).map(renderGroup));
        }

        function renderGroup(group: DayGroup): HTMLElement {
          const wrap = document.createElement('div');
          wrap.className = 'love-day';
          const heading = document.createElement('h3');
          heading.className = 'love-day-heading';
          heading.textContent = formatDateHeading(group.dateKey);
          wrap.append(heading, ...group.notes.map(renderNote));
          return wrap;
        }

        // Toàn bộ nội dung note đi qua textContent — không innerHTML với
        // dữ liệu người dùng.
        function renderNote(note: LoveNote): HTMLElement {
          const card = document.createElement('article');
          card.className = `love-note love-note--${note.author}`;

          const head = document.createElement('header');
          head.className = 'love-note-head';
          const author = document.createElement('span');
          author.className = 'love-note-author';
          const profile = LOVE_CONFIG.profiles.find(
            (p) => p.id === note.author
          );
          author.textContent = profile
            ? `${profile.emoji} ${profile.name}`
            : note.author;
          const meta = document.createElement('span');
          meta.className = 'love-note-meta';
          meta.textContent = `${note.mood} ${formatTimeVN(note.createdAtMs)}${
            note.updatedAtMs ? ' · đã sửa' : ''
          }`;
          head.append(author, meta);
          card.append(head);

          const text = document.createElement('p');
          text.className = 'love-note-text';
          text.textContent = note.text;
          card.append(text);

          if (note.imageBase64) {
            const img = document.createElement('img');
            img.className = 'love-note-img';
            img.src = note.imageBase64;
            img.alt = 'Ảnh kỷ niệm';
            img.loading = 'lazy';
            card.append(img);
          }

          const foot = document.createElement('footer');
          foot.className = 'love-note-actions';
          const editBtn = iconButton('✏️', 'Sửa note này');
          editBtn.addEventListener('click', () => startEdit(note));
          const delBtn = iconButton('🗑️', 'Xóa note này');
          delBtn.addEventListener('click', () =>
            askDelete(card, note.id, 'dailyNotes', notesError)
          );
          foot.append(editBtn, delBtn);
          card.append(foot);

          return card;
        }

        function iconButton(glyph: string, label: string): HTMLButtonElement {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'love-icon-button';
          button.textContent = glyph;
          button.setAttribute('aria-label', label);
          return button;
        }

        // ---- notes: write (AC-4, AC-6) ---------------------------------------
        noteForm.addEventListener('submit', (event) => {
          event.preventDefault();
          submitNote();
        });

        noteCancel.addEventListener('click', () => stopEdit());

        // ---- đính ảnh (AC-9) --------------------------------------------------
        photoPick.addEventListener('click', () => photoInput.click());

        photoInput.addEventListener('change', () => {
          const file = photoInput.files?.[0];
          photoInput.value = ''; // reset để chọn lại đúng file cũ vẫn bắn change
          if (!file) return;
          photoPick.disabled = true;
          photoPick.textContent = 'Đang nén… 🍬';
          void compressImage(file).then((dataUrl) => {
            photoPick.disabled = false;
            photoPick.textContent = '📷 Thêm ảnh';
            if (!dataUrl) {
              noteError.textContent =
                'Ảnh nặng quá hoặc không đọc được — chọn ảnh khác nhé 🥺';
              return;
            }
            noteError.textContent = '';
            setPhoto(dataUrl);
          });
        });

        photoRemove.addEventListener('click', () => setPhoto(undefined));

        function setPhoto(dataUrl: string | undefined): void {
          pendingImage = dataUrl;
          photoPreview.hidden = !dataUrl;
          if (dataUrl) photoThumb.src = dataUrl;
          else photoThumb.removeAttribute('src');
        }

        function submitNote(): void {
          const text = noteText.value.trim();
          if (!text) {
            noteError.textContent = 'Viết gì đó đã nè ✍️';
            return;
          }
          noteError.textContent = '';

          const base = { author: activeProfile, mood: activeMood, text };
          const wasEditing = editingId;
          const imageAtSubmit = pendingImage;

          // Latency compensation của Firestore cho note hiện trong timeline
          // ngay (kể cả offline) → dọn composer luôn; lỗi thật thì trả lại
          // nội dung (edge case "mất mạng, không mất chữ đang gõ").
          const write = wasEditing
            ? fb.dbApi.updateDoc(
                fb.dbApi.doc(fb.db, 'dailyNotes', wasEditing),
                {
                  ...base,
                  // '' = bỏ ảnh (updateDoc không xóa field khi thiếu deleteField)
                  imageBase64: imageAtSubmit ?? '',
                  updatedAtMs: Date.now(),
                }
              )
            : fb.dbApi.addDoc(fb.dbApi.collection(fb.db, 'dailyNotes'), {
                ...base,
                ...(imageAtSubmit ? { imageBase64: imageAtSubmit } : {}),
                dateKey: todayKeyVN(),
                createdAtMs: Date.now(),
              });

          stopEdit();
          noteText.value = '';

          write.catch((err: unknown) => {
            noteText.value = text;
            setPhoto(imageAtSubmit);
            if (wasEditing) {
              editingId = wasEditing;
              setEditMode(true);
            }
            noteError.textContent = writeErrorMessage(firebaseErrorCode(err));
          });
        }

        function startEdit(note: LoveNote): void {
          editingId = note.id;
          setPhoto(note.imageBase64);
          noteText.value = note.text;
          pickChip(profileChips, 'loveProfile', note.author);
          activeProfile = note.author;
          if (note.mood) {
            pickChip(moodChips, 'loveMood', note.mood);
            activeMood = note.mood;
          }
          setEditMode(true);
          noteForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
          noteText.focus();
        }

        function stopEdit(): void {
          editingId = null;
          setPhoto(undefined);
          setEditMode(false);
        }

        function setEditMode(editing: boolean): void {
          noteSubmit.textContent = editing ? 'Lưu lại 💾' : 'Gửi thương 💌';
          noteCancel.hidden = !editing;
          if (!editing) noteText.value = '';
        }

        // Xác nhận xóa inline (AC-6) — dùng chung cho note và sticky.
        function askDelete(
          card: HTMLElement,
          id: string,
          coll: 'dailyNotes' | 'stickyNotes',
          errEl: HTMLParagraphElement
        ): void {
          if (card.querySelector('.love-confirm')) return;
          const row = document.createElement('div');
          row.className = 'love-confirm';
          const msg = document.createElement('span');
          msg.textContent = 'Xóa thiệt hông? 🥺';
          const yes = document.createElement('button');
          yes.type = 'button';
          yes.className = 'love-confirm-yes';
          yes.textContent = 'Xóa 💔';
          yes.addEventListener('click', () => {
            row.remove();
            fb.dbApi
              .deleteDoc(fb.dbApi.doc(fb.db, coll, id))
              .catch((err: unknown) => {
                errEl.textContent = writeErrorMessage(firebaseErrorCode(err));
              });
          });
          const no = document.createElement('button');
          no.type = 'button';
          no.className = 'love-ghost-button love-confirm-no';
          no.textContent = 'Thôi';
          no.addEventListener('click', () => row.remove());
          row.append(msg, yes, no);
          card.append(row);
        }

        // ---- sticky board (AC-7) ---------------------------------------------
        stickyForm.addEventListener('submit', (event) => {
          event.preventDefault();
          const text = stickyText.value.trim();
          if (!text) {
            stickyError.textContent = 'Viết gì đó lên giấy đã nè ✍️';
            return;
          }
          stickyError.textContent = '';
          stickyText.value = '';
          fb.dbApi
            .addDoc(fb.dbApi.collection(fb.db, 'stickyNotes'), {
              text,
              color: activeColor,
              author: activeProfile,
              createdAtMs: Date.now(),
            })
            .catch((err: unknown) => {
              stickyText.value = text;
              stickyError.textContent = writeErrorMessage(
                firebaseErrorCode(err)
              );
            });
        });

        function subscribeSticky(): void {
          if (stickyUnsub) return;
          stickyUnsub = fb.dbApi.onSnapshot(
            fb.dbApi.query(
              fb.dbApi.collection(fb.db, 'stickyNotes'),
              fb.dbApi.orderBy('createdAtMs', 'desc')
            ),
            (snap) => {
              const stickies = snap.docs
                .map((docSnap) => stickyFromDoc(docSnap.id, docSnap.data()))
                .filter((s): s is LoveSticky => s !== null);
              stickyEmpty.hidden = stickies.length > 0;
              stickyGrid.replaceChildren(...stickies.map(renderSticky));
            },
            (err) => {
              stickyError.textContent = writeErrorMessage(
                firebaseErrorCode(err)
              );
            }
          );
        }

        function renderSticky(sticky: LoveSticky): HTMLElement {
          const card = document.createElement('article');
          card.className = `love-sticky love-paper--${sticky.color}`;
          const text = document.createElement('p');
          text.className = 'love-sticky-text';
          text.textContent = sticky.text;
          const foot = document.createElement('footer');
          foot.className = 'love-sticky-foot';
          const who = document.createElement('span');
          const profile = LOVE_CONFIG.profiles.find(
            (p) => p.id === sticky.author
          );
          who.textContent = profile ? profile.emoji : '💌';
          const del = iconButton('🗑️', 'Gỡ mẩu giấy này');
          del.addEventListener('click', () =>
            askDelete(card, sticky.id, 'stickyNotes', stickyError)
          );
          foot.append(who, del);
          card.append(text, foot);
          return card;
        }
      }

      // ---- chip helpers (dùng chung cho profile + mood) ----------------------
      function readSavedProfile(): string {
        try {
          const stored = localStorage.getItem('love-profile');
          if (stored === 'p1' || stored === 'p2') return stored;
        } catch {
          // localStorage bị chặn — dùng mặc định.
        }
        return LOVE_CONFIG.profiles[0].id;
      }

      function wireChips(
        chips: HTMLButtonElement[],
        dataKey: 'loveProfile' | 'loveMood' | 'loveColor',
        initial: string,
        onPick: (value: string) => void
      ): void {
        const set = (value: string): void => {
          for (const chip of chips) {
            chip.setAttribute(
              'aria-pressed',
              String(chip.dataset[dataKey] === value)
            );
          }
          onPick(value);
        };
        for (const chip of chips) {
          chip.addEventListener('click', () =>
            set(chip.dataset[dataKey] ?? '')
          );
        }
        set(initial);
      }

      function pickChip(
        chips: HTMLButtonElement[],
        dataKey: 'loveProfile' | 'loveMood' | 'loveColor',
        value: string
      ): void {
        for (const chip of chips) {
          chip.setAttribute(
            'aria-pressed',
            String(chip.dataset[dataKey] === value)
          );
        }
      }
    </script>
  </body>
</html>

