---
/**
 * Daily love board — trang private của chủ site (spec 005-daily-love-board).
 *
 * Cố ý KHÔNG dùng BaseLayout: tránh GA4, nav/footer của site, và OG/JSON-LD —
 * trang này không muốn được track hay share. Page tự render full HTML shell,
 * meta noindex, và bị loại khỏi sitemap trong astro.config.mjs. Theme pastel
 * riêng scoped trong page (không thêm token love vào @theme của global.css —
 * token global là của site).
 *
 * global.css vẫn được import để có Tailwind engine + focus ring; nền/font
 * dark-terminal của nó bị override trong <style> bên dưới.
 */
import '~/styles/global.css';
import { LOVE_CONFIG } from '~/lib/love-config';

// Bộ mood cho note hằng ngày — render tĩnh, script đọc lại từ data attribute.
const MOODS = ['🥰', '😄', '😌', '🥺', '😭', '😡'];

// Màu giấy cho sticky board — id lưu vào document, label cho aria-label.
const STICKY_COLORS = [
  { id: 'rose', label: 'hồng' },
  { id: 'mint', label: 'xanh bạc hà' },
  { id: 'lemon', label: 'vàng chanh' },
  { id: 'sky', label: 'xanh trời' },
];

// Favicon riêng (trái tim) dạng data URI — không đụng favicon.svg của site,
// và giữ page tự chứa, không cần thêm asset vào public/.
const heartFavicon =
  'data:image/svg+xml,' +
  encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16"><text x="0" y="13" font-size="13">💗</text></svg>`
  );
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#fff5f7" />
    <link rel="icon" type="image/svg+xml" href={heartFavicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Pacifico&family=Quicksand:wght@400;500;600;700&display=swap"
    />
    <title>Góc nhỏ của hai đứa ♡</title>
    <script is:inline>
      // Chống chớp form login khi reload lúc ĐÃ có phiên: flag localStorage
      // được ghi sau lần đăng nhập thành công; class này giấu gate và hiện
      // màn "đang mở cửa" cho tới khi Firebase xác nhận phiên (script chính
      // gỡ class ở mọi nhánh). is:inline để chạy trước first paint — cùng
      // pattern chống FOUC theme trong BaseLayout của site.
      try {
        if (localStorage.getItem('love-session') === '1') {
          document.documentElement.classList.add('love-pending');
        }
      } catch (_) {
        /* localStorage bị chặn — hiện form login như thường. */
      }
    </script>
  </head>

  <body>
    <!-- Tim bay trang trí — thuần CSS, tắt khi prefers-reduced-motion -->
    <div class="love-hearts" aria-hidden="true">
      <span>💗</span><span>💕</span><span>🌸</span><span>💗</span><span>✨</span
      ><span>💕</span>
    </div>

    <main class="mx-auto w-full max-w-2xl px-4 py-8 sm:py-12">
      <header class="text-center">
        <p class="love-kicker">✿ ✿ ✿</p>
        <h1 class="love-title">Góc nhỏ của hai đứa</h1>
        <!-- Bộ đếm ngày bên nhau (AC-8) — script điền sau khi đăng nhập -->
        <p class="love-days" data-love-days hidden></p>
      </header>

      <!-- Màn chờ xác nhận phiên — chỉ hiện khi <html> có .love-pending
           (đã đăng nhập lần trước), thay cho việc chớp form login. -->
      <section
        id="love-loading"
        class="love-card mt-8 text-center sm:mt-10"
        aria-label="Đang mở cửa"
      >
        <p class="love-lock" aria-hidden="true">🗝️</p>
        <p class="love-loading-text">Đang mở cửa cho tụi mình…</p>
      </section>

      <!-- Cổng mật mã (AC-1..3) -->
      <section
        id="love-gate"
        class="love-card mt-8 sm:mt-10"
        aria-label="Mở khóa bằng mật mã"
      >
        <p class="love-lock" aria-hidden="true">🔐</p>
        <form data-love-login>
          <label class="love-label" for="love-email">Email của tụi mình</label>
          <input
            id="love-email"
            class="love-input"
            type="email"
            name="email"
            autocomplete="username"
            required
          />
          <label class="love-label" for="love-passphrase">
            Mật mã của tụi mình
          </label>
          <input
            id="love-passphrase"
            class="love-input"
            type="password"
            name="passphrase"
            autocomplete="current-password"
            required
          />
          <p class="love-error" data-love-error aria-live="polite"></p>
          <button class="love-button" type="submit">Mở cửa 💝</button>
        </form>
      </section>

      <!-- Board chính — hiện sau khi đăng nhập -->
      <section id="love-board" aria-label="Bảng ghi chú" hidden>
        <div class="love-board-bar">
          <p class="love-board-hello">Về nhà rồi nè 🏡</p>
          <button class="love-ghost-button" type="button" data-love-logout>
            Khóa cửa 🔒
          </button>
        </div>

        <!-- Composer note hằng ngày (AC-4..6) -->
        <form class="love-card mt-4" data-love-note-form>
          <h2 class="love-section-title">Hôm nay của tụi mình 🍡</h2>

          <div class="love-chip-row" role="group" aria-label="Ai đang viết?">
            {
              LOVE_CONFIG.profiles.map((profile) => (
                <button
                  type="button"
                  class="love-chip"
                  data-love-profile={profile.id}
                  aria-pressed="false"
                >
                  {profile.emoji} {profile.name}
                </button>
              ))
            }
          </div>

          <div class="love-chip-row" role="group" aria-label="Mood hôm nay">
            {
              MOODS.map((mood) => (
                <button
                  type="button"
                  class="love-chip love-chip--mood"
                  data-love-mood={mood}
                  aria-pressed="false"
                  aria-label={`Mood ${mood}`}
                >
                  {mood}
                </button>
              ))
            }
          </div>

          <label class="love-label" for="love-note-text"
            >Chuyện hôm nay 💬</label
          >
          <textarea
            id="love-note-text"
            class="love-input love-textarea"
            rows="3"
            placeholder="Hôm nay thương nhau chuyện gì…?"></textarea>

          <!-- Đính ảnh (AC-9) — nén client-side, lưu base64 trong document -->
          <div class="love-photo-row">
            <button
              type="button"
              class="love-ghost-button"
              data-love-photo-pick
            >
              📷 Thêm ảnh
            </button>
            <input type="file" accept="image/*" data-love-photo-input hidden />
            <span class="love-photo-preview" data-love-photo-preview hidden>
              <img data-love-photo-thumb alt="" />
              <button
                type="button"
                class="love-icon-button"
                data-love-photo-remove
                aria-label="Bỏ ảnh đã chọn"
              >
                ✖
              </button>
            </span>
          </div>

          <p class="love-error" data-love-note-error aria-live="polite"></p>
          <div class="love-composer-actions">
            <button class="love-button" type="submit">Gửi thương 💌</button>
          </div>
        </form>

        <!-- Timeline gom theo ngày (AC-4, AC-5) -->
        <section class="mt-8" aria-label="Nhật ký">
          <h2 class="love-section-title">Nhật ký 📖</h2>
          <p class="love-error" data-love-notes-error aria-live="polite"></p>
          <p class="love-empty" data-love-empty hidden>
            Chưa có note nào hết — viết dòng đầu tiên đi nè 🥹
          </p>
          <div id="love-timeline"></div>
        </section>

        <!-- Sticky board (AC-7) — note tự do không gắn ngày -->
        <section class="mt-8" aria-label="Bảng dán">
          <h2 class="love-section-title">Bảng dán nho nhỏ 📌</h2>
          <form class="love-card mt-3" data-love-sticky-form>
            <label class="love-label" for="love-sticky-text">
              Dán một mẩu giấy 💭
            </label>
            <input
              id="love-sticky-text"
              class="love-input"
              type="text"
              maxlength="300"
              placeholder="Điều muốn ghim lại hoài…"
            />
            <div class="love-chip-row" role="group" aria-label="Màu giấy">
              {
                STICKY_COLORS.map((color) => (
                  <button
                    type="button"
                    class={`love-chip love-chip--paper love-paper--${color.id}`}
                    data-love-color={color.id}
                    aria-pressed="false"
                    aria-label={`Màu ${color.label}`}
                  />
                ))
              }
            </div>
            <p class="love-error" data-love-sticky-error aria-live="polite"></p>
            <button class="love-button" type="submit">Dán lên bảng 📌</button>
          </form>
          <p class="love-empty" data-love-sticky-empty hidden>
            Bảng còn trống trơn — dán mẩu giấy đầu tiên nè 📌
          </p>
          <div id="love-sticky-grid"></div>
        </section>
      </section>

      <!-- Hiện thay cho gate khi love-config.ts còn placeholder -->
      <section
        id="love-setup"
        class="love-card mt-8 text-center sm:mt-10"
        aria-label="Chưa cấu hình Firebase"
        hidden
      >
        <p class="love-lock" aria-hidden="true">🛠️</p>
        <h2 class="love-setup-title">Chưa nối với Firebase</h2>
        <p class="mt-3">
          Trang chưa có cấu hình nên chưa mở khóa được. Làm theo hướng dẫn từng
          bước trong
          <code>docs/specs/005-daily-love-board/firebase-setup.md</code>
          rồi điền <code>src/lib/love-config.ts</code> nhé 💌
        </p>
      </section>

      <noscript>
        <p class="love-card mt-8 text-center">
          Trang này cần JavaScript để mở khóa và tải ghi chú 🥺
        </p>
      </noscript>
    </main>
    <script>
      import { isLoveConfigured, LOVE_CONFIG } from '~/lib/love-config';
      import {
        firebaseErrorCode,
        loadFirebase,
        type LoveFirebase,
        type QuerySnapshot,
      } from '~/lib/love-firebase';
      import {
        commentCountLabel,
        compressImage,
        daysTogether,
        defaultOpenDateKey,
        formatDateHeading,
        formatTimeVN,
        groupByDate,
        isCollapseEnabled,
        loginErrorMessage,
        noteCountLabel,
        noteFromDoc,
        stickyFromDoc,
        todayKeyVN,
        writeErrorMessage,
        type DayGroup,
        type LoveComment,
        type LoveNote,
        type LoveReaction,
        type LoveSticky,
      } from '~/lib/love-board';

      /**
       * Bộ cảm xúc cố định cho reaction trên note/sticky (spec 006). Khai ở
       * script (không phải frontmatter như MOODS) vì reaction bar do script
       * dựng theo từng card, không có markup tĩnh để đọc lại data attribute.
       */
      const REACTIONS = ['❤️', '😂', '🥺', '😍', '👍'];

      /**
       * Gỡ trạng thái "đang mở cửa" do inline script trong <head> set —
       * phải gọi ở MỌI nhánh kết thúc chờ (auth resolve, SDK fail, chưa
       * config), nếu không gate bị CSS giấu vĩnh viễn.
       */
      function clearPending(): void {
        document.documentElement.classList.remove('love-pending');
      }

      /** querySelector bắt buộc — page tự sở hữu markup nên thiếu là bug. */
      function must<T extends HTMLElement>(selector: string): T {
        const node = document.querySelector<T>(selector);
        if (!node) throw new Error(`love-board: thiếu phần tử ${selector}`);
        return node;
      }

      const gate = must<HTMLElement>('#love-gate');
      const board = must<HTMLElement>('#love-board');
      const setup = must<HTMLElement>('#love-setup');
      const daysEl = must<HTMLParagraphElement>('[data-love-days]');
      const loginForm = must<HTMLFormElement>('[data-love-login]');
      const emailInput = must<HTMLInputElement>('#love-email');
      const passInput = must<HTMLInputElement>('#love-passphrase');
      const loginError = must<HTMLParagraphElement>('[data-love-error]');
      const loginButton = must<HTMLButtonElement>('[data-love-login] button');
      const logoutButton = must<HTMLButtonElement>('[data-love-logout]');
      const noteForm = must<HTMLFormElement>('[data-love-note-form]');
      const noteText = must<HTMLTextAreaElement>('#love-note-text');
      const noteError = must<HTMLParagraphElement>('[data-love-note-error]');
      const photoPick = must<HTMLButtonElement>('[data-love-photo-pick]');
      const photoInput = must<HTMLInputElement>('[data-love-photo-input]');
      const photoPreview = must<HTMLSpanElement>('[data-love-photo-preview]');
      const photoThumb = must<HTMLImageElement>('[data-love-photo-thumb]');
      const photoRemove = must<HTMLButtonElement>('[data-love-photo-remove]');
      const notesError = must<HTMLParagraphElement>('[data-love-notes-error]');
      const emptyEl = must<HTMLParagraphElement>('[data-love-empty]');
      const timeline = must<HTMLDivElement>('#love-timeline');
      const stickyForm = must<HTMLFormElement>('[data-love-sticky-form]');
      const stickyText = must<HTMLInputElement>('#love-sticky-text');
      const stickyError = must<HTMLParagraphElement>(
        '[data-love-sticky-error]'
      );
      const stickyEmpty = must<HTMLParagraphElement>(
        '[data-love-sticky-empty]'
      );
      const stickyGrid = must<HTMLDivElement>('#love-sticky-grid');

      if (!isLoveConfigured()) {
        // Config còn placeholder → thay gate bằng màn hướng dẫn setup,
        // không load SDK (đỡ 300KB vô ích).
        clearPending();
        gate.hidden = true;
        setup.hidden = false;
      } else {
        // Email không hardcode trong repo — nhớ theo máy sau lần login đầu.
        try {
          const savedEmail = localStorage.getItem('love-email');
          if (savedEmail) emailInput.value = savedEmail;
        } catch {
          // localStorage bị chặn — người dùng gõ tay.
        }
        void initBoard();
      }

      async function initBoard(): Promise<void> {
        let fb: LoveFirebase;
        try {
          fb = await loadFirebase();
        } catch (err) {
          // SDK không tải được (mất mạng lúc mở trang) — báo trên gate;
          // loadFirebase không cache rejection nên lần sau reload sẽ retry.
          clearPending();
          loginError.textContent =
            'Không tải được Firebase 📡 kiểm tra mạng rồi tải lại trang nhé.';
          console.error('love-board: load SDK fail', err);
          return;
        }

        // ---- composer state -------------------------------------------------
        const profileChips = Array.from(
          document.querySelectorAll<HTMLButtonElement>('[data-love-profile]')
        );
        const moodChips = Array.from(
          document.querySelectorAll<HTMLButtonElement>('[data-love-mood]')
        );
        const colorChips = Array.from(
          document.querySelectorAll<HTMLButtonElement>('[data-love-color]')
        );

        let activeProfile: string = LOVE_CONFIG.profiles[0].id;
        let activeMood = moodChips[0]?.dataset.loveMood ?? '🥰';
        let activeColor = colorChips[0]?.dataset.loveColor ?? 'rose';
        /** Ảnh đang đính trong composer (nút 📷) — composer giờ chỉ tạo mới. */
        let pendingImage: string | undefined;
        /**
         * Note đang sửa tại chỗ (spec 006, hướng E1). `draft` là nguồn sự
         * thật của form inline: snapshot mới về thì redraw dựng lại form từ
         * draft chứ không reset theo data — chữ đang gõ không mất. Chỉ một
         * note ở mode sửa tại một thời điểm.
         */
        let editing: {
          id: string;
          draft: {
            text: string;
            mood: string;
            author: string;
            image: string | undefined;
          };
        } | null = null;
        /** Notes của snapshot gần nhất — để redraw khi vào/ra mode sửa. */
        let currentNotes: LoveNote[] = [];
        /** Sticky của snapshot gần nhất — để redraw khi đổi profile. */
        let currentStickies: LoveSticky[] = [];
        let notesUnsub: (() => void) | null = null;
        let stickyUnsub: (() => void) | null = null;
        /**
         * Toggle tay của user cho từng nhóm ngày (true = mở) — thắng mặc
         * định "hôm nay mở, còn lại đóng". Sống trong closure chứ không
         * trong DOM vì renderTimeline thay cả cây mỗi snapshot (AC-4);
         * cố ý không persist qua reload (đã chốt ở requirement).
         */
        const openOverrides = new Map<string, boolean>();
        /**
         * Panel comment đang xòe (true) và text đang gõ dở trong ô trả lời —
         * key `${coll}/${id}`. Cùng lý do sống-trong-closure với
         * openOverrides: snapshot mới về không được đóng panel hay xóa chữ
         * đang gõ của người dùng.
         */
        const commentOpen = new Map<string, boolean>();
        const commentDrafts = new Map<string, string>();

        wireChips(profileChips, 'loveProfile', readSavedProfile(), (value) => {
          activeProfile = value;
          try {
            localStorage.setItem('love-profile', value);
          } catch {
            // Safari private mode — picker vẫn chạy, chỉ không nhớ được.
          }
          // Chip reaction render "của mình" theo activeProfile tại thời điểm
          // render — đổi người thì phải dựng lại card, không thì nhãn/toggle
          // tính theo người cũ (bấm sẽ thành no-op sai).
          redrawTimeline();
          redrawSticky();
        });
        wireChips(moodChips, 'loveMood', activeMood, (value) => {
          activeMood = value;
        });
        wireChips(colorChips, 'loveColor', activeColor, (value) => {
          activeColor = value;
        });

        // ---- auth -----------------------------------------------------------
        // Nguồn sự thật duy nhất cho việc khóa/mở: auth state. Firebase tự
        // giữ phiên trong storage nên reload không phải nhập lại (AC-3).
        fb.authApi.onAuthStateChanged(fb.auth, (user) => {
          const loggedIn = user !== null;
          clearPending();
          // Flag cho inline script ở <head>: lần reload sau đã có phiên thì
          // hiện màn "đang mở cửa" thay vì chớp form login.
          try {
            if (loggedIn) localStorage.setItem('love-session', '1');
            else localStorage.removeItem('love-session');
          } catch {
            // localStorage bị chặn — lần sau lại thấy form trước, vô hại.
          }
          gate.hidden = loggedIn;
          board.hidden = !loggedIn;
          daysEl.hidden = !loggedIn;
          if (loggedIn) {
            const days = daysTogether(LOVE_CONFIG.anniversary);
            daysEl.textContent = `Bên nhau ${days} ngày 💞`;
            passInput.value = '';
            subscribeNotes();
            subscribeSticky();
          } else {
            notesUnsub?.();
            notesUnsub = null;
            stickyUnsub?.();
            stickyUnsub = null;
            timeline.replaceChildren();
            stickyGrid.replaceChildren();
          }
        });

        loginForm.addEventListener('submit', (event) => {
          event.preventDefault();
          void signIn();
        });

        logoutButton.addEventListener('click', () => {
          void fb.authApi.signOut(fb.auth);
        });

        async function signIn(): Promise<void> {
          loginError.textContent = '';
          loginButton.disabled = true;
          loginButton.textContent = 'Đang mở… 🗝️';
          const email = emailInput.value.trim();
          try {
            await fb.authApi.signInWithEmailAndPassword(
              fb.auth,
              email,
              passInput.value
            );
            try {
              localStorage.setItem('love-email', email);
            } catch {
              // Không nhớ được thì lần sau gõ lại — không chặn login.
            }
          } catch (err) {
            loginError.textContent = loginErrorMessage(firebaseErrorCode(err));
          } finally {
            loginButton.disabled = false;
            loginButton.textContent = 'Mở cửa 💝';
          }
        }

        // ---- notes: realtime read (AC-4, AC-5) ------------------------------
        function subscribeNotes(): void {
          if (notesUnsub) return;
          notesUnsub = fb.dbApi.onSnapshot(
            fb.dbApi.query(
              fb.dbApi.collection(fb.db, 'dailyNotes'),
              fb.dbApi.orderBy('createdAtMs', 'desc')
            ),
            (snap) => {
              notesError.textContent = '';
              renderTimeline(snap);
            },
            (err) => {
              const code = firebaseErrorCode(err);
              notesError.textContent =
                code === 'permission-denied'
                  ? 'Không đọc được nhật ký — kiểm tra UID trong Firestore Rules (firebase-setup.md, Bước 5).'
                  : `Không đọc được nhật ký (${code || 'lỗi lạ'}) — thử tải lại trang nhé.`;
            }
          );
        }

        function renderTimeline(snap: QuerySnapshot): void {
          currentNotes = snap.docs
            .map((docSnap) => noteFromDoc(docSnap.id, docSnap.data()))
            .filter((note): note is LoveNote => note !== null);
          // Note đang sửa bị máy kia xóa → thoát edit, bỏ draft, báo nhẹ.
          const editingNow = editing;
          if (
            editingNow &&
            !currentNotes.some((note) => note.id === editingNow.id)
          ) {
            editing = null;
            notesError.textContent =
              'Note đang sửa vừa bị xóa ở máy bên kia rồi 🥺';
          }
          redrawTimeline();
        }

        /** Dựng lại cây timeline từ snapshot gần nhất + state trong closure. */
        function redrawTimeline(): void {
          emptyEl.hidden = currentNotes.length > 0;
          const groups = groupByDate(currentNotes);
          const collapsible = isCollapseEnabled(currentNotes.length);
          const defaultOpen = defaultOpenDateKey(groups);
          timeline.replaceChildren(
            ...groups.map((group) =>
              renderGroup(
                group,
                collapsible,
                // Ưu tiên toggle tay; chưa toggle thì mở đúng ngày mặc định.
                openOverrides.get(group.dateKey) ??
                  group.dateKey === defaultOpen
              )
            )
          );
        }

        function renderGroup(
          group: DayGroup,
          collapsible: boolean,
          open: boolean
        ): HTMLElement {
          const wrap = document.createElement('div');
          wrap.className = 'love-day';
          const heading = document.createElement('h3');
          heading.className = 'love-day-heading';
          const body = document.createElement('div');
          body.className = 'love-day-notes';
          body.append(...group.notes.map(renderNote));

          // Dưới ngưỡng: heading text như cũ, không có control nào (AC-1).
          if (!collapsible) {
            heading.textContent = formatDateHeading(group.dateKey);
            wrap.append(heading, body);
            return wrap;
          }

          body.id = `love-day-${group.dateKey}`;
          body.hidden = !open;

          const toggle = document.createElement('button');
          toggle.type = 'button';
          toggle.className = 'love-day-toggle';
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-controls', body.id);
          const label = document.createElement('span');
          label.className = 'love-day-label';
          label.textContent = formatDateHeading(group.dateKey);
          const count = document.createElement('span');
          count.className = 'love-day-count';
          count.textContent = noteCountLabel(group.notes.length);
          const chevron = document.createElement('span');
          chevron.className = 'love-day-chevron';
          chevron.setAttribute('aria-hidden', 'true');
          chevron.textContent = '▸';
          toggle.append(label, count, chevron);

          toggle.addEventListener('click', () => {
            const nowOpen = body.hidden; // đang ẩn → click này mở ra
            openOverrides.set(group.dateKey, nowOpen);
            body.hidden = !nowOpen;
            toggle.setAttribute('aria-expanded', String(nowOpen));
          });

          heading.append(toggle);
          wrap.append(heading, body);
          return wrap;
        }

        // Toàn bộ nội dung note đi qua textContent — không innerHTML với
        // dữ liệu người dùng.
        function renderNote(note: LoveNote): HTMLElement {
          // Note đang sửa render form inline thay thân card (AC-14);
          // comment/reaction tạm ẩn theo tới khi Lưu/Hủy.
          const editState = editing;
          if (editState && editState.id === note.id) {
            return renderNoteEditor(note, editState.draft);
          }
          const card = document.createElement('article');
          card.className = `love-note love-note--${note.author}`;

          const head = document.createElement('header');
          head.className = 'love-note-head';
          const author = document.createElement('span');
          author.className = 'love-note-author';
          const profile = LOVE_CONFIG.profiles.find(
            (p) => p.id === note.author
          );
          author.textContent = profile
            ? `${profile.emoji} ${profile.name}`
            : note.author;
          const meta = document.createElement('span');
          meta.className = 'love-note-meta';
          meta.textContent = `${note.mood} ${formatTimeVN(note.createdAtMs)}${
            note.updatedAtMs ? ' · đã sửa' : ''
          }`;
          head.append(author, meta);
          card.append(head);

          const text = document.createElement('p');
          text.className = 'love-note-text';
          text.textContent = note.text;
          card.append(text);

          if (note.imageBase64) {
            const img = document.createElement('img');
            img.className = 'love-note-img';
            img.src = note.imageBase64;
            img.alt = 'Ảnh kỷ niệm';
            img.loading = 'lazy';
            card.append(img);
          }

          card.append(
            renderReactionCorner(
              'dailyNotes',
              note.id,
              note.reactions,
              notesError
            )
          );

          const foot = document.createElement('footer');
          foot.className = 'love-note-actions';
          const editBtn = iconButton('✏️', 'Sửa note này');
          editBtn.addEventListener('click', () => startEdit(note));
          const delBtn = iconButton('🗑️', 'Xóa note này');
          delBtn.addEventListener('click', () =>
            askConfirm(card, notesError, () =>
              fb.dbApi.deleteDoc(fb.dbApi.doc(fb.db, 'dailyNotes', note.id))
            )
          );
          foot.append(editBtn, delBtn);
          card.append(foot);
          card.append(
            renderCommentSection('dailyNotes', note.id, note.comments)
          );

          return card;
        }

        function iconButton(glyph: string, label: string): HTMLButtonElement {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'love-icon-button';
          button.textContent = glyph;
          button.setAttribute('aria-label', label);
          return button;
        }

        // ---- notes: write (AC-4, AC-6) ---------------------------------------
        noteForm.addEventListener('submit', (event) => {
          event.preventDefault();
          submitNote();
        });

        // ---- đính ảnh (AC-9) --------------------------------------------------
        photoPick.addEventListener('click', () => photoInput.click());

        photoInput.addEventListener('change', () => {
          const file = photoInput.files?.[0];
          photoInput.value = ''; // reset để chọn lại đúng file cũ vẫn bắn change
          if (!file) return;
          photoPick.disabled = true;
          photoPick.textContent = 'Đang nén… 🍬';
          void compressImage(file).then((dataUrl) => {
            photoPick.disabled = false;
            photoPick.textContent = '📷 Thêm ảnh';
            if (!dataUrl) {
              noteError.textContent =
                'Ảnh nặng quá hoặc không đọc được — chọn ảnh khác nhé 🥺';
              return;
            }
            noteError.textContent = '';
            setPhoto(dataUrl);
          });
        });

        photoRemove.addEventListener('click', () => setPhoto(undefined));

        function setPhoto(dataUrl: string | undefined): void {
          pendingImage = dataUrl;
          photoPreview.hidden = !dataUrl;
          if (dataUrl) photoThumb.src = dataUrl;
          else photoThumb.removeAttribute('src');
        }

        // Composer giờ chỉ tạo note MỚI — sửa đi qua form inline (AC-15).
        function submitNote(): void {
          const text = noteText.value.trim();
          if (!text) {
            noteError.textContent = 'Viết gì đó đã nè ✍️';
            return;
          }
          noteError.textContent = '';
          const imageAtSubmit = pendingImage;

          // Latency compensation của Firestore cho note hiện trong timeline
          // ngay (kể cả offline) → dọn composer luôn; lỗi thật thì trả lại
          // nội dung (edge case "mất mạng, không mất chữ đang gõ").
          const write = fb.dbApi.addDoc(
            fb.dbApi.collection(fb.db, 'dailyNotes'),
            {
              author: activeProfile,
              mood: activeMood,
              text,
              ...(imageAtSubmit ? { imageBase64: imageAtSubmit } : {}),
              dateKey: todayKeyVN(),
              createdAtMs: Date.now(),
            }
          );

          setPhoto(undefined);
          noteText.value = '';

          write.catch((err: unknown) => {
            noteText.value = text;
            setPhoto(imageAtSubmit);
            noteError.textContent = writeErrorMessage(firebaseErrorCode(err));
          });
        }

        // ---- sửa tại chỗ (AC-14..15) -------------------------------------------
        function startEdit(note: LoveNote): void {
          // Đang sửa note khác thì draft cũ bỏ — một form sửa tại một thời điểm.
          editing = {
            id: note.id,
            draft: {
              text: note.text,
              mood: note.mood || activeMood,
              author: note.author,
              image: note.imageBase64,
            },
          };
          redrawTimeline();
          // Chỉ focus ô text của form vừa dựng — không scrollIntoView cả
          // trang (AC-14: viewport không nhảy; focus tự cuộn tối thiểu).
          document.getElementById(`love-edit-text-${note.id}`)?.focus();
        }

        /** Dựng hàng chip chọn-một (aria-pressed) cho form sửa inline. */
        function buildChipRow(
          options: {
            value: string;
            label: string;
            extraClass?: string;
            ariaLabel?: string;
          }[],
          current: string,
          groupLabel: string,
          onPick: (value: string) => void
        ): HTMLDivElement {
          const row = document.createElement('div');
          row.className = 'love-chip-row';
          row.setAttribute('role', 'group');
          row.setAttribute('aria-label', groupLabel);
          const chips: HTMLButtonElement[] = [];
          for (const option of options) {
            const chip = document.createElement('button');
            chip.type = 'button';
            chip.className = option.extraClass
              ? `love-chip ${option.extraClass}`
              : 'love-chip';
            chip.textContent = option.label;
            if (option.ariaLabel) {
              chip.setAttribute('aria-label', option.ariaLabel);
            }
            chip.setAttribute('aria-pressed', String(option.value === current));
            chip.addEventListener('click', () => {
              for (const other of chips) {
                other.setAttribute('aria-pressed', String(other === chip));
              }
              onPick(option.value);
            });
            chips.push(chip);
            row.append(chip);
          }
          return row;
        }

        /**
         * Form sửa tại chỗ thay thân card note đang sửa (hướng E1). Mọi
         * control ghi thẳng vào `draft` nên form sống qua redraw; lỗi lưu
         * báo qua notesError vì error cục bộ của form không sống sót redraw.
         * Mood list đọc lại từ chip tĩnh của composer — một nguồn duy nhất.
         */
        function renderNoteEditor(
          note: LoveNote,
          draft: NonNullable<typeof editing>['draft']
        ): HTMLElement {
          const form = document.createElement('form');
          form.className = `love-note love-note--${draft.author} love-note-editor`;

          const title = document.createElement('p');
          title.className = 'love-note-author';
          title.textContent = 'Sửa note ✏️';
          form.append(title);

          form.append(
            buildChipRow(
              LOVE_CONFIG.profiles.map((profile) => ({
                value: profile.id,
                label: `${profile.emoji} ${profile.name}`,
              })),
              draft.author,
              'Ai đang viết?',
              (value) => {
                draft.author = value;
              }
            ),
            buildChipRow(
              moodChips.map((chip) => ({
                value: chip.dataset.loveMood ?? '',
                label: chip.dataset.loveMood ?? '',
                extraClass: 'love-chip--mood',
                ariaLabel: `Mood ${chip.dataset.loveMood ?? ''}`,
              })),
              draft.mood,
              'Mood hôm nay',
              (value) => {
                draft.mood = value;
              }
            )
          );

          const label = document.createElement('label');
          label.className = 'love-label';
          const textId = `love-edit-text-${note.id}`;
          label.htmlFor = textId;
          label.textContent = 'Chuyện hôm nay 💬';
          const textarea = document.createElement('textarea');
          textarea.id = textId;
          textarea.className = 'love-input love-textarea';
          textarea.rows = 3;
          textarea.value = draft.text;
          textarea.addEventListener('input', () => {
            draft.text = textarea.value;
          });
          form.append(label, textarea);

          const photoRow = document.createElement('div');
          photoRow.className = 'love-photo-row';
          const pick = document.createElement('button');
          pick.type = 'button';
          pick.className = 'love-ghost-button';
          const file = document.createElement('input');
          file.type = 'file';
          file.accept = 'image/*';
          file.hidden = true;
          const preview = document.createElement('span');
          preview.className = 'love-photo-preview';
          const thumb = document.createElement('img');
          thumb.alt = '';
          const drop = iconButton('✖', 'Bỏ ảnh của note');
          preview.append(thumb, drop);
          photoRow.append(pick, file, preview);

          const errEl = document.createElement('p');
          errEl.className = 'love-error';
          errEl.setAttribute('aria-live', 'polite');

          function syncPhoto(): void {
            preview.hidden = !draft.image;
            if (draft.image) thumb.src = draft.image;
            else thumb.removeAttribute('src');
            pick.textContent = draft.image ? '📷 Đổi ảnh' : '📷 Thêm ảnh';
          }
          syncPhoto();

          pick.addEventListener('click', () => file.click());
          file.addEventListener('change', () => {
            const chosen = file.files?.[0];
            file.value = '';
            if (!chosen) return;
            pick.disabled = true;
            pick.textContent = 'Đang nén… 🍬';
            void compressImage(chosen).then((dataUrl) => {
              pick.disabled = false;
              if (!dataUrl) {
                errEl.textContent =
                  'Ảnh nặng quá hoặc không đọc được — chọn ảnh khác nhé 🥺';
                syncPhoto();
                return;
              }
              errEl.textContent = '';
              draft.image = dataUrl;
              syncPhoto();
            });
          });
          drop.addEventListener('click', () => {
            draft.image = undefined;
            syncPhoto();
          });

          const actions = document.createElement('div');
          actions.className = 'love-composer-actions';
          const save = document.createElement('button');
          save.type = 'submit';
          save.className = 'love-button';
          save.textContent = 'Lưu lại 💾';
          const cancel = document.createElement('button');
          cancel.type = 'button';
          cancel.className = 'love-ghost-button';
          cancel.textContent = 'Thôi, không sửa nữa';
          cancel.addEventListener('click', () => {
            editing = null;
            redrawTimeline();
          });
          actions.append(save, cancel);
          form.append(photoRow, errEl, actions);

          form.addEventListener('submit', (event) => {
            event.preventDefault();
            const text = draft.text.trim();
            if (!text) {
              errEl.textContent = 'Viết gì đó đã nè ✍️';
              return;
            }
            // Latency compensation phản ánh bản sửa ngay → thoát edit trước;
            // lỗi thật thì mở lại form với đúng draft (không mất chữ).
            const saved = { ...draft, text };
            editing = null;
            redrawTimeline();
            fb.dbApi
              .updateDoc(fb.dbApi.doc(fb.db, 'dailyNotes', note.id), {
                author: saved.author,
                mood: saved.mood,
                text: saved.text,
                // '' = bỏ ảnh (updateDoc không xóa field khi thiếu deleteField)
                imageBase64: saved.image ?? '',
                updatedAtMs: Date.now(),
              })
              .catch((err: unknown) => {
                editing = { id: note.id, draft: saved };
                redrawTimeline();
                notesError.textContent = writeErrorMessage(
                  firebaseErrorCode(err)
                );
              });
          });

          return form;
        }

        // Xác nhận xóa inline (AC-6 spec 005) — nhận callback thay vì tự
        // deleteDoc để dùng được cho cả note/sticky (deleteDoc) lẫn comment
        // (updateDoc + arrayRemove).
        function askConfirm(
          host: HTMLElement,
          errEl: HTMLParagraphElement,
          run: () => Promise<void>
        ): void {
          if (host.querySelector('.love-confirm')) return;
          const row = document.createElement('div');
          row.className = 'love-confirm';
          const msg = document.createElement('span');
          msg.textContent = 'Xóa thiệt hông? 🥺';
          const yes = document.createElement('button');
          yes.type = 'button';
          yes.className = 'love-confirm-yes';
          yes.textContent = 'Xóa 💔';
          yes.addEventListener('click', () => {
            row.remove();
            run().catch((err: unknown) => {
              errEl.textContent = writeErrorMessage(firebaseErrorCode(err));
            });
          });
          const no = document.createElement('button');
          no.type = 'button';
          no.className = 'love-ghost-button love-confirm-no';
          no.textContent = 'Thôi';
          no.addEventListener('click', () => row.remove());
          row.append(msg, yes, no);
          host.append(row);
        }

        // ---- comment (AC-8..11) ------------------------------------------------
        /**
         * Khu comment cuối card note/sticky: nút "💬 N" + panel (list + ô
         * trả lời + error riêng). Trạng thái xòe và draft giữ trong Map ở
         * closure nên sống qua re-render snapshot.
         */
        function renderCommentSection(
          coll: 'dailyNotes' | 'stickyNotes',
          id: string,
          comments: LoveComment[]
        ): HTMLElement {
          const key = `${coll}/${id}`;
          const open = commentOpen.get(key) ?? false;

          const section = document.createElement('div');
          section.className = 'love-comments';

          const toggle = document.createElement('button');
          toggle.type = 'button';
          toggle.className = 'love-comment-toggle';
          toggle.textContent =
            comments.length > 0 ? `💬 ${comments.length}` : '💬';
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute(
            'aria-label',
            comments.length > 0
              ? `${commentCountLabel(comments.length)}, bấm để xem`
              : 'Trả lời'
          );

          const panel = document.createElement('div');
          panel.className = 'love-comment-panel';
          panel.id = `love-comments-${coll}-${id}`;
          panel.hidden = !open;
          toggle.setAttribute('aria-controls', panel.id);
          toggle.addEventListener('click', () => {
            const nowOpen = panel.hidden;
            commentOpen.set(key, nowOpen);
            panel.hidden = !nowOpen;
            toggle.setAttribute('aria-expanded', String(nowOpen));
          });

          const errEl = document.createElement('p');
          errEl.className = 'love-error';
          errEl.setAttribute('aria-live', 'polite');

          const list = document.createElement('div');
          list.className = 'love-comment-list';
          list.append(
            ...comments.map((comment) =>
              renderComment(coll, id, comment, errEl)
            )
          );

          const form = document.createElement('form');
          form.className = 'love-comment-form';
          const label = document.createElement('label');
          label.className = 'love-sr-only';
          const inputId = `love-comment-input-${coll}-${id}`;
          label.htmlFor = inputId;
          label.textContent = 'Trả lời';
          const input = document.createElement('input');
          input.type = 'text';
          input.id = inputId;
          input.className = 'love-input love-comment-input';
          input.maxLength = 300;
          input.placeholder = 'Trả lời nè…';
          input.value = commentDrafts.get(key) ?? '';
          input.addEventListener('input', () => {
            commentDrafts.set(key, input.value);
          });
          const send = document.createElement('button');
          send.type = 'submit';
          send.className = 'love-comment-send';
          send.textContent = 'Gửi 💌';
          form.append(label, input, send);

          form.addEventListener('submit', (event) => {
            event.preventDefault();
            const text = input.value.trim();
            if (!text) {
              errEl.textContent = 'Viết gì đó đã nè ✍️';
              return;
            }
            errEl.textContent = '';
            // Shape ghi = shape LoveComment, không field thừa — arrayRemove
            // lúc xóa phải match từng field (xem comment trong love-board.ts).
            const comment = {
              id: `c${Date.now().toString(36)}${Math.random().toString(36).slice(2, 8)}`,
              author: activeProfile,
              text,
              createdAtMs: Date.now(),
            };
            // Dọn ô ngay (latency compensation hiện comment tức thì); lỗi
            // thật thì trả chữ lại — cùng pattern với submitNote.
            input.value = '';
            commentDrafts.delete(key);
            fb.dbApi
              .updateDoc(fb.dbApi.doc(fb.db, coll, id), {
                comments: fb.dbApi.arrayUnion(comment),
              })
              .catch((err: unknown) => {
                input.value = text;
                commentDrafts.set(key, text);
                errEl.textContent = writeErrorMessage(firebaseErrorCode(err));
              });
          });

          panel.append(list, form, errEl);
          section.append(toggle, panel);
          return section;
        }

        // ---- reaction (AC-12..13, hành vi Facebook) -----------------------------
        /**
         * Reaction gom về MỘT nút duy nhất dính góc dưới bubble/sticky
         * (feedback lần 4 — nút ở action row và cluster hiển thị bị trùng):
         * - Chưa ai thả: pill 🤍 nhỏ ở góc; có reaction: chính cụm
         *   emoji + avatar từng người là nút.
         * - BẤM nút xòe palette nổi; desktop hover cũng mở, phím mũi tên
         *   cho bàn phím; Escape / click-ngoài / bấm lại để đóng.
         * - Mỗi người ĐÚNG MỘT reaction — chọn emoji khác là THAY, chọn
         *   lại emoji đang thả là BỎ.
         * - Pill thấp hơn 44px nhưng vùng bấm được nới bằng ::after nên
         *   touch target thật vẫn ≥44px.
         */
        function renderReactionCorner(
          coll: 'dailyNotes' | 'stickyNotes',
          id: string,
          reactions: LoveReaction[],
          errEl: HTMLParagraphElement
        ): HTMLElement {
          const wrap = document.createElement('span');
          wrap.className = 'love-react-corner';

          const mine = myReactions(reactions)[0];
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'love-react-corner-btn';
          if (reactions.length === 0) {
            btn.classList.add('love-react-corner-btn--empty');
            const face = document.createElement('span');
            face.setAttribute('aria-hidden', 'true');
            face.textContent = '🤍';
            btn.append(face);
            btn.setAttribute('aria-label', 'Thả cảm xúc');
          } else {
            const parts: string[] = [];
            for (const reaction of reactions) {
              const profile = LOVE_CONFIG.profiles.find(
                (p) => p.id === reaction.author
              );
              const pair = document.createElement('span');
              pair.className = 'love-reaction-pair';
              pair.setAttribute('aria-hidden', 'true');
              const face = document.createElement('span');
              face.className = 'love-rp-emoji';
              face.textContent = reaction.emoji;
              const who = document.createElement('span');
              who.className = 'love-rp-who';
              who.textContent = profile?.emoji ?? '💌';
              pair.append(face, who);
              btn.append(pair);
              parts.push(
                `${reaction.emoji} — ${profile?.name ?? reaction.author}`
              );
            }
            btn.setAttribute(
              'aria-label',
              `Cảm xúc: ${parts.join('; ')}. Bấm để ${
                mine ? 'đổi hoặc bỏ' : 'thả'
              } của bạn`
            );
          }
          btn.setAttribute('aria-haspopup', 'true');
          btn.setAttribute('aria-expanded', 'false');

          const palette = document.createElement('div');
          palette.className = 'love-react-palette';
          palette.hidden = true;

          let closeTimer: number | undefined;
          const onDocClick = (event: MouseEvent): void => {
            if (!wrap.contains(event.target as Node)) close();
          };
          const onKey = (event: KeyboardEvent): void => {
            if (event.key === 'Escape') {
              close();
              btn.focus();
            }
          };
          function open(): void {
            if (!palette.hidden) return;
            palette.hidden = false;
            // Nút ở góc PHẢI bubble → neo phải mặc định; tràn mép trái
            // viewport (sticky cột trái trên mobile) thì lật neo trái.
            // Đo bằng offsetWidth chứ KHÔNG getBoundingClientRect: animation
            // pop đang scale nhỏ palette nên rect trả bề rộng thiếu.
            palette.classList.remove('love-react-palette--flip');
            const anchor = wrap.getBoundingClientRect();
            if (anchor.right - palette.offsetWidth < 8) {
              palette.classList.add('love-react-palette--flip');
            }
            btn.setAttribute('aria-expanded', 'true');
            document.addEventListener('click', onDocClick);
            document.addEventListener('keydown', onKey);
          }
          function close(): void {
            if (palette.hidden) return;
            palette.hidden = true;
            btn.setAttribute('aria-expanded', 'false');
            document.removeEventListener('click', onDocClick);
            document.removeEventListener('keydown', onKey);
          }

          REACTIONS.forEach((emoji, index) => {
            const isMine = mine?.emoji === emoji;
            const pick = document.createElement('button');
            pick.type = 'button';
            pick.className = 'love-react-pick';
            pick.textContent = emoji;
            // Stagger từng emoji nhô lên lần lượt như palette của FB.
            pick.style.animationDelay = `${index * 35}ms`;
            pick.setAttribute('aria-pressed', String(isMine));
            pick.setAttribute(
              'aria-label',
              isMine ? `Bỏ ${emoji} của bạn` : `Thả ${emoji}`
            );
            pick.addEventListener('click', () => {
              close();
              // Chọn lại emoji đang thả = bỏ; emoji khác = thay (FB).
              setReaction(coll, id, reactions, isMine ? null : emoji, errEl);
            });
            palette.append(pick);
          });

          // Bấm nút là xòe palette ngay — long-press kiểu FB bị chê khó
          // khám phá (feedback lần 3); mọi thao tác chọn/thay/bỏ nằm
          // trong palette.
          btn.addEventListener('click', (event) => {
            // Đừng để onDocClick vừa gắn xong đã đóng lại vì chính click này.
            event.stopPropagation();
            if (palette.hidden) open();
            else close();
          });
          // Bàn phím: mũi tên cũng mở và nhảy focus vào emoji đầu.
          btn.addEventListener('keydown', (event) => {
            if (event.key === 'ArrowUp' || event.key === 'ArrowDown') {
              event.preventDefault();
              open();
              palette.querySelector<HTMLButtonElement>('button')?.focus();
            }
          });
          // Desktop trỏ chuột vào là xòe như Facebook; rời cả cụm 300ms thì
          // cất. Chỉ gắn ở môi trường có hover thật để không phá touch.
          if (window.matchMedia('(hover: hover)').matches) {
            wrap.addEventListener('mouseenter', () => {
              window.clearTimeout(closeTimer);
              open();
            });
            wrap.addEventListener('mouseleave', () => {
              closeTimer = window.setTimeout(close, 300);
            });
          }

          wrap.append(btn, palette);
          return wrap;
        }

        /** Mọi reaction của người đang chọn — data cũ có thể còn nhiều
         * cái/người (mô hình bật/tắt trước đây), gom hết để lần ghi kế
         * dọn về đúng một reaction/người như Facebook. */
        function myReactions(reactions: LoveReaction[]): LoveReaction[] {
          return reactions.filter((r) => r.author === activeProfile);
        }

        /**
         * Đặt reaction của mình thành `emoji` (null = bỏ hẳn). Firestore
         * không cho hai transform trên cùng field trong một updateDoc nên
         * replace = gỡ hết của mình trước rồi union cái mới; mỗi bước vẫn
         * atomic theo phần tử nên không đè reaction của người kia (AC-13).
         */
        function setReaction(
          coll: 'dailyNotes' | 'stickyNotes',
          id: string,
          reactions: LoveReaction[],
          emoji: string | null,
          errEl: HTMLParagraphElement
        ): void {
          const ref = fb.dbApi.doc(fb.db, coll, id);
          const mine = myReactions(reactions);
          void (async () => {
            if (mine.length > 0) {
              await fb.dbApi.updateDoc(ref, {
                reactions: fb.dbApi.arrayRemove(...mine),
              });
            }
            if (emoji) {
              await fb.dbApi.updateDoc(ref, {
                reactions: fb.dbApi.arrayUnion({
                  emoji,
                  author: activeProfile,
                }),
              });
            }
          })().catch((err: unknown) => {
            errEl.textContent = writeErrorMessage(firebaseErrorCode(err));
          });
        }

        function renderComment(
          coll: 'dailyNotes' | 'stickyNotes',
          id: string,
          comment: LoveComment,
          errEl: HTMLParagraphElement
        ): HTMLElement {
          const row = document.createElement('div');
          row.className = `love-comment love-comment--${comment.author}`;
          const meta = document.createElement('span');
          meta.className = 'love-comment-meta';
          const profile = LOVE_CONFIG.profiles.find(
            (p) => p.id === comment.author
          );
          meta.textContent = `${
            profile ? `${profile.emoji} ${profile.name}` : comment.author
          } · ${formatTimeVN(comment.createdAtMs)}`;
          const text = document.createElement('p');
          text.className = 'love-comment-text';
          text.textContent = comment.text;
          const del = iconButton('🗑️', 'Xóa trả lời này');
          del.classList.add('love-comment-del');
          del.addEventListener('click', () =>
            askConfirm(row, errEl, () =>
              fb.dbApi.updateDoc(fb.dbApi.doc(fb.db, coll, id), {
                comments: fb.dbApi.arrayRemove(comment),
              })
            )
          );
          row.append(meta, text, del);
          return row;
        }

        // ---- sticky board (AC-7) ---------------------------------------------
        stickyForm.addEventListener('submit', (event) => {
          event.preventDefault();
          const text = stickyText.value.trim();
          if (!text) {
            stickyError.textContent = 'Viết gì đó lên giấy đã nè ✍️';
            return;
          }
          stickyError.textContent = '';
          stickyText.value = '';
          fb.dbApi
            .addDoc(fb.dbApi.collection(fb.db, 'stickyNotes'), {
              text,
              color: activeColor,
              author: activeProfile,
              createdAtMs: Date.now(),
            })
            .catch((err: unknown) => {
              stickyText.value = text;
              stickyError.textContent = writeErrorMessage(
                firebaseErrorCode(err)
              );
            });
        });

        function subscribeSticky(): void {
          if (stickyUnsub) return;
          stickyUnsub = fb.dbApi.onSnapshot(
            fb.dbApi.query(
              fb.dbApi.collection(fb.db, 'stickyNotes'),
              fb.dbApi.orderBy('createdAtMs', 'desc')
            ),
            (snap) => {
              currentStickies = snap.docs
                .map((docSnap) => stickyFromDoc(docSnap.id, docSnap.data()))
                .filter((s): s is LoveSticky => s !== null);
              redrawSticky();
            },
            (err) => {
              stickyError.textContent = writeErrorMessage(
                firebaseErrorCode(err)
              );
            }
          );
        }

        /** Dựng lại sticky grid từ snapshot gần nhất (đổi profile cũng gọi). */
        function redrawSticky(): void {
          stickyEmpty.hidden = currentStickies.length > 0;
          stickyGrid.replaceChildren(...currentStickies.map(renderSticky));
        }

        function renderSticky(sticky: LoveSticky): HTMLElement {
          const card = document.createElement('article');
          card.className = `love-sticky love-paper--${sticky.color}`;
          const text = document.createElement('p');
          text.className = 'love-sticky-text';
          text.textContent = sticky.text;
          const foot = document.createElement('footer');
          foot.className = 'love-sticky-foot';
          const who = document.createElement('span');
          const profile = LOVE_CONFIG.profiles.find(
            (p) => p.id === sticky.author
          );
          who.textContent = profile ? profile.emoji : '💌';
          const del = iconButton('🗑️', 'Gỡ mẩu giấy này');
          del.addEventListener('click', () =>
            askConfirm(card, stickyError, () =>
              fb.dbApi.deleteDoc(fb.dbApi.doc(fb.db, 'stickyNotes', sticky.id))
            )
          );
          foot.append(who, del);
          card.append(
            renderReactionCorner(
              'stickyNotes',
              sticky.id,
              sticky.reactions,
              stickyError
            ),
            text,
            foot
          );
          card.append(
            renderCommentSection('stickyNotes', sticky.id, sticky.comments)
          );
          return card;
        }
      }

      // ---- chip helpers (dùng chung cho profile + mood) ----------------------
      function readSavedProfile(): string {
        try {
          const stored = localStorage.getItem('love-profile');
          if (stored === 'p1' || stored === 'p2') return stored;
        } catch {
          // localStorage bị chặn — dùng mặc định.
        }
        return LOVE_CONFIG.profiles[0].id;
      }

      function wireChips(
        chips: HTMLButtonElement[],
        dataKey: 'loveProfile' | 'loveMood' | 'loveColor',
        initial: string,
        onPick: (value: string) => void
      ): void {
        const set = (value: string): void => {
          for (const chip of chips) {
            chip.setAttribute(
              'aria-pressed',
              String(chip.dataset[dataKey] === value)
            );
          }
          onPick(value);
        };
        for (const chip of chips) {
          chip.addEventListener('click', () =>
            set(chip.dataset[dataKey] ?? '')
          );
        }
        set(initial);
      }
    </script>
  </body>
</html>

<style is:global>
  /* is:global BẮT BUỘC ở đây: timeline/sticky được script dựng bằng
     createElement ở runtime nên không có scope attribute của Astro — style
     scoped sẽ không áp vào chúng. An toàn vì Astro chỉ bundle CSS này cho
     đúng page này, và mọi selector đều prefix .love-*. */

  /* Palette pastel cục bộ của trang — độc lập với --color-* của site. */
  html {
    --love-bg: #fff5f7;
    --love-bg-accent: #ffe4ec;
    --love-card: #ffffff;
    --love-border: #ffd3e0;
    /* Chữ/nền đều phải giữ contrast AA trên nền pastel — các màu "deep"
       được chọn đạt ≥4.5:1 với trắng (text nhỏ) hoặc làm nền cho chữ trắng. */
    --love-fg: #5b4049;
    /* Đậm hơn bản cũ (#8a6575) để giữ ≥4.5:1 trên nền bubble tint. */
    --love-fg-muted: #7d5966;
    --love-pink: #f472a8; /* decor: viền active, tim, selection */
    --love-pink-deep: #b23a6f; /* text nhỏ trên nền sáng + nền nút chữ trắng */
    --love-pink-darker: #9c2f60; /* hover của nút */
    --love-pink-fg: #ffffff;
    --love-p1: #f472a8;
    --love-p2: #7c5cba;
    /* Bong bóng chat 2 phía (polish P2): nền tint + viền theo người viết.
       Text trên tint phải giữ AA: fg 7.8:1, tên p1 4.9:1, tên p2 dùng
       --love-p2-deep 5.6:1 (chính --love-p2 chỉ đạt 4.3:1 trên tint tím). */
    --love-p1-soft: #ffe9f1;
    --love-p2-soft: #efe9fb;
    --love-p2-border: #ded1f5;
    --love-p2-deep: #6a4ba8;
    --love-radius: 20px;
    --love-font:
      'Quicksand', ui-rounded, 'SF Pro Rounded', 'Segoe UI', system-ui,
      sans-serif;
    --love-font-display: 'Pacifico', 'Quicksand', ui-rounded, cursive;

    /* Override nền/font dark-terminal của global.css cho riêng page này. */
    background: linear-gradient(
      180deg,
      var(--love-bg) 0%,
      var(--love-bg-accent) 100%
    );
    color: var(--love-fg);
    font-family: var(--love-font);
    color-scheme: light;
  }

  body {
    background: transparent;
    min-height: 100dvh;
  }

  /* Focus ring của global.css dùng accent lime của site — đổi sang hồng. */
  :focus-visible {
    outline-color: var(--love-pink-deep);
  }

  ::selection {
    background: var(--love-pink);
    color: var(--love-pink-fg);
  }

  .love-kicker {
    color: var(--love-pink);
    font-size: 0.8rem;
    letter-spacing: 0.6em;
    padding-left: 0.6em; /* bù letter-spacing để chuỗi cân giữa */
  }

  .love-title {
    font-family: var(--love-font-display);
    font-size: 2rem;
    line-height: 1.3;
    margin-top: 0.5rem;
    color: var(--love-pink-deep);
  }

  .love-setup-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--love-pink-deep);
  }

  /* Bộ đếm ngày thành pill nổi — điểm nhấn của header (polish P2). */
  .love-days {
    display: inline-block;
    margin-top: 0.875rem;
    padding: 0.5rem 1.25rem;
    border: 2px solid var(--love-border);
