---
import { ArrowLeft, ExternalLink } from '@lucide/astro';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/ui/Container.astro';
import { withBase } from '~/lib/site-config';
import { allTools, toolSlug, type Tool } from '~/lib/tools';

/**
 * Chrome-wrapped viewer for a standalone tool demo.
 *
 * The demos live as self-contained documents in `public/tools/<slug>/` (their
 * own <html>/<body>, isolated CSS+JS). Embedding them in an iframe here lets us
 * keep the site header/footer + navigation around them without leaking their
 * styles into the app shell.
 */
export const getStaticPaths = (() =>
  allTools.map((tool) => ({
    params: { slug: toolSlug(tool.href) },
    props: { tool },
  }))) satisfies GetStaticPaths;

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const slug = toolSlug(tool.href);
const demoSrc = withBase(`/tools/${slug}/`);

// App-style demos (canvas/game/fixed-height) fill a tall viewport; content-flow
// demos are auto-sized to their content height by the inline script below.
const isApp = tool.app === true;
const frameStyle = isApp
  ? 'height: calc(100dvh - 9rem); min-height: 540px; overflow: hidden'
  : 'height: 80vh; overflow: hidden';
---

<BaseLayout title={tool.name} description={tool.description}>
  <div class="flex h-full flex-col">
    <Container class="pt-8">
      <div
        class="flex flex-wrap items-center justify-between gap-3 border-b border-dashed border-[var(--color-border-strong)] pb-4"
      >
        <div class="min-w-0">
          <a
            href={withBase('/tools')}
            class="inline-flex items-center gap-1.5 text-xs tracking-wider text-[var(--color-fg-muted)] uppercase transition-colors hover:text-[var(--color-accent)]"
          >
            <ArrowLeft class="h-3.5 w-3.5" />
            All tools
          </a>
          <h1
            class="mt-2 truncate text-xl font-semibold tracking-tight sm:text-2xl"
          >
            <span class="text-[var(--color-accent)]">//</span>
            {tool.name}
          </h1>
        </div>

        <a
          href={demoSrc}
          target="_blank"
          rel="noopener"
          class="inline-flex shrink-0 items-center gap-1.5 rounded-xs border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-1.5 text-xs tracking-wider text-[var(--color-fg-muted)] uppercase transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
        >
          Open standalone
          <ExternalLink class="h-3.5 w-3.5" />
        </a>
      </div>
    </Container>

    <Container class="flex flex-1 flex-col pt-5 pb-12">
      <iframe
        id="tool-frame"
        src={demoSrc}
        title={`${tool.name} — interactive demo`}
        loading="lazy"
        data-fit={isApp ? 'app' : 'flow'}
        style={frameStyle}
        class="w-full rounded-md border border-[var(--color-border)] bg-[#0a0a0a]"
      ></iframe>
    </Container>
  </div>
</BaseLayout>

{
  /* Auto-size the iframe to its content so tall, interactive demos aren't
   * clipped or trapped behind an inner scrollbar. The demo is same-origin, so
   * we can read its document height and keep it in sync as the demo expands
   * (accordions, tabs, spawning elements). */
}
<script>
  const frame = document.getElementById('tool-frame');

  // App-style demos keep their fixed viewport height — only content-flow demos
  // are auto-sized to their content.
  if (frame instanceof HTMLIFrameElement && frame.dataset.fit !== 'app') {
    const fit = () => {
      const doc = frame.contentDocument;
      if (!doc) return;
      // Collapse before measuring: a height applied earlier stretches the
      // demo's <html> to match, which would pin the measurement to that old
      // value and stop the frame from ever shrinking again. Reading in the
      // same tick means the collapsed state is never painted.
      const previous = frame.style.height;
      frame.style.height = '0px';
      const height = Math.max(
        doc.documentElement.scrollHeight,
        doc.body?.scrollHeight ?? 0
      );
      frame.style.height = height > 0 ? `${height}px` : previous;
    };

    const observe = () => {
      fit();
      const win = frame.contentWindow;
      const doc = frame.contentDocument;
      if (!win || !doc) return;

      // React to content reflow inside the demo (interaction, async render).
      // Observe <body>, not <html>: once we set an explicit iframe height,
      // <html> is stretched to it and stops reporting the content's growth.
      const RO = (win as unknown as { ResizeObserver?: typeof ResizeObserver })
        .ResizeObserver;
      if (RO && doc.body) new RO(fit).observe(doc.body);

      // ResizeObserver does not reliably deliver notifications for a target
      // living in another document, so also re-measure after the interactions
      // that change a demo's height, plus a few settling passes for demos that
      // render asynchronously.
      // Timers rather than requestAnimationFrame: rAF is throttled to a
      // stopped animation frame while the page is hidden, which would leave
      // the demo clipped until it becomes visible again.
      const scheduleFit = () => {
        setTimeout(fit, 0);
        setTimeout(fit, 120);
      };
      for (const type of ['click', 'change', 'input', 'keyup']) {
        doc.addEventListener(type, scheduleFit, true);
      }
      for (const delay of [150, 500, 1200]) setTimeout(fit, delay);

      win.addEventListener('resize', fit);
    };

    frame.addEventListener('load', observe);
    // The iframe can finish loading before this module runs, in which case the
    // `load` event above never fires and the demo stays clipped at its initial
    // height — so size it immediately when it is already complete.
    if (frame.contentDocument?.readyState === 'complete') observe();

    // Parent viewport resize changes the demo's responsive layout height too.
    window.addEventListener('resize', fit);
  }
</script>
