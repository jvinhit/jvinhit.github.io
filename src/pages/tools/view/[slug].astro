---
import { ArrowLeft, ExternalLink } from '@lucide/astro';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/ui/Container.astro';
import { withBase } from '~/lib/site-config';
import { allTools, toolSlug, type Tool } from '~/lib/tools';

/**
 * Chrome-wrapped viewer for a standalone tool demo.
 *
 * The demos live as self-contained documents in `public/tools/<slug>/` (their
 * own <html>/<body>, isolated CSS+JS). Embedding them in an iframe here lets us
 * keep the site header/footer + navigation around them without leaking their
 * styles into the app shell.
 */
export const getStaticPaths = (() =>
  allTools.map((tool) => ({
    params: { slug: toolSlug(tool.href) },
    props: { tool },
  }))) satisfies GetStaticPaths;

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const slug = toolSlug(tool.href);
const demoSrc = withBase(`/tools/${slug}/`);

// Both kinds of demo get a viewport-sized frame.
//
// Content-flow demos used to be grown to their full content height instead, but
// a frame taller than the viewport is a scroll trap: the wheel goes to the
// demo's document and the browser does not pass it on to this page, so with the
// pointer over the frame — which covers nearly the whole screen — the page
// cannot be scrolled at all. A bounded frame lets the demo scroll itself and
// the page scroll normally, so `overflow: hidden` stays off for flow demos.
const isApp = tool.app === true;
const frameStyle = isApp
  ? 'height: calc(100dvh - 9rem); min-height: 540px; overflow: hidden'
  : 'height: calc(100dvh - 12rem); min-height: 520px';
---

<BaseLayout title={tool.name} description={tool.description}>
  <div class="flex h-full flex-col">
    <Container class="pt-8">
      <div
        class="flex flex-wrap items-center justify-between gap-3 border-b border-dashed border-[var(--color-border-strong)] pb-4"
      >
        <div class="min-w-0">
          <a
            href={withBase('/tools')}
            class="inline-flex items-center gap-1.5 text-xs tracking-wider text-[var(--color-fg-muted)] uppercase transition-colors hover:text-[var(--color-accent)]"
          >
            <ArrowLeft class="h-3.5 w-3.5" />
            All tools
          </a>
          <h1
            class="mt-2 truncate text-xl font-semibold tracking-tight sm:text-2xl"
          >
            <span class="text-[var(--color-accent)]">//</span>
            {tool.name}
          </h1>
        </div>

        <a
          href={demoSrc}
          target="_blank"
          rel="noopener"
          class="inline-flex shrink-0 items-center gap-1.5 rounded-xs border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-1.5 text-xs tracking-wider text-[var(--color-fg-muted)] uppercase transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
        >
          Open standalone
          <ExternalLink class="h-3.5 w-3.5" />
        </a>
      </div>
    </Container>

    <Container class="flex flex-1 flex-col pt-5 pb-12">
      <iframe
        id="tool-frame"
        src={demoSrc}
        title={`${tool.name} — interactive demo`}
        loading="lazy"
        style={frameStyle}
        class="w-full rounded-md border border-[var(--color-border)] bg-[#0a0a0a]"
      ></iframe>
    </Container>
  </div>
</BaseLayout>
