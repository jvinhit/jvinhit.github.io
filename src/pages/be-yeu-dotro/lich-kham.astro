---
/**
 * `/be-yeu-dotro/lich-kham/` — lịch hẹn khám (spec 009, AC-16) + bảng mốc
 * khám chuẩn theo tuần (AC-9). Lịch hẹn là của chung hai vợ chồng nên cả hai
 * sửa/xóa được (khác nhật ký "của mình"). Danh sách dựng bằng script từ
 * snapshot realtime → style đặt `is:global` với prefix `.by-appt-*`.
 */
import PregnancyLayout from '~/layouts/PregnancyLayout.astro';
import Disclaimer from '~/components/pregnancy/Disclaimer.astro';
import { MILESTONES } from '~/lib/pregnancy-milestones';
---

<PregnancyLayout title="Lịch khám" nav="appointments">
  <h1 class="by-title">Lịch khám</h1>
  <p class="by-muted mt-1">
    Ghi lịch hẹn và kết quả mỗi lần khám; bảng mốc chuẩn bên dưới nhắc mốc nào
    đang tới.
  </p>

  <!-- Form tạo / sửa lịch hẹn -->
  <section class="by-card mt-4" aria-labelledby="by-appt-form-heading">
    <h2 id="by-appt-form-heading" class="by-subtitle" data-by-appt-form-title>
      Thêm lịch hẹn
    </h2>
    <form data-by-appt-form novalidate>
      <fieldset class="by-fieldset" data-by-appt-fields disabled>
        <div class="by-appt-row">
          <div>
            <label class="by-label" for="by-appt-date">Ngày khám</label>
            <input id="by-appt-date" class="by-input" type="date" name="date" />
          </div>
          <div>
            <label class="by-label" for="by-appt-time">
              Giờ <span class="by-muted">(tuỳ chọn)</span>
            </label>
            <input id="by-appt-time" class="by-input" type="time" name="time" />
          </div>
        </div>
        <label class="by-label" for="by-appt-purpose">Khám gì</label>
        <input
          id="by-appt-purpose"
          class="by-input"
          type="text"
          name="purpose"
          maxlength="120"
          placeholder="Siêu âm hình thái, khám định kỳ…"
        />
        <label class="by-label" for="by-appt-place">
          Nơi khám / bác sĩ <span class="by-muted">(tuỳ chọn)</span>
        </label>
        <input
          id="by-appt-place"
          class="by-input"
          type="text"
          name="place"
          maxlength="120"
          placeholder="BV Từ Dũ, phòng khám BS…"
        />
        <label class="by-label" for="by-appt-result">
          Kết quả / ghi chú <span class="by-muted">(điền sau khi khám)</span>
        </label>
        <textarea
          id="by-appt-result"
          class="by-input by-textarea"
          name="result"
          rows="3"
          maxlength="2000"
          placeholder="Cân nặng bé, kết luận của bác sĩ, thuốc được kê…"
        ></textarea>
        <label class="by-appt-done-toggle">
          <input type="checkbox" name="done" />
          <span>Đã khám xong</span>
        </label>
        <input type="hidden" name="milestoneId" value="" />
        <p class="by-error" data-by-appt-error aria-live="polite"></p>
        <div class="by-appt-form-actions">
          <button class="by-button" type="submit" data-by-appt-submit>
            Lưu lịch hẹn
          </button>
          <button
            class="by-ghost-button"
            type="button"
            data-by-appt-cancel
            hidden
          >
            Hủy sửa
          </button>
        </div>
      </fieldset>
    </form>
  </section>

  <p
    class="by-error by-inline-error"
    data-by-appt-list-error
    aria-live="polite"
  >
  </p>

  <section class="mt-5" aria-labelledby="by-appt-upcoming-heading">
    <h2 id="by-appt-upcoming-heading" class="by-subtitle">🗓️ Sắp tới</h2>
    <p class="by-muted mt-1" data-by-appt-upcoming-empty hidden>
      Chưa có lịch hẹn nào — thêm ở trên hoặc bấm "Thêm vào lịch khám" ở một mốc
      bên dưới.
    </p>
    <div class="by-appt-list mt-2" data-by-appt-upcoming aria-busy="true">
      <span class="by-skel by-skel-card by-appt-skel" aria-hidden="true"></span>
      <span class="by-skel by-skel-card by-appt-skel" aria-hidden="true"></span>
    </div>
  </section>

  <section class="mt-5" aria-labelledby="by-appt-done-heading">
    <h2 id="by-appt-done-heading" class="by-subtitle">✅ Đã khám</h2>
    <p class="by-muted mt-1" data-by-appt-done-empty hidden>
      Lần khám xong, tick "Đã khám xong" và ghi kết quả để sau này tra lại.
    </p>
    <div class="by-appt-list mt-2" data-by-appt-done aria-busy="true">
      <span class="by-skel by-skel-card by-appt-skel" aria-hidden="true"></span>
    </div>
  </section>

  <!-- Bảng mốc chuẩn (tĩnh); script gắn trạng thái + ngày gợi ý -->
  <section class="mt-6" aria-labelledby="by-milestones-heading">
    <h2 id="by-milestones-heading" class="by-subtitle">
      🩺 Mốc khám & xét nghiệm chuẩn
    </h2>
    <p class="by-muted mt-1">
      Theo tuần thai. Trạng thái tô theo tuần hiện tại của nhà mình; bấm "Thêm
      vào lịch khám" để điền sẵn form ở trên.
    </p>
    <ol class="by-ms-list mt-3">
      {
        MILESTONES.map((m) => (
          <li
            class="by-card by-ms"
            data-by-ms={m.id}
            data-by-ms-from={m.fromWeek}
            data-by-ms-to={m.toWeek}
          >
            <div class="by-ms-head">
              <p class="by-kicker">
                Tuần {m.fromWeek}–{m.toWeek}
              </p>
              <span class="by-ms-status" data-by-ms-status>
                Sắp tới
              </span>
            </div>
            <h3 class="by-ms-title">{m.title}</h3>
            <p class="mt-1">{m.why}</p>
            <details class="by-ms-prep mt-2">
              <summary>Chuẩn bị gì</summary>
              <p class="mt-1">{m.prep}</p>
            </details>
            <button
              class="by-ghost-button mt-3"
              type="button"
              data-by-ms-add
              data-by-ms-title={m.title}
            >
              Thêm vào lịch khám
            </button>
          </li>
        ))
      }
    </ol>
    <Disclaimer />
  </section>
</PregnancyLayout>

<script>
  import { todayKeyVN } from '~/lib/love-board';
  import { firebaseErrorCode } from '~/lib/love-firebase';
  import {
    appointmentFromDoc,
    formatDateVN,
    gestationalAge,
    isDateKey,
    milestoneStatus,
    milestoneStatusLabel,
    relativeDayLabel,
    splitAppointments,
    suggestedDateForWeek,
    type Appointment,
  } from '~/lib/pregnancy';
  import {
    awaitWrite,
    onSettings,
    pregnancyWriteErrorMessage,
    QUEUED_MESSAGE,
    watchCollection,
    whileSignedIn,
    type SessionContext,
  } from '~/lib/pregnancy-session';
  import { markLoaded, showSkeletonCards, withBusy } from '~/lib/pregnancy-ui';

  const COLLECTION = 'pregnancyAppointments';

  function must<T extends HTMLElement>(selector: string): T {
    const node = document.querySelector<T>(selector);
    if (!node) throw new Error(`be-yeu lich-kham: thiếu ${selector}`);
    return node;
  }

  const form = must<HTMLFormElement>('[data-by-appt-form]');
  const fields = must<HTMLFieldSetElement>('[data-by-appt-fields]');
  const formTitle = must<HTMLHeadingElement>('[data-by-appt-form-title]');
  const formError = must<HTMLParagraphElement>('[data-by-appt-error]');
  const submitButton = must<HTMLButtonElement>('[data-by-appt-submit]');
  const cancelButton = must<HTMLButtonElement>('[data-by-appt-cancel]');
  const listError = must<HTMLParagraphElement>('[data-by-appt-list-error]');
  const upcomingEl = must<HTMLDivElement>('[data-by-appt-upcoming]');
  const upcomingEmpty = must<HTMLParagraphElement>(
    '[data-by-appt-upcoming-empty]'
  );
  const doneEl = must<HTMLDivElement>('[data-by-appt-done]');
  const doneEmpty = must<HTMLParagraphElement>('[data-by-appt-done-empty]');

  const field = (name: string): HTMLInputElement | HTMLTextAreaElement => {
    const node = form.querySelector<HTMLInputElement | HTMLTextAreaElement>(
      `[name="${name}"]`
    );
    if (!node) throw new Error(`be-yeu lich-kham: thiếu field ${name}`);
    return node;
  };
  const dateInput = field('date') as HTMLInputElement;
  const timeInput = field('time') as HTMLInputElement;
  const purposeInput = field('purpose') as HTMLInputElement;
  const placeInput = field('place') as HTMLInputElement;
  const resultInput = field('result') as HTMLTextAreaElement;
  const doneInput = field('done') as HTMLInputElement;
  const milestoneInput = field('milestoneId') as HTMLInputElement;

  let ctx: SessionContext | null = null;
  let current: Appointment[] = [];
  /**
   * Đã có snapshot đầu chưa — trước đó danh sách là skeleton và KHÔNG được
   * hiện "chưa có lịch hẹn" (mạng chậm sẽ báo rỗng sai).
   */
  let loaded = false;
  /** id lịch hẹn đang sửa trong form; null = đang tạo mới. */
  let editingId: string | null = null;
  /** Ngày dự sinh hiện tại — để gợi ý ngày cho mốc khám. */
  let dueDate: string | null = null;
  let currentWeek: number | null = null;

  // ---- form -----------------------------------------------------------------

  function resetForm(): void {
    editingId = null;
    form.reset();
    milestoneInput.value = '';
    formTitle.textContent = 'Thêm lịch hẹn';
    submitButton.textContent = 'Lưu lịch hẹn';
    cancelButton.hidden = true;
    formError.textContent = '';
  }

  function startEdit(appointment: Appointment): void {
    editingId = appointment.id;
    dateInput.value = appointment.date;
    timeInput.value = appointment.time ?? '';
    purposeInput.value = appointment.purpose;
    placeInput.value = appointment.place;
    resultInput.value = appointment.result ?? '';
    doneInput.checked = appointment.status === 'done';
    milestoneInput.value = appointment.milestoneId ?? '';
    formTitle.textContent = 'Sửa lịch hẹn';
    submitButton.textContent = 'Lưu thay đổi';
    cancelButton.hidden = false;
    formError.textContent = '';
    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    purposeInput.focus();
  }

  cancelButton.addEventListener('click', resetForm);

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    void save();
  });

  async function save(): Promise<void> {
    formError.textContent = '';
    if (!ctx) {
      formError.textContent = 'Chưa có phiên hợp lệ — đăng nhập lại nhé.';
      return;
    }
    const date = dateInput.value;
    const purpose = purposeInput.value.trim();
    if (!isDateKey(date)) {
      formError.textContent = 'Chọn ngày khám nhé.';
      return;
    }
    if (!purpose) {
      formError.textContent = 'Ghi khám gì để sau còn nhớ nhé.';
      return;
    }
    const payload = {
      date,
      time: /^\d{2}:\d{2}$/.test(timeInput.value) ? timeInput.value : '',
      purpose,
      place: placeInput.value.trim(),
      result: resultInput.value.trim(),
      status: doneInput.checked ? 'done' : 'upcoming',
      milestoneId: milestoneInput.value,
      updatedAtMs: Date.now(),
    };
    const { fb, me } = ctx;
    const write = editingId
      ? fb.dbApi.updateDoc(fb.dbApi.doc(fb.db, COLLECTION, editingId), payload)
      : fb.dbApi.addDoc(fb.dbApi.collection(fb.db, COLLECTION), {
          ...payload,
          author: me.id,
          createdAtMs: Date.now(),
        });
    try {
      const outcome = await withBusy(submitButton, 'Đang lưu…', () =>
        awaitWrite(write, (message) => {
          listError.textContent = message;
        })
      );
      resetForm();
      if (outcome === 'queued') formError.textContent = QUEUED_MESSAGE;
    } catch (err) {
      // Chữ trong form giữ nguyên để thử lại.
      formError.textContent = pregnancyWriteErrorMessage(
        firebaseErrorCode(err)
      );
    }
  }

  async function markDone(
    appointment: Appointment,
    trigger: HTMLButtonElement
  ): Promise<void> {
    if (!ctx) return;
    const { fb } = ctx;
    try {
      await withBusy(trigger, 'Đang lưu…', () =>
        awaitWrite(
          fb.dbApi.updateDoc(fb.dbApi.doc(fb.db, COLLECTION, appointment.id), {
            status: 'done',
            updatedAtMs: Date.now(),
          }),
          (message) => {
            listError.textContent = message;
          }
        )
      );
      // Mở form để ghi kết quả luôn cho tiện.
      startEdit({ ...appointment, status: 'done' });
    } catch (err) {
      listError.textContent = pregnancyWriteErrorMessage(
        firebaseErrorCode(err)
      );
    }
  }

  async function remove(
    appointment: Appointment,
    trigger: HTMLButtonElement
  ): Promise<void> {
    if (!ctx) return;
    const ok = window.confirm(
      `Xóa lịch hẹn "${appointment.purpose}" ngày ${formatDateVN(appointment.date)}?`
    );
    if (!ok) return;
    const { fb } = ctx;
    try {
      await withBusy(trigger, 'Đang xóa…', () =>
        awaitWrite(
          fb.dbApi.deleteDoc(fb.dbApi.doc(fb.db, COLLECTION, appointment.id)),
          (message) => {
            listError.textContent = message;
          }
        )
      );
      if (editingId === appointment.id) resetForm();
    } catch (err) {
      listError.textContent = pregnancyWriteErrorMessage(
        firebaseErrorCode(err)
      );
    }
  }

  // ---- render -----------------------------------------------------------------

  function button(
    label: string,
    onClick: (node: HTMLButtonElement) => void,
    ghost = true
  ) {
    const node = document.createElement('button');
    node.type = 'button';
    node.className = ghost
      ? 'by-ghost-button by-appt-btn'
      : 'by-button by-appt-btn';
    node.textContent = label;
    node.addEventListener('click', () => onClick(node));
    return node;
  }

  function renderCard(appointment: Appointment, today: string): HTMLElement {
    const card = document.createElement('article');
    card.className = 'by-card by-appt';
    if (appointment.id === editingId) card.classList.add('is-editing');

    const when = document.createElement('p');
    when.className = 'by-appt-when';
    const dateStrong = document.createElement('strong');
    dateStrong.textContent = formatDateVN(appointment.date);
    when.append(dateStrong);
    if (appointment.time) when.append(` · ${appointment.time}`);
    if (appointment.status === 'upcoming') {
      const rel = document.createElement('span');
      rel.className = 'by-appt-rel';
      rel.textContent = relativeDayLabel(appointment.date, today);
      when.append(' ', rel);
    }
    card.append(when);

    const purpose = document.createElement('p');
    purpose.className = 'by-appt-purpose';
    purpose.textContent = appointment.purpose;
    card.append(purpose);

    if (appointment.place) {
      const place = document.createElement('p');
      place.className = 'by-muted';
      place.textContent = `📍 ${appointment.place}`;
      card.append(place);
    }
    if (appointment.result) {
      const result = document.createElement('p');
      result.className = 'by-appt-result';
      result.textContent = appointment.result;
      card.append(result);
    }

    const actions = document.createElement('div');
    actions.className = 'by-appt-actions';
    if (appointment.status === 'upcoming') {
      actions.append(
        button('Đã khám ✓', (node) => void markDone(appointment, node), false)
      );
    }
    actions.append(button('Sửa', () => startEdit(appointment)));
    actions.append(button('Xóa', (node) => void remove(appointment, node)));
    card.append(actions);
    return card;
  }

  function render(): void {
    if (!loaded) {
      showSkeletonCards(upcomingEl, 2, 6);
      showSkeletonCards(doneEl, 1, 6);
      upcomingEmpty.hidden = true;
      doneEmpty.hidden = true;
      return;
    }
    markLoaded(upcomingEl);
    markLoaded(doneEl);
    const today = todayKeyVN();
    const { upcoming, done } = splitAppointments(current);
    upcomingEl.replaceChildren(...upcoming.map((a) => renderCard(a, today)));
    doneEl.replaceChildren(...done.map((a) => renderCard(a, today)));
    upcomingEmpty.hidden = upcoming.length > 0;
    doneEmpty.hidden = done.length > 0;
  }

  // ---- mốc khám chuẩn ---------------------------------------------------------

  const milestoneItems = Array.from(
    document.querySelectorAll<HTMLLIElement>('[data-by-ms]')
  );

  function paintMilestones(): void {
    for (const item of milestoneItems) {
      const statusEl = item.querySelector<HTMLSpanElement>(
        '[data-by-ms-status]'
      );
      if (!statusEl) continue;
      const window = {
        fromWeek: Number(item.dataset.byMsFrom),
        toWeek: Number(item.dataset.byMsTo),
      };
      const status =
        currentWeek === null
          ? 'upcoming'
          : milestoneStatus(window, currentWeek);
      statusEl.textContent = milestoneStatusLabel(status);
      statusEl.dataset.status = status;
      item.dataset.status = status;
    }
  }

  for (const item of milestoneItems) {
    const add = item.querySelector<HTMLButtonElement>('[data-by-ms-add]');
    add?.addEventListener('click', () => {
      resetForm();
      purposeInput.value = add.dataset.byMsTitle ?? '';
      milestoneInput.value = item.dataset.byMs ?? '';
      if (dueDate !== null) {
        // Gợi ý ngày: đầu cửa sổ, hoặc tuần hiện tại nếu đã ở trong cửa sổ.
        const fromWeek = Number(item.dataset.byMsFrom);
        const week =
          currentWeek !== null && currentWeek > fromWeek
            ? currentWeek
            : fromWeek;
        dateInput.value = suggestedDateForWeek(dueDate, week);
      }
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      dateInput.focus();
    });
  }

  onSettings((settings) => {
    dueDate = settings?.dueDate ?? null;
    const ga = dueDate ? gestationalAge(dueDate, todayKeyVN()) : null;
    currentWeek = ga ? ga.weeks : null;
    paintMilestones();
  });
  paintMilestones();

  // ---- phiên -------------------------------------------------------------------

  whileSignedIn((session) => {
    ctx = session;
    fields.disabled = false;
    listError.textContent = '';
    const unsub = watchCollection<Appointment>(
      session.fb,
      COLLECTION,
      'date',
      appointmentFromDoc,
      (items) => {
        current = items;
        loaded = true;
        listError.textContent = '';
        render();
      },
      (message) => {
        // Lỗi đọc: bỏ skeleton, hiện danh sách rỗng kèm câu lỗi phía trên.
        loaded = true;
        render();
        listError.textContent = message;
      }
    );
    return () => {
      unsub();
      ctx = null;
      current = [];
      loaded = false;
      fields.disabled = true;
      resetForm();
      render();
    };
  });
</script>

<style is:global>
  /* is:global: thẻ lịch hẹn dựng bằng script. Prefix .by-appt-* / .by-ms-*.
     .by-fieldset / .by-textarea dùng chung nên nằm ở PregnancyLayout. */
  .by-appt-skel {
    height: 6rem;
  }

  .by-appt-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .by-appt-done-toggle {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    min-height: 44px;
    margin-top: 0.75rem;
    font-weight: 700;
  }

  .by-appt-done-toggle input {
    width: 1.25rem;
    height: 1.25rem;
    accent-color: var(--by-green-deep);
  }

  .by-appt-form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .by-appt-form-actions .by-button {
    flex: 1 1 12rem;
  }

  .by-appt-form-actions .by-ghost-button {
    margin-top: 1rem;
  }

  .by-appt-list {
    display: grid;
    gap: 0.75rem;
  }

  .by-appt {
    padding: 1rem 1.1rem;
  }

  .by-appt.is-editing {
    border-color: var(--by-green);
  }

  .by-appt-when {
    font-size: 0.95rem;
  }

  .by-appt-rel {
    display: inline-block;
    margin-left: 0.25rem;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background: var(--by-peach-soft);
    color: var(--by-peach-deep);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .by-appt-purpose {
    margin-top: 0.25rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--by-green-deep);
  }

  .by-appt-result {
    margin-top: 0.5rem;
    padding: 0.6rem 0.8rem;
    border-radius: 12px;
    background: var(--by-green-soft);
    white-space: pre-wrap;
  }

  .by-appt-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .by-appt-btn {
    width: auto;
    margin-top: 0;
    padding-inline: 0.9rem;
  }

  .by-ms-list {
    display: grid;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
  }

  .by-ms {
    padding: 1rem 1.1rem;
  }

  .by-ms[data-status='now'] {
    border-color: var(--by-green);
    background: var(--by-green-soft);
  }

  .by-ms[data-status='past'] {
    opacity: 0.75;
  }

  .by-ms-head {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    align-items: center;
  }

  .by-ms-status {
    padding: 0.15rem 0.7rem;
    border-radius: 999px;
    border: 2px solid var(--by-border);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--by-fg-muted);
  }

  .by-ms-status[data-status='now'] {
    border-color: var(--by-green);
    color: var(--by-green-deep);
    background: var(--by-card);
  }

  .by-ms-status[data-status='past'] {
    text-decoration: line-through;
  }

  .by-ms-title {
    margin-top: 0.25rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--by-green-deep);
  }

  .by-ms-prep summary {
