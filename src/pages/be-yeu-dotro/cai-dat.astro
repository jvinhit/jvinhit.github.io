---
/**
 * `/be-yeu-dotro/cai-dat/` — sửa ngày dự sinh, tên bé, ngày bé chào đời,
 * số đo của mẹ (spec 009, AC-6 / AC-7). Form thật nằm trong SettingsForm.
 */
import PregnancyLayout from '~/layouts/PregnancyLayout.astro';
import SettingsForm from '~/components/pregnancy/SettingsForm.astro';
import InstallPrompt from '~/components/pregnancy/InstallPrompt.astro';
---

<PregnancyLayout title="Cài đặt" nav="settings">
  <h1 class="by-title">Cài đặt</h1>
  <p class="by-muted mt-1">
    Đang đăng nhập: <span data-by-me
      ><span class="by-skel by-skel-inline" aria-hidden="true"></span></span
    >
  </p>

  <section class="by-card mt-4" aria-labelledby="by-settings-heading">
    <h2 id="by-settings-heading" class="by-subtitle">Thai kỳ của nhà mình</h2>
    <p class="by-muted mt-1">
      Bác sĩ điều chỉnh lại dự sinh sau siêu âm thì sửa ở đây — ghi chú và lịch
      khám cũ vẫn giữ nguyên ngày, chỉ nhãn tuần được tính lại.
    </p>
    <SettingsForm mode="edit" />
  </section>

  <section class="by-card mt-4" aria-labelledby="by-install-heading">
    <h2 id="by-install-heading" class="by-subtitle">Màn hình chính</h2>
    <InstallPrompt variant="settings" />
  </section>
</PregnancyLayout>

<script>
  import { whileSignedIn } from '~/lib/pregnancy-session';

  const meEl = document.querySelector<HTMLSpanElement>('[data-by-me]');
  whileSignedIn(({ me }) => {
    if (meEl) meEl.textContent = `${me.emoji} ${me.name}`;
    return () => {
      if (meEl) meEl.textContent = '';
    };
  });
</script>

<style>
  .by-skel-inline {
    display: inline-block;
    width: 5rem;
    height: 0.9rem;
    vertical-align: middle;
  }
</style>
