---
/**
 * `/be-yeu-dotro/nhat-ky/` — nhật ký thai kỳ (spec 009, AC-14 / AC-15):
 * composer theo loại (khám / ăn uống / triệu chứng / cân nặng / chuẩn bị /
 * khác), ảnh nén client-side, timeline gom tuần thai → ngày, lọc theo loại,
 * bảng cân nặng. Ghi chú là "của mình": chỉ người viết sửa/xóa được.
 *
 * Timeline dựng bằng script từ snapshot → style `is:global` prefix .by-note-*.
 */
import PregnancyLayout from '~/layouts/PregnancyLayout.astro';
import { NOTE_KINDS } from '~/lib/pregnancy';
---

<PregnancyLayout title="Nhật ký" nav="journal">
  <h1 class="by-title">Nhật ký</h1>
  <p class="by-muted mt-1">
    Ghi lại từng lần khám, bữa ăn đáng nhớ, cảm giác lạ, số cân — để hai đứa
    cùng xem và sau này kể cho bé.
  </p>

  <!-- Composer -->
  <section class="by-card mt-4" aria-labelledby="by-note-form-heading">
    <h2 id="by-note-form-heading" class="by-subtitle" data-by-note-form-title>
      Ghi chú mới
    </h2>
    <form data-by-note-form novalidate>
      <fieldset class="by-fieldset" data-by-note-fields disabled>
        <p class="by-label">Loại</p>
        <div class="by-note-kinds" role="group" aria-label="Loại ghi chú">
          {
            NOTE_KINDS.map((kind, index) => (
              <button
                class="by-chip"
                type="button"
                data-by-kind={kind.id}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                <span aria-hidden="true">{kind.emoji}</span> {kind.label}
              </button>
            ))
          }
        </div>

        <div class="by-note-row">
          <div>
            <label class="by-label" for="by-note-date">Ngày</label>
            <input
              id="by-note-date"
              class="by-input"
              type="date"
              name="dateKey"
            />
          </div>
          <div data-by-weight-field hidden>
            <label class="by-label" for="by-note-weight">Cân nặng (kg)</label>
            <input
              id="by-note-weight"
              class="by-input"
              type="number"
              name="weightKg"
              inputmode="decimal"
              min="30"
              max="200"
              step="0.1"
            />
          </div>
        </div>

        <label class="by-label" for="by-note-text">Nội dung</label>
        <textarea
          id="by-note-text"
          class="by-input by-textarea"
          name="text"
          rows="3"
          maxlength="4000"
          placeholder="Hôm nay…"></textarea>

        <!-- Đính ảnh: nén client-side, lưu base64 trong document (như love board) -->
        <div class="by-note-photo">
          <button class="by-ghost-button" type="button" data-by-photo-pick>
            📷 Đính ảnh
          </button>
          <input
            class="sr-only"
            type="file"
            accept="image/*"
            data-by-photo-input
            tabindex="-1"
          />
          <span class="by-note-photo-preview" data-by-photo-preview hidden>
            <img alt="Ảnh đính kèm" data-by-photo-thumb />
            <button
              class="by-icon-button"
              type="button"
              data-by-photo-remove
              aria-label="Bỏ ảnh"
            >
              ✕
            </button>
          </span>
        </div>

        <p class="by-error" data-by-note-error aria-live="polite"></p>
        <div class="by-note-form-actions">
          <button class="by-button" type="submit" data-by-note-submit>
            Lưu ghi chú
          </button>
          <button
            class="by-ghost-button"
            type="button"
            data-by-note-cancel
            hidden
          >
            Hủy sửa
          </button>
        </div>
      </fieldset>
    </form>
  </section>

  <!-- Cân nặng (AC-15) -->
  <section
    class="by-card mt-4"
    data-by-weight-summary
    hidden
    aria-labelledby="by-weight-heading"
  >
    <h2 id="by-weight-heading" class="by-subtitle">⚖️ Cân nặng</h2>
    <p class="mt-1" data-by-weight-headline></p>
    <p class="by-muted" data-by-weight-target></p>
    <ul class="by-weight-list mt-2" data-by-weight-list></ul>
  </section>

  <!-- Lọc -->
  <div class="by-note-filters mt-5" role="group" aria-label="Lọc theo loại">
    <button
      class="by-chip"
      type="button"
      data-by-filter="all"
      aria-pressed="true"
    >
      Tất cả
    </button>
    {
      NOTE_KINDS.map((kind) => (
        <button
          class="by-chip"
          type="button"
          data-by-filter={kind.id}
          aria-pressed="false"
        >
          <span aria-hidden="true">{kind.emoji}</span> {kind.label}
        </button>
      ))
    }
  </div>

  <p
    class="by-error by-inline-error"
    data-by-note-list-error
    aria-live="polite"
  >
  </p>
  <p class="by-muted mt-3" data-by-note-empty hidden>
    Chưa có ghi chú nào — bắt đầu bằng cảm giác của mẹ hôm nay nhé 🌱
  </p>
  <div class="mt-3" data-by-timeline></div>
</PregnancyLayout>

<script>
  import { LOVE_CONFIG } from '~/lib/love-config';
  import { compressImage, formatTimeVN, todayKeyVN } from '~/lib/love-board';
  import { firebaseErrorCode } from '~/lib/love-firebase';
  import {
    formatDateVN,
    groupNotesByWeek,
    isDateKey,
    isNoteKind,
    noteFromDoc,
    noteKindMeta,
    weightSummary,
    type NoteKind,
    type PregnancyNote,
    type PregnancySettings,
  } from '~/lib/pregnancy';
  import {
    onSettings,
    pregnancyWriteErrorMessage,
    watchCollection,
    whileSignedIn,
    type SessionContext,
  } from '~/lib/pregnancy-session';

  const COLLECTION = 'pregnancyNotes';

  function must<T extends HTMLElement>(selector: string): T {
    const node = document.querySelector<T>(selector);
    if (!node) throw new Error(`be-yeu nhat-ky: thiếu ${selector}`);
    return node;
  }

  const form = must<HTMLFormElement>('[data-by-note-form]');
  const fields = must<HTMLFieldSetElement>('[data-by-note-fields]');
  const formTitle = must<HTMLHeadingElement>('[data-by-note-form-title]');
  const kindChips = Array.from(
    form.querySelectorAll<HTMLButtonElement>('[data-by-kind]')
  );
  const dateInput = must<HTMLInputElement>('#by-note-date');
  const weightField = must<HTMLDivElement>('[data-by-weight-field]');
  const weightInput = must<HTMLInputElement>('#by-note-weight');
  const textInput = must<HTMLTextAreaElement>('#by-note-text');
  const photoPick = must<HTMLButtonElement>('[data-by-photo-pick]');
  const photoInput = must<HTMLInputElement>('[data-by-photo-input]');
  const photoPreview = must<HTMLSpanElement>('[data-by-photo-preview]');
  const photoThumb = must<HTMLImageElement>('[data-by-photo-thumb]');
  const photoRemove = must<HTMLButtonElement>('[data-by-photo-remove]');
  const formError = must<HTMLParagraphElement>('[data-by-note-error]');
  const submitButton = must<HTMLButtonElement>('[data-by-note-submit]');
  const cancelButton = must<HTMLButtonElement>('[data-by-note-cancel]');
  const filterChips = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-by-filter]')
  );
  const listError = must<HTMLParagraphElement>('[data-by-note-list-error]');
  const emptyEl = must<HTMLParagraphElement>('[data-by-note-empty]');
  const timeline = must<HTMLDivElement>('[data-by-timeline]');
  const weightCard = must<HTMLElement>('[data-by-weight-summary]');
  const weightHeadline = must<HTMLParagraphElement>(
    '[data-by-weight-headline]'
  );
  const weightTarget = must<HTMLParagraphElement>('[data-by-weight-target]');
  const weightList = must<HTMLUListElement>('[data-by-weight-list]');

  let ctx: SessionContext | null = null;
  let settings: PregnancySettings | null = null;
  let current: PregnancyNote[] = [];
  let activeKind: NoteKind = 'checkup';
  let activeFilter: 'all' | NoteKind = 'all';
  let editingId: string | null = null;
  /** Ảnh đang đính: data URI, '' = đã bỏ ảnh khi sửa, undefined = không đổi. */
  let pendingImage: string | undefined;

  const profileName = (author: string): string => {
    const profile = LOVE_CONFIG.profiles.find((p) => p.id === author);
    return profile ? `${profile.emoji} ${profile.name}` : author;
  };

  // ---- composer -------------------------------------------------------------

  function setKind(kind: NoteKind): void {
    activeKind = kind;
    for (const chip of kindChips) {
      chip.setAttribute(
        'aria-pressed',
        chip.dataset.byKind === kind ? 'true' : 'false'
      );
    }
    weightField.hidden = kind !== 'weight';
  }

  for (const chip of kindChips) {
    chip.addEventListener('click', () => {
      const kind = chip.dataset.byKind;
      if (isNoteKind(kind)) setKind(kind);
    });
  }

  function showPhoto(dataUrl: string | undefined): void {
    pendingImage = dataUrl;
    const has = Boolean(dataUrl);
    photoPreview.hidden = !has;
    photoThumb.src = dataUrl ?? '';
    photoPick.hidden = has;
  }

  photoPick.addEventListener('click', () => photoInput.click());
  photoInput.addEventListener('change', () => {
    const file = photoInput.files?.[0];
    photoInput.value = '';
    if (!file) return;
    formError.textContent = '';
    void compressImage(file).then((dataUrl) => {
      if (dataUrl) showPhoto(dataUrl);
      else
        formError.textContent =
          'Ảnh này nén mãi vẫn to quá 🥲 chọn ảnh khác nhé (chữ đang gõ vẫn còn).';
    });
  });
  photoRemove.addEventListener('click', () => {
    // '' để updateDoc ghi đè ảnh cũ thành "không có" (quy ước love board).
    showPhoto(undefined);
    pendingImage = editingId ? '' : undefined;
  });

  function resetForm(): void {
    editingId = null;
    form.reset();
    dateInput.value = todayKeyVN();
    setKind('checkup');
    showPhoto(undefined);
    formTitle.textContent = 'Ghi chú mới';
    submitButton.textContent = 'Lưu ghi chú';
    cancelButton.hidden = true;
    formError.textContent = '';
  }

  function startEdit(note: PregnancyNote): void {
    editingId = note.id;
    setKind(note.kind);
    dateInput.value = note.dateKey;
    weightInput.value =
      note.weightKg === undefined ? '' : String(note.weightKg);
    textInput.value = note.text;
    showPhoto(note.imageBase64);
    pendingImage = undefined; // chưa đổi ảnh
    formTitle.textContent = 'Sửa ghi chú';
    submitButton.textContent = 'Lưu thay đổi';
    cancelButton.hidden = false;
    formError.textContent = '';
    render();
    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    textInput.focus();
  }

  cancelButton.addEventListener('click', () => {
    resetForm();
    render();
  });

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    void save();
  });

  async function save(): Promise<void> {
    formError.textContent = '';
    if (!ctx) {
      formError.textContent = 'Chưa có phiên hợp lệ — đăng nhập lại nhé.';
      return;
    }
    const dateKey = dateInput.value;
    const text = textInput.value.trim();
    if (!isDateKey(dateKey)) {
      formError.textContent = 'Chọn ngày cho ghi chú nhé.';
      return;
    }
    let weightKg: number | null = null;
    if (activeKind === 'weight') {
      const raw = Number(weightInput.value.replace(',', '.'));
      if (!Number.isFinite(raw) || raw < 30 || raw > 200) {
        formError.textContent = 'Nhập cân nặng từ 30 đến 200 kg nhé.';
        return;
      }
      weightKg = Math.round(raw * 10) / 10;
    }
    if (!text && weightKg === null && !pendingImage) {
      formError.textContent =
        'Ghi chú đang trống — gõ vài chữ hoặc đính ảnh nhé.';
      return;
    }
    const { fb, me } = ctx;
    submitButton.disabled = true;
    try {
      if (editingId) {
        const patch: Record<string, unknown> = {
          dateKey,
          kind: activeKind,
          text,
          weightKg,
          updatedAtMs: Date.now(),
        };
        if (pendingImage !== undefined) patch.imageBase64 = pendingImage;
        await fb.dbApi.updateDoc(
          fb.dbApi.doc(fb.db, COLLECTION, editingId),
          patch
        );
      } else {
        await fb.dbApi.addDoc(fb.dbApi.collection(fb.db, COLLECTION), {
          dateKey,
          kind: activeKind,
          text,
          weightKg,
          imageBase64: pendingImage ?? '',
          author: me.id,
          createdAtMs: Date.now(),
        });
      }
      resetForm();
      render();
    } catch (err) {
      // Chữ đang gõ giữ nguyên trong form (AC-14).
      formError.textContent = pregnancyWriteErrorMessage(
        firebaseErrorCode(err)
      );
    } finally {
      submitButton.disabled = false;
    }
  }

  async function remove(note: PregnancyNote): Promise<void> {
    if (!ctx) return;
    if (!window.confirm('Xóa ghi chú này? Không hoàn tác được đâu.')) return;
    try {
      await ctx.fb.dbApi.deleteDoc(
        ctx.fb.dbApi.doc(ctx.fb.db, COLLECTION, note.id)
      );
      if (editingId === note.id) resetForm();
    } catch (err) {
      listError.textContent = pregnancyWriteErrorMessage(
        firebaseErrorCode(err)
      );
    }
  }

  // ---- lọc ---------------------------------------------------------------------

  for (const chip of filterChips) {
    chip.addEventListener('click', () => {
      const value = chip.dataset.byFilter;
      activeFilter = value === 'all' || !isNoteKind(value) ? 'all' : value;
      for (const other of filterChips) {
        other.setAttribute(
          'aria-pressed',
          other.dataset.byFilter === activeFilter ? 'true' : 'false'
        );
      }
      render();
    });
  }

  // ---- render -------------------------------------------------------------------

  function el<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    className: string,
    text?: string
  ): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function renderNote(note: PregnancyNote): HTMLElement {
    const card = el('article', 'by-card by-note');
    if (note.id === editingId) card.classList.add('is-editing');
    const meta = noteKindMeta(note.kind);

    const head = el('p', 'by-note-head');
    head.append(
      el('span', 'by-note-kind', `${meta.emoji} ${meta.label}`),
      el(
        'span',
        'by-muted',
        ` · ${formatTimeVN(note.createdAtMs)} · ${profileName(note.author)}`
      )
    );
    card.append(head);

    if (note.weightKg !== undefined) {
      card.append(
        el('p', 'by-note-weight', `${note.weightKg.toLocaleString('vi-VN')} kg`)
      );
    }
    if (note.text) card.append(el('p', 'by-note-text', note.text));
    if (note.imageBase64) {
      const img = document.createElement('img');
      img.className = 'by-note-img';
      img.src = note.imageBase64;
      img.alt = 'Ảnh đính kèm ghi chú';
      img.loading = 'lazy';
      card.append(img);
    }
    if (note.updatedAtMs)
      card.append(el('p', 'by-muted by-note-edited', 'đã sửa'));

    if (ctx && note.author === ctx.me.id) {
      const actions = el('div', 'by-note-actions');
      const edit = el('button', 'by-ghost-button by-note-btn', 'Sửa');
      edit.type = 'button';
      edit.addEventListener('click', () => startEdit(note));
      const del = el('button', 'by-ghost-button by-note-btn', 'Xóa');
      del.type = 'button';
      del.addEventListener('click', () => void remove(note));
      actions.append(edit, del);
      card.append(actions);
    }
    return card;
  }

  function render(): void {
    const visible =
      activeFilter === 'all'
        ? current
        : current.filter((n) => n.kind === activeFilter);
    emptyEl.hidden = current.length > 0;
    const dueDate = settings?.dueDate ?? '';
    const groups = groupNotesByWeek(visible, dueDate);
    timeline.replaceChildren(
      ...groups.map((group) => {
        const section = el('section', 'by-note-week');
        const heading = el(
          'h2',
          'by-note-week-title',
          dueDate
            ? group.week === 0
              ? 'Trước tuần 1'
              : `Tuần ${group.week}`
            : 'Ghi chú'
        );
        section.append(heading);
        for (const day of group.days) {
          section.append(el('h3', 'by-note-day', formatDateVN(day.dateKey)));
          const list = el('div', 'by-note-list');
          list.append(...day.notes.map(renderNote));
          section.append(list);
        }
        return section;
      })
    );
    if (visible.length === 0 && current.length > 0) {
      timeline.append(
        el('p', 'by-muted', 'Không có ghi chú nào thuộc loại này.')
      );
    }
    renderWeight();
  }

  function renderWeight(): void {
    const summary = settings ? weightSummary(current, settings) : null;
    weightCard.hidden = summary === null;
    if (!summary) return;
    const sign = summary.gainKg >= 0 ? '+' : '';
    weightHeadline.textContent = `Hiện ${summary.latestKg.toLocaleString('vi-VN')} kg · ${sign}${summary.gainKg.toLocaleString('vi-VN')} kg so với ${summary.baseIsPrePregnancy ? 'trước mang thai' : 'lần cân đầu'} (${summary.baseKg.toLocaleString('vi-VN')} kg)`;
    weightTarget.textContent = summary.target
      ? `BMI trước mang thai ${summary.bmi} (${summary.target.label}) → khuyến nghị tăng tổng ${summary.target.minKg}–${summary.target.maxKg} kg cả thai kỳ (IOM).`
      : 'Điền chiều cao + cân nặng trước mang thai ở Cài đặt để so với khuyến nghị theo BMI.';
    weightList.replaceChildren(
      ...summary.entries
        .slice()
        .reverse()
        .map((entry) => {
          const li = el('li', 'by-weight-item');
          const delta =
            entry.deltaKg >= 0 ? `+${entry.deltaKg}` : `${entry.deltaKg}`;
          li.append(
            el('span', '', formatDateVN(entry.dateKey)),
            el('strong', '', `${entry.kg.toLocaleString('vi-VN')} kg`),
            el('span', 'by-muted', `${delta} kg`)
          );
          return li;
        })
    );
  }

  // ---- phiên ---------------------------------------------------------------------

  onSettings((next) => {
    settings = next;
    render();
  });

  resetForm();

  whileSignedIn((session) => {
    ctx = session;
    fields.disabled = false;
    listError.textContent = '';
    const unsub = watchCollection<PregnancyNote>(
      session.fb,
      COLLECTION,
      'createdAtMs',
      noteFromDoc,
      (items) => {
        current = items.reverse(); // mới → cũ
        if (editingId && !current.some((n) => n.id === editingId)) {
          resetForm();
          listError.textContent = 'Ghi chú đang sửa vừa bị xóa ở máy kia.';
        } else {
          listError.textContent = '';
        }
        render();
      },
      (message) => {
        listError.textContent = message;
      }
    );
    return () => {
      unsub();
      ctx = null;
      current = [];
      fields.disabled = true;
      resetForm();
      render();
    };
  });
</script>

<style is:global>
  /* is:global: timeline dựng bằng script. Prefix .by-note-* / .by-weight-* / .by-chip. */
  .by-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 40px;
    padding: 0.4rem 0.9rem;
    border: 2px solid var(--by-border);
    border-radius: 999px;
    background: var(--by-card);
    color: var(--by-fg-muted);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
  }

  .by-chip[aria-pressed='true'] {
    border-color: var(--by-green);
    background: var(--by-green-soft);
    color: var(--by-green-deep);
  }

  .by-note-kinds,
  .by-note-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .by-note-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .by-note-photo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .by-note-photo-preview {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .by-note-photo-preview img {
    width: 4.5rem;
    height: 4.5rem;
    object-fit: cover;
    border-radius: 12px;
    border: 2px solid var(--by-border);
  }

  .by-note-form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .by-note-form-actions .by-button {
    flex: 1 1 12rem;
  }

  .by-note-form-actions .by-ghost-button {
    margin-top: 1rem;
  }

  .by-note-week {
    margin-top: 1.25rem;
  }

  .by-note-week-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--by-green-deep);
  }

  .by-note-day {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--by-peach-deep);
  }

  .by-note-list {
    display: grid;
    gap: 0.6rem;
    margin-top: 0.4rem;
  }

  .by-note {
    padding: 0.9rem 1.1rem;
  }

  .by-note.is-editing {
    border-color: var(--by-green);
  }

  .by-note-head {
    font-size: 0.85rem;
  }

  .by-note-kind {
    font-weight: 700;
    color: var(--by-green-deep);
  }

  .by-note-weight {
    margin-top: 0.25rem;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--by-green-deep);
  }

  .by-note-text {
    margin-top: 0.35rem;
    white-space: pre-wrap;
    line-height: 1.55;
  }

  .by-note-img {
    display: block;
    max-width: 100%;
    max-height: 20rem;
    margin-top: 0.6rem;
    border-radius: 12px;
  }

  .by-note-edited {
    margin-top: 0.25rem;
    font-size: 0.75rem;
  }

  .by-note-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }

