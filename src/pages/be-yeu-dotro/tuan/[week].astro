---
/**
 * `/be-yeu-dotro/tuan/<n>/` — hướng dẫn một tuần thai (spec 009, AC-8):
 * 4 khối (bé / mẹ / nên làm / đi khám ngay nếu) + mốc khám rơi vào tuần +
 * điều hướng tuần. Mỗi tuần là một trang tĩnh nhỏ để dashboard không phải
 * mang theo cả 42 tuần (ràng buộc Performance của requirement).
 */
import PregnancyLayout from '~/layouts/PregnancyLayout.astro';
import AlertBox from '~/components/pregnancy/AlertBox.astro';
import Disclaimer from '~/components/pregnancy/Disclaimer.astro';
import {
  assertWeekGuidesComplete,
  WEEK_GUIDES,
  type WeekGuide,
} from '~/lib/pregnancy-weeks';
import { milestonesForWeek } from '~/lib/pregnancy-milestones';
import { formatSize, weekSize } from '~/lib/pregnancy-week-sizes';
import { MAX_GUIDE_WEEK, trimesterOf } from '~/lib/pregnancy';
import { withBase } from '~/lib/site-config';

export function getStaticPaths() {
  // Thiếu tuần / khối rỗng → build fail ngay tại đây (AC-8).
  assertWeekGuidesComplete(MAX_GUIDE_WEEK);
  return WEEK_GUIDES.map((guide) => ({
    params: { week: String(guide.week) },
    props: { guide },
  }));
}

// Cast an toàn ở page có getStaticPaths (xem coding-conventions).
const { guide } = Astro.props as { guide: WeekGuide };
const { week } = guide;
const size = weekSize(week);
const trimester = trimesterOf(week);
const milestones = milestonesForWeek(week);
const prev = week > 1 ? week - 1 : null;
const next = week < MAX_GUIDE_WEEK ? week + 1 : null;
const weekHref = (n: number) => withBase(`/be-yeu-dotro/tuan/${n}/`);
const allWeeks = Array.from({ length: MAX_GUIDE_WEEK }, (_, i) => i + 1);
---

<PregnancyLayout title={`Tuần ${week}`} nav="weeks">
  <div data-by-week={week}>
    <p class="by-kicker">Tuần {week} · Tam cá nguyệt {trimester}</p>
    <h1 class="by-title">{guide.title}</h1>
    <p class="by-week-badge" data-by-current-badge hidden>
      💚 Đây là tuần hiện tại của nhà mình
    </p>
    <p class="by-muted mt-1" data-by-current-link hidden>
      Tuần hiện tại của nhà mình: <a data-by-current-anchor href="#">…</a>
    </p>

    {
      guide.note && (
        <p class="by-week-note mt-3">
          <span aria-hidden="true">📌</span> {guide.note}
        </p>
      )
    }

    {
      size && (
        <div class="by-card by-week-size mt-4">
          <span class="by-week-size-emoji" aria-hidden="true">
            {size.emoji}
          </span>
          <div>
            <p class="by-week-size-fruit">
              {size.fruit ? `Bé to bằng ${size.fruit}` : 'Bé chưa hình thành'}
            </p>
            {formatSize(size) && (
              <p class="by-muted">
                {formatSize(size)}
                {size.measure === 'crl' && ' (đo đầu–mông)'}
                {size.measure === 'heel' && ' (đo đầu–gót)'}
              </p>
            )}
            <p class="mt-1">{size.headline}</p>
          </div>
        </div>
      )
    }

    <section class="by-card mt-3" aria-labelledby="by-wk-baby">
      <h2 id="by-wk-baby" class="by-week-heading">👶 Bé tuần này</h2>
      <ul class="by-week-list">
        {guide.baby.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="by-card mt-3" aria-labelledby="by-wk-mom">
      <h2 id="by-wk-mom" class="by-week-heading">🤰 Mẹ tuần này</h2>
      <ul class="by-week-list">
        {guide.mom.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="by-card mt-3" aria-labelledby="by-wk-todo">
      <h2 id="by-wk-todo" class="by-week-heading">📋 Nên làm tuần này</h2>
      <ul class="by-week-list">
        {guide.todo.map((item) => <li>{item}</li>)}
      </ul>
      {
        milestones.length > 0 && (
          <div class="by-week-milestones">
            <p class="by-kicker">Mốc khám rơi vào tuần này</p>
            <ul class="by-week-list">
              {milestones.map((m) => (
                <li>
                  <strong>{m.title}</strong> (tuần {m.fromWeek}–{m.toWeek}):{' '}
                  {m.why}
                </li>
              ))}
            </ul>
            <a
              class="by-week-milestone-link"
              href={withBase('/be-yeu-dotro/lich-kham/')}
            >
              Thêm vào lịch khám →
            </a>
          </div>
        )
      }
    </section>

    <AlertBox>
      <ul class="by-week-list">
        {guide.warning.map((item) => <li>{item}</li>)}
      </ul>
    </AlertBox>

    <Disclaimer />

    <nav class="by-week-nav mt-4" aria-label="Chuyển tuần">
      {
        prev !== null ? (
          <a class="by-ghost-button" href={weekHref(prev)}>
            ← Tuần {prev}
          </a>
        ) : (
          <span />
        )
      }
      <label class="by-week-jump">
        <span class="sr-only">Chọn tuần</span>
        <select class="by-input" data-by-week-jump>
          {
            allWeeks.map((n) => (
              <option value={n} selected={n === week}>
                Tuần {n}
              </option>
            ))
          }
        </select>
      </label>
      {
        next !== null ? (
          <a class="by-ghost-button" href={weekHref(next)}>
            Tuần {next} →
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </div>
</PregnancyLayout>

<script>
  import { todayKeyVN } from '~/lib/love-board';
  import { gestationalAge } from '~/lib/pregnancy';
  import { onSettings } from '~/lib/pregnancy-session';
  import { withBase } from '~/lib/site-config';

  const root = document.querySelector<HTMLElement>('[data-by-week]');
  const week = Number(root?.dataset.byWeek ?? 0);
  const badge = document.querySelector<HTMLElement>('[data-by-current-badge]');
  const link = document.querySelector<HTMLElement>('[data-by-current-link]');
  const anchor = document.querySelector<HTMLAnchorElement>(
    '[data-by-current-anchor]'
  );
  const jump = document.querySelector<HTMLSelectElement>('[data-by-week-jump]');

  // Đánh dấu tuần hiện tại / trỏ về tuần hiện tại — chỉ khi còn mang thai.
  onSettings((settings) => {
    if (!settings || settings.birthDate) return;
    const ga = gestationalAge(settings.dueDate, todayKeyVN());
    if (!ga || !badge || !link || !anchor) return;
    const isCurrent = ga.guideWeek === week;
    badge.hidden = !isCurrent;
    link.hidden = isCurrent;
    anchor.href = withBase(`/be-yeu-dotro/tuan/${ga.guideWeek}/`);
    anchor.textContent = `tuần ${ga.guideWeek}`;
  });

  jump?.addEventListener('change', () => {
    window.location.href = withBase(`/be-yeu-dotro/tuan/${jump.value}/`);
  });
</script>

<style>
  .by-week-badge {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    background: var(--by-green-soft);
    color: var(--by-green-deep);
    font-weight: 700;
  }

  .by-week-note {
    padding: 0.75rem 1rem;
    border-radius: 14px;
    background: var(--by-peach-soft);
    color: var(--by-peach-deep);
    font-weight: 600;
  }

  .by-week-size {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .by-week-size-emoji {
    flex: none;
    width: 3.5rem;
    font-size: 2.5rem;
    line-height: 1;
    text-align: center;
  }

  .by-week-size-fruit {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--by-green-deep);
  }

  .by-week-heading {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--by-green-deep);
  }

  .by-week-list {
    margin-top: 0.5rem;
    padding-left: 1.2rem;
    list-style: disc;
    display: grid;
    gap: 0.4rem;
    line-height: 1.55;
  }

  .by-week-milestones {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 2px dashed var(--by-border);
  }

  .by-week-milestone-link {
    display: inline-block;
    margin-top: 0.5rem;
    font-weight: 700;
    color: var(--by-green-deep);
  }

  .by-week-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0.5rem;
    align-items: center;
  }

  .by-week-nav > :last-child {
    justify-self: end;
  }

  .by-week-jump .by-input {
    margin-top: 0;
    min-width: 7.5rem;
  }
</style>
