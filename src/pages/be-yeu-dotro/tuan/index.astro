---
/**
 * `/be-yeu-dotro/tuan/` — lưới 42 tuần theo tam cá nguyệt (spec 009, AC-8).
 * Render tĩnh từ bảng kích thước; script chỉ tô tuần hiện tại.
 */
import PregnancyLayout from '~/layouts/PregnancyLayout.astro';
import { WEEK_SIZES } from '~/lib/pregnancy-week-sizes';
import { trimesterOf, type Trimester } from '~/lib/pregnancy';
import { withBase } from '~/lib/site-config';

const TRIMESTERS: { id: Trimester; label: string; range: string }[] = [
  { id: 1, label: 'Tam cá nguyệt 1', range: 'tuần 1–13' },
  { id: 2, label: 'Tam cá nguyệt 2', range: 'tuần 14–27' },
  { id: 3, label: 'Tam cá nguyệt 3', range: 'tuần 28–42' },
];
---

<PregnancyLayout title="Theo tuần" nav="weeks">
  <h1 class="by-title">Hành trình 42 tuần</h1>
  <p class="by-muted mt-1">
    Mỗi tuần: bé thay đổi gì, mẹ cảm thấy gì, nên làm gì và khi nào cần đi khám
    ngay.
  </p>

  {
    TRIMESTERS.map((trimester) => (
      <section class="mt-5" aria-labelledby={`by-tri-${trimester.id}`}>
        <h2 id={`by-tri-${trimester.id}`} class="by-subtitle">
          {trimester.label}{' '}
          <span class="by-muted by-tri-range">({trimester.range})</span>
        </h2>
        <ul class="by-week-grid mt-2">
          {WEEK_SIZES.filter(
            (size) => trimesterOf(size.week) === trimester.id
          ).map((size) => (
            <li>
              <a
                class="by-week-cell"
                href={withBase(`/be-yeu-dotro/tuan/${size.week}/`)}
                data-by-week-cell={size.week}
              >
                <span class="by-week-cell-emoji" aria-hidden="true">
                  {size.emoji}
                </span>
                <span class="by-week-cell-label">Tuần {size.week}</span>
                <span class="by-week-cell-fruit">{size.fruit || '—'}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</PregnancyLayout>

<script>
  import { todayKeyVN } from '~/lib/love-board';
  import { gestationalAge } from '~/lib/pregnancy';
  import { onSettings } from '~/lib/pregnancy-session';

  onSettings((settings) => {
    if (!settings || settings.birthDate) return;
    const ga = gestationalAge(settings.dueDate, todayKeyVN());
    if (!ga) return;
    for (const cell of document.querySelectorAll<HTMLAnchorElement>(
      '[data-by-week-cell]'
    )) {
      const isCurrent = Number(cell.dataset.byWeekCell) === ga.guideWeek;
      cell.classList.toggle('is-current', isCurrent);
      if (isCurrent) cell.setAttribute('aria-current', 'true');
      else cell.removeAttribute('aria-current');
    }
  });
</script>

<style>
  .by-tri-range {
    font-size: 0.9rem;
    font-weight: 500;
  }

  .by-week-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }

  @media (min-width: 640px) {
    .by-week-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .by-week-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    min-height: 44px;
    padding: 0.6rem 0.4rem;
    border: 2px solid var(--by-border);
    border-radius: 14px;
    background: var(--by-card);
    color: inherit;
    text-align: center;
    text-decoration: none;
  }

  .by-week-cell:hover {
    border-color: var(--by-green);
  }

  .by-week-cell.is-current {
    border-color: var(--by-green);
    background: var(--by-green-soft);
    box-shadow: 0 0 0 3px var(--by-green-soft);
  }

  .by-week-cell-emoji {
    font-size: 1.4rem;
    line-height: 1;
  }

  .by-week-cell-label {
    font-weight: 700;
    color: var(--by-green-deep);
  }

  .by-week-cell-fruit {
    font-size: 0.75rem;
    color: var(--by-fg-muted);
  }
</style>
