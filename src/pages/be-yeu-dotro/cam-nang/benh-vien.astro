---
/**
 * `/be-yeu-dotro/cam-nang/benh-vien/` — bệnh viện khám thai + sinh và bác sĩ
 * hay được giới thiệu (spec 009). Nội dung tĩnh từ pregnancy-hospitals.ts;
 * viện nhà mình ưu tiên (`preferred`) mở sẵn, các viện khác gập lại để trang
 * không quá dài trên điện thoại.
 */
import PregnancyLayout from '~/layouts/PregnancyLayout.astro';
import Disclaimer from '~/components/pregnancy/Disclaimer.astro';
import AlertBox from '~/components/pregnancy/AlertBox.astro';
import { HOSPITALS, HOSPITAL_QUESTIONS } from '~/lib/pregnancy-hospitals';
import { withBase } from '~/lib/site-config';

// Viện ưu tiên luôn đứng đầu dù thứ tự trong data đổi.
const hospitals = [...HOSPITALS].sort(
  (a, b) => Number(Boolean(b.preferred)) - Number(Boolean(a.preferred))
);

function formatTel(tel: string): string {
  if (tel.startsWith('1900')) return `${tel.slice(0, 4)} ${tel.slice(4)}`;
  return tel.replace(/^(\d{3})(\d{4})(\d+)$/, '$1 $2 $3');
}
---

<PregnancyLayout title="Bệnh viện & bác sĩ" nav="guides">
  <p class="by-kicker">
    <a href={withBase('/be-yeu-dotro/cam-nang/')}>Cẩm nang</a> · Bệnh viện
  </p>
  <h1 class="by-title">Bệnh viện & bác sĩ</h1>
  <p class="by-muted mt-1">
    Nơi khám thai và sinh ở TP.HCM, xếp MêKông lên đầu vì nhà mình đang ưu tiên.
    Bác sĩ là những người hay được các mẹ giới thiệu và còn có tên trên trang
    của viện — không phải bảng xếp hạng.
  </p>

  <nav class="by-guide-toc mt-4" aria-label="Danh sách bệnh viện">
    {
      hospitals.map((h) => (
        <a class="by-chip" href={`#${h.id}`}>
          {h.preferred && <span aria-hidden="true">⭐</span>}
          {h.name.replace(/^Bệnh viện /, 'BV ')}
        </a>
      ))
    }
    <a class="by-chip" href="#cau-hoi">❓ Nên hỏi gì</a>
  </nav>

  {
    hospitals.map((h) => (
      <details
        class:list={[
          'by-card',
          'by-hosp',
          'mt-4',
          { 'by-hosp-pref': h.preferred },
        ]}
        id={h.id}
        open={h.preferred}
      >
        <summary class="by-hosp-summary">
          {h.preferred && (
            <span class="by-hosp-badge">⭐ Nhà mình ưu tiên</span>
          )}
          <span class="by-hosp-name">{h.name}</span>
          <span class="by-hosp-kind by-muted">{h.kind}</span>
        </summary>

        <p class="by-hosp-intro">{h.summary}</p>

        <dl class="by-hosp-dl">
          <dt>Địa chỉ</dt>
          <dd>{h.address}</dd>
          <dt>Điện thoại</dt>
          <dd class="by-hosp-phones">
            {h.phones.map((p) => (
              <a href={`tel:${p.tel}`}>
                {p.label}: <strong>{formatTel(p.tel)}</strong>
              </a>
            ))}
          </dd>
          <dt>Website</dt>
          <dd>
            <a href={h.website} target="_blank" rel="noopener noreferrer">
              {h.website.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}
            </a>
          </dd>
        </dl>

        <h3 class="by-hosp-sub">👩‍⚕️ Bác sĩ hay được giới thiệu</h3>
        <ul class="by-hosp-doctors">
          {h.doctors.map((d) => (
            <li class="by-hosp-doctor">
              <p>
                <span class="by-muted">{d.title}</span>{' '}
                <strong>{d.name}</strong>
              </p>
              <p class="by-hosp-role">{d.role}</p>
              {d.note && <p class="by-muted by-hosp-note">{d.note}</p>}
            </li>
          ))}
        </ul>

        <h3 class="by-hosp-sub">💰 Chi phí tham khảo</h3>
        <ul class="by-hosp-list">
          {h.cost.map((item) => (
            <li>{item}</li>
          ))}
        </ul>

        <h3 class="by-hosp-sub">👍 Điểm mạnh</h3>
        <ul class="by-hosp-list">
          {h.strengths.map((item) => (
            <li>{item}</li>
          ))}
        </ul>

        <h3 class="by-hosp-sub">⚠️ Cần lưu ý</h3>
        <ul class="by-hosp-list">
          {h.cautions.map((item) => (
            <li>{item}</li>
          ))}
        </ul>

        <p class="by-hosp-sources by-muted">
          Kiểm tra lần cuối {h.checked} · Nguồn:{' '}
          {h.sources.map((s, i) => (
            <>
              {i > 0 && ' · '}
              <a href={s.url} target="_blank" rel="noopener noreferrer">
                {s.label}
              </a>
            </>
          ))}
        </p>
      </details>
    ))
  }

  <section class="mt-6" id="cau-hoi" aria-labelledby="by-hosp-q">
    <h2 id="by-hosp-q" class="by-subtitle">❓ Nên hỏi gì trước khi chọn</h2>
    {
      HOSPITAL_QUESTIONS.map((block) => (
        <div class="by-card by-hosp-block mt-3">
          <h3 class="by-hosp-block-title">{block.title}</h3>
          <ul class="by-hosp-list">
            {block.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <AlertBox tone="info" title="Trước khi đi" action="">
    <ul class="by-hosp-list">
      <li>
        Bác sĩ đổi nơi làm, giá đổi theo năm — gọi tổng đài xác nhận lịch khám
        của bác sĩ và giá gói sinh trước khi đặt.
      </li>
      <li>
        Chốt viện xong thì ghi tên viện, bác sĩ vào Lịch khám và lưu số tổng đài
        vào danh bạ của cả hai người.
      </li>
      <li>
        Cấp cứu sản (ra máu nhiều, vỡ ối, đau dữ dội) mà viện chọn ở xa: đến
        viện có khoa sản gần nhất hoặc gọi 115, đừng cố chạy xa.
      </li>
    </ul>
  </AlertBox>

  <Disclaimer />
</PregnancyLayout>

<script>
  // Chip trỏ tới viện đang gập: mở <details> trước khi nhảy — Safari không tự
  // mở details khi điều hướng bằng #anchor như Chrome.
  function openFromHash(): void {
    const id = decodeURIComponent(location.hash.slice(1));
    const target = id ? document.getElementById(id) : null;
    if (target instanceof HTMLDetailsElement) target.open = true;
  }

  window.addEventListener('hashchange', openFromHash);
  openFromHash();
</script>

<style>
  .by-guide-toc {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Khai lại tối thiểu như GuideTopics để trang không phụ thuộc trang khác. */
  .by-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 40px;
    padding: 0.4rem 0.9rem;
    border: 2px solid var(--by-border);
    border-radius: 999px;
    background: var(--by-card);
    color: var(--by-green-deep);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .by-chip:hover {
    border-color: var(--by-green);
    background: var(--by-green-soft);
  }

  .by-hosp {
    padding: 1rem 1.1rem;
    scroll-margin-top: 1rem;
  }

  .by-hosp-pref {
    border-color: var(--by-green);
  }

  .by-hosp-summary {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-height: 44px;
    cursor: pointer;
  }

  .by-hosp-badge {
    align-self: flex-start;
    margin-bottom: 0.2rem;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background: var(--by-green-soft);
    color: var(--by-green-deep);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .by-hosp-name {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--by-green-deep);
  }

  .by-hosp-kind {
    font-size: 0.9rem;
  }

  .by-hosp-intro {
    margin-top: 0.75rem;
    line-height: 1.55;
  }

  .by-hosp-dl {
    margin-top: 0.75rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.35rem 0.75rem;
    font-size: 0.92rem;
  }

  .by-hosp-dl dt {
    font-weight: 700;
    color: var(--by-fg-muted);
  }

  .by-hosp-dl dd {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .by-hosp-phones {
    display: grid;
    gap: 0.25rem;
  }

  .by-hosp-dl a,
  .by-hosp-sources a {
    color: var(--by-green-deep);
  }

  .by-hosp-sub {
    margin-top: 1rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--by-peach-deep);
  }

  .by-hosp-doctors {
    margin-top: 0.5rem;
    display: grid;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }

  @media (min-width: 640px) {
    .by-hosp-doctors {
      grid-template-columns: 1fr 1fr;
    }
  }

  .by-hosp-doctor {
    padding: 0.6rem 0.8rem;
    border: 2px solid var(--by-border);
    border-left: 6px solid var(--by-green);
    border-radius: 14px;
  }

  .by-hosp-role {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--by-green-deep);
  }

  .by-hosp-note {
    margin-top: 0.15rem;
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .by-hosp-list {
    margin-top: 0.5rem;
    padding-left: 1.2rem;
    list-style: disc;
    display: grid;
    gap: 0.4rem;
    line-height: 1.55;
  }

  .by-hosp-sources {
    margin-top: 1rem;
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .by-hosp-block {
    padding: 1rem 1.1rem;
  }

  .by-hosp-block-title {
    font-weight: 700;
    color: var(--by-green-deep);
  }
</style>
