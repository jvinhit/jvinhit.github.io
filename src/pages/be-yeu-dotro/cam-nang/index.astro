---
/**
 * `/be-yeu-dotro/cam-nang/` — mục lục ba cẩm nang (spec 009). Khi bé đã chào
 * đời (settings.birthDate), script đưa cẩm nang sơ sinh lên đầu (AC-7).
 */
import PregnancyLayout from '~/layouts/PregnancyLayout.astro';
import { withBase } from '~/lib/site-config';

const GUIDES = [
  {
    id: 'dinh-duong',
    emoji: '🥗',
    title: 'Dinh dưỡng',
    description:
      'Món nào nên ăn, hạn chế, tránh — kèm lý do. Vi chất, chia bữa theo giai đoạn, tăng cân hợp lý.',
  },
  {
    id: 'me-bau',
    emoji: '🤰',
    title: 'Chăm sóc mẹ bầu',
    description:
      'Ngủ, khó chịu thường gặp, thuốc – vắc xin, bệnh lý thai kỳ, vận động, chuyện vợ chồng, tinh thần, chuyển dạ, việc của bố.',
  },
  {
    id: 'so-sinh',
    emoji: '👶',
    title: 'Chăm bé sơ sinh & mẹ sau sinh',
    description:
      'Bú, trữ sữa, khóc – trớ – phân, ngủ an toàn, tắm rốn, vàng da, tiêm chủng, sàng lọc & giấy tờ, dấu hiệu nguy hiểm, hậu sản.',
  },
  {
    id: 'benh-vien',
    emoji: '🏥',
    title: 'Bệnh viện & bác sĩ',
    description:
      'Nơi khám thai và sinh ở TP.HCM (ưu tiên Phụ sản MêKông), bác sĩ hay được giới thiệu, câu hỏi nên hỏi trước khi chọn.',
  },
];
---

<PregnancyLayout title="Cẩm nang" nav="guides">
  <h1 class="by-title">Cẩm nang</h1>
  <p class="by-muted mt-1">
    Kiến thức tham khảo gom một chỗ để khỏi lục web mỗi lần thắc mắc. Mọi thứ ở
    đây là tham khảo — bác sĩ của mẹ mới là người quyết.
  </p>
  <div class="by-guides mt-4" data-by-guides>
    {
      GUIDES.map((guide) => (
        <a
          class="by-card by-guide-card"
          href={withBase(`/be-yeu-dotro/cam-nang/${guide.id}/`)}
          data-by-guide={guide.id}
        >
          <span class="by-guide-emoji" aria-hidden="true">
            {guide.emoji}
          </span>
          <span>
            <span class="by-guide-badge" data-by-guide-badge hidden>
              Giai đoạn hiện tại
            </span>
            <span class="by-guide-title">{guide.title}</span>
            <span class="by-guide-desc">{guide.description}</span>
          </span>
        </a>
      ))
    }
  </div>
</PregnancyLayout>

<script>
  import { onSettings } from '~/lib/pregnancy-session';

  const wrap = document.querySelector<HTMLElement>('[data-by-guides]');
  const newborn = document.querySelector<HTMLAnchorElement>(
    '[data-by-guide="so-sinh"]'
  );
  const badge = newborn?.querySelector<HTMLElement>('[data-by-guide-badge]');

  // Bé chào đời → cẩm nang sơ sinh lên đầu kèm nhãn; bỏ ngày sinh → về cuối.
  onSettings((settings) => {
    if (!wrap || !newborn || !badge) return;
    const born = Boolean(settings?.birthDate);
    badge.hidden = !born;
    if (born) wrap.prepend(newborn);
    else wrap.append(newborn);
  });
</script>

<style>
  .by-guides {
    display: grid;
    gap: 0.75rem;
  }

  .by-guide-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.1rem 1.2rem;
    color: inherit;
    text-decoration: none;
  }

  .by-guide-card:hover {
    border-color: var(--by-green);
  }

  .by-guide-emoji {
    flex: none;
    font-size: 2rem;
    line-height: 1;
  }

  .by-guide-badge {
    display: inline-block;
    margin-bottom: 0.25rem;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background: var(--by-green-soft);
    color: var(--by-green-deep);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .by-guide-title {
    display: block;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--by-green-deep);
  }

  .by-guide-desc {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.92rem;
    color: var(--by-fg-muted);
  }
</style>
