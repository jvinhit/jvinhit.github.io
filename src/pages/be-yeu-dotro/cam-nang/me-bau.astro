---
/**
 * `/be-yeu-dotro/cam-nang/me-bau/` — chăm sóc mẹ bầu (spec 009, AC-11).
 * Nội dung tĩnh từ pregnancy-care.ts, render qua GuideTopics.
 */
import PregnancyLayout from '~/layouts/PregnancyLayout.astro';
import GuideTopics from '~/components/pregnancy/GuideTopics.astro';
import Disclaimer from '~/components/pregnancy/Disclaimer.astro';
import { CARE_TOPICS } from '~/lib/pregnancy-care';
import { withBase } from '~/lib/site-config';
---

<PregnancyLayout title="Chăm sóc mẹ bầu" nav="guides">
  <p class="by-kicker">
    <a href={withBase('/be-yeu-dotro/cam-nang/')}>Cẩm nang</a> · Mẹ bầu
  </p>
  <h1 class="by-title">Chăm sóc mẹ bầu</h1>
  <p class="by-muted mt-1">
    Ngủ, khó chịu thường gặp, thuốc – vắc xin, bệnh lý cần biết, vận động, làm
    việc, chuyện vợ chồng, tinh thần, chuyển dạ — và phần việc của bố. Mỗi chủ
    đề chia theo giai đoạn để đọc đúng lúc cần.
  </p>
  <GuideTopics topics={CARE_TOPICS} />
  <Disclaimer />
</PregnancyLayout>
