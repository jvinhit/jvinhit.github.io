---
/**
 * `/be-yeu-dotro/cam-nang/dinh-duong/` — cẩm nang dinh dưỡng (spec 009,
 * AC-10). Toàn bộ nội dung render tĩnh; script chỉ lọc danh sách món theo
 * ô tìm (so chuỗi đã bỏ dấu dựng sẵn ở build) — không cần Firebase.
 */
import PregnancyLayout from '~/layouts/PregnancyLayout.astro';
import Disclaimer from '~/components/pregnancy/Disclaimer.astro';
import AlertBox from '~/components/pregnancy/AlertBox.astro';
import {
  FOOD_GROUPS,
  FOODS,
  MEAL_PLANS,
  MICRONUTRIENTS,
  WEIGHT_GAIN,
  foodSearchKey,
} from '~/lib/pregnancy-nutrition';
import { withBase } from '~/lib/site-config';
---

<PregnancyLayout title="Dinh dưỡng" nav="guides">
  <p class="by-kicker">
    <a href={withBase('/be-yeu-dotro/cam-nang/')}>Cẩm nang</a> · Dinh dưỡng
  </p>
  <h1 class="by-title">Ăn gì, tránh gì</h1>
  <p class="by-muted mt-1">
    Gõ tên món để biết ngay nên ăn hay tránh, và vì sao. Phần dưới là vi chất,
    cách chia bữa theo giai đoạn và mức tăng cân hợp lý.
  </p>

  <!-- Ô tìm nhanh -->
  <div class="by-card by-food-search mt-4">
    <label class="by-label" for="by-food-q">Món này ăn được không?</label>
    <input
      id="by-food-q"
      class="by-input"
      type="search"
      placeholder="đu đủ, sushi, cà phê, nước dừa…"
      autocomplete="off"
      data-by-food-q
    />
    <p class="by-food-none by-muted" data-by-food-none hidden>
      Chưa có món này trong danh sách — nguyên tắc chung: nấu chín kỹ, nguồn
      sạch, ăn vừa phải; không chắc thì hỏi bác sĩ cho chắc nhé.
    </p>
  </div>

  {
    FOOD_GROUPS.map((group) => (
      <section
        class="mt-5"
        aria-labelledby={`by-food-${group.id}`}
        data-by-food-group={group.id}
      >
        <h2 id={`by-food-${group.id}`} class="by-subtitle">
          {group.emoji} {group.label}{' '}
          <span class="by-muted by-food-hint">— {group.hint}</span>
        </h2>
        <ul class="by-food-list mt-2">
          {FOODS.filter((food) => food.group === group.id).map((food) => (
            <li
              class:list={['by-card', 'by-food', `by-food-${group.id}`]}
              data-by-food
              data-search={foodSearchKey(food)}
            >
              <p class="by-food-name">{food.name}</p>
              <p class="by-food-reason">{food.reason}</p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <!-- Vi chất -->
  <section class="mt-6" aria-labelledby="by-micro-heading">
    <h2 id="by-micro-heading" class="by-subtitle">💊 Vi chất cần nhớ</h2>
    <p class="by-muted mt-1">
      Liều tham khảo cho mẹ khỏe mạnh — bác sĩ điều chỉnh theo xét nghiệm của
      mẹ. Vitamin bầu tốt thường đã gom gần đủ, trừ canxi và DHA.
    </p>
    <div class="by-micro-grid mt-3">
      {
        MICRONUTRIENTS.map((m) => (
          <article class="by-card by-micro">
            <h3 class="by-micro-name">{m.name}</h3>
            <p class="by-micro-dose">{m.dose}</p>
            <dl class="by-micro-dl">
              <dt>Khi nào</dt>
              <dd>{m.when}</dd>
              <dt>Vì sao</dt>
              <dd>{m.why}</dd>
              <dt>Nguồn</dt>
              <dd>{m.sources}</dd>
            </dl>
          </article>
        ))
      }
    </div>
    <AlertBox tone="info" title="Mẹo uống thuốc bổ" action="">
      <ul class="by-food-tips">
        <li>
          Sắt uống lúc bụng hơi đói với nước cam; cách sữa, canxi, trà, cà phê
          ít nhất 2 giờ.
        </li>
        <li>
          Canxi chia 2 lần/ngày, mỗi lần không quá 500 mg mới hấp thu tốt; uống
          sau ăn.
        </li>
        <li>
          Vitamin bầu gây nôn thì đổi sang uống tối sau bữa ăn, hoặc đổi loại.
        </li>
      </ul>
    </AlertBox>
  </section>

  <!-- Bữa ăn theo tam cá nguyệt -->
  <section class="mt-6" aria-labelledby="by-meal-heading">
    <h2 id="by-meal-heading" class="by-subtitle">🍽️ Chia bữa theo giai đoạn</h2>
    {
      MEAL_PLANS.map((plan) => (
        <details class="by-card by-meal mt-3" open={plan.trimester === 1}>
          <summary class="by-meal-summary">
            <span class="by-meal-title">{plan.title}</span>
            <span class="by-meal-energy by-muted">{plan.energy}</span>
          </summary>
          <h3 class="by-meal-sub">Nguyên tắc</h3>
          <ul class="by-food-tips">
            {plan.points.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
          <h3 class="by-meal-sub">Một ngày gợi ý</h3>
          <ul class="by-food-tips">
            {plan.sample.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        </details>
      ))
    }
  </section>

  <!-- Tăng cân theo BMI -->
  <section class="mt-6" aria-labelledby="by-gain-heading">
    <h2 id="by-gain-heading" class="by-subtitle">⚖️ Tăng bao nhiêu là vừa</h2>
    <p class="by-muted mt-1">
      Theo BMI trước mang thai (IOM 2009, đơn thai). Tam cá nguyệt 1 chỉ tăng
      0,5–2 kg; Bộ Y tế khuyến nghị tổng 10–12 kg cho mẹ BMI bình thường. Điền
      chiều cao và cân nặng trước mang thai ở Cài đặt để Nhật ký tự so sánh.
    </p>
    <div class="by-table-wrap mt-3">
      <table class="by-table">
        <thead>
          <tr>
            <th scope="col">BMI</th>
            <th scope="col">Nhóm</th>
            <th scope="col">Tổng cả thai kỳ</th>
            <th scope="col">Từ tam cá nguyệt 2</th>
          </tr>
        </thead>
        <tbody>
          {
            WEIGHT_GAIN.map((row) => (
              <tr>
                <td>{row.bmi}</td>
                <td>{row.label}</td>
                <td>{row.total}</td>
                <td>{row.perWeek}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <Disclaimer />
</PregnancyLayout>

<script>
  import { searchKey } from '~/lib/pregnancy-nutrition';

  const input = document.querySelector<HTMLInputElement>('[data-by-food-q]');
  const none = document.querySelector<HTMLElement>('[data-by-food-none]');
  const items = Array.from(
    document.querySelectorAll<HTMLLIElement>('[data-by-food]')
  );
  const groups = Array.from(
    document.querySelectorAll<HTMLElement>('[data-by-food-group]')
  );

  function filter(): void {
    const q = searchKey(input?.value.trim() ?? '');
    let shown = 0;
    for (const item of items) {
      const hit = q === '' || (item.dataset.search ?? '').includes(q);
      item.hidden = !hit;
      if (hit) shown += 1;
    }
    // Nhóm không còn món nào khớp thì ẩn luôn tiêu đề nhóm.
    for (const group of groups) {
      group.hidden = !group.querySelector('[data-by-food]:not([hidden])');
    }
    if (none) none.hidden = !(q !== '' && shown === 0);
  }

  input?.addEventListener('input', filter);
</script>

<style>
  .by-food-search .by-input {
    border-radius: 999px;
  }

  .by-food-none {
    margin-top: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: 14px;
    background: var(--by-peach-soft);
    color: var(--by-peach-deep);
    font-weight: 600;
  }

  .by-food-hint {
    font-size: 0.9rem;
    font-weight: 500;
  }

  .by-food-list {
    display: grid;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }

  .by-food {
    padding: 0.75rem 1rem;
    border-left-width: 6px;
  }

  .by-food-eat {
    border-left-color: var(--by-green);
  }

  .by-food-limit {
    border-left-color: var(--by-peach);
  }

  .by-food-avoid {
    border-left-color: var(--by-danger);
  }

  .by-food-name {
    font-weight: 700;
  }

  .by-food-reason {
    margin-top: 0.15rem;
    font-size: 0.92rem;
    color: var(--by-fg-muted);
  }

  .by-food-tips {
    margin-top: 0.5rem;
    padding-left: 1.2rem;
    list-style: disc;
    display: grid;
    gap: 0.35rem;
    line-height: 1.5;
  }

  .by-micro-grid {
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .by-micro-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .by-micro {
    padding: 1rem 1.1rem;
  }

  .by-micro-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--by-green-deep);
  }

  .by-micro-dose {
    margin-top: 0.15rem;
    font-weight: 700;
    color: var(--by-peach-deep);
  }

  .by-micro-dl {
    margin-top: 0.5rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 0.75rem;
    font-size: 0.9rem;
  }

  .by-micro-dl dt {
    font-weight: 700;
    color: var(--by-fg-muted);
  }

  .by-meal {
    padding: 1rem 1.1rem;
  }

  .by-meal-summary {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-height: 44px;
    cursor: pointer;
  }

  .by-meal-title {
    font-weight: 700;
    color: var(--by-green-deep);
  }

  .by-meal-energy {
    font-size: 0.9rem;
  }

  .by-meal-sub {
    margin-top: 0.9rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--by-peach-deep);
  }

  .by-table-wrap {
    overflow-x: auto;
    border: 2px solid var(--by-border);
    border-radius: 14px;
    background: var(--by-card);
  }

  .by-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .by-table th,
  .by-table td {
    padding: 0.6rem 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--by-border);
  }

  .by-table th {
    background: var(--by-green-soft);
    color: var(--by-green-deep);
  }

  .by-table tr:last-child td {
    border-bottom: 0;
  }
</style>
