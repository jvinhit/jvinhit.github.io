---
/**
 * `/be-yeu-dotro/cam-nang/so-sinh/` — chăm bé sơ sinh + mẹ sau sinh (spec
 * 009, AC-12). Nội dung tĩnh từ pregnancy-newborn.ts, render qua GuideTopics;
 * link sang hai checklist liên quan.
 */
import PregnancyLayout from '~/layouts/PregnancyLayout.astro';
import GuideTopics from '~/components/pregnancy/GuideTopics.astro';
import Disclaimer from '~/components/pregnancy/Disclaimer.astro';
import { NEWBORN_TOPICS } from '~/lib/pregnancy-newborn';
import { withBase } from '~/lib/site-config';
---

<PregnancyLayout title="Chăm bé sơ sinh" nav="guides">
  <p class="by-kicker">
    <a href={withBase('/be-yeu-dotro/cam-nang/')}>Cẩm nang</a> · Sơ sinh
  </p>
  <h1 class="by-title">Chăm bé sơ sinh & mẹ sau sinh</h1>
  <p class="by-muted mt-1">
    Những tuần đầu có bé: bú, khóc – trớ – phân, ngủ, tắm rốn, vàng da, tiêm
    chủng, giấy tờ, dấu hiệu nguy hiểm — và mẹ cũng cần được chăm.
  </p>
  <div class="by-so-sinh-links mt-3">
    <a
      class="by-ghost-button"
      href={withBase('/be-yeu-dotro/checklist/#newborn-shopping')}
    >
      🍼 Checklist đồ sơ sinh
    </a>
    <a
      class="by-ghost-button"
      href={withBase('/be-yeu-dotro/checklist/#postpartum-week1')}
    >
      🏡 Checklist tuần đầu
    </a>
  </div>
  <GuideTopics
    topics={NEWBORN_TOPICS}
    warningTitle="Đưa bé/mẹ đi viện ngay nếu"
    warningAction="Có một dấu hiệu là đủ lý do để đi khám ngay, kể cả nửa đêm — với trẻ sơ sinh, đi sớm luôn đúng."
  />
  <Disclaimer />
</PregnancyLayout>

<style>
  .by-so-sinh-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .by-so-sinh-links .by-ghost-button {
    text-decoration: none;
  }
</style>
