---
/**
 * `/be-yeu-dotro/` — trang "Hôm nay" (spec 009). Chưa có settings → form
 * onboarding (AC-4); có rồi → dashboard tuần thai (AC-5) hoặc tuổi bé khi
 * đã nhập ngày chào đời (AC-7).
 *
 * Một <h1> duy nhất; các section thay phiên nhau bằng `hidden` theo snapshot
 * settings, đều ẩn cho tới khi có snapshot đầu để không chớp form khi dữ
 * liệu đã có. Markup dashboard render tĩnh, script chỉ điền số — không
 * dựng DOM nên style scoped của Astro áp được.
 */
import PregnancyLayout from '~/layouts/PregnancyLayout.astro';
import SettingsForm from '~/components/pregnancy/SettingsForm.astro';
import { withBase } from '~/lib/site-config';
---

<PregnancyLayout title="Hôm nay" nav="home">
  <h1 class="by-title">Hôm nay</h1>

  <section data-by-onboarding hidden aria-labelledby="by-onboarding-heading">
    <div class="by-card mt-4">
      <p class="by-kicker">Chào mừng về nhà 🏡</p>
      <h2 id="by-onboarding-heading" class="by-subtitle mt-1">
        Bắt đầu bằng ngày dự sinh
      </h2>
      <p class="by-muted mt-1">
        Từ mốc này trang sẽ tính tuần thai, gợi ý mốc khám và mở đúng tuần trong
        cẩm nang. Sửa lại bất cứ lúc nào ở Cài đặt.
      </p>
      <SettingsForm mode="onboarding" />
    </div>
  </section>

  <section data-by-dashboard hidden aria-label="Tổng quan hôm nay">
    <!-- Thẻ chính: tuần thai (AC-5) / tuổi bé (AC-7) — script chọn một -->
    <div class="by-card by-hero mt-4" data-by-hero-pregnant hidden>
      <p class="by-kicker" data-by-trimester></p>
      <p class="by-hero-number" data-by-ga></p>
      <p class="by-muted" data-by-due></p>
      <div
        class="by-progress mt-3"
        role="progressbar"
        aria-label="Tiến trình thai kỳ"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        data-by-progress
      >
        <span class="by-progress-bar" data-by-progress-bar></span>
      </div>
      <p class="by-hero-overdue" data-by-overdue hidden>
        Quá ngày dự sinh rồi — đi khám theo lịch bác sĩ hẹn, theo dõi cử động
        thai mỗi ngày nhé.
      </p>
    </div>

    <div class="by-card by-hero mt-4" data-by-hero-born hidden>
      <p class="by-kicker">Bé đã chào đời 🎉</p>
      <p class="by-hero-number" data-by-baby-age></p>
      <p class="by-muted" data-by-birth></p>
      <a
        class="by-ghost-button mt-3"
        href={withBase('/be-yeu-dotro/cam-nang/so-sinh/')}
      >
        Cẩm nang chăm bé sơ sinh →
      </a>
    </div>

    <!-- Kích thước bé tuần này + link sang trang tuần -->
    <a
      class="by-card by-size mt-3"
      data-by-size-link
      href={withBase('/be-yeu-dotro/tuan/')}
    >
      <span class="by-size-emoji" aria-hidden="true" data-by-size-emoji></span>
      <span class="by-size-text">
        <span class="by-kicker" data-by-size-week></span>
        <span class="by-size-fruit" data-by-size-fruit></span>
        <span class="by-muted" data-by-size-measure></span>
        <span data-by-size-headline></span>
        <span class="by-size-cta">Xem tuần này →</span>
      </span>
    </a>

    <!-- Ba khung nhỏ — điền ở T10 (lịch hẹn), T11 (ghi chú), T12 (checklist) -->
    <div class="by-grid mt-3">
      <section class="by-card by-mini" aria-labelledby="by-upcoming-heading">
        <h2 id="by-upcoming-heading" class="by-mini-title">
          🩺 Lịch khám 7 ngày tới
        </h2>
        <p class="by-muted" data-by-upcoming>Đang tải…</p>
        <a class="by-mini-link" href={withBase('/be-yeu-dotro/lich-kham/')}
          >Xem lịch khám →</a
        >
      </section>
      <section class="by-card by-mini" aria-labelledby="by-checklist-heading">
        <h2 id="by-checklist-heading" class="by-mini-title">✅ Checklist</h2>
        <p class="by-muted" data-by-checklist-progress>Đang tải…</p>
        <a class="by-mini-link" href={withBase('/be-yeu-dotro/checklist/')}
          >Mở checklist →</a
        >
      </section>
      <section class="by-card by-mini" aria-labelledby="by-notes-heading">
        <h2 id="by-notes-heading" class="by-mini-title">📝 Ghi chú mới nhất</h2>
        <p class="by-muted" data-by-latest-notes>Đang tải…</p>
        <a class="by-mini-link" href={withBase('/be-yeu-dotro/nhat-ky/')}
          >Mở nhật ký →</a
        >
      </section>
    </div>
  </section>
</PregnancyLayout>

<script>
  import { todayKeyVN } from '~/lib/love-board';
  import {
    appointmentFromDoc,
    babyAge,
    checklistStateFromDoc,
    formatBabyAge,
    formatDateShort,
    formatDateVN,
    formatGa,
    gestationalAge,
    noteFromDoc,
    noteKindMeta,
    relativeDayLabel,
    trimesterLabel,
    upcomingWithin,
    type Appointment,
    type PregnancyNote,
  } from '~/lib/pregnancy';
  import { formatSize, weekSize } from '~/lib/pregnancy-week-sizes';
  import { CHECKLISTS, templateItemIds } from '~/lib/pregnancy-checklists';
  import {
    onSettings,
    watchCollection,
    whileSignedIn,
  } from '~/lib/pregnancy-session';
  import { withBase } from '~/lib/site-config';

  function must<T extends HTMLElement>(selector: string): T {
    const node = document.querySelector<T>(selector);
    if (!node) throw new Error(`be-yeu home: thiếu ${selector}`);
    return node;
  }

  const onboarding = must<HTMLElement>('[data-by-onboarding]');
  const dashboard = must<HTMLElement>('[data-by-dashboard]');
  const heroPregnant = must<HTMLElement>('[data-by-hero-pregnant]');
  const heroBorn = must<HTMLElement>('[data-by-hero-born]');
  const trimesterEl = must<HTMLParagraphElement>('[data-by-trimester]');
  const gaEl = must<HTMLParagraphElement>('[data-by-ga]');
  const dueEl = must<HTMLParagraphElement>('[data-by-due]');
  const progress = must<HTMLDivElement>('[data-by-progress]');
  const progressBar = must<HTMLSpanElement>('[data-by-progress-bar]');
  const overdueEl = must<HTMLParagraphElement>('[data-by-overdue]');
  const babyAgeEl = must<HTMLParagraphElement>('[data-by-baby-age]');
  const birthEl = must<HTMLParagraphElement>('[data-by-birth]');
  const sizeLink = must<HTMLAnchorElement>('[data-by-size-link]');
  const sizeEmoji = must<HTMLSpanElement>('[data-by-size-emoji]');
  const sizeWeek = must<HTMLSpanElement>('[data-by-size-week]');
  const sizeFruit = must<HTMLSpanElement>('[data-by-size-fruit]');
  const sizeMeasure = must<HTMLSpanElement>('[data-by-size-measure]');
  const sizeHeadline = must<HTMLSpanElement>('[data-by-size-headline]');

  onSettings((settings, error) => {
    // Lỗi đọc (rules chưa dán) đã được layout báo; không bật form onboarding
    // kẻo người dùng tưởng chưa nhập và nhập lại.
    onboarding.hidden = settings !== null || Boolean(error);
    dashboard.hidden = settings === null;
    if (!settings) return;

    const today = todayKeyVN();
    const born = Boolean(settings.birthDate);
    heroPregnant.hidden = born;
    heroBorn.hidden = !born;

    if (settings.birthDate) {
      const age = babyAge(settings.birthDate, today);
      const name = settings.babyName ?? 'Bé';
      babyAgeEl.textContent = age ? `${name} được ${formatBabyAge(age)}` : name;
      birthEl.textContent = `Chào đời ${formatDateVN(settings.birthDate)}`;
    }

    const ga = gestationalAge(settings.dueDate, today);
    if (!ga) return;
    if (!born) {
      trimesterEl.textContent = trimesterLabel(ga.trimester);
      gaEl.textContent = formatGa(ga);
      dueEl.textContent =
        ga.overdueDays > 0
          ? `Dự sinh ${formatDateVN(settings.dueDate)} · quá ${ga.overdueDays} ngày`
          : `Dự sinh ${formatDateVN(settings.dueDate)} · còn ${ga.daysLeft} ngày`;
      const percent = Math.round(ga.progress * 100);
      progress.setAttribute('aria-valuenow', String(percent));
      progressBar.style.transform = `scaleX(${ga.progress})`;
      overdueEl.hidden = ga.overdueDays === 0;
    }

    // Thẻ kích thước: tuần nội dung hiện tại (sau sinh giữ tuần cuối).
    const size = weekSize(ga.guideWeek);
    if (!size) return;
    sizeLink.href = withBase(`/be-yeu-dotro/tuan/${size.week}/`);
    sizeEmoji.textContent = size.emoji;
    sizeWeek.textContent = `Tuần ${size.week}`;
    sizeFruit.textContent = size.fruit
      ? `Bé to bằng ${size.fruit}`
      : 'Bé chưa hình thành';
    sizeMeasure.textContent = formatSize(size);
    sizeHeadline.textContent = size.headline;
  });

  // Khung "lịch khám 7 ngày tới" (AC-16) — subscribe chỉ khi đã đăng nhập.
  const upcomingEl = must<HTMLParagraphElement>('[data-by-upcoming]');

  function renderUpcoming(items: Appointment[]): void {
    const today = todayKeyVN();
    const soon = upcomingWithin(items, today, 7);
    if (soon.length === 0) {
      upcomingEl.textContent = 'Không có lịch hẹn trong 7 ngày tới.';
      return;
    }
    upcomingEl.replaceChildren(
      ...soon.map((a) => {
        const line = document.createElement('span');
        line.className = 'by-mini-line';
        line.textContent = `${relativeDayLabel(a.date, today)} (${formatDateShort(a.date)}${a.time ? ` ${a.time}` : ''}) · ${a.purpose}`;
        return line;
      })
    );
  }

  // Khung "ghi chú mới nhất" (AC-14) — 3 ghi chú gần nhất, mọi loại.
  const latestEl = must<HTMLParagraphElement>('[data-by-latest-notes]');

  function renderLatest(items: PregnancyNote[]): void {
    const latest = items.slice(-3).reverse();
    if (latest.length === 0) {
      latestEl.textContent = 'Chưa có ghi chú nào.';
      return;
    }
    latestEl.replaceChildren(
      ...latest.map((note) => {
        const line = document.createElement('span');
        line.className = 'by-mini-line';
        const meta = noteKindMeta(note.kind);
        const body =
          note.text ||
          (note.weightKg !== undefined ? `${note.weightKg} kg` : '') ||
          (note.imageBase64 ? '📷 ảnh' : '');
        line.textContent = `${meta.emoji} ${formatDateShort(note.dateKey)} · ${body.length > 60 ? `${body.slice(0, 60)}…` : body}`;
        return line;
      })
    );
  }

  // Khung "checklist" (AC-17): tổng tiến độ + giỏ đồ đi sinh.
  const checklistEl = must<HTMLParagraphElement>(
    '[data-by-checklist-progress]'
  );

  function renderChecklist(docs: Map<string, Record<string, unknown>>): void {
    let done = 0;
    let total = 0;
    let bagLine = '';
    for (const list of CHECKLISTS) {
      const state = checklistStateFromDoc(docs.get(list.id));
      const ids = templateItemIds(list);
      const checked = new Set(state.checked);
      const listTotal = ids.size + state.custom.length;
      const listDone =
        state.checked.filter((id) => ids.has(id)).length +
        state.custom.filter((item) => checked.has(item.id)).length;
      done += listDone;
      total += listTotal;
      if (list.id === 'hospital-bag')
        bagLine = `${list.emoji} Giỏ đồ đi sinh: ${listDone}/${listTotal}`;
    }
    checklistEl.replaceChildren(
      ...[`Tổng: ${done}/${total} mục`, bagLine].filter(Boolean).map((text) => {
        const line = document.createElement('span');
        line.className = 'by-mini-line';
        line.textContent = text;
        return line;
      })
    );
  }

  whileSignedIn(({ fb }) => {
    const unsubChecklist = fb.dbApi.onSnapshot(
      fb.dbApi.collection(fb.db, 'pregnancyChecklist'),
      (snap) => {
        const docs = new Map<string, Record<string, unknown>>();
        for (const docSnap of snap.docs) docs.set(docSnap.id, docSnap.data());
        renderChecklist(docs);
      },
      () => {
        checklistEl.textContent = 'Không đọc được checklist.';
      }
    );
    const unsubAppointments = watchCollection<Appointment>(
      fb,
      'pregnancyAppointments',
      'date',
      appointmentFromDoc,
      renderUpcoming,
      (message) => {
        upcomingEl.textContent = message;
      }
    );
    const unsubNotes = watchCollection<PregnancyNote>(
      fb,
      'pregnancyNotes',
      'createdAtMs',
      noteFromDoc,
      renderLatest,
      (message) => {
        latestEl.textContent = message;
      }
    );
    return () => {
      unsubChecklist();
      unsubAppointments();
      unsubNotes();
      checklistEl.textContent = 'Đang tải…';
      upcomingEl.textContent = 'Đang tải…';
      latestEl.textContent = 'Đang tải…';
    };
  });
</script>

<style>
  .by-hero {
    text-align: center;
  }

  .by-hero-number {
    margin-top: 0.25rem;
    font-size: 2.1rem;
    line-height: 1.15;
    font-weight: 700;
    color: var(--by-green-deep);
  }

  .by-hero-overdue {
    margin-top: 0.75rem;
    padding: 0.6rem 0.9rem;
    border-radius: 12px;
    background: var(--by-peach-soft);
    color: var(--by-peach-deep);
    font-weight: 600;
  }

  .by-progress {
    height: 10px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--by-green-soft);
  }

  .by-progress-bar {
    display: block;
    height: 100%;
    transform: scaleX(0);
    transform-origin: left;
    border-radius: 999px;
    background: var(--by-green);
    transition: transform 0.6s var(--ease-out-quad);
  }

  @media (prefers-reduced-motion: reduce) {
    .by-progress-bar {
      transition: none;
    }
  }

  .by-size {
    display: flex;
    gap: 1rem;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .by-size:hover {
    border-color: var(--by-green);
  }

  .by-size-emoji {
    flex: none;
    width: 3.5rem;
    font-size: 2.5rem;
    line-height: 1;
    text-align: center;
  }

  .by-size-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .by-size-fruit {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--by-green-deep);
  }

  .by-size-cta {
    margin-top: 0.25rem;
    font-weight: 700;
    color: var(--by-peach-deep);
  }

  .by-grid {
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .by-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .by-mini {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem 1.1rem;
  }

  .by-mini-title {
    font-size: 0.95rem;
    font-weight: 700;
  }

  .by-mini-line {
    display: block;
    color: var(--by-fg);
  }

  .by-mini-line + .by-mini-line {
    margin-top: 0.25rem;
  }

  .by-mini-link {
    margin-top: auto;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--by-green-deep);
  }
</style>
