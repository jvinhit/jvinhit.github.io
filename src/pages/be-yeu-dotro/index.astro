---
/**
 * `/be-yeu-dotro/` — trang "Hôm nay" (spec 009). Chưa có settings → form
 * onboarding (AC-4); có rồi → dashboard tuần thai (AC-5) hoặc tuổi bé khi
 * đã nhập ngày chào đời (AC-7).
 *
 * Một <h1> duy nhất; các section thay phiên nhau bằng `hidden` theo snapshot
 * settings, đều ẩn cho tới khi có snapshot đầu để không chớp form khi dữ
 * liệu đã có. Markup dashboard render tĩnh, script điền chữ; riêng các danh
 * sách 5 mục do script dựng nên style của chúng (`.by-feed-*`) đặt :global().
 */
import PregnancyLayout from '~/layouts/PregnancyLayout.astro';
import SettingsForm from '~/components/pregnancy/SettingsForm.astro';
import InstallPrompt from '~/components/pregnancy/InstallPrompt.astro';
import { withBase } from '~/lib/site-config';
---

<PregnancyLayout title="Hôm nay" nav="home">
  <h1 class="by-title">Hôm nay</h1>

  <InstallPrompt variant="card" />

  <!-- Chờ snapshot settings đầu tiên: skeleton đúng hình dashboard thay vì
       trang trống (mạng chậm). Ẩn ngay khi biết là onboarding hay dashboard. -->
  <div data-by-dash-skeleton aria-busy="true" aria-label="Đang tải tổng quan">
    <div class="by-card by-hero mt-4">
      <span class="by-skel by-skel-line by-skel-center by-skel-w-md"></span>
      <span class="by-skel by-skel-hero by-skel-center"></span>
      <span class="by-skel by-skel-line by-skel-center by-skel-w-lg"></span>
      <span class="by-skel by-skel-bar"></span>
    </div>
    <div class="by-card mt-3">
      <span class="by-skel by-skel-line by-skel-w-md"></span>
      <span class="by-skel by-skel-line"></span>
      <span class="by-skel by-skel-line is-short"></span>
    </div>
    <div class="by-card by-size mt-3">
      <span class="by-skel by-skel-emoji"></span>
      <span class="by-size-text by-skel-fill">
        <span class="by-skel by-skel-line by-skel-w-sm"></span>
        <span class="by-skel by-skel-line"></span>
        <span class="by-skel by-skel-line is-short"></span>
      </span>
    </div>
  </div>

  <section data-by-onboarding hidden aria-labelledby="by-onboarding-heading">
    <div class="by-card mt-4">
      <p class="by-kicker">Chào mừng về nhà 🏡</p>
      <h2 id="by-onboarding-heading" class="by-subtitle mt-1">
        Bắt đầu bằng ngày dự sinh
      </h2>
      <p class="by-muted mt-1">
        Từ mốc này trang sẽ tính tuần thai, gợi ý mốc khám và mở đúng tuần trong
        cẩm nang. Sửa lại bất cứ lúc nào ở Cài đặt.
      </p>
      <SettingsForm mode="onboarding" />
    </div>
  </section>

  <section data-by-dashboard hidden aria-label="Tổng quan hôm nay">
    <!-- Thẻ chính: tuần thai (AC-5) / tuổi bé (AC-7) — script chọn một -->
    <div class="by-card by-hero mt-4" data-by-hero-pregnant hidden>
      <p class="by-kicker" data-by-trimester></p>
      <p class="by-hero-number" data-by-ga></p>
      <p class="by-muted" data-by-due></p>
      <div
        class="by-progress mt-3"
        role="progressbar"
        aria-label="Tiến trình thai kỳ"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        data-by-progress
      >
        <span class="by-progress-bar" data-by-progress-bar></span>
      </div>
      <p class="by-hero-overdue" data-by-overdue hidden>
        Quá ngày dự sinh rồi — đi khám theo lịch bác sĩ hẹn, theo dõi cử động
        thai mỗi ngày nhé.
      </p>
    </div>

    <div class="by-card by-hero mt-4" data-by-hero-born hidden>
      <p class="by-kicker">Bé đã chào đời 🎉</p>
      <p class="by-hero-number" data-by-baby-age></p>
      <p class="by-muted" data-by-birth></p>
      <a
        class="by-ghost-button mt-3"
        href={withBase('/be-yeu-dotro/cam-nang/so-sinh/')}
      >
        Cẩm nang chăm bé sơ sinh →
      </a>
    </div>

    <!-- Thẻ "Sắp tới" (AC-16): lần khám gần nhất + nhắc lịch quá ngày chưa
         đánh dấu. Markup tĩnh, script chỉ điền chữ và bật/tắt `hidden`. -->
    <section
      class="by-card by-next mt-3"
      aria-labelledby="by-next-heading"
      data-by-next
    >
      <h2 id="by-next-heading" class="by-subtitle">🗓️ Sắp tới</h2>
      <div class="by-next-skel" data-by-next-skeleton aria-busy="true">
        <span class="by-skel by-skel-line" aria-hidden="true"></span>
        <span class="by-skel by-skel-line" aria-hidden="true"></span>
        <span class="by-skel by-skel-line is-short" aria-hidden="true"></span>
      </div>
      <p class="by-muted" data-by-next-empty hidden></p>
      <div data-by-next-body hidden>
        <p class="by-next-when">
          <strong data-by-next-date></strong><span data-by-next-time></span>
          <span class="by-next-rel" data-by-next-rel></span>
        </p>
        <p class="by-next-purpose" data-by-next-purpose></p>
        <p class="by-muted" data-by-next-place hidden></p>
        <ul class="by-feed-list" data-by-next-list hidden></ul>
        <p class="by-muted by-next-more" data-by-next-more hidden></p>
      </div>
      <p class="by-next-overdue" data-by-next-overdue hidden></p>
      <a class="by-feed-link" href={withBase('/be-yeu-dotro/lich-kham/')}
        >Xem lịch khám →</a
      >
    </section>

    <!-- Kích thước bé tuần này + link sang trang tuần -->
    <a
      class="by-card by-size mt-3"
      data-by-size-link
      href={withBase('/be-yeu-dotro/tuan/')}
    >
      <span class="by-size-emoji" aria-hidden="true" data-by-size-emoji></span>
      <span class="by-size-text">
        <span class="by-kicker" data-by-size-week></span>
        <span class="by-size-fruit" data-by-size-fruit></span>
        <span class="by-muted" data-by-size-measure></span>
        <span data-by-size-headline></span>
        <span class="by-size-cta">Xem tuần này →</span>
      </span>
    </a>

    <!-- Ghi chú (AC-14) và checklist (AC-17): 5 mục gần nhất, cùng kiểu danh
         sách với thẻ "Sắp tới". Phần thân do script thay (skeleton → list). -->
    <section class="by-card mt-3" aria-labelledby="by-notes-heading">
      <h2 id="by-notes-heading" class="by-subtitle">📝 Ghi chú gần nhất</h2>
      <div data-by-latest-notes aria-busy="true">
        <span class="by-skel by-skel-line" aria-hidden="true"></span><span
          class="by-skel by-skel-line is-short"
          aria-hidden="true"></span>
      </div>
      <a class="by-feed-link" href={withBase('/be-yeu-dotro/nhat-ky/')}
        >Mở nhật ký →</a
      >
    </section>

    <section class="by-card mt-3" aria-labelledby="by-checklist-heading">
      <h2 id="by-checklist-heading" class="by-subtitle">
        ✅ Checklist vừa tick
      </h2>
      <div data-by-checklist aria-busy="true">
        <span class="by-skel by-skel-line" aria-hidden="true"></span><span
          class="by-skel by-skel-line is-short"
          aria-hidden="true"></span>
      </div>
      <a class="by-feed-link" href={withBase('/be-yeu-dotro/checklist/')}
        >Mở checklist →</a
      >
    </section>
  </section>
</PregnancyLayout>

<script>
  import { todayKeyVN } from '~/lib/love-board';
  import {
    appointmentFromDoc,
    babyAge,
    checklistStateFromDoc,
    formatBabyAge,
    formatDateShort,
    formatDateVN,
    formatGa,
    gestationalAge,
    noteFromDoc,
    noteKindMeta,
    pendingAppointments,
    relativeDayLabel,
    trimesterLabel,
    type Appointment,
    type PregnancyNote,
  } from '~/lib/pregnancy';
  import { formatSize, weekSize } from '~/lib/pregnancy-week-sizes';
  import { CHECKLISTS, templateItemIds } from '~/lib/pregnancy-checklists';
  import {
    onSettings,
    watchCollection,
    whileSignedIn,
  } from '~/lib/pregnancy-session';
  import { LOVE_CONFIG } from '~/lib/love-config';
  import { withBase } from '~/lib/site-config';
  import { markLoaded, showSkeletonLines } from '~/lib/pregnancy-ui';

  function must<T extends HTMLElement>(selector: string): T {
    const node = document.querySelector<T>(selector);
    if (!node) throw new Error(`be-yeu home: thiếu ${selector}`);
    return node;
  }

  const dashSkeleton = must<HTMLElement>('[data-by-dash-skeleton]');
  const onboarding = must<HTMLElement>('[data-by-onboarding]');
  const dashboard = must<HTMLElement>('[data-by-dashboard]');
  const heroPregnant = must<HTMLElement>('[data-by-hero-pregnant]');
  const heroBorn = must<HTMLElement>('[data-by-hero-born]');
  const trimesterEl = must<HTMLParagraphElement>('[data-by-trimester]');
  const gaEl = must<HTMLParagraphElement>('[data-by-ga]');
  const dueEl = must<HTMLParagraphElement>('[data-by-due]');
  const progress = must<HTMLDivElement>('[data-by-progress]');
  const progressBar = must<HTMLSpanElement>('[data-by-progress-bar]');
  const overdueEl = must<HTMLParagraphElement>('[data-by-overdue]');
  const babyAgeEl = must<HTMLParagraphElement>('[data-by-baby-age]');
  const birthEl = must<HTMLParagraphElement>('[data-by-birth]');
  const sizeLink = must<HTMLAnchorElement>('[data-by-size-link]');
  const sizeEmoji = must<HTMLSpanElement>('[data-by-size-emoji]');
  const sizeWeek = must<HTMLSpanElement>('[data-by-size-week]');
  const sizeFruit = must<HTMLSpanElement>('[data-by-size-fruit]');
  const sizeMeasure = must<HTMLSpanElement>('[data-by-size-measure]');
  const sizeHeadline = must<HTMLSpanElement>('[data-by-size-headline]');

  onSettings((settings, error) => {
    // Lỗi đọc (rules chưa dán) đã được layout báo; không bật form onboarding
    // kẻo người dùng tưởng chưa nhập và nhập lại.
    dashSkeleton.hidden = true;
    onboarding.hidden = settings !== null || Boolean(error);
    dashboard.hidden = settings === null;
    if (!settings) return;

    const today = todayKeyVN();
    const born = Boolean(settings.birthDate);
    heroPregnant.hidden = born;
    heroBorn.hidden = !born;

    if (settings.birthDate) {
      const age = babyAge(settings.birthDate, today);
      const name = settings.babyName ?? 'Bé';
      babyAgeEl.textContent = age ? `${name} được ${formatBabyAge(age)}` : name;
      birthEl.textContent = `Chào đời ${formatDateVN(settings.birthDate)}`;
    }

    const ga = gestationalAge(settings.dueDate, today);
    if (!ga) return;
    if (!born) {
      trimesterEl.textContent = trimesterLabel(ga.trimester);
      gaEl.textContent = formatGa(ga);
      dueEl.textContent =
        ga.overdueDays > 0
          ? `Dự sinh ${formatDateVN(settings.dueDate)} · quá ${ga.overdueDays} ngày`
          : `Dự sinh ${formatDateVN(settings.dueDate)} · còn ${ga.daysLeft} ngày`;
      const percent = Math.round(ga.progress * 100);
      progress.setAttribute('aria-valuenow', String(percent));
      progressBar.style.transform = `scaleX(${ga.progress})`;
      overdueEl.hidden = ga.overdueDays === 0;
    }

    // Thẻ kích thước: tuần nội dung hiện tại (sau sinh giữ tuần cuối).
    const size = weekSize(ga.guideWeek);
    if (!size) return;
    sizeLink.href = withBase(`/be-yeu-dotro/tuan/${size.week}/`);
    sizeEmoji.textContent = size.emoji;
    sizeWeek.textContent = `Tuần ${size.week}`;
    sizeFruit.textContent = size.fruit
      ? `Bé to bằng ${size.fruit}`
      : 'Bé chưa hình thành';
    sizeMeasure.textContent = formatSize(size);
    sizeHeadline.textContent = size.headline;
  });

  // ---- danh sách dùng chung cho ba thẻ ----------------------------------------

  /** Số mục tối đa mỗi thẻ (lịch hẹn, ghi chú, checklist vừa tick). */
  const FEED_LIMIT = 5;

  /** Một dòng: chữ nhỏ "khi nào / ở đâu" phía trên, nội dung phía dưới. */
  function feedItem(when: string, text: string): HTMLLIElement {
    const item = document.createElement('li');
    const meta = document.createElement('span');
    meta.className = 'by-feed-when';
    meta.textContent = when;
    item.append(meta, text);
    return item;
  }

  function feedList(items: HTMLLIElement[]): HTMLUListElement {
    const list = document.createElement('ul');
    list.className = 'by-feed-list';
    list.append(...items);
    return list;
  }

  function mutedLine(text: string): HTMLParagraphElement {
    const line = document.createElement('p');
    line.className = 'by-muted';
    line.textContent = text;
    return line;
  }

  // Thẻ "Sắp tới" (AC-16) — subscribe chỉ khi đã đăng nhập.
  const nextSkeleton = must<HTMLElement>('[data-by-next-skeleton]');
  const nextEmpty = must<HTMLParagraphElement>('[data-by-next-empty]');
  const nextBody = must<HTMLElement>('[data-by-next-body]');
  const nextDate = must<HTMLElement>('[data-by-next-date]');
  const nextTime = must<HTMLSpanElement>('[data-by-next-time]');
  const nextRel = must<HTMLSpanElement>('[data-by-next-rel]');
  const nextPurpose = must<HTMLParagraphElement>('[data-by-next-purpose]');
  const nextPlace = must<HTMLParagraphElement>('[data-by-next-place]');
  const nextList = must<HTMLUListElement>('[data-by-next-list]');
  const nextMore = must<HTMLParagraphElement>('[data-by-next-more]');
  const nextOverdue = must<HTMLParagraphElement>('[data-by-next-overdue]');

  function renderNext(items: Appointment[]): void {
    nextSkeleton.hidden = true;
    const today = todayKeyVN();
    const { ahead, overdue } = pendingAppointments(items, today);
    const [next, ...rest] = ahead;

    nextBody.hidden = !next;
    nextEmpty.hidden = Boolean(next);
    if (next) {
      nextDate.textContent = formatDateVN(next.date);
      nextTime.textContent = next.time ? ` · ${next.time}` : '';
      nextRel.textContent = relativeDayLabel(next.date, today);
      nextPurpose.textContent = next.purpose;
      nextPlace.textContent = next.place ? `📍 ${next.place}` : '';
      nextPlace.hidden = !next.place;
      // Lịch đầu đã nêu bật phía trên → danh sách lấy thêm FEED_LIMIT - 1.
      const shown = rest.slice(0, FEED_LIMIT - 1);
      nextList.replaceChildren(
        ...shown.map((a) =>
          feedItem(
            `${formatDateShort(a.date)}${a.time ? ` ${a.time}` : ''} · ${relativeDayLabel(a.date, today)}`,
            a.purpose
          )
        )
      );
      nextList.hidden = shown.length === 0;
      const hiddenCount = rest.length - shown.length;
      nextMore.textContent = `+${hiddenCount} lịch hẹn nữa`;
      nextMore.hidden = hiddenCount === 0;
    } else {
      nextEmpty.textContent = 'Chưa có lịch khám nào sắp tới.';
    }

    const [late] = overdue;
    nextOverdue.hidden = !late;
    if (late) {
      nextOverdue.textContent =
        overdue.length === 1
          ? `⏰ Chưa đánh dấu đã khám: ${late.purpose} (${formatDateShort(late.date)} · ${relativeDayLabel(late.date, today)})`
          : `⏰ ${overdue.length} lịch hẹn đã qua ngày, chưa đánh dấu đã khám`;
    }
  }

  function showNextError(message: string): void {
    nextSkeleton.hidden = true;
    nextBody.hidden = true;
    nextOverdue.hidden = true;
    nextEmpty.hidden = false;
    nextEmpty.textContent = message;
  }

  function resetNext(): void {
    nextSkeleton.hidden = false;
    nextBody.hidden = true;
    nextEmpty.hidden = true;
    nextOverdue.hidden = true;
  }

  // Thẻ "ghi chú gần nhất" (AC-14) — 5 ghi chú mới nhất, mọi loại, cả hai người.
  const latestEl = must<HTMLDivElement>('[data-by-latest-notes]');

  const authorLabel = (author: string): string => {
    const profile = LOVE_CONFIG.profiles.find((p) => p.id === author);
    return profile ? `${profile.emoji} ${profile.name}` : author;
  };

  function renderLatest(items: PregnancyNote[]): void {
    markLoaded(latestEl);
    // watchCollection sort createdAtMs tăng dần → lấy cuối mảng, đảo lại.
    const latest = items.slice(-FEED_LIMIT).reverse();
    if (latest.length === 0) {
      latestEl.replaceChildren(mutedLine('Chưa có ghi chú nào.'));
      return;
    }
    latestEl.replaceChildren(
      feedList(
        latest.map((note) => {
          const meta = noteKindMeta(note.kind);
          const body =
            note.text ||
            (note.weightKg !== undefined ? `${note.weightKg} kg` : '') ||
            (note.imageBase64 ? '📷 ảnh' : '');
          return feedItem(
            `${meta.emoji} ${meta.label} · ${formatDateShort(note.dateKey)} · ${authorLabel(note.author)}`,
            body.length > 80 ? `${body.slice(0, 80)}…` : body
          );
        })
      )
    );
  }

  // Thẻ "checklist vừa tick" (AC-17): tổng tiến độ + 5 mục tick gần nhất
  // trên cả 6 list (theo `checkedAt`; mục tick trước khi có field này không
  // có giờ nên không vào danh sách).
  const checklistEl = must<HTMLDivElement>('[data-by-checklist]');

  interface RecentTick {
    at: number;
    list: (typeof CHECKLISTS)[number];
    text: string;
  }

  function renderChecklist(docs: Map<string, Record<string, unknown>>): void {
    markLoaded(checklistEl);
    let done = 0;
    let total = 0;
    let bagText = '';
    const ticks: RecentTick[] = [];
    for (const list of CHECKLISTS) {
      const state = checklistStateFromDoc(docs.get(list.id));
      const ids = templateItemIds(list);
      const checked = new Set(state.checked);
      const listTotal = ids.size + state.custom.length;
      const listDone =
        state.checked.filter((id) => ids.has(id)).length +
        state.custom.filter((item) => checked.has(item.id)).length;
      done += listDone;
      total += listTotal;
      if (list.id === 'hospital-bag')
        bagText = ` · ${list.emoji} Giỏ đồ đi sinh: ${listDone}/${listTotal}`;

      const texts = new Map<string, string>();
      for (const group of list.groups)
        for (const item of group.items) texts.set(item.id, item.text);
      for (const item of state.custom) texts.set(item.id, item.text);
      for (const id of checked) {
        const at = state.checkedAt[id];
        const text = texts.get(id);
        if (at !== undefined && text !== undefined)
          ticks.push({ at, list, text });
      }
    }

    ticks.sort((a, b) => b.at - a.at);
    const recent = ticks.slice(0, FEED_LIMIT);
    checklistEl.replaceChildren(
      mutedLine(`Tổng: ${done}/${total} mục${bagText}`),
      recent.length > 0
        ? feedList(
            recent.map((tick) =>
              feedItem(
                `${tick.list.emoji} ${tick.list.title} · ${formatDateShort(todayKeyVN(new Date(tick.at)))}`,
                `✓ ${tick.text}`
              )
            )
          )
        : mutedLine('Tick mục nào ở trang Checklist là hiện ở đây.')
    );
  }

  whileSignedIn(({ fb }) => {
    const unsubChecklist = fb.dbApi.onSnapshot(
      fb.dbApi.collection(fb.db, 'pregnancyChecklist'),
      (snap) => {
        const docs = new Map<string, Record<string, unknown>>();
        for (const docSnap of snap.docs) docs.set(docSnap.id, docSnap.data());
        renderChecklist(docs);
      },
      () => {
        markLoaded(checklistEl);
        checklistEl.replaceChildren(mutedLine('Không đọc được checklist.'));
      }
    );
    const unsubAppointments = watchCollection<Appointment>(
      fb,
      'pregnancyAppointments',
      'date',
      appointmentFromDoc,
      renderNext,
      showNextError
    );
    const unsubNotes = watchCollection<PregnancyNote>(
      fb,
      'pregnancyNotes',
      'createdAtMs',
      noteFromDoc,
      renderLatest,
      (message) => {
        markLoaded(latestEl);
        latestEl.replaceChildren(mutedLine(message));
      }
    );
    return () => {
      unsubChecklist();
      unsubAppointments();
      unsubNotes();
      // Đăng xuất: về lại skeleton để lần sau không chớp số của phiên trước.
      showSkeletonLines(checklistEl);
      resetNext();
      showSkeletonLines(latestEl);
      dashSkeleton.hidden = false;
      dashboard.hidden = true;
      onboarding.hidden = true;
    };
  });
</script>

<style>
  .by-skel-center {
    margin-inline: auto;
  }

  .by-skel-w-sm {
    width: 5rem;
  }

  .by-skel-w-md {
    width: 8rem;
  }

  .by-skel-w-lg {
    width: 14rem;
  }

  .by-skel-fill {
    flex: 1;
  }

  .by-skel-hero {
    width: 11rem;
    height: 2.4rem;
    margin-top: 0.6rem;
  }

  .by-skel-bar {
    height: 10px;
    margin-top: 1rem;
    border-radius: 999px;
  }

  .by-skel-emoji {
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 999px;
  }

  .by-hero {
    text-align: center;
  }

  .by-hero-number {
    margin-top: 0.25rem;
    font-size: 2.1rem;
    line-height: 1.15;
    font-weight: 700;
    color: var(--by-green-deep);
  }

  .by-hero-overdue {
    margin-top: 0.75rem;
    padding: 0.6rem 0.9rem;
    border-radius: 12px;
    background: var(--by-peach-soft);
    color: var(--by-peach-deep);
    font-weight: 600;
  }

  .by-progress {
