---
import {
  Wrench,
  Dices,
  LoaderCircle,
  Repeat,
  Sparkles,
  Cookie,
  Globe,
  GitFork,
  TrendingUp,
  ExternalLink,
  Code,
  Layers,
  Bot,
} from '@lucide/astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/ui/Container.astro';
import { withBase } from '~/lib/site-config';
import { toolSections, toolSlug, type ToolIcon } from '~/lib/tools';

/** Map the serializable icon key from `~/lib/tools` to a Lucide component. */
const ICONS: Record<ToolIcon, typeof Wrench> = {
  wrench: Wrench,
  dices: Dices,
  loader: LoaderCircle,
  repeat: Repeat,
  sparkles: Sparkles,
  cookie: Cookie,
  globe: Globe,
  gitfork: GitFork,
  trending: TrendingUp,
  code: Code,
  layers: Layers,
  bot: Bot,
};

const toolCount = toolSections.reduce((n, s) => n + s.tools.length, 0);
---

<BaseLayout
  title="Tools"
  description="A collection of small utilities, generators, and experiments — built for fun and daily use."
>
  <Container class="pt-12 pb-16">
    <header
      class="border-b border-dashed border-[var(--color-border-strong)] pb-6"
    >
      <p class="terminal-label">Directory/Tools</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-5xl">
        <span class="text-[var(--color-accent)]">//</span> Tools
      </h1>
      <p class="mt-3 max-w-prose text-[var(--color-fg-muted)]">
        Small utilities, generators, and experiments — built for fun and daily
        use. Each tool runs entirely in your browser.
      </p>

      <dl
        class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-xs tracking-wider text-[var(--color-fg-muted)] uppercase"
      >
        <div class="flex items-baseline gap-2">
          <dt class="text-[var(--color-fg-subtle)]">Available</dt>
          <dd class="text-[var(--color-fg)] tabular-nums">
            {toolCount.toString().padStart(2, '0')}
          </dd>
        </div>
        <div class="flex items-baseline gap-2">
          <dt class="text-[var(--color-fg-subtle)]">Runtime</dt>
          <dd class="text-[var(--color-accent)]">client-side</dd>
        </div>
      </dl>
    </header>

    {
      toolSections.map((section) => (
        <section class:list={['mt-8', { 'mt-10': section.label }]}>
          {section.label && (
            <h2 class="mb-4 text-xs font-semibold tracking-[0.14em] text-[var(--color-accent)] uppercase">
              {section.label}
            </h2>
          )}
          <ul class="grid gap-4 sm:grid-cols-2 sm:gap-5">
            {section.tools.map((tool) => {
              const Icon = ICONS[tool.icon];
              const viewerHref = withBase(`/tools/view/${toolSlug(tool.href)}/`);
              return (
                <li>
                  <a
                    href={viewerHref}
                    class="group flex h-full flex-col gap-3 rounded-xs border border-[var(--color-border)] bg-[var(--color-surface)] p-5 transition-all duration-200 hover:border-[var(--color-accent)] hover:bg-[var(--color-surface-2)]"
                  >
                    <div class="flex items-start justify-between gap-3">
                      <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xs border border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-accent)] transition-colors group-hover:border-[var(--color-accent)]">
                        <Icon class="h-4 w-4" />
                      </div>
                      <ExternalLink class="h-4 w-4 shrink-0 text-[var(--color-fg-subtle)] opacity-0 transition-opacity group-hover:opacity-100" />
                    </div>

                    <div class="flex flex-1 flex-col gap-1.5">
                      <h3 class="text-sm font-semibold tracking-wide text-[var(--color-fg)] group-hover:text-[var(--color-accent)]">
                        {tool.name}
                      </h3>
                      <p class="text-xs leading-relaxed text-[var(--color-fg-muted)]">
                        {tool.description}
                      </p>
                    </div>

                    <div class="mt-auto flex flex-wrap gap-1.5 pt-2">
                      {tool.tags.map((tag) => (
                        <span class="rounded-xs bg-[var(--color-bg)] px-1.5 py-0.5 text-[0.65rem] tracking-wider text-[var(--color-fg-subtle)] uppercase">
                          {tag}
                        </span>
                      ))}
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </Container>
</BaseLayout>
