---
/**
 * Nút "Thêm vào màn hình chính" cho khu /be-yeu-dotro/ (spec 009).
 *
 * - Android/Chrome (có `beforeinstallprompt`, bắt sớm trong <head> của
 *   PregnancyLayout): bấm là bật hộp thoại cài thật của trình duyệt.
 * - iOS (Safari/Chrome trên iPhone): Apple không cho trang tự bật hộp thoại
 *   → bấm mở bảng hướng dẫn 3 bước "Chia sẻ → Thêm vào MH chính".
 * - Android chưa có sự kiện (Chrome chưa coi là cài được, trình duyệt khác):
 *   hướng dẫn qua menu ⋮.
 * - Trình duyệt trong app (Zalo, Facebook, Messenger…): không thêm được →
 *   hướng dẫn mở bằng Safari/Chrome trước.
 * - Đang mở từ màn hình chính (standalone): ẩn hết.
 *
 * `variant="card"` (trang Hôm nay) đóng được "để sau" 14 ngày; `variant=
 * "settings"` (trang Cài đặt) luôn hiện để cài lại khi cần.
 */
interface Props {
  variant: 'card' | 'settings';
}

const { variant } = Astro.props;
---

<section
  class:list={['by-install', { 'by-card': variant === 'card' }]}
  data-by-install
  data-variant={variant}
  aria-label="Thêm vào màn hình chính"
  hidden
>
  <div class="by-install-row">
    <span class="by-install-icon" aria-hidden="true">📲</span>
    <div class="by-install-text">
      <p class="by-install-title">Thêm "Bé yêu" vào màn hình chính</p>
      <p class="by-muted by-install-sub" data-by-install-sub>
        Mở như một app riêng, một chạm là vào, không cần gõ địa chỉ.
      </p>
    </div>
  </div>
  <div class="by-install-actions">
    <button class="by-button by-install-btn" type="button" data-by-install-go>
      Thêm vào màn hình chính
    </button>
    {
      variant === 'card' && (
        <button class="by-ghost-button" type="button" data-by-install-later>
          Để sau
        </button>
      )
    }
  </div>
</section>

<dialog
  class="by-install-dialog"
  data-by-install-dialog
  aria-labelledby="by-install-dialog-title"
>
  <div class="by-install-dialog-head">
    <h2 id="by-install-dialog-title" class="by-subtitle" data-by-dialog-title>
      Thêm vào màn hình chính
    </h2>
    <button
      class="by-icon-button"
      type="button"
      data-by-dialog-close
      aria-label="Đóng hướng dẫn"
    >
      ✕
    </button>
  </div>

  <ol class="by-install-steps" data-by-steps="ios" hidden>
    <li>
      Bấm nút <strong>Chia sẻ</strong>
      <svg class="by-share-icon" viewBox="0 0 24 24" aria-hidden="true"
        ><path
          d="M12 3v12M7.5 7.5 12 3l4.5 4.5M5 11v8a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-8"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path></svg
      >
      — ở thanh dưới cùng của Safari (Chrome trên iPhone: góc trên bên phải thanh
      địa chỉ).
    </li>
    <li>
      Kéo xuống, chọn <strong>Thêm vào MH chính</strong> (Add to Home Screen).
    </li>
    <li>Giữ tên <strong>Bé yêu</strong>, bấm <strong>Thêm</strong>.</li>
    <li class="by-muted">
      Lần đầu mở từ màn hình chính sẽ cần đăng nhập lại một lần — iPhone tách
      riêng dữ liệu của app này với Safari.
    </li>
  </ol>

  <ol class="by-install-steps" data-by-steps="android" hidden>
    <li>Bấm nút menu <strong>⋮</strong> ở góc trên bên phải của Chrome.</li>
    <li>
      Chọn <strong>Thêm vào màn hình chính</strong> (hoặc
      <strong>Cài đặt ứng dụng</strong>).
    </li>
    <li>Giữ tên <strong>Bé yêu</strong>, bấm <strong>Thêm</strong>.</li>
  </ol>

  <ol class="by-install-steps" data-by-steps="inapp" hidden>
    <li>
      Trang đang mở bên trong một app khác (Zalo, Facebook…) nên không thêm được
      vào màn hình chính.
    </li>
    <li>
      Bấm menu của app đó, chọn <strong>Mở bằng trình duyệt</strong> (Safari hoặc
      Chrome).
    </li>
    <li>
      Ở trình duyệt, bấm lại nút "Thêm vào màn hình chính" trên trang này.
    </li>
  </ol>

  <ol class="by-install-steps" data-by-steps="desktop" hidden>
    <li>
      Mở trang này bằng điện thoại (Safari trên iPhone, Chrome trên Android).
    </li>
    <li>Bấm nút "Thêm vào màn hình chính" ở trang Hôm nay hoặc Cài đặt.</li>
  </ol>

  <button class="by-button" type="button" data-by-dialog-ok>Đã hiểu</button>
</dialog>

<script>
  /** Sự kiện cài của Chromium — không có trong lib.dom chuẩn. */
  interface InstallPromptEvent extends Event {
    prompt(): Promise<void>;
    userChoice: Promise<{ outcome: 'accepted' | 'dismissed' }>;
  }

  declare global {
    interface Window {
      __byInstallEvent?: InstallPromptEvent;
    }
    interface Navigator {
      /** iOS Safari: true khi mở từ màn hình chính. */
      standalone?: boolean;
    }
  }

  type Platform = 'ios' | 'android' | 'inapp' | 'desktop';

  const DISMISS_KEY = 'by-install-dismissed-at';
  const DISMISS_MS = 14 * 24 * 60 * 60 * 1000;

  const ua = navigator.userAgent;
  const isAndroid = /Android/i.test(ua);
  // iPadOS 13+ tự nhận là Mac → nhận qua cảm ứng; kiểm Android TRƯỚC để
  // máy giả lập / trình duyệt lạ có UA Android không bị coi là iPad.
  const isIos =
    /iPad|iPhone|iPod/.test(ua) ||
    (!isAndroid &&
      navigator.platform === 'MacIntel' &&
      navigator.maxTouchPoints > 1);
  const isInApp = /FBAN|FBAV|FB_IAB|Instagram|Zalo|Line\/|Messenger/i.test(ua);
  const platform: Platform = isInApp
    ? 'inapp'
    : isIos
      ? 'ios'
      : isAndroid
        ? 'android'
        : 'desktop';

  function isStandalone(): boolean {
    return (
      window.matchMedia('(display-mode: standalone)').matches ||
      navigator.standalone === true
    );
  }

  function dismissedRecently(): boolean {
    try {
      const at = Number(localStorage.getItem(DISMISS_KEY));
      return Number.isFinite(at) && at > 0 && Date.now() - at < DISMISS_MS;
    } catch {
      return false;
    }
  }

  const dialog = document.querySelector<HTMLDialogElement>(
    '[data-by-install-dialog]'
  );
  const sections = Array.from(
    document.querySelectorAll<HTMLElement>('[data-by-install]')
  );

  function openSteps(kind: Platform): void {
    if (!dialog) return;
    for (const list of dialog.querySelectorAll<HTMLElement>(
      '[data-by-steps]'
    )) {
      list.hidden = list.dataset.bySteps !== kind;
    }
    dialog.showModal();
  }

  dialog
    ?.querySelector('[data-by-dialog-close]')
    ?.addEventListener('click', () => dialog.close());
  dialog
    ?.querySelector('[data-by-dialog-ok]')
    ?.addEventListener('click', () => dialog.close());
  // Bấm ra vùng tối ngoài hộp thoại cũng đóng.
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  /** Có nên hiện khối cài ở trang này không. */
  function shouldShow(section: HTMLElement): boolean {
    if (isStandalone()) return false;
    const isCard = section.dataset.variant === 'card';
    if (isCard && dismissedRecently()) return false;
    // Desktop chỉ hiện thẻ khi trình duyệt thực sự cài được; trang Cài đặt
    // thì luôn hiện (kèm hướng dẫn mở trên điện thoại).
    if (platform === 'desktop' && isCard && !window.__byInstallEvent) {
      return false;
    }
    return true;
  }

  function refresh(): void {
    for (const section of sections) section.hidden = !shouldShow(section);
  }

  for (const section of sections) {
    const go = section.querySelector<HTMLButtonElement>('[data-by-install-go]');
    const later = section.querySelector<HTMLButtonElement>(
      '[data-by-install-later]'
    );
    go?.addEventListener('click', () => {
      const event = window.__byInstallEvent;
      if (event) {
        void event.prompt().then(() =>
          event.userChoice.then(({ outcome }) => {
            // Sự kiện chỉ dùng được một lần.
            window.__byInstallEvent = undefined;
            if (outcome === 'accepted') {
              for (const s of sections) s.hidden = true;
            }
          })
        );
        return;
      }
      openSteps(platform);
    });
    later?.addEventListener('click', () => {
      try {
        localStorage.setItem(DISMISS_KEY, String(Date.now()));
      } catch {
        // Không nhớ được thì lần sau lại hiện — vô hại.
      }
      section.hidden = true;
    });
  }

  document.addEventListener('by:installable', refresh);
  window.addEventListener('appinstalled', () => {
    window.__byInstallEvent = undefined;
    for (const section of sections) section.hidden = true;
  });
  refresh();
</script>

<style is:global>
  /* is:global: <dialog> render vào top layer; prefix .by-install-*. */
  .by-install {
    margin-top: 1rem;
  }

  .by-install-row {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .by-install-icon {
    flex: none;
    font-size: 1.8rem;
    line-height: 1;
  }

  .by-install-title {
    font-weight: 700;
    color: var(--by-green-deep);
  }

  .by-install-sub {
    margin-top: 0.15rem;
    font-size: 0.9rem;
  }

  .by-install-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin-top: 0.75rem;
  }

  .by-install-actions .by-button {
    flex: 1 1 12rem;
    width: auto;
    margin-top: 0;
  }

  .by-install-dialog {
    width: min(26rem, calc(100vw - 2rem));
    margin: auto;
    padding: 1.25rem 1.25rem calc(1.25rem + env(safe-area-inset-bottom));
    border: 2px solid var(--by-border);
    border-radius: var(--by-radius);
    background: var(--by-card);
    color: var(--by-fg);
    font-family: var(--by-font);
  }

  .by-install-dialog::backdrop {
    background: rgb(34 66 58 / 0.45);
  }

  .by-install-dialog-head {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: center;
  }

  .by-install-steps {
    margin-top: 0.75rem;
    padding-left: 1.3rem;
    list-style: decimal;
    display: grid;
    gap: 0.6rem;
    line-height: 1.55;
  }

  .by-share-icon {
    display: inline-block;
    width: 1.15em;
    height: 1.15em;
    vertical-align: -0.2em;
    color: #0a84ff;
  }
</style>
