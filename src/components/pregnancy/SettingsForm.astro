---
/**
 * Form cài đặt thai kỳ (spec 009, AC-4 / AC-6 / AC-7): ba cách nhập ngày dự
 * sinh, tên bé, ngày bé chào đời, chiều cao + cân nặng trước mang thai (để
 * tính BMI cho khuyến nghị tăng cân — AC-15). Dùng ở hai nơi: onboarding
 * trên trang Hôm nay (chưa có settings) và trang Cài đặt (sửa).
 *
 * Validate + suy ngày dự sinh nằm trong `~/lib/pregnancy` (thuần); script
 * ở đây chỉ nối DOM với logic và ghi qua `saveSettings`.
 */
import { ONBOARDING_DEFAULTS } from '~/lib/pregnancy';

interface Props {
  /** `onboarding` giấu ô "ngày bé chào đời" và không prefill; `edit` đủ hết. */
  mode: 'onboarding' | 'edit';
}

const { mode } = Astro.props;
const isEdit = mode === 'edit';

const METHODS = [
  {
    id: 'edd',
    label: 'Ngày dự sinh bác sĩ cho',
    hint: 'Cách chắc nhất — lấy từ phiếu siêu âm gần nhất.',
  },
  {
    id: 'lmp',
    label: 'Ngày đầu kỳ kinh cuối',
    hint: 'Tính theo Naegele: cộng 280 ngày (40 tuần).',
  },
  {
    id: 'scan',
    label: 'Tuổi thai lúc siêu âm',
    hint: 'Bác sĩ ghi "thai X tuần Y ngày" vào ngày đi siêu âm.',
  },
  {
    id: 'test',
    label: 'Ngày que lên hai vạch / ngày trễ kinh',
    hint: 'Chưa nhớ kỳ kinh? Lúc này bé đã khoảng 4 tuần — ước lượng thô, siêu âm lần đầu sẽ chốt lại.',
  },
] as const;
---

<form
  class="by-settings"
  data-by-settings-form
  data-by-prefill={isEdit ? '1' : '0'}
  data-by-default-method={isEdit ? undefined : ONBOARDING_DEFAULTS.method}
  data-by-default-date={isEdit ? undefined : ONBOARDING_DEFAULTS.date}
  novalidate
>
  <fieldset class="by-settings-fieldset">
    <legend class="by-label">Tính ngày dự sinh bằng</legend>
    <div class="by-settings-methods" role="radiogroup" aria-label="Cách tính">
      {
        METHODS.map((method, index) => (
          <label class="by-settings-method">
            <input
              type="radio"
              name="method"
              value={method.id}
              checked={index === 0}
            />
            <span>
              <span class="by-settings-method-label">{method.label}</span>
              <span class="by-settings-method-hint">{method.hint}</span>
            </span>
          </label>
        ))
      }
    </div>

    <div data-by-method-panel="edd">
      <label class="by-label" for={`by-s-${mode}-due`}>Ngày dự sinh</label>
      <input
        id={`by-s-${mode}-due`}
        class="by-input"
        type="date"
        name="dueDate"
      />
    </div>

    <div data-by-method-panel="lmp" hidden>
      <label class="by-label" for={`by-s-${mode}-lmp`}>
        Ngày đầu của kỳ kinh cuối
      </label>
      <input
        id={`by-s-${mode}-lmp`}
        class="by-input"
        type="date"
        name="lmpDate"
      />
    </div>

    <div data-by-method-panel="scan" hidden>
      <label class="by-label" for={`by-s-${mode}-scan`}>Ngày đi siêu âm</label>
      <input
        id={`by-s-${mode}-scan`}
        class="by-input"
        type="date"
        name="scanDate"
      />
      <div class="by-settings-row">
        <div>
          <label class="by-label" for={`by-s-${mode}-weeks`}>Tuần</label>
          <input
            id={`by-s-${mode}-weeks`}
            class="by-input"
            type="number"
            name="scanWeeks"
            inputmode="numeric"
            min="0"
            max="42"
            step="1"
          />
        </div>
        <div>
          <label class="by-label" for={`by-s-${mode}-days`}>Ngày lẻ</label>
          <input
            id={`by-s-${mode}-days`}
            class="by-input"
            type="number"
            name="scanDays"
            inputmode="numeric"
            min="0"
            max="6"
            step="1"
            placeholder="0"
          />
        </div>
      </div>
    </div>

    <div data-by-method-panel="test" hidden>
      <label class="by-label" for={`by-s-${mode}-test`}>
        Ngày que lên hai vạch (hoặc ngày lẽ ra có kinh)
      </label>
      <input
        id={`by-s-${mode}-test`}
        class="by-input"
        type="date"
        name="testDate"
      />
      <p class="by-settings-hint by-muted">
        Tuổi thai tính từ ngày đầu kỳ kinh cuối, nên tuần 1–2 là lúc chưa có bé
        và lúc que hai vạch bé đã ~4 tuần. Đây là ước lượng với chu kỳ 28 ngày;
        đi siêu âm lần đầu rồi sửa lại cho chuẩn.
      </p>
    </div>

    <!-- Xem trước ngày dự sinh + tuần hiện tại, cập nhật khi gõ -->
    <p class="by-settings-preview" data-by-settings-preview aria-live="polite">
    </p>
  </fieldset>

  <label class="by-label" for={`by-s-${mode}-name`}>
    Tên gọi của bé <span class="by-muted">(tuỳ chọn)</span>
  </label>
  <input
    id={`by-s-${mode}-name`}
    class="by-input"
    type="text"
    name="babyName"
    maxlength="40"
    autocomplete="off"
    placeholder="Bơ, Bắp, Sóc…"
  />

  <div class="by-settings-row">
    <div>
      <label class="by-label" for={`by-s-${mode}-height`}>
        Chiều cao mẹ (cm)
      </label>
      <input
        id={`by-s-${mode}-height`}
        class="by-input"
        type="number"
        name="heightCm"
        inputmode="decimal"
        min="120"
        max="220"
        step="0.1"
      />
    </div>
    <div>
      <label class="by-label" for={`by-s-${mode}-weight`}>
        Cân nặng trước mang thai (kg)
      </label>
      <input
        id={`by-s-${mode}-weight`}
        class="by-input"
        type="number"
        name="preWeightKg"
        inputmode="decimal"
        min="30"
        max="200"
        step="0.1"
      />
    </div>
  </div>
  <p class="by-settings-hint by-muted">
    Hai ô trên không bắt buộc — có thì mục Cân nặng trong Nhật ký so được với
    khuyến nghị tăng cân theo BMI.
  </p>

  {
    isEdit && (
      <>
        <label class="by-label" for="by-s-edit-birth">
          Ngày bé chào đời <span class="by-muted">(khi bé đã ra đời)</span>
        </label>
        <input
          id="by-s-edit-birth"
          class="by-input"
          type="date"
          name="birthDate"
        />
        <p class="by-settings-hint by-muted">
          Điền xong, trang Hôm nay chuyển sang đếm tuổi bé và cẩm nang sơ sinh
          lên đầu. Xóa trống để quay lại chế độ thai kỳ.
        </p>
      </>
    )
  }

  <p class="by-error" data-by-settings-error aria-live="polite"></p>
  <button class="by-button" type="submit" disabled>
    {isEdit ? 'Lưu thay đổi' : 'Bắt đầu hành trình 🌱'}
  </button>
  <p
    class="by-settings-status by-muted"
    data-by-settings-status
    aria-live="polite"
  >
  </p>
</form>

<script>
  import { todayKeyVN } from '~/lib/love-board';
  import { firebaseErrorCode } from '~/lib/love-firebase';
  import {
    formatDateVN,
    formatGa,
    gestationalAge,
    validateSettingsInput,
    type DueDateMethod,
    type PregnancySettings,
    type SettingsInput,
  } from '~/lib/pregnancy';
  import {
    awaitWrite,
    onSettings,
    pregnancyWriteErrorMessage,
    QUEUED_MESSAGE,
    saveSettings,
    whileSignedIn,
    type SessionContext,
  } from '~/lib/pregnancy-session';
  import { withBusy } from '~/lib/pregnancy-ui';

  for (const form of document.querySelectorAll<HTMLFormElement>(
    '[data-by-settings-form]'
  )) {
    wireSettingsForm(form);
  }

  function wireSettingsForm(form: HTMLFormElement): void {
    const field = (name: string): HTMLInputElement | null =>
      form.querySelector<HTMLInputElement>(`[name="${name}"]`);
    const must = <T extends HTMLElement>(selector: string): T => {
      const node = form.querySelector<T>(selector);
      if (!node) throw new Error(`be-yeu settings: thiếu ${selector}`);
      return node;
    };

    const radios = Array.from(
      form.querySelectorAll<HTMLInputElement>('input[name="method"]')
    );
    const panels = Array.from(
      form.querySelectorAll<HTMLElement>('[data-by-method-panel]')
    );
    const preview = must<HTMLParagraphElement>('[data-by-settings-preview]');
    const error = must<HTMLParagraphElement>('[data-by-settings-error]');
    const status = must<HTMLParagraphElement>('[data-by-settings-status]');
    const submit = must<HTMLButtonElement>('button[type="submit"]');

    let ctx: SessionContext | null = null;
    let prefilled = false;

    function currentMethod(): DueDateMethod {
      const picked = radios.find((radio) => radio.checked)?.value;
      return picked === 'lmp' || picked === 'scan' || picked === 'test'
        ? picked
        : 'edd';
    }

    function readInput(): SettingsInput {
      return {
        method: currentMethod(),
        dueDate: field('dueDate')?.value ?? '',
        lmpDate: field('lmpDate')?.value ?? '',
        scanDate: field('scanDate')?.value ?? '',
        scanWeeks: field('scanWeeks')?.value ?? '',
        scanDays: field('scanDays')?.value ?? '',
        testDate: field('testDate')?.value ?? '',
        babyName: field('babyName')?.value ?? '',
        birthDate: field('birthDate')?.value ?? '',
        heightCm: field('heightCm')?.value ?? '',
        preWeightKg: field('preWeightKg')?.value ?? '',
      };
    }

    function syncPanels(): void {
      const method = currentMethod();
      for (const panel of panels) {
        panel.hidden = panel.dataset.byMethodPanel !== method;
      }
    }

    // Xem trước: chỉ hiện khi input đã đủ để suy ra dự sinh; lỗi để dành
    // cho lúc bấm lưu, tránh la người dùng khi họ mới gõ nửa chừng.
    function updatePreview(): void {
      const result = validateSettingsInput(readInput(), todayKeyVN());
      if (!result.ok) {
        preview.textContent = '';
        return;
      }
      const ga = gestationalAge(result.value.dueDate, todayKeyVN());
      preview.textContent = ga
        ? `Dự sinh ${formatDateVN(result.value.dueDate)} · hôm nay ${formatGa(ga)}`
        : '';
    }

    function fill(settings: PregnancySettings): void {
      for (const radio of radios)
        radio.checked = radio.value === settings.method;
      const set = (name: string, value: string | number | undefined) => {
        const input = field(name);
        if (input) input.value = value === undefined ? '' : String(value);
      };
      set('dueDate', settings.dueDate);
      set('lmpDate', settings.lmpDate);
      set('scanDate', settings.scanDate);
      set('scanWeeks', settings.scanWeeks);
      set('scanDays', settings.scanDays);
      set('testDate', settings.testDate);
      set('babyName', settings.babyName);
      set('birthDate', settings.birthDate);
      set('heightCm', settings.heightCm);
      set('preWeightKg', settings.preWeightKg);
    }

    for (const radio of radios) {
      radio.addEventListener('change', () => {
        syncPanels();
        updatePreview();
      });
    }
    form.addEventListener('input', updatePreview);

    // Nút khóa tới khi có phiên — nói rõ lý do thay vì để nút xám vô cớ.
    status.textContent = 'Đang kết nối…';
    whileSignedIn((session) => {
      ctx = session;
      submit.disabled = false;
      if (status.textContent === 'Đang kết nối…') status.textContent = '';
      return () => {
        ctx = null;
        submit.disabled = true;
      };
    });

    // Chế độ sửa: đổ settings hiện có vào form ĐÚNG MỘT LẦN — snapshot sau
    // đó (người kia lưu) không được đè chữ đang gõ.
    if (form.dataset.byPrefill === '1') {
      onSettings((settings) => {
        if (!settings || prefilled) return;
        prefilled = true;
        fill(settings);
        syncPanels();
        updatePreview();
      });
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      void save();
    });

    async function save(): Promise<void> {
      error.textContent = '';
      status.textContent = '';
      if (!ctx) {
        error.textContent = 'Chưa có phiên hợp lệ — đăng nhập lại nhé.';
        return;
      }
      const result = validateSettingsInput(readInput(), todayKeyVN());
      if (!result.ok) {
        error.textContent = result.error;
        return;
      }
      const session = ctx;
      try {
        const outcome = await withBusy(submit, 'Đang lưu…', () =>
          awaitWrite(saveSettings(session, result.value), (message) => {
            status.textContent = '';
            error.textContent = message;
          })
        );
        status.textContent =
          outcome === 'queued' ? QUEUED_MESSAGE : 'Đã lưu 🌱';
      } catch (err) {
        error.textContent = pregnancyWriteErrorMessage(firebaseErrorCode(err));
      }
    }

    // Onboarding: điền sẵn mặc định của nhà mình để chỉ việc bấm lưu.
    const defaultMethod = form.dataset.byDefaultMethod;
    const defaultDate = form.dataset.byDefaultDate;
    if (defaultMethod && defaultDate) {
      for (const radio of radios) radio.checked = radio.value === defaultMethod;
      const target = field(
        defaultMethod === 'lmp'
          ? 'lmpDate'
          : defaultMethod === 'scan'
            ? 'scanDate'
            : defaultMethod === 'test'
              ? 'testDate'
              : 'dueDate'
      );
      if (target && !target.value) target.value = defaultDate;
    }

    syncPanels();
    updatePreview();
  }
</script>

<style>
  /* Reset fieldset để không tràn ngang ở 375px (min-inline-size mặc định
     là min-content) — cùng bài học với composer của love board. */
  .by-settings-fieldset {
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .by-settings-methods {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .by-settings-method {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    min-height: 44px;
    padding: 0.75rem 1rem;
    border: 2px solid var(--by-border);
    border-radius: 14px;
    background: var(--by-card);
    cursor: pointer;
  }

  .by-settings-method:has(input:checked) {
    border-color: var(--by-green);
    background: var(--by-green-soft);
  }

  .by-settings-method input {
    margin-top: 0.2rem;
    accent-color: var(--by-green-deep);
  }

  .by-settings-method-label {
    display: block;
    font-weight: 700;
  }

  .by-settings-method-hint {
    display: block;
    font-size: 0.85rem;
    color: var(--by-fg-muted);
  }

  .by-settings-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .by-settings-preview {
    min-height: 1.25rem;
    margin-top: 0.75rem;
    font-weight: 700;
    color: var(--by-green-deep);
  }

  .by-settings-hint {
    margin-top: 0.5rem;
    font-size: 0.85rem;
  }

  .by-settings-status {
    min-height: 1.25rem;
    margin-top: 0.5rem;
    text-align: center;
    font-weight: 600;
  }
</style>
