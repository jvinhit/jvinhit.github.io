---
/**
 * Khối cảnh báo "đi khám ngay nếu…" (spec 009, AC-13): nhận biết bằng icon
 * + tiêu đề chữ + viền, KHÔNG chỉ bằng màu. Luôn kèm câu hành động ở cuối
 * để người đọc biết phải làm gì, không chỉ biết sợ.
 */
interface Props {
  title?: string;
  /** `danger` cho dấu hiệu nguy hiểm, `info` cho lưu ý thường. */
  tone?: 'danger' | 'info';
  /** Câu hành động dưới danh sách; '' để bỏ. */
  action?: string;
}

const {
  title = 'Đi khám ngay nếu',
  tone = 'danger',
  action = 'Gặp một trong các dấu hiệu trên: gọi bác sĩ hoặc đến bệnh viện ngay, đừng chờ tới lịch hẹn.',
} = Astro.props;
---

<section
  class:list={['by-alert', { 'by-alert-danger': tone === 'danger' }]}
  aria-label={title}
>
  <h2 class="by-alert-title">
    <span aria-hidden="true">{tone === 'danger' ? '🚨' : '💡'}</span>
    {title}
  </h2>
  <slot />
  {action && <p class="by-alert-action">{action}</p>}
</section>

<style>
  .by-alert {
    margin-top: 0.75rem;
    padding: 1rem 1.25rem;
    border: 2px solid var(--by-border-strong);
    border-radius: var(--by-radius);
    background: var(--by-card);
  }

  .by-alert-danger {
    border-color: var(--by-danger);
    background: var(--by-danger-soft);
  }

  .by-alert-title {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .by-alert-danger .by-alert-title {
    color: var(--by-danger);
  }

  .by-alert-action {
    margin-top: 0.75rem;
    font-weight: 700;
  }

  .by-alert-danger .by-alert-action {
    color: var(--by-danger);
  }
</style>
