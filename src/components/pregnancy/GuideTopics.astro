---
/**
 * Render một danh sách GuideTopic (cẩm nang mẹ bầu / sơ sinh — spec 009):
 * mục lục nhảy nhanh + từng chủ đề với các khối gạch đầu dòng, khối "đi
 * khám ngay nếu" bằng AlertBox. Thuần render, không script.
 */
import AlertBox from '~/components/pregnancy/AlertBox.astro';
import type { GuideTopic } from '~/lib/pregnancy-care';

interface Props {
  topics: readonly GuideTopic[];
  /** Tiêu đề khối cảnh báo; mặc định "Đi khám ngay nếu". */
  warningTitle?: string;
  /** Câu hành động dưới khối cảnh báo. */
  warningAction?: string;
}

const { topics, warningTitle, warningAction } = Astro.props;
---

<nav class="by-guide-toc mt-4" aria-label="Mục lục">
  {
    topics.map((topic) => (
      <a class="by-chip" href={`#${topic.id}`}>
        <span aria-hidden="true">{topic.emoji}</span> {topic.title}
      </a>
    ))
  }
</nav>

{
  topics.map((topic) => (
    <section
      class="by-guide-topic mt-6"
      id={topic.id}
      aria-labelledby={`${topic.id}-h`}
    >
      <h2 id={`${topic.id}-h`} class="by-subtitle">
        <span aria-hidden="true">{topic.emoji}</span> {topic.title}
      </h2>
      <p class="by-muted mt-1">{topic.intro}</p>
      {topic.blocks.map((block) => (
        <div class="by-card by-guide-block mt-3">
          <h3 class="by-guide-block-title">{block.title}</h3>
          <ul class="by-guide-list">
            {block.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
      {topic.warning && (
        <AlertBox title={warningTitle} action={warningAction}>
          <ul class="by-guide-list">
            {topic.warning.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </AlertBox>
      )}
    </section>
  ))
}

<style>
  .by-guide-toc {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* .by-chip khai is:global ở trang nhật ký; khai lại tối thiểu ở đây để
     cẩm nang không phụ thuộc trang khác có được bundle hay không. */
  .by-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 40px;
    padding: 0.4rem 0.9rem;
    border: 2px solid var(--by-border);
    border-radius: 999px;
    background: var(--by-card);
    color: var(--by-green-deep);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .by-chip:hover {
    border-color: var(--by-green);
    background: var(--by-green-soft);
  }

  .by-guide-topic {
    scroll-margin-top: 1rem;
  }

  .by-guide-block {
    padding: 1rem 1.1rem;
  }

  .by-guide-block-title {
    font-weight: 700;
    color: var(--by-green-deep);
  }

  .by-guide-list {
    margin-top: 0.5rem;
    padding-left: 1.2rem;
    list-style: disc;
    display: grid;
    gap: 0.4rem;
    line-height: 1.55;
  }
</style>
