---
/**
 * LessonProgress — a small progress bar that reflects how many <LessonCheck>
 * boxes on the page are ticked. The counting/updating logic lives in
 * LessonCheck.astro's hoisted script (it targets `[data-eng-progress]`), so this
 * component is purely presentational. Place it once near the top of a lesson.
 */
---

<div class="eng-progress" data-eng-progress>
  <div class="eng-progress__head">
    <span class="eng-progress__label">Progress <span class="eng-progress__vi">{'{Tiến độ}'}</span></span>
    <span class="eng-progress__count" data-eng-progress-count>0 / 0</span>
  </div>
  <div class="eng-progress__track">
    <div class="eng-progress__bar" data-eng-progress-bar></div>
  </div>
</div>

<style>
  .eng-progress {
    margin: 1rem 0 1.25rem;
    padding: 0.75rem 0.85rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .eng-progress__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }
  .eng-progress__label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
  }
  .eng-progress__vi {
    color: var(--color-fg-subtle);
    text-transform: none;
    letter-spacing: 0;
  }
  .eng-progress__count {
    font-size: 0.85rem;
    color: var(--color-fg-muted);
  }
  .eng-progress__track {
    height: 8px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    overflow: hidden;
  }
  .eng-progress__bar {
    height: 100%;
    width: 0;
    background: var(--color-accent);
    border-radius: 999px;
    transition: width 0.25s ease;
  }
</style>
