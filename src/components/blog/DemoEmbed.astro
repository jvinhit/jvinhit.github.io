---
import { withBase } from '~/lib/site-config';

interface Props {
  slug: string;
  title: string;
  height?: string;
}

const { slug, title, height = '760px' } = Astro.props;
const href = withBase(`/tools/${slug}`);
---

<figure class="demo-embed not-prose" style={`--demo-height:${height}`}>
  <iframe
    src={href}
    title={title}
    loading="lazy"
    allow="fullscreen"
    allowfullscreen></iframe>
  <figcaption>
    <a href={href} target="_blank" rel="noopener noreferrer">
      Mở demo toàn màn hình <span aria-hidden="true">↗</span>
    </a>
  </figcaption>
</figure>

<style>
  .demo-embed {
    margin-block: 1.5rem 2rem;
  }

  iframe {
    display: block;
    width: 100%;
    height: var(--demo-height);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: #0a0a0a;
  }

  figcaption {
    margin-top: 0.6rem;
    text-align: right;
  }

  a {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  a:hover {
    color: var(--color-accent-hover);
  }

  @media (max-width: 640px) {
    iframe {
      height: min(var(--demo-height), 84vh);
      min-height: 34rem;
    }
  }
</style>
