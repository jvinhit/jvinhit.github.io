---
/**
 * Theme-aware SVG explainers for the stock investing series.
 * Kept as code so figures stay sharp, searchable, and consistent in dark/light mode.
 */
type StockFigureKind =
  | 'ownership-engine'
  | 'market-pipeline'
  | 'statements-loop'
  | 'valuation-stack'
  | 'portfolio-risk'
  | 'position-sizing'
  | 'cost-drag'
  | 'bubble-lifecycle';

interface Props {
  kind: StockFigureKind;
  caption: string;
}

const { kind, caption } = Astro.props;
const marker = `skf-arrow-${kind}`;
---

<figure class="stock-figure">
  {
    kind === 'ownership-engine' && (
      <svg viewBox="0 0 760 320" role="img" aria-label={caption}>
        <defs>
          <marker
            id={marker}
            markerWidth="10"
            markerHeight="10"
            refX="7.5"
            refY="3.5"
            orient="auto"
          >
            <path d="M0,0 L8,3.5 L0,7 Z" class="arrow" />
          </marker>
        </defs>
        <rect class="panel" x="24" y="34" width="208" height="252" rx="8" />
        <text class="label" x="128" y="68" text-anchor="middle">
          YOU OWN A SLICE
        </text>
        <circle class="pie" cx="128" cy="158" r="64" />
        <path class="pie-slice" d="M128 158 L128 94 A64 64 0 0 1 183 126 Z" />
        <text class="big" x="128" y="250" text-anchor="middle">
          0.1%
        </text>

        <line
          class="stroke"
          x1="232"
          y1="160"
          x2="310"
          y2="160"
          marker-end={`url(#${marker})`}
        />

        <rect
          class="accent-panel"
          x="312"
          y="34"
          width="180"
          height="252"
          rx="8"
        />
        <text class="label dark" x="402" y="64" text-anchor="middle">
          BUSINESS
        </text>
        <text class="metric dark" x="402" y="114" text-anchor="middle">
          revenue
        </text>
        <text class="metric dark" x="402" y="152" text-anchor="middle">
          cash flow
        </text>
        <text class="metric dark" x="402" y="190" text-anchor="middle">
          debt
        </text>
        <text class="metric dark" x="402" y="228" text-anchor="middle">
          moat
        </text>

        <line
          class="stroke"
          x1="492"
          y1="160"
          x2="570"
          y2="160"
          marker-end={`url(#${marker})`}
        />

        <rect class="panel" x="572" y="34" width="164" height="252" rx="8" />
        <text class="label" x="654" y="68" text-anchor="middle">
          OWNER RETURN
        </text>
        <path
          class="line green"
          d="M600 226 C624 208 628 178 646 158 S682 134 708 92"
        />
        <text class="metric" x="654" y="256" text-anchor="middle">
          dividends + growth
        </text>
      </svg>
    )
  }

  {
    kind === 'market-pipeline' && (
      <svg viewBox="0 0 760 320" role="img" aria-label={caption}>
        <defs>
          <marker
            id={marker}
            markerWidth="10"
            markerHeight="10"
            refX="7.5"
            refY="3.5"
            orient="auto"
          >
            <path d="M0,0 L8,3.5 L0,7 Z" class="arrow" />
          </marker>
        </defs>
        {[
          ['Investor', 28],
          ['Broker', 198],
          ['Exchange', 368],
          ['Clearing', 538],
        ].map(([text, x]) => (
          <g>
            <rect
              class={text === 'Exchange' ? 'accent-panel' : 'panel'}
              x={x}
              y="86"
              width="142"
              height="78"
              rx="8"
            />
            <text
              class={text === 'Exchange' ? 'label dark' : 'label'}
              x={Number(x) + 71}
              y="122"
              text-anchor="middle"
            >
              {text}
            </text>
            <text
              class={text === 'Exchange' ? 'metric dark' : 'metric'}
              x={Number(x) + 71}
              y="146"
              text-anchor="middle"
            >
              {text === 'Investor'
                ? 'order'
                : text === 'Broker'
                  ? 'route + check'
                  : text === 'Exchange'
                    ? 'match'
                    : 'settle T+n'}
            </text>
          </g>
        ))}
        {[170, 340, 510].map((x) => (
          <line
            class="stroke"
            x1={x}
            y1="125"
            x2={x + 26}
            y2="125"
            marker-end={`url(#${marker})`}
          />
        ))}
        <rect class="subtle" x="86" y="218" width="588" height="54" rx="8" />
        <text class="metric" x="380" y="241" text-anchor="middle">
          You usually buy from another investor, not from the company.
        </text>
        <text class="tiny" x="380" y="261" text-anchor="middle">
          Company gets cash mainly in IPOs and follow-on issuance.
        </text>
      </svg>
    )
  }

  {
    kind === 'statements-loop' && (
      <svg viewBox="0 0 760 320" role="img" aria-label={caption}>
        <defs>
          <marker
            id={marker}
            markerWidth="10"
            markerHeight="10"
            refX="7.5"
            refY="3.5"
            orient="auto"
          >
            <path d="M0,0 L8,3.5 L0,7 Z" class="arrow" />
          </marker>
        </defs>
        <rect class="panel" x="52" y="62" width="190" height="92" rx="8" />
        <text class="label" x="147" y="99" text-anchor="middle">
          INCOME
        </text>
        <text class="metric" x="147" y="126" text-anchor="middle">
          earned this period
        </text>

        <rect
          class="accent-panel"
          x="285"
          y="188"
          width="190"
          height="92"
          rx="8"
        />
        <text class="label dark" x="380" y="225" text-anchor="middle">
          BALANCE SHEET
        </text>
        <text class="metric dark" x="380" y="252" text-anchor="middle">
          owns - owes
        </text>

        <rect class="panel" x="518" y="62" width="190" height="92" rx="8" />
        <text class="label" x="613" y="99" text-anchor="middle">
          CASH FLOW
        </text>
        <text class="metric" x="613" y="126" text-anchor="middle">
          cash truth check
        </text>

        <path
          class="stroke"
          d="M242 112 C300 122 318 166 336 188"
          marker-end={`url(#${marker})`}
        />
        <path
          class="stroke"
          d="M475 233 C554 230 607 184 613 154"
          marker-end={`url(#${marker})`}
        />
        <path
          class="stroke"
          d="M518 90 C416 34 276 42 210 82"
          marker-end={`url(#${marker})`}
        />
        <text class="tiny" x="380" y="45" text-anchor="middle">
          profit is an accounting story; cash is the lie detector
        </text>
      </svg>
    )
  }

  {
    kind === 'valuation-stack' && (
      <svg viewBox="0 0 760 320" role="img" aria-label={caption}>
        <rect class="subtle" x="40" y="36" width="680" height="248" rx="8" />
        {[
          { name: 'Price', note: 'what market asks today', y: 64 },
          {
            name: 'Earnings / Cash flow',
            note: 'what owners may receive',
            y: 116,
          },
          { name: 'Growth', note: 'how fast the engine expands', y: 168 },
          { name: 'Risk', note: 'how uncertain the future is', y: 220 },
        ].map(({ name, note, y }, i) => (
          <g>
            <rect
              class={i === 0 ? 'accent-panel' : 'panel'}
              x={86 + i * 46}
              y={y}
              width={588 - i * 92}
              height="38"
              rx="6"
            />
            <text
              class={i === 0 ? 'metric dark' : 'metric'}
              x="380"
              y={y + 25}
              text-anchor="middle"
            >
              {name} - {note}
            </text>
          </g>
        ))}
        <text class="label" x="380" y="68" text-anchor="middle">
          VALUATION IS A STACK, NOT ONE RATIO
        </text>
      </svg>
    )
  }

  {
    kind === 'portfolio-risk' && (
      <svg viewBox="0 0 760 320" role="img" aria-label={caption}>
        <line class="axis" x1="70" y1="250" x2="700" y2="250" />
        <line class="axis" x1="70" y1="250" x2="70" y2="58" />
        <text class="tiny" x="62" y="54" text-anchor="end">
          risk
        </text>
        <text class="tiny" x="703" y="274" text-anchor="end">
          number of independent bets
        </text>
        <path
          class="line green"
          d="M76 70 C118 92 152 152 206 188 C270 232 398 238 688 238"
        />
        <line class="dash" x1="78" y1="238" x2="692" y2="238" />
        <text class="metric" x="400" y="228" text-anchor="middle">
          market-risk floor
        </text>
        <rect class="panel" x="446" y="72" width="214" height="72" rx="8" />
        <text class="label" x="553" y="101" text-anchor="middle">
          DIVERSIFICATION
        </text>
        <text class="metric" x="553" y="126" text-anchor="middle">
          kills specific risk
        </text>
      </svg>
    )
  }

  {
    kind === 'position-sizing' && (
      <svg viewBox="0 0 760 320" role="img" aria-label={caption}>
        <defs>
          <marker
            id={marker}
            markerWidth="10"
            markerHeight="10"
            refX="7.5"
            refY="3.5"
            orient="auto"
          >
            <path d="M0,0 L8,3.5 L0,7 Z" class="arrow" />
          </marker>
        </defs>
        <rect class="panel" x="34" y="58" width="196" height="92" rx="8" />
        <text class="label" x="132" y="93" text-anchor="middle">
          CAPITAL
        </text>
        <text class="big" x="132" y="126" text-anchor="middle">
          200M
        </text>
        <line
          class="stroke"
          x1="230"
          y1="104"
          x2="298"
          y2="104"
          marker-end={`url(#${marker})`}
        />

        <rect
          class="accent-panel"
          x="300"
          y="58"
          width="160"
          height="92"
          rx="8"
        />
        <text class="label dark" x="380" y="93" text-anchor="middle">
          RISK BUDGET
        </text>
        <text class="big dark" x="380" y="126" text-anchor="middle">
          1% = 2M
        </text>
        <line
          class="stroke"
          x1="460"
          y1="104"
          x2="528"
          y2="104"
          marker-end={`url(#${marker})`}
        />

        <rect class="panel" x="530" y="58" width="196" height="92" rx="8" />
        <text class="label" x="628" y="93" text-anchor="middle">
          STOP DISTANCE
        </text>
        <text class="big" x="628" y="126" text-anchor="middle">
          4,000/share
        </text>

        <rect class="subtle" x="115" y="208" width="530" height="58" rx="8" />
        <text class="metric" x="380" y="232" text-anchor="middle">
          shares = risk budget / risk per share
        </text>
        <text class="big" x="380" y="257" text-anchor="middle">
          2,000,000 / 4,000 = 500 shares
        </text>
      </svg>
    )
  }

  {
    kind === 'cost-drag' && (
      <svg viewBox="0 0 760 320" role="img" aria-label={caption}>
        <line class="axis" x1="70" y1="254" x2="700" y2="254" />
        <line class="axis" x1="70" y1="254" x2="70" y2="52" />
        <path
          class="line green"
          d="M78 238 C180 220 260 190 336 152 C448 96 548 66 690 56"
        />
        <path
          class="line red"
          d="M78 238 C190 226 282 204 362 178 C470 142 566 122 690 112"
        />
        <text class="metric" x="610" y="62">
          low cost
        </text>
        <text class="metric red-text" x="606" y="118">
          high turnover
        </text>
        <path class="dash" d="M690 56 L690 112" />
        <text class="label" x="384" y="292" text-anchor="middle">
          cost drag compounds in reverse
        </text>
      </svg>
    )
  }

  {
    kind === 'bubble-lifecycle' && (
      <svg viewBox="0 0 760 320" role="img" aria-label={caption}>
        <path
          class="line green"
          d="M54 246 C116 236 152 210 196 174 C240 138 286 100 338 82 C402 60 472 70 516 112 C560 154 594 214 708 250"
        />
        <line class="axis" x1="54" y1="254" x2="708" y2="254" />
        {[
          ['displacement', 92, 229],
          ['boom', 220, 168],
          ['euphoria', 390, 74],
          ['profit-taking', 520, 124],
          ['panic', 646, 234],
        ].map(([t, x, y]) => (
          <g>
            <circle class="dot" cx={x} cy={y} r="5" />
            <text class="tiny" x={x} y={Number(y) - 16} text-anchor="middle">
              {t}
            </text>
          </g>
        ))}
        <rect class="subtle" x="176" y="266" width="408" height="34" rx="8" />
        <text class="metric" x="380" y="288" text-anchor="middle">
          the asset changes; crowd psychology repeats
        </text>
      </svg>
    )
  }
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .stock-figure {
    margin: 1.6rem 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg);
    padding: 0.75rem 0.9rem 0.55rem;
  }
  .stock-figure svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .stock-figure figcaption {
    margin-top: 0.45rem;
    color: var(--color-fg-muted);
    font-size: 0.72rem;
    text-align: center;
  }
  .panel,
  .subtle {
    fill: var(--color-surface);
    stroke: var(--color-border);
    stroke-width: 1.2;
  }
  .subtle {
    fill: var(--color-surface-2);
  }
  .accent-panel {
    fill: var(--color-accent);
    stroke: var(--color-accent);
    stroke-width: 1.2;
  }
  .label,
  .metric,
  .tiny,
  .big {
    fill: var(--color-fg);
    font-family: var(--font-mono);
  }
  .label {
    font-size: 14px;
    font-weight: 700;
  }
  .metric {
    font-size: 14px;
  }
  .tiny {
    font-size: 12px;
    fill: var(--color-fg-muted);
  }
  .big {
    font-size: 24px;
    font-weight: 700;
  }
  .dark {
    fill: var(--color-accent-fg);
  }
  .stroke,
  .axis {
    fill: none;
    stroke: var(--color-border-strong);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .axis {
    stroke-width: 1.2;
  }
  .dash {
    fill: none;
    stroke: var(--color-fg-subtle);
    stroke-width: 1.4;
    stroke-dasharray: 6 6;
  }
  .line {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .green {
    stroke: var(--color-accent);
  }
  .red {
    stroke: var(--color-danger);
  }
  .red-text {
    fill: var(--color-danger);
  }
  .arrow,
  .dot,
  .pie-slice {
    fill: var(--color-accent);
  }
  .pie {
    fill: var(--color-surface-2);
    stroke: var(--color-border-strong);
    stroke-width: 2;
  }
</style>
