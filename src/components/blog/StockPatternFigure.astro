---
/**
 * Small static SVG figure for illustrating a stock chart pattern inside MDX.
 * Kept as a component so SVG presentation attributes (stroke-width, etc.) live
 * in `.astro` (plain HTML semantics) rather than MDX/JSX, where hyphenated
 * attribute names are awkward.
 */
interface Props {
  /** Polyline points in the 360×140 viewBox, e.g. "8,118 44,78 …". */
  points: string;
  /** Optional secondary polyline (e.g. a moving-average line), drawn in blue. */
  points2?: string;
  /** Optional dashed horizontal reference line (neckline / support / resistance). */
  neckY?: number;
  /** Caption shown under the figure. */
  caption: string;
}

const { points, points2, neckY, caption } = Astro.props;
---

<figure class="pattern-fig">
  <svg viewBox="0 0 360 140" role="img" aria-label={caption}>
    <line
      x1="8"
      y1="132"
      x2="352"
      y2="132"
      stroke="var(--color-border)"
      stroke-width="1"></line>
    {
      neckY !== undefined && (
        <line
          x1="8"
          y1={neckY}
          x2="352"
          y2={neckY}
          stroke="#60a5fa"
          stroke-width="1.25"
          stroke-dasharray="5 4"
        />
      )
    }
    {
      points2 && (
        <polyline
          points={points2}
          fill="none"
          stroke="#60a5fa"
          stroke-width="1.75"
          stroke-linejoin="round"
          stroke-linecap="round"
        />
      )
    }
    <polyline
      points={points}
      fill="none"
      stroke="var(--color-accent)"
      stroke-width="2"
      stroke-linejoin="round"
      stroke-linecap="round"></polyline>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .pattern-fig {
    margin: 1.5rem 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg);
    padding: 0.75rem 0.9rem 0.5rem;
  }
  .pattern-fig svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .pattern-fig figcaption {
    margin-top: 0.4rem;
    font-size: 0.72rem;
    color: var(--color-fg-muted);
    text-align: center;
    letter-spacing: 0.02em;
  }
</style>
