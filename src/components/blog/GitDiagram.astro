---
/**
 * Theme-aware Git diagrams for the advanced Git articles.
 * Inline SVG keeps labels crisp, accessible and self-hosted.
 */
type DiagramKind =
  | 'workspace-pipeline'
  | 'patch-decision'
  | 'head-refs'
  | 'reset-effects'
  | 'reflog-recovery';

interface Props {
  kind: DiagramKind;
  caption?: string;
}

const { kind, caption } = Astro.props;
const arrowId = `git-arrow-${kind}`;
---

<figure class="git-diagram">
  <div class="mobile-hint" aria-hidden="true">
    ↔ Vuốt ngang để xem toàn bộ sơ đồ
  </div>

  {
    kind === 'workspace-pipeline' && (
      <svg
        viewBox="0 0 720 245"
        role="img"
        aria-label={
          caption ?? 'Luồng dữ liệu từ working tree đến remote trong Git'
        }
      >
        <defs>
          <marker
            id={arrowId}
            markerWidth="9"
            markerHeight="9"
            refX="6.5"
            refY="3"
            orient="auto"
          >
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>

        <text x="360" y="20" text-anchor="middle" class="d-title">
          MỘT THAY ĐỔI ĐI QUA GIT NHƯ THẾ NÀO?
        </text>

        {[
          {
            x: 12,
            title: 'Working tree',
            sub: 'file đang sửa',
            code: 'git diff',
            accent: false,
          },
          {
            x: 194,
            title: 'Index',
            sub: 'nội dung sẽ commit',
            code: 'diff --staged',
            accent: true,
          },
          {
            x: 376,
            title: 'Local history',
            sub: 'commit trong máy',
            code: 'git log',
            accent: false,
          },
          {
            x: 558,
            title: 'Remote',
            sub: 'lịch sử đã chia sẻ',
            code: 'origin/*',
            accent: false,
          },
        ].map((zone) => (
          <g>
            <rect
              class={zone.accent ? 'd-accent' : 'd-box'}
              x={zone.x}
              y="62"
              width="150"
              height="100"
              rx="6"
            />
            <text
              x={zone.x + 75}
              y="91"
              text-anchor="middle"
              class={zone.accent ? 'd-ta' : 'd-t'}
            >
              {zone.title}
            </text>
            <text x={zone.x + 75} y="113" text-anchor="middle" class="d-ts">
              {zone.sub}
            </text>
            <rect
              class="d-chip"
              x={zone.x + 24}
              y="128"
              width="102"
              height="22"
              rx="11"
            />
            <text x={zone.x + 75} y="143" text-anchor="middle" class="d-code">
              {zone.code}
            </text>
          </g>
        ))}

        {[
          { x1: 162, x2: 192, label: 'add -p' },
          { x1: 344, x2: 374, label: 'commit' },
          { x1: 526, x2: 556, label: 'push' },
        ].map((edge) => (
          <g>
            <line
              class="d-stroke"
              x1={edge.x1}
              y1="112"
              x2={edge.x2}
              y2="112"
              marker-end={`url(#${arrowId})`}
            />
            <text
              x={(edge.x1 + edge.x2) / 2}
              y="99"
              text-anchor="middle"
              class="d-ta"
            >
              {edge.label}
            </text>
          </g>
        ))}

        <path
          class="d-soft-stroke"
          d="M 269 166 L 269 202 L 87 202 L 87 164"
          marker-end={`url(#${arrowId})`}
        />
        <text x="178" y="220" text-anchor="middle" class="d-ts">
          restore --staged · giữ code, bỏ stage
        </text>

        <path
          class="d-soft-stroke"
          d="M 633 166 L 633 202 L 451 202 L 451 164"
          marker-end={`url(#${arrowId})`}
        />
        <text x="542" y="220" text-anchor="middle" class="d-ts">
          fetch · cập nhật hiểu biết về remote
        </text>
      </svg>
    )
  }

  {
    kind === 'patch-decision' && (
      <svg
        viewBox="0 0 720 300"
        role="img"
        aria-label={caption ?? 'Bản đồ chọn công cụ patch phù hợp trong Git'}
      >
        <defs>
          <marker
            id={arrowId}
            markerWidth="9"
            markerHeight="9"
            refX="6.5"
            refY="3"
            orient="auto"
          >
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>

        <rect class="d-accent" x="250" y="16" width="220" height="52" rx="6" />
        <text x="360" y="39" text-anchor="middle" class="d-ta">
          Bạn muốn di chuyển gì?
        </text>
        <text x="360" y="56" text-anchor="middle" class="d-ts">
          chọn đơn vị nhỏ nhất đúng với mục tiêu
        </text>

        {[
          {
            x: 10,
            title: 'Một phần file',
            sub: 'chọn từng hunk',
            cmd: 'git add -p',
            note: 'tạo commit sạch',
          },
          {
            x: 188,
            title: 'Nội dung diff',
            sub: 'không cần metadata',
            cmd: 'diff → apply',
            note: 'working tree mới',
          },
          {
            x: 366,
            title: 'Series commit',
            sub: 'giữ author + message',
            cmd: 'format-patch → am',
            note: 'commit đầy đủ',
          },
          {
            x: 544,
            title: 'Commit đã có',
            sub: 'cùng repo / đã fetch',
            cmd: 'cherry-pick -x',
            note: 'backport nhanh',
          },
        ].map((choice, index) => (
          <g>
            <path
              class="d-stroke"
              d={`M 360 68 L 360 92 L ${choice.x + 83} 92 L ${choice.x + 83} 116`}
              marker-end={`url(#${arrowId})`}
            />
            <rect
              class={index === 0 ? 'd-accent' : 'd-box'}
              x={choice.x}
              y="118"
              width="166"
              height="142"
              rx="6"
            />
            <text
              x={choice.x + 83}
              y="147"
              text-anchor="middle"
              class={index === 0 ? 'd-ta' : 'd-t'}
            >
              {choice.title}
            </text>
            <text x={choice.x + 83} y="169" text-anchor="middle" class="d-ts">
              {choice.sub}
            </text>
            <rect
              class="d-chip"
              x={choice.x + 17}
              y="188"
              width="132"
              height="28"
              rx="4"
            />
            <text x={choice.x + 83} y="207" text-anchor="middle" class="d-code">
              {choice.cmd}
            </text>
            <text x={choice.x + 83} y="240" text-anchor="middle" class="d-tm">
              {choice.note}
            </text>
          </g>
        ))}

        <text x="360" y="287" text-anchor="middle" class="d-ts">
          diff/apply chuyển nội dung · format-patch/am chuyển lịch sử
        </text>
      </svg>
    )
  }

  {
    kind === 'head-refs' && (
      <svg
        viewBox="0 0 720 285"
        role="img"
        aria-label={
          caption ?? 'HEAD trỏ qua branch hoặc trỏ trực tiếp tới commit'
        }
      >
        <defs>
          <marker
            id={arrowId}
            markerWidth="9"
            markerHeight="9"
            refX="6.5"
            refY="3"
            orient="auto"
          >
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>

        <text x="175" y="20" text-anchor="middle" class="d-title">
          ATTACHED HEAD
        </text>
        <text x="545" y="20" text-anchor="middle" class="d-title">
          DETACHED HEAD
        </text>

        <rect class="d-panel" x="10" y="34" width="330" height="226" rx="8" />
        <rect class="d-panel" x="380" y="34" width="330" height="226" rx="8" />

        {[56, 128, 200, 272].map((x, index) => (
          <g>
            {index < 3 && (
              <line
                class="d-stroke"
                x1={x + 18}
                y1="148"
                x2={x + 52}
                y2="148"
                marker-end={`url(#${arrowId})`}
              />
            )}
            <circle
              class={index === 3 ? 'd-node-active' : 'd-node'}
              cx={x}
              cy="148"
              r="18"
            />
            <text
              x={x}
              y="153"
              text-anchor="middle"
              class={index === 3 ? 'd-ta' : 'd-t'}
            >
              {String.fromCharCode(65 + index)}
            </text>
          </g>
        ))}

        <rect class="d-accent" x="222" y="52" width="100" height="34" rx="4" />
        <text x="272" y="74" text-anchor="middle" class="d-ta">
          HEAD
        </text>
        <line
          class="d-stroke"
          x1="272"
          y1="86"
          x2="272"
          y2="102"
          marker-end={`url(#${arrowId})`}
        />
        <rect class="d-box" x="222" y="104" width="100" height="30" rx="4" />
        <text x="272" y="124" text-anchor="middle" class="d-t">
          main
        </text>
        <line
          class="d-stroke"
          x1="272"
          y1="134"
          x2="272"
          y2="128"
          marker-end={`url(#${arrowId})`}
        />
        <text x="175" y="222" text-anchor="middle" class="d-ts">
          HEAD → main → commit D
        </text>
        <text x="175" y="240" text-anchor="middle" class="d-tm">
          commit mới sẽ di chuyển main
        </text>

        {[426, 498, 570, 642].map((x, index) => (
          <g>
            {index < 3 && (
              <line
                class="d-stroke"
                x1={x + 18}
                y1="148"
                x2={x + 52}
                y2="148"
                marker-end={`url(#${arrowId})`}
              />
            )}
            <circle
              class={index === 2 ? 'd-node-active' : 'd-node'}
              cx={x}
              cy="148"
              r="18"
            />
            <text
              x={x}
              y="153"
              text-anchor="middle"
              class={index === 2 ? 'd-ta' : 'd-t'}
            >
              {String.fromCharCode(65 + index)}
            </text>
          </g>
        ))}

        <rect class="d-accent" x="520" y="52" width="100" height="34" rx="4" />
        <text x="570" y="74" text-anchor="middle" class="d-ta">
          HEAD
        </text>
        <line
          class="d-stroke"
          x1="570"
          y1="86"
          x2="570"
          y2="128"
          marker-end={`url(#${arrowId})`}
        />
        <rect class="d-box" x="610" y="190" width="64" height="28" rx="4" />
        <text x="642" y="209" text-anchor="middle" class="d-t">
          main
        </text>
        <line
          class="d-soft-stroke"
          x1="642"
          y1="190"
          x2="642"
          y2="168"
          marker-end={`url(#${arrowId})`}
        />
        <text x="545" y="240" text-anchor="middle" class="d-ts">
          HEAD → commit C · main vẫn ở D
        </text>
      </svg>
    )
  }

  {
    kind === 'reset-effects' && (
      <svg
        viewBox="0 0 720 350"
        role="img"
        aria-label={
          caption ?? 'So sánh tác động của reset soft, mixed, hard và revert'
        }
      >
        <text x="360" y="20" text-anchor="middle" class="d-title">
          SAU KHI HOÀN TÁC COMMIT E
        </text>

        <text x="225" y="57" text-anchor="middle" class="d-tm">
          HEAD / branch
        </text>
        <text x="390" y="57" text-anchor="middle" class="d-tm">
          Index
        </text>
        <text x="555" y="57" text-anchor="middle" class="d-tm">
          Working tree
        </text>

        {[
          {
            y: 78,
            mode: '--soft',
            values: ['D', 'E', 'E'],
            affected: [true, false, false],
            note: 'giữ staged',
          },
          {
            y: 140,
            mode: '--mixed',
            values: ['D', 'D', 'E'],
            affected: [true, true, false],
            note: 'giữ file',
          },
          {
            y: 202,
            mode: '--hard',
            values: ['D', 'D', 'D'],
            affected: [true, true, true],
            note: 'xóa tracked changes',
          },
          {
            y: 264,
            mode: 'revert',
            values: ['F', 'F', 'F'],
            affected: [true, true, true],
            note: 'commit mới, giữ history',
          },
        ].map((row) => (
          <g>
            <rect
              class="d-row"
              x="10"
              y={row.y}
              width="700"
              height="52"
              rx="5"
            />
            <text x="78" y={row.y + 23} text-anchor="middle" class="d-code">
              {row.mode}
            </text>
            <text x="78" y={row.y + 40} text-anchor="middle" class="d-ts">
              {row.note}
            </text>
            {row.values.map((value, index) => (
              <g>
                <rect
                  class={row.affected[index] ? 'd-state-active' : 'd-state'}
                  x={175 + index * 165}
                  y={row.y + 10}
                  width="100"
                  height="32"
                  rx="16"
                />
                <text
                  x={225 + index * 165}
                  y={row.y + 31}
                  text-anchor="middle"
                  class={row.affected[index] ? 'd-ta' : 'd-t'}
                >
                  {value}
                </text>
              </g>
            ))}
          </g>
        ))}

        <text x="360" y="337" text-anchor="middle" class="d-ts">
          D = parent · E = commit bị bỏ · F = commit hoàn tác mới
        </text>
      </svg>
    )
  }

  {
    kind === 'reflog-recovery' && (
      <svg
        viewBox="0 0 720 270"
        role="img"
        aria-label={
          caption ?? 'Ba bước phục hồi commit bằng reflog và rescue branch'
        }
      >
        <defs>
          <marker
            id={arrowId}
            markerWidth="9"
            markerHeight="9"
            refX="6.5"
            refY="3"
            orient="auto"
          >
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>

        {[
          {
            x: 10,
            step: '1',
            title: 'Lịch sử bị rewrite',
            cmd: 'main → D′',
            sub: 'commit D biến khỏi log',
          },
          {
            x: 250,
            step: '2',
            title: 'Reflog còn dấu vết',
            cmd: 'HEAD@{6} → D',
            sub: 'show để xác nhận',
          },
          {
            x: 490,
            step: '3',
            title: 'Neo bằng branch',
            cmd: 'rescue → D',
            sub: 'an toàn để kiểm tra',
          },
        ].map((panel, index) => (
          <g>
            <rect
              class={index === 2 ? 'd-accent' : 'd-box'}
              x={panel.x}
              y="54"
              width="220"
              height="150"
              rx="7"
            />
            <circle
              class={index === 2 ? 'd-step-active' : 'd-step'}
              cx={panel.x + 28}
              cy="80"
              r="14"
            />
            <text
              x={panel.x + 28}
              y="85"
              text-anchor="middle"
              class={index === 2 ? 'd-ta' : 'd-t'}
            >
              {panel.step}
            </text>
            <text
              x={panel.x + 110}
              y="112"
              text-anchor="middle"
              class={index === 2 ? 'd-ta' : 'd-t'}
            >
              {panel.title}
            </text>
            <rect
              class="d-chip"
              x={panel.x + 35}
              y="130"
              width="150"
              height="30"
              rx="4"
            />
            <text x={panel.x + 110} y="150" text-anchor="middle" class="d-code">
              {panel.cmd}
            </text>
            <text x={panel.x + 110} y="184" text-anchor="middle" class="d-ts">
              {panel.sub}
            </text>
            {index < 2 && (
              <line
                class="d-stroke"
                x1={panel.x + 220}
                y1="129"
                x2={panel.x + 238}
                y2="129"
                marker-end={`url(#${arrowId})`}
              />
            )}
          </g>
        ))}

        <text x="360" y="28" text-anchor="middle" class="d-title">
          DỪNG → TÌM → NEO COMMIT
        </text>
        <text x="360" y="234" text-anchor="middle" class="d-t">
          git reflog → git show &lt;D&gt; → git switch -c rescue/before-fix
          &lt;D&gt;
        </text>
        <text x="360" y="254" text-anchor="middle" class="d-ts">
          tạo đường lui trước khi reset hoặc rebase lần nữa
        </text>
      </svg>
    )
  }

  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .git-diagram {
    margin: 1.5rem 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg);
    padding: 0.85rem 0.9rem 0.6rem;
  }
  .git-diagram svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .git-diagram figcaption {
    margin-top: 0.5rem;
    color: var(--color-fg-muted);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    text-align: center;
  }
  .mobile-hint {
    display: none;
  }
  .git-diagram :global(text) {
    font-family: var(--font-mono);
  }
  .git-diagram :global(.d-box) {
    fill: var(--color-surface);
    stroke: var(--color-border);
    stroke-width: 1;
  }
  .git-diagram :global(.d-panel),
  .git-diagram :global(.d-row) {
    fill: transparent;
    stroke: var(--color-border);
    stroke-width: 1;
  }
  .git-diagram :global(.d-row) {
    fill: color-mix(in srgb, var(--color-surface) 70%, transparent);
  }
  .git-diagram :global(.d-accent) {
    fill: color-mix(in srgb, var(--color-accent) 12%, transparent);
    stroke: var(--color-accent);
    stroke-width: 1;
  }
  .git-diagram :global(.d-chip) {
    fill: var(--color-surface-2);
    stroke: var(--color-border);
    stroke-width: 1;
  }
  .git-diagram :global(.d-stroke) {
    fill: none;
    stroke: var(--color-border-strong);
    stroke-width: 1.4;
  }
  .git-diagram :global(.d-soft-stroke) {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 1.2;
  }
  .git-diagram :global(.d-arrowhead) {
    fill: var(--color-border-strong);
  }
  .git-diagram :global(.d-node),
  .git-diagram :global(.d-step),
  .git-diagram :global(.d-state) {
    fill: var(--color-surface-2);
    stroke: var(--color-border-strong);
    stroke-width: 1;
  }
  .git-diagram :global(.d-node-active),
  .git-diagram :global(.d-step-active),
  .git-diagram :global(.d-state-active) {
    fill: color-mix(in srgb, var(--color-accent) 14%, var(--color-surface));
    stroke: var(--color-accent);
    stroke-width: 1.2;
  }
  .git-diagram :global(.d-t) {
    fill: var(--color-fg);
    font-size: 13px;
  }
  .git-diagram :global(.d-tm) {
    fill: var(--color-fg-muted);
    font-size: 12px;
  }
  .git-diagram :global(.d-ts) {
    fill: var(--color-fg-subtle);
    font-size: 11px;
  }
  .git-diagram :global(.d-ta) {
    fill: var(--color-accent);
    font-size: 12.5px;
  }
  .git-diagram :global(.d-code) {
    fill: var(--color-fg);
    font-size: 11.5px;
  }
  .git-diagram :global(.d-title) {
    fill: var(--color-fg-muted);
    font-size: 12px;
    letter-spacing: 0.1em;
  }

  @media (max-width: 640px) {
    .git-diagram {
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      -webkit-overflow-scrolling: touch;
    }
    .mobile-hint {
      position: sticky;
      left: 0;
      display: block;
      width: max-content;
      margin-bottom: 0.6rem;
      color: var(--color-fg-subtle);
      font-family: var(--font-mono);
      font-size: 0.7rem;
    }
    .git-diagram svg {
      width: 640px;
      max-width: none;
    }
    .git-diagram figcaption {
      width: 640px;
      max-width: none;
      text-align: left;
    }
  }
</style>
