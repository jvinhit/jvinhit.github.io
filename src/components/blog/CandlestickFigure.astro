---
/**
 * Inline SVG figure rendering one or more candlesticks for MDX posts.
 * Each candle is {o,h,l,c} in 0..1 price space (0 = bottom, 1 = top).
 * Green if close ≥ open, else red. The last `highlight` candles are drawn at
 * full opacity (the pattern); earlier ones are dimmed context.
 */
interface Candle {
  o: number;
  h: number;
  l: number;
  c: number;
}

interface Props {
  candles: Candle[];
  /** How many trailing candles form the actual pattern (full opacity). */
  highlight?: number;
  caption: string;
}

const { candles, highlight = 1, caption } = Astro.props;

const W = 360;
const H = 168;
const PAD = 16;
const n = candles.length;
const slot = (W - 2 * PAD) / n;
// Real candles read best when the body is clearly wider than the wick but
// still leaves a gap to its neighbour, and the wick is a thin centered line.
const bodyW = Math.max(6, Math.min(18, slot * 0.5));
const wickW = bodyW <= 9 ? 1.25 : 1.75;

const Y = (v: number) => H - PAD - v * (H - 2 * PAD);

const GREEN = '#34d399';
const RED = '#ef4444';

const drawn = candles.map((c, i) => {
  // Snap the centre to a half-pixel so a 1–2px wick renders crisp, not blurry.
  const cx = Math.round(PAD + slot * (i + 0.5)) + 0.5;
  const up = c.c >= c.o;
  const color = up ? GREEN : RED;
  const opacity = i >= n - highlight ? 1 : 0.4;
  const top = Y(Math.max(c.o, c.c));
  // Guarantee a visible body even for a doji (open ≈ close).
  const bodyH = Math.max(1.5, Math.abs(Y(c.o) - Y(c.c)));
  return { cx, color, opacity, top, bodyH, wickTop: Y(c.h), wickBottom: Y(c.l) };
});
---

<figure class="pattern-fig">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={caption}>
    <line
      x1={PAD}
      y1={H - PAD}
      x2={W - PAD}
      y2={H - PAD}
      stroke="var(--color-border)"
      stroke-width="1"></line>
    {
      drawn.map((d) => (
        <g opacity={d.opacity}>
          <line
            x1={d.cx}
            y1={d.wickTop}
            x2={d.cx}
            y2={d.wickBottom}
            stroke={d.color}
            stroke-width={wickW}
            stroke-linecap="butt"
          />
          <rect
            x={d.cx - bodyW / 2}
            y={d.top}
            width={bodyW}
            height={d.bodyH}
            fill={d.color}
            rx="1"
          />
        </g>
      ))
    }
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .pattern-fig {
    margin: 1.5rem 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg);
    padding: 0.75rem 0.9rem 0.5rem;
  }
  .pattern-fig svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .pattern-fig figcaption {
    margin-top: 0.4rem;
    font-size: 0.72rem;
    color: var(--color-fg-muted);
    text-align: center;
    letter-spacing: 0.02em;
  }
</style>
