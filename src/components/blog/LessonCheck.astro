---
/**
 * LessonCheck — an inline "done" checkbox for English-lesson examples/drills.
 *
 * Progress is persisted in localStorage keyed by `eng100:<pathname>:<id>`, so
 * each learner's ticks survive reloads on a static page (no backend).
 *
 * Usage in MDX:
 *   <LessonCheck id="svo-1">I called the client. \{Tôi đã gọi cho khách.\}</LessonCheck>
 *
 * The `id` MUST be unique within a single post.
 */
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<label class="lesson-check" data-lesson-check data-id={id}>
  <input type="checkbox" />
  <span class="lesson-check__box" aria-hidden="true"></span>
  <span class="lesson-check__label"><slot /></span>
</label>

<style>
  .lesson-check {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.55rem 0.7rem;
    margin: 0.4rem 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .lesson-check:hover {
    border-color: var(--color-border-strong);
  }
  .lesson-check input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  .lesson-check__box {
    flex: 0 0 auto;
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.15rem;
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    display: grid;
    place-items: center;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .lesson-check__box::after {
    content: '✓';
    font-size: 0.8rem;
    line-height: 1;
    color: var(--color-accent-fg);
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity 0.12s ease,
      transform 0.12s ease;
  }
  .lesson-check__label {
    font-size: 0.95rem;
    color: var(--color-fg);
  }
  .lesson-check:has(input:checked) {
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent) 7%, var(--color-surface));
  }
  .lesson-check:has(input:checked) .lesson-check__box {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }
  .lesson-check:has(input:checked) .lesson-check__box::after {
    opacity: 1;
    transform: scale(1);
  }
  .lesson-check:has(input:checked) .lesson-check__label {
    color: var(--color-fg-muted);
  }
  .lesson-check input:focus-visible + .lesson-check__box {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>

<script>
  // Hoisted & deduped by Astro: runs once per page no matter how many
  // <LessonCheck> instances are present.
  const KEY_PREFIX = 'eng100:';

  function storageKey(id: string): string {
    return KEY_PREFIX + window.location.pathname + ':' + id;
  }

  function updateProgress(): void {
    const boxes = document.querySelectorAll<HTMLInputElement>(
      '[data-lesson-check] input[type="checkbox"]',
    );
    const total = boxes.length;
    if (total === 0) return;
    let done = 0;
    for (const b of boxes) {
      if (b.checked) done += 1;
    }
    const pct = Math.round((done / total) * 100);
    for (const el of document.querySelectorAll<HTMLElement>('[data-eng-progress]')) {
      const count = el.querySelector<HTMLElement>('[data-eng-progress-count]');
      const bar = el.querySelector<HTMLElement>('[data-eng-progress-bar]');
      if (count) count.textContent = done + ' / ' + total;
      if (bar) bar.style.width = pct + '%';
    }
  }

  function init(): void {
    const wraps = document.querySelectorAll<HTMLElement>('[data-lesson-check]');
    for (const wrap of wraps) {
      const id = wrap.dataset.id;
      const input = wrap.querySelector<HTMLInputElement>('input[type="checkbox"]');
      if (!id || !input) continue;

      const key = storageKey(id);
      if (window.localStorage.getItem(key) === '1') input.checked = true;

      input.addEventListener('change', () => {
        try {
          if (input.checked) window.localStorage.setItem(key, '1');
          else window.localStorage.removeItem(key);
        } catch {
          // Private mode / storage disabled — ticks just won't persist.
        }
        updateProgress();
      });
    }
    updateProgress();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
