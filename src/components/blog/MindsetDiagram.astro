---
/**
 * Inline-SVG concept diagrams for the "Effort, Focus & Grit" mindset series.
 * Self-hosted, theme-aware (design tokens), one diagram per `kind`.
 */
type MindsetKind =
  | 'effort-talent'
  | 'focus'
  | 'consistency'
  | 'discipline'
  | 'resilience'
  | 'reframe'
  | 'patience'
  | 'energy'
  | 'systems'
  | 'daily-loop';

interface Props {
  kind: MindsetKind;
  caption?: string;
}

const { kind, caption } = Astro.props;
const a = `md-arrow-${kind}`;
---

<figure class="diagram">
  {
    kind === 'effort-talent' && (
      <svg viewBox="0 0 720 220" role="img" aria-label={caption ?? 'Effort overtakes talent over time'}>
        <line class="d-stroke" x1="60" y1="180" x2="680" y2="180" />
        <line class="d-stroke" x1="60" y1="180" x2="60" y2="24" />
        <text x="360" y="208" text-anchor="middle" class="d-ts">time + consistent effort →</text>
        <text x="28" y="100" text-anchor="middle" class="d-ts" transform="rotate(-90 28 100)">skill</text>
        <polyline class="d-box2-line" points="60,120 220,108 400,96 680,84" fill="none" />
        <text x="600" y="74" class="d-tm">talent (head start, flat)</text>
        <polyline class="d-accent-line" points="60,168 220,150 400,110 680,40" fill="none" />
        <text x="560" y="36" class="d-ta">effort (compounds)</text>
        <circle cx="470" cy="92" r="4" class="d-dot" />
        <text x="470" y="118" text-anchor="middle" class="d-ts">crossover</text>
      </svg>
    )
  }

  {
    kind === 'focus' && (
      <svg viewBox="0 0 720 210" role="img" aria-label={caption ?? 'Scattered attention vs deep focus'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <text x="180" y="28" text-anchor="middle" class="d-title">SCATTERED</text>
        {[[60, 60], [120, 50], [200, 72], [280, 56], [90, 96], [240, 104]].map((p) => (
          <line class="d-stroke" x1="180" y1="150" x2={p[0]} y2={p[1]} marker-end={`url(#${a})`} />
        ))}
        <rect class="d-box" x="150" y="150" width="60" height="34" rx="4" />
        <text x="180" y="172" text-anchor="middle" class="d-t">you</text>
        <text x="180" y="200" text-anchor="middle" class="d-ts">energy leaks everywhere</text>
        <line class="d-stroke" x1="370" y1="30" x2="370" y2="190" />
        <text x="545" y="28" text-anchor="middle" class="d-title">FOCUSED</text>
        <rect class="d-box" x="515" y="150" width="60" height="34" rx="4" />
        <text x="545" y="172" text-anchor="middle" class="d-t">you</text>
        <line class="d-accent-line" x1="545" y1="150" x2="545" y2="48" marker-end={`url(#${a})`} />
        <rect class="d-accent" x="500" y="40" width="90" height="26" rx="4" />
        <text x="545" y="58" text-anchor="middle" class="d-ta">one task</text>
        <text x="545" y="200" text-anchor="middle" class="d-ts">all energy, one direction</text>
      </svg>
    )
  }

  {
    kind === 'consistency' && (
      <svg viewBox="0 0 720 210" role="img" aria-label={caption ?? 'Small daily steps compound'}>
        <line class="d-stroke" x1="60" y1="180" x2="680" y2="180" />
        <line class="d-stroke" x1="60" y1="180" x2="60" y2="24" />
        {Array.from({ length: 9 }).map((_, i) => {
          const x = 60 + i * 70;
          const y = 180 - Math.pow(i, 1.55) * 4.6;
          return <rect class={i === 8 ? 'd-accent' : 'd-box2'} x={x} y={y} width="44" height={180 - y} rx="2" />;
        })}
        <text x="120" y="170" text-anchor="middle" class="d-ts">1%</text>
        <text x="660" y="40" text-anchor="middle" class="d-ta">huge</text>
        <text x="360" y="204" text-anchor="middle" class="d-ts">tiny daily gains stack into something big — that's compounding</text>
      </svg>
    )
  }

  {
    kind === 'discipline' && (
      <svg viewBox="0 0 720 210" role="img" aria-label={caption ?? 'Motivation fluctuates, discipline stays flat'}>
        <line class="d-stroke" x1="60" y1="120" x2="680" y2="120" />
        <text x="360" y="200" text-anchor="middle" class="d-ts">days →</text>
        <polyline class="d-box2-line" points="60,70 130,160 200,50 270,170 340,80 410,150 480,40 550,165 620,90 680,140" fill="none" />
        <text x="150" y="40" class="d-tm">motivation (up & down)</text>
        <line class="d-accent-line" x1="60" y1="118" x2="680" y2="110" />
        <text x="470" y="104" class="d-ta">discipline (steady line you keep)</text>
      </svg>
    )
  }

  {
    kind === 'resilience' && (
      <svg viewBox="0 0 720 210" role="img" aria-label={caption ?? 'Fall, then rise higher'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <line class="d-stroke" x1="60" y1="180" x2="680" y2="180" />
        <polyline class="d-accent-line" points="60,120 200,120 300,170 360,170 470,80 680,40" fill="none" marker-end={`url(#${a})`} />
        <circle cx="330" cy="172" r="4" class="d-dot" />
        <text x="330" y="196" text-anchor="middle" class="d-ts">setback</text>
        <text x="150" y="110" class="d-tm">going fine</text>
        <text x="560" y="56" text-anchor="middle" class="d-ta">recover + grow</text>
        <text x="360" y="206" text-anchor="middle" class="d-ts">the dip is data, not the end — you bounce back stronger</text>
      </svg>
    )
  }

  {
    kind === 'reframe' && (
      <svg viewBox="0 0 720 210" role="img" aria-label={caption ?? 'Same event, two interpretations'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <rect class="d-box" x="280" y="86" width="160" height="44" rx="5" />
        <text x="360" y="106" text-anchor="middle" class="d-t">same event</text>
        <text x="360" y="123" text-anchor="middle" class="d-ts">"I made a mistake"</text>
        <line class="d-stroke" x1="280" y1="100" x2="190" y2="60" marker-end={`url(#${a})`} />
        <line class="d-stroke" x1="280" y1="116" x2="190" y2="160" marker-end={`url(#${a})`} />
        <rect class="d-box2" x="20" y="36" width="170" height="48" rx="5" />
        <text x="105" y="58" text-anchor="middle" class="d-tm">"I'm a failure"</text>
        <text x="105" y="74" text-anchor="middle" class="d-ts">closed lens</text>
        <line class="d-stroke" x1="440" y1="108" x2="530" y2="108" marker-end={`url(#${a})`} />
        <rect class="d-accent" x="532" y="84" width="168" height="48" rx="5" />
        <text x="616" y="106" text-anchor="middle" class="d-ta">"now I know better"</text>
        <text x="616" y="122" text-anchor="middle" class="d-ts">growth lens</text>
        <text x="360" y="190" text-anchor="middle" class="d-ts">you can't always pick the event — you can pick the lens</text>
      </svg>
    )
  }

  {
    kind === 'patience' && (
      <svg viewBox="0 0 720 220" role="img" aria-label={caption ?? 'The valley before the breakthrough'}>
        <line class="d-stroke" x1="60" y1="190" x2="680" y2="190" />
        <line class="d-stroke" x1="60" y1="190" x2="60" y2="24" />
        <polyline class="d-box2-line" points="60,60 680,60" fill="none" />
        <text x="120" y="50" class="d-tm">what you expect (straight up)</text>
        <polyline class="d-accent-line" points="60,180 200,150 340,140 470,120 560,70 680,36" fill="none" />
        <text x="300" y="170" class="d-ta">what really happens</text>
        <rect class="d-box" x="300" y="120" width="120" height="22" rx="3" />
        <text x="360" y="136" text-anchor="middle" class="d-ts">the plateau</text>
        <text x="360" y="214" text-anchor="middle" class="d-ts">most people quit on the flat part — right before it climbs</text>
      </svg>
    )
  }

  {
    kind === 'energy' && (
      <svg viewBox="0 0 720 210" role="img" aria-label={caption ?? 'Sustainable work-rest rhythm vs burnout'}>
        <line class="d-stroke" x1="60" y1="110" x2="680" y2="110" />
        <text x="360" y="200" text-anchor="middle" class="d-ts">work in waves: sprint, then truly rest</text>
        <path class="d-accent-line" d="M60,110 Q110,40 160,110 Q210,40 260,110 Q310,40 360,110 Q410,40 460,110 Q510,40 560,110 Q610,40 660,110" fill="none" />
        <text x="120" y="34" class="d-ta">push</text>
        <text x="120" y="134" class="d-ts">recover</text>
        <polyline class="d-box2-line" points="60,108 200,80 340,64 480,150 560,175 680,182" fill="none" />
        <text x="500" y="170" class="d-tm">no rest → burnout</text>
      </svg>
    )
  }

  {
    kind === 'systems' && (
      <svg viewBox="0 0 720 210" role="img" aria-label={caption ?? 'Goals set direction, systems do the work'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <rect class="d-accent" x="270" y="20" width="180" height="44" rx="6" />
        <text x="360" y="42" text-anchor="middle" class="d-ta">goal</text>
        <text x="360" y="58" text-anchor="middle" class="d-ts">the direction</text>
        <text x="360" y="92" text-anchor="middle" class="d-ts">↑ fed by ↑</text>
        {['daily action', 'measure', 'adjust'].map((t, i) => (
          <g>
            <rect class="d-box" x={70 + i * 200} y="120" width="180" height="46" rx="5" />
            <text x={160 + i * 200} y="148" text-anchor="middle" class="d-t">{t}</text>
            {i < 2 && (
              <line class="d-stroke" x1={250 + i * 200} y1="143" x2={270 + i * 200} y2="143" marker-end={`url(#${a})`} />
            )}
          </g>
        ))}
        <path class="d-stroke" d="M160,166 L160,186 L640,186 L640,166" marker-end={`url(#${a})`} />
        <text x="400" y="204" text-anchor="middle" class="d-ts">the system is the loop you repeat — it produces the goal</text>
      </svg>
    )
  }

  {
    kind === 'daily-loop' && (
      <svg viewBox="0 0 720 210" role="img" aria-label={caption ?? 'A resilient daily practice loop'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        {[
          ['Show up', 130, 60],
          ['Focus block', 470, 60],
          ['Rest', 590, 150],
          ['Reflect', 250, 150],
        ].map((t) => (
          <g>
            <rect class={t[0] === 'Focus block' ? 'd-accent' : 'd-box'} x={Number(t[1]) - 70} y={Number(t[2]) - 22} width="140" height="44" rx="6" />
            <text x={t[1]} y={Number(t[2]) + 5} text-anchor="middle" class={t[0] === 'Focus block' ? 'd-ta' : 'd-t'}>{t[0]}</text>
          </g>
        ))}
        <line class="d-stroke" x1="200" y1="55" x2="398" y2="55" marker-end={`url(#${a})`} />
        <line class="d-stroke" x1="520" y1="82" x2="575" y2="128" marker-end={`url(#${a})`} />
        <line class="d-stroke" x1="520" y1="150" x2="322" y2="150" marker-end={`url(#${a})`} />
        <line class="d-stroke" x1="215" y1="128" x2="120" y2="82" marker-end={`url(#${a})`} />
        <text x="360" y="120" text-anchor="middle" class="d-ts">repeat daily</text>
      </svg>
    )
  }

  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .diagram {
    margin: 1.5rem 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg);
    padding: 0.85rem 0.9rem 0.6rem;
  }
  .diagram svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .diagram figcaption {
    margin-top: 0.5rem;
    font-size: 0.72rem;
    color: var(--color-fg-muted);
    text-align: center;
    letter-spacing: 0.02em;
  }
  .diagram :global(text) {
    font-family: var(--font-mono);
  }
  .diagram :global(.d-box) {
    fill: var(--color-surface);
    stroke: var(--color-border);
    stroke-width: 1;
  }
  .diagram :global(.d-box2) {
    fill: var(--color-surface-2);
    stroke: var(--color-border);
    stroke-width: 1;
  }
  .diagram :global(.d-accent) {
    fill: color-mix(in srgb, var(--color-accent) 12%, transparent);
    stroke: var(--color-accent);
    stroke-width: 1;
  }
  .diagram :global(.d-stroke) {
    fill: none;
    stroke: var(--color-border-strong);
    stroke-width: 1.4;
  }
  .diagram :global(.d-accent-line) {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2;
  }
  .diagram :global(.d-box2-line) {
    fill: none;
    stroke: var(--color-fg-subtle);
    stroke-width: 1.6;
    stroke-dasharray: 5 4;
  }
  .diagram :global(.d-arrowhead) {
    fill: var(--color-border-strong);
  }
  .diagram :global(.d-dot) {
    fill: var(--color-accent);
  }
  .diagram :global(.d-t) {
    fill: var(--color-fg);
    font-size: 13px;
  }
  .diagram :global(.d-tm) {
    fill: var(--color-fg-muted);
    font-size: 12px;
  }
  .diagram :global(.d-ts) {
    fill: var(--color-fg-subtle);
    font-size: 11px;
  }
  .diagram :global(.d-ta) {
    fill: var(--color-accent);
    font-size: 12.5px;
  }
  .diagram :global(.d-title) {
    fill: var(--color-fg-muted);
    font-size: 12px;
    letter-spacing: 0.1em;
  }
</style>
