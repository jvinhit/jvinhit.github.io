---
/**
 * Inline-SVG concept diagrams for the "Effort, Focus & Grit" mindset series.
 * Self-hosted, theme-aware (design tokens), one diagram per `kind`.
 */
type MindsetKind =
  | 'effort-talent'
  | 'focus'
  | 'consistency'
  | 'discipline'
  | 'resilience'
  | 'reframe'
  | 'patience'
  | 'energy'
  | 'systems'
  | 'daily-loop';

interface Props {
  kind: MindsetKind;
  caption?: string;
}

const { kind, caption } = Astro.props;
const a = `md-arrow-${kind}`;

const legacyCaptions: Record<MindsetKind, string> = {
  'effort-talent':
    'Talent starts higher but stays flat; consistent effort compounds and overtakes it',
  focus:
    'Scattered attention leaks energy everywhere; deep focus sends it all in one direction',
  consistency:
    'Small daily reps stack into something big; intensity spikes fade',
  discipline:
    'Motivation fluctuates up and down; discipline stays a steady line you keep',
  resilience:
    'A setback dips the line — resilience is recovering above where you were before',
  reframe:
    'Same event, two framings — the lens you choose shapes what you do next',
  patience:
    'Effort compounds underground on the plateau — most people quit right before the upward bend',
  energy:
    'Sustainable work-rest waves compound capacity; grinding without recovery slides into burnout',
  systems:
    'Goals set direction; the daily-measure-adjust loop is what delivers them',
  'daily-loop':
    'Show up → focus → rest → reflect → repeat — the loop that holds all nine parts together',
};

const vietnameseCaptions: Record<MindsetKind, string> = {
  'effort-talent':
    'Nỗ lực là điều kiện quan trọng; luyện tập có chủ đích, phản hồi và điều chỉnh mới định hình quỹ đạo tiến bộ.',
  focus:
    'Sự chú ý phân tán làm hao năng lượng; tập trung sâu dành nhiều nguồn lực hơn cho một hướng.',
  consistency:
    'Những lần luyện tập nhỏ và đều có thể cộng dồn theo thời gian; các đợt bùng sức thường khó duy trì.',
  discipline:
    'Động lực dao động; kỷ luật là mức cam kết tối thiểu bạn có thể duy trì và điều chỉnh.',
  resilience:
    'Sau một trở ngại, hồi phục có nhiều quỹ đạo và không bảo đảm bạn sẽ kết thúc ở vị trí cao hơn trước.',
  reframe:
    'Cùng một sự việc có thể được diễn giải theo nhiều cách; khung nhìn chính xác và hữu ích hơn giúp định hướng bước tiếp theo.',
  patience:
    'Tiến bộ thường không đều; giai đoạn chững là tín hiệu để xem lại phương pháp, không phải lời hứa rằng đột phá sắp đến.',
  energy:
    'Nhịp làm việc và hồi phục giúp duy trì năng lực; tải kéo dài, thiếu kiểm soát và thiếu hồi phục làm tăng nguy cơ kiệt sức.',
  systems:
    'Mục tiêu đặt hướng; vòng thực hiện, đo lường và điều chỉnh tạo ra tiến độ và phản hồi.',
  'daily-loop':
    'Tín hiệu → có mặt → tập trung → nghỉ → suy ngẫm → lặp lại: một vòng thực hành linh hoạt cho mỗi ngày.',
};

// Các bài cũ truyền caption tiếng Anh. Chuyển đúng những caption đó sang bản
// tiếng Việt đã hiệu chỉnh, nhưng vẫn giữ khả năng override bằng caption mới.
const diagramCaption =
  caption && caption !== legacyCaptions[kind]
    ? caption
    : vietnameseCaptions[kind];
---

<figure class="diagram">
  {
    kind === 'effort-talent' && (
      <svg viewBox="0 0 720 220" role="img" aria-label={diagramCaption}>
        <line class="d-stroke" x1="60" y1="180" x2="680" y2="180" />
        <line class="d-stroke" x1="60" y1="180" x2="60" y2="24" />
        <text x="360" y="208" text-anchor="middle" class="d-ts">
          thời gian →
        </text>
        <text
          x="28"
          y="100"
          text-anchor="middle"
          class="d-ts"
          transform="rotate(-90 28 100)"
        >
          năng lực
        </text>
        <polyline
          class="d-box2-line"
          points="60,116 220,108 400,104 680,98"
          fill="none"
        />
        <text x="492" y="90" class="d-tm">
          lợi thế ban đầu + ít luyện tập
        </text>
        <polyline
          class="d-accent-line"
          points="60,168 180,150 280,155 400,118 500,126 600,84 680,72"
          fill="none"
        />
        <text x="430" y="54" class="d-ta">
          luyện đúng + phản hồi + điều chỉnh
        </text>
      </svg>
    )
  }

  {
    kind === 'focus' && (
      <svg viewBox="0 0 720 210" role="img" aria-label={diagramCaption}>
        <defs>
          <marker
            id={a}
            markerWidth="9"
            markerHeight="9"
            refX="6.5"
            refY="3"
            orient="auto"
          >
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <text x="180" y="28" text-anchor="middle" class="d-title">
          PHÂN TÁN
        </text>
        {[
          [60, 60],
          [120, 50],
          [200, 72],
          [280, 56],
          [90, 96],
          [240, 104],
        ].map((p) => (
          <line
            class="d-stroke"
            x1="180"
            y1="150"
            x2={p[0]}
            y2={p[1]}
            marker-end={`url(#${a})`}
          />
        ))}
        <rect class="d-box" x="150" y="150" width="60" height="34" rx="4" />
        <text x="180" y="172" text-anchor="middle" class="d-t">
          bạn
        </text>
        <text x="180" y="200" text-anchor="middle" class="d-ts">
          năng lượng rò rỉ nhiều hướng
        </text>
        <line class="d-stroke" x1="370" y1="30" x2="370" y2="190" />
        <text x="545" y="28" text-anchor="middle" class="d-title">
          TẬP TRUNG
        </text>
        <rect class="d-box" x="515" y="150" width="60" height="34" rx="4" />
        <text x="545" y="172" text-anchor="middle" class="d-t">
          bạn
        </text>
        <line
          class="d-accent-line"
          x1="545"
          y1="150"
          x2="545"
          y2="48"
          marker-end={`url(#${a})`}
        />
        <rect class="d-accent" x="500" y="40" width="90" height="26" rx="4" />
        <text x="545" y="58" text-anchor="middle" class="d-ta">
          một việc
        </text>
        <text x="545" y="200" text-anchor="middle" class="d-ts">
          nhiều năng lượng hơn cho một hướng
        </text>
      </svg>
    )
  }

  {
    kind === 'consistency' && (
      <svg viewBox="0 0 720 210" role="img" aria-label={diagramCaption}>
        <line class="d-stroke" x1="60" y1="180" x2="680" y2="180" />
        <line class="d-stroke" x1="60" y1="180" x2="60" y2="24" />
        {Array.from({ length: 9 }).map((_, i) => {
          const x = 60 + i * 70;
          const y = 180 - Math.pow(i, 1.55) * 4.6;
          return (
            <rect
              class={i === 8 ? 'd-accent' : 'd-box2'}
              x={x}
              y={y}
              width="44"
              height={180 - y}
              rx="2"
            />
          );
        })}
        <text x="120" y="170" text-anchor="middle" class="d-ts">
          1%
        </text>
        <text x="660" y="40" text-anchor="middle" class="d-ta">
          lớn dần
        </text>
        <text x="360" y="204" text-anchor="middle" class="d-ts">
          những bước nhỏ đều đặn có thể cộng dồn theo thời gian
        </text>
      </svg>
    )
  }

  {
    kind === 'discipline' && (
      <svg viewBox="0 0 720 210" role="img" aria-label={diagramCaption}>
        <line class="d-stroke" x1="60" y1="120" x2="680" y2="120" />
        <text x="360" y="200" text-anchor="middle" class="d-ts">
          ngày →
        </text>
        <polyline
          class="d-box2-line"
          points="60,70 130,160 200,50 270,170 340,80 410,150 480,40 550,165 620,90 680,140"
          fill="none"
        />
        <text x="150" y="40" class="d-tm">
          động lực (lên xuống)
        </text>
        <line class="d-accent-line" x1="60" y1="118" x2="680" y2="110" />
        <text x="500" y="102" text-anchor="middle" class="d-ta">
          cam kết đã thiết kế
        </text>
      </svg>
    )
  }

  {
    kind === 'resilience' && (
      <svg viewBox="0 0 720 220" role="img" aria-label={diagramCaption}>
        <defs>
          <marker
            id={a}
            markerWidth="9"
            markerHeight="9"
            refX="6.5"
            refY="3"
            orient="auto"
          >
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <line class="d-stroke" x1="60" y1="190" x2="680" y2="190" />
        <polyline
          class="d-stroke"
          points="60,116 200,116 300,170"
          fill="none"
        />
        <polyline
          class="d-accent-line"
          points="300,170 400,146 520,120 680,114"
          fill="none"
          marker-end={`url(#${a})`}
        />
        <polyline
          class="d-box2-line"
          points="300,170 420,164 550,150 680,144"
          fill="none"
        />
        <circle cx="300" cy="170" r="4" class="d-dot" />
        <text x="300" y="188" text-anchor="middle" class="d-ts">
          trở ngại
        </text>
        <text x="120" y="106" class="d-tm">
          đang ổn định
        </text>
        <text x="522" y="104" class="d-ta">
          hồi phục / thích nghi
        </text>
        <text x="520" y="174" text-anchor="middle" class="d-tm">
          cần thêm thời gian / hỗ trợ
        </text>
        <text x="360" y="214" text-anchor="middle" class="d-ts">
          hồi phục có nhiều quỹ đạo; không bắt buộc phải kết thúc cao hơn trước
        </text>
      </svg>
    )
  }

  {
    kind === 'reframe' && (
      <svg viewBox="0 0 720 210" role="img" aria-label={diagramCaption}>
        <defs>
          <marker
            id={a}
            markerWidth="9"
            markerHeight="9"
            refX="6.5"
            refY="3"
            orient="auto"
          >
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <rect class="d-box" x="280" y="86" width="160" height="44" rx="5" />
        <text x="360" y="106" text-anchor="middle" class="d-t">
          cùng một sự việc
        </text>
        <text x="360" y="123" text-anchor="middle" class="d-ts">
          "Tôi đã mắc lỗi"
        </text>
        <line
          class="d-stroke"
          x1="280"
          y1="100"
          x2="190"
          y2="60"
          marker-end={`url(#${a})`}
        />
        <line
          class="d-stroke"
          x1="280"
          y1="116"
          x2="190"
          y2="160"
          marker-end={`url(#${a})`}
        />
        <rect class="d-box2" x="20" y="36" width="170" height="48" rx="5" />
        <text x="105" y="58" text-anchor="middle" class="d-tm">
          "Tôi là kẻ thất bại"
        </text>
        <text x="105" y="74" text-anchor="middle" class="d-ts">
          khung nhìn đóng
        </text>
        <line
          class="d-stroke"
          x1="440"
          y1="108"
          x2="530"
          y2="108"
          marker-end={`url(#${a})`}
        />
        <rect class="d-accent" x="532" y="84" width="168" height="48" rx="5" />
        <text x="616" y="106" text-anchor="middle" class="d-ta">
          "Giờ tôi hiểu hơn"
        </text>
        <text x="616" y="122" text-anchor="middle" class="d-ts">
          khung học hỏi
        </text>
        <text x="360" y="190" text-anchor="middle" class="d-ts">
          không luôn chọn được sự việc; ta có thể thử một cách diễn giải hữu ích
          hơn
        </text>
      </svg>
    )
  }

  {
    kind === 'patience' && (
      <svg viewBox="0 0 720 220" role="img" aria-label={diagramCaption}>
        <line class="d-stroke" x1="60" y1="190" x2="680" y2="190" />
        <line class="d-stroke" x1="60" y1="190" x2="60" y2="24" />
        <polyline class="d-box2-line" points="60,180 680,40" fill="none" />
        <text x="500" y="66" class="d-tm">
          kỳ vọng: tăng đều
        </text>
        <polyline
          class="d-accent-line"
          points="60,180 180,150 300,132 430,132 520,118 600,80 680,62"
          fill="none"
        />
        <text x="160" y="168" class="d-ta">
          thực tế: tiến bộ không đều
        </text>
        <rect class="d-box" x="310" y="119" width="120" height="22" rx="3" />
        <text x="370" y="135" text-anchor="middle" class="d-ts">
          giai đoạn chững
        </text>
        <text x="360" y="214" text-anchor="middle" class="d-ts">
          chỗ chững là tín hiệu để xem lại, không phải lời hứa đột phá
        </text>
      </svg>
    )
  }

  {
    kind === 'energy' && (
      <svg viewBox="0 0 720 230" role="img" aria-label={diagramCaption}>
        <line class="d-stroke" x1="60" y1="110" x2="680" y2="110" />
        <path
          class="d-accent-line"
          d="M60,110 Q110,40 160,110 Q210,40 260,110 Q310,40 360,110 Q410,40 460,110 Q510,40 560,110 Q610,40 660,110"
          fill="none"
        />
        <text x="120" y="34" class="d-ta">
          gắng sức
        </text>
        <text x="120" y="134" class="d-ts">
          hồi phục
        </text>
        <polyline
          class="d-box2-line"
          points="60,108 200,80 340,64 480,150 560,175 680,182"
          fill="none"
        />
        <text x="505" y="200" text-anchor="middle" class="d-tm">
          <tspan x="505">tải kéo dài + ít kiểm soát</tspan>
          <tspan x="505" dy="14">
            + ít hồi phục → tăng nguy cơ kiệt sức
          </tspan>
        </text>
      </svg>
    )
  }

  {
    kind === 'systems' && (
      <svg viewBox="0 0 720 210" role="img" aria-label={diagramCaption}>
        <defs>
          <marker
            id={a}
            markerWidth="9"
            markerHeight="9"
            refX="6.5"
            refY="3"
            orient="auto"
          >
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <rect class="d-accent" x="270" y="20" width="180" height="44" rx="6" />
        <text x="360" y="42" text-anchor="middle" class="d-ta">
          mục tiêu
        </text>
        <text x="360" y="58" text-anchor="middle" class="d-ts">
          đặt hướng
        </text>
        <text x="360" y="92" text-anchor="middle" class="d-ts">
          ↑ được nuôi bởi ↑
        </text>
        {['thực hiện', 'đo lường', 'điều chỉnh'].map((t, i) => (
          <g>
            <rect
              class="d-box"
              x={70 + i * 200}
              y="120"
              width="180"
              height="46"
              rx="5"
            />
            <text x={160 + i * 200} y="148" text-anchor="middle" class="d-t">
              {t}
            </text>
            {i < 2 && (
              <line
                class="d-stroke"
                x1={250 + i * 200}
                y1="143"
                x2={270 + i * 200}
                y2="143"
                marker-end={`url(#${a})`}
              />
            )}
          </g>
        ))}
        <path
          class="d-stroke"
          d="M560,166 L560,186 L160,186 L160,166"
          marker-end={`url(#${a})`}
        />
        <text x="360" y="204" text-anchor="middle" class="d-ts">
          mục tiêu đặt hướng; vòng thực hiện–đo–chỉnh tạo tiến độ
        </text>
      </svg>
    )
  }

  {
    kind === 'daily-loop' && (
      <svg viewBox="0 0 720 220" role="img" aria-label={diagramCaption}>
        <defs>
          <marker
            id={a}
            markerWidth="9"
            markerHeight="9"
            refX="6.5"
            refY="3"
            orient="auto"
          >
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        {[
          ['Tín hiệu', 100, 55],
          ['Có mặt', 280, 55],
          ['Khối tập trung', 500, 55],
          ['Nghỉ', 570, 155],
          ['Suy ngẫm', 300, 155],
        ].map((t) => (
          <g>
            <rect
              class={t[0] === 'Khối tập trung' ? 'd-accent' : 'd-box'}
              x={Number(t[1]) - 65}
              y={Number(t[2]) - 22}
              width="130"
              height="44"
              rx="6"
            />
            <text
              x={t[1]}
              y={Number(t[2]) + 5}
              text-anchor="middle"
              class={t[0] === 'Khối tập trung' ? 'd-ta' : 'd-t'}
            >
              {t[0]}
            </text>
          </g>
        ))}
        <line
          class="d-stroke"
          x1="165"
          y1="55"
          x2="213"
          y2="55"
          marker-end={`url(#${a})`}
        />
        <line
          class="d-stroke"
          x1="345"
          y1="55"
          x2="433"
          y2="55"
          marker-end={`url(#${a})`}
        />
        <line
          class="d-stroke"
          x1="530"
          y1="77"
          x2="555"
          y2="131"
          marker-end={`url(#${a})`}
        />
        <line
          class="d-stroke"
          x1="505"
          y1="155"
          x2="367"
          y2="155"
          marker-end={`url(#${a})`}
        />
        <line
          class="d-stroke"
          x1="246"
          y1="133"
          x2="125"
          y2="78"
          marker-end={`url(#${a})`}
        />
        <text x="390" y="116" text-anchor="middle" class="d-ts">
          lặp theo nhịp phù hợp
        </text>
      </svg>
    )
  }

  {caption && <figcaption>{diagramCaption}</figcaption>}
</figure>

<style>
  .diagram {
    margin: 1.5rem 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg);
    padding: 0.85rem 0.9rem 0.6rem;
  }
  .diagram svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .diagram figcaption {
    margin-top: 0.5rem;
    font-size: 0.72rem;
    color: var(--color-fg-muted);
    text-align: center;
    letter-spacing: 0.02em;
  }
  .diagram :global(text) {
    font-family: var(--font-mono);
  }
  .diagram :global(.d-box) {
    fill: var(--color-surface);
    stroke: var(--color-border);
    stroke-width: 1;
  }
  .diagram :global(.d-box2) {
    fill: var(--color-surface-2);
    stroke: var(--color-border);
    stroke-width: 1;
  }
  .diagram :global(.d-accent) {
    fill: color-mix(in srgb, var(--color-accent) 12%, transparent);
    stroke: var(--color-accent);
    stroke-width: 1;
  }
  .diagram :global(.d-stroke) {
    fill: none;
    stroke: var(--color-border-strong);
    stroke-width: 1.4;
  }
  .diagram :global(.d-accent-line) {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2;
  }
  .diagram :global(.d-box2-line) {
    fill: none;
    stroke: var(--color-fg-subtle);
    stroke-width: 1.6;
    stroke-dasharray: 5 4;
  }
  .diagram :global(.d-arrowhead) {
    fill: var(--color-border-strong);
  }
  .diagram :global(.d-dot) {
    fill: var(--color-accent);
  }
  .diagram :global(.d-t) {
    fill: var(--color-fg);
    font-size: 13px;
  }
  .diagram :global(.d-tm) {
    fill: var(--color-fg-muted);
    font-size: 12px;
  }
  .diagram :global(.d-ts) {
    fill: var(--color-fg-subtle);
    font-size: 11px;
  }
  .diagram :global(.d-ta) {
    fill: var(--color-accent);
    font-size: 12.5px;
  }
  .diagram :global(.d-title) {
    fill: var(--color-fg-muted);
    font-size: 12px;
    letter-spacing: 0.1em;
  }
</style>
