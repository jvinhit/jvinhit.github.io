---
/**
 * Inline-SVG structure diagrams for the "Design Patterns in TypeScript" series.
 * Self-hosted, theme-aware (design tokens), one diagram per `kind`.
 */
type PatternKind =
  | 'singleton'
  | 'factory'
  | 'builder'
  | 'strategy'
  | 'observer'
  | 'decorator'
  | 'adapter-facade'
  | 'command'
  | 'state'
  | 'proxy-di';

interface Props {
  kind: PatternKind;
  caption?: string;
}

const { kind, caption } = Astro.props;
const a = `pd-arrow-${kind}`;
---

<figure class="diagram">
  {
    kind === 'singleton' && (
      <svg viewBox="0 0 720 210" role="img" aria-label={caption ?? 'Singleton pattern'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        {['Module A', 'Module B', 'Module C'].map((t, i) => (
          <g>
            <rect class="d-box" x="24" y={20 + i * 64} width="150" height="48" rx="5" />
            <text x="99" y={48 + i * 64} text-anchor="middle" class="d-t">{t}</text>
            <line class="d-stroke" x1="174" y1={44 + i * 64} x2="494" y2="105" marker-end={`url(#${a})`} />
          </g>
        ))}
        <rect class="d-accent" x="496" y="72" width="200" height="66" rx="6" />
        <text x="596" y="102" text-anchor="middle" class="d-ta">Singleton</text>
        <text x="596" y="122" text-anchor="middle" class="d-ts">one shared instance · getInstance()</text>
      </svg>
    )
  }

  {
    kind === 'factory' && (
      <svg viewBox="0 0 720 220" role="img" aria-label={caption ?? 'Factory pattern'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <rect class="d-box" x="20" y="86" width="130" height="56" rx="5" />
        <text x="85" y="118" text-anchor="middle" class="d-t">Client</text>
        <line class="d-stroke" x1="150" y1="114" x2="222" y2="114" marker-end={`url(#${a})`} />
        <text x="186" y="104" text-anchor="middle" class="d-ts">create(type)</text>
        <rect class="d-accent" x="224" y="86" width="150" height="56" rx="5" />
        <text x="299" y="112" text-anchor="middle" class="d-ta">Factory</text>
        <text x="299" y="130" text-anchor="middle" class="d-ts">decides which</text>
        {['ProductA', 'ProductB', 'ProductC'].map((t, i) => (
          <g>
            <rect class="d-box2" x="510" y={20 + i * 66} width="180" height="50" rx="5" />
            <text x="600" y={50 + i * 66} text-anchor="middle" class="d-t">{t}</text>
            <line class="d-stroke" x1="374" y1="114" x2="508" y2={45 + i * 66} marker-end={`url(#${a})`} />
          </g>
        ))}
        <text x="600" y="208" text-anchor="middle" class="d-ts">all implement one Product interface</text>
      </svg>
    )
  }

  {
    kind === 'builder' && (
      <svg viewBox="0 0 720 200" role="img" aria-label={caption ?? 'Builder pattern'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        {['.url(...)', '.method(...)', '.header(...)'].map((t, i) => (
          <g>
            <rect class="d-box" x={20 + i * 150} y="40" width="138" height="48" rx="5" />
            <text x={89 + i * 150} y="68" text-anchor="middle" class="d-ta">{t}</text>
            {i < 2 && (
              <line class="d-stroke" x1={158 + i * 150} y1="64" x2={168 + i * 150} y2="64" marker-end={`url(#${a})`} />
            )}
          </g>
        ))}
        <line class="d-stroke" x1="470" y1="64" x2="498" y2="64" marker-end={`url(#${a})`} />
        <rect class="d-box" x="500" y="40" width="120" height="48" rx="5" />
        <text x="560" y="68" text-anchor="middle" class="d-t">.build()</text>
        <line class="d-stroke" x1="560" y1="88" x2="560" y2="120" marker-end={`url(#${a})`} />
        <rect class="d-accent" x="470" y="122" width="180" height="50" rx="5" />
        <text x="560" y="152" text-anchor="middle" class="d-ta">Request (product)</text>
        <text x="230" y="150" text-anchor="middle" class="d-ts">fluent, immutable steps build one object</text>
      </svg>
    )
  }

  {
    kind === 'strategy' && (
      <svg viewBox="0 0 720 220" role="img" aria-label={caption ?? 'Strategy pattern'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <rect class="d-box" x="20" y="84" width="140" height="60" rx="5" />
        <text x="90" y="110" text-anchor="middle" class="d-t">Context</text>
        <text x="90" y="128" text-anchor="middle" class="d-ts">has a Strategy</text>
        <line class="d-stroke" x1="160" y1="114" x2="234" y2="114" marker-end={`url(#${a})`} />
        <rect class="d-accent" x="236" y="84" width="170" height="60" rx="5" />
        <text x="321" y="110" text-anchor="middle" class="d-ta">Strategy</text>
        <text x="321" y="128" text-anchor="middle" class="d-ts">interface: run()</text>
        {['SortByDate', 'SortByPrice', 'SortByName'].map((t, i) => (
          <g>
            <rect class="d-box2" x="510" y={20 + i * 66} width="184" height="50" rx="5" />
            <text x="602" y={50 + i * 66} text-anchor="middle" class="d-t">{t}</text>
            <line class="d-stroke" x1="406" y1="114" x2="508" y2={45 + i * 66} stroke-dasharray="4 4" marker-end={`url(#${a})`} />
          </g>
        ))}
        <text x="602" y="208" text-anchor="middle" class="d-ts">swap implementation at runtime</text>
      </svg>
    )
  }

  {
    kind === 'observer' && (
      <svg viewBox="0 0 720 220" role="img" aria-label={caption ?? 'Observer pattern'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <rect class="d-accent" x="24" y="80" width="180" height="64" rx="6" />
        <text x="114" y="108" text-anchor="middle" class="d-ta">Subject</text>
        <text x="114" y="128" text-anchor="middle" class="d-ts">state + notify()</text>
        {['Observer 1', 'Observer 2', 'Observer 3'].map((t, i) => (
          <g>
            <rect class="d-box" x="500" y={20 + i * 66} width="190" height="50" rx="5" />
            <text x="595" y={50 + i * 66} text-anchor="middle" class="d-t">{t}</text>
            <line class="d-stroke" x1="204" y1="112" x2="498" y2={45 + i * 66} marker-end={`url(#${a})`} />
          </g>
        ))}
        <text x="350" y="104" text-anchor="middle" class="d-ts">notify on change</text>
        <text x="350" y="200" text-anchor="middle" class="d-ts">observers subscribe / unsubscribe — Subject doesn't know who</text>
      </svg>
    )
  }

  {
    kind === 'decorator' && (
      <svg viewBox="0 0 720 200" role="img" aria-label={caption ?? 'Decorator pattern'}>
        <rect class="d-box2" x="20" y="40" width="500" height="120" rx="8" />
        <text x="40" y="62" class="d-tm">LoggingDecorator</text>
        <rect class="d-box" x="70" y="74" width="400" height="72" rx="7" />
        <text x="90" y="96" class="d-tm">CacheDecorator</text>
        <rect class="d-accent" x="130" y="104" width="300" height="34" rx="6" />
        <text x="280" y="126" text-anchor="middle" class="d-ta">Core service</text>
        <text x="600" y="92" text-anchor="middle" class="d-ts">every layer shares</text>
        <text x="600" y="110" text-anchor="middle" class="d-ts">the SAME interface</text>
        <text x="600" y="138" text-anchor="middle" class="d-ts">→ wrap to add</text>
        <text x="600" y="156" text-anchor="middle" class="d-ts">behavior</text>
      </svg>
    )
  }

  {
    kind === 'adapter-facade' && (
      <svg viewBox="0 0 720 250" role="img" aria-label={caption ?? 'Adapter and Facade patterns'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <text x="20" y="20" class="d-title">ADAPTER</text>
        <rect class="d-box" x="20" y="30" width="110" height="44" rx="5" />
        <text x="75" y="58" text-anchor="middle" class="d-t">Client</text>
        <line class="d-stroke" x1="130" y1="52" x2="178" y2="52" marker-end={`url(#${a})`} />
        <rect class="d-accent" x="180" y="30" width="150" height="44" rx="5" />
        <text x="255" y="58" text-anchor="middle" class="d-ta">Adapter</text>
        <line class="d-stroke" x1="330" y1="52" x2="378" y2="52" marker-end={`url(#${a})`} />
        <rect class="d-box2" x="380" y="30" width="200" height="44" rx="5" />
        <text x="480" y="58" text-anchor="middle" class="d-t">Adaptee (odd API)</text>
        <text x="640" y="56" text-anchor="middle" class="d-ts">conform</text>

        <text x="20" y="116" class="d-title">FACADE</text>
        <rect class="d-box" x="20" y="126" width="110" height="44" rx="5" />
        <text x="75" y="154" text-anchor="middle" class="d-t">Client</text>
        <line class="d-stroke" x1="130" y1="148" x2="178" y2="148" marker-end={`url(#${a})`} />
        <rect class="d-accent" x="180" y="126" width="150" height="44" rx="5" />
        <text x="255" y="154" text-anchor="middle" class="d-ta">Facade</text>
        {['Subsystem A', 'Subsystem B', 'Subsystem C'].map((t, i) => (
          <g>
            <rect class="d-box2" x="470" y={100 + i * 50} width="220" height="40" rx="5" />
            <text x="580" y={125 + i * 50} text-anchor="middle" class="d-t">{t}</text>
            <line class="d-stroke" x1="330" y1="148" x2="468" y2={120 + i * 50} marker-end={`url(#${a})`} />
          </g>
        ))}
        <text x="255" y="190" text-anchor="middle" class="d-ts">one simple entry point</text>
      </svg>
    )
  }

  {
    kind === 'command' && (
      <svg viewBox="0 0 720 230" role="img" aria-label={caption ?? 'Command pattern'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <rect class="d-box" x="20" y="40" width="150" height="56" rx="5" />
        <text x="95" y="66" text-anchor="middle" class="d-t">Invoker</text>
        <text x="95" y="84" text-anchor="middle" class="d-ts">button / dispatch</text>
        <line class="d-stroke" x1="170" y1="68" x2="244" y2="68" marker-end={`url(#${a})`} />
        <rect class="d-accent" x="246" y="40" width="180" height="56" rx="5" />
        <text x="336" y="66" text-anchor="middle" class="d-ta">Command</text>
        <text x="336" y="84" text-anchor="middle" class="d-ts">execute() · undo()</text>
        <line class="d-stroke" x1="426" y1="68" x2="500" y2="68" marker-end={`url(#${a})`} />
        <rect class="d-box" x="502" y="40" width="190" height="56" rx="5" />
        <text x="597" y="66" text-anchor="middle" class="d-t">Receiver</text>
        <text x="597" y="84" text-anchor="middle" class="d-ts">does the real work</text>
        <line class="d-stroke" x1="336" y1="96" x2="336" y2="138" marker-end={`url(#${a})`} />
        <rect class="d-box2" x="160" y="140" width="400" height="60" rx="6" />
        <text x="180" y="162" class="d-tm">History stack</text>
        {['cmd₁', 'cmd₂', 'cmd₃'].map((t, i) => (
          <g>
            <rect class="d-box" x={300 + i * 80} y="156" width="70" height="32" rx="4" />
            <text x={335 + i * 80} y="178" text-anchor="middle" class="d-ts">{t}</text>
          </g>
        ))}
        <text x="230" y="184" class="d-ts">undo / redo</text>
      </svg>
    )
  }

  {
    kind === 'state' && (
      <svg viewBox="0 0 720 200" role="img" aria-label={caption ?? 'State machine'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <rect class="d-box" x="20" y="80" width="120" height="48" rx="24" />
        <text x="80" y="109" text-anchor="middle" class="d-t">idle</text>
        <line class="d-stroke" x1="140" y1="104" x2="244" y2="104" marker-end={`url(#${a})`} />
        <text x="192" y="94" text-anchor="middle" class="d-ts">FETCH</text>
        <rect class="d-accent" x="246" y="80" width="140" height="48" rx="24" />
        <text x="316" y="109" text-anchor="middle" class="d-ta">loading</text>
        <line class="d-stroke" x1="386" y1="92" x2="500" y2="52" marker-end={`url(#${a})`} />
        <text x="446" y="58" text-anchor="middle" class="d-ts">RESOLVE</text>
        <rect class="d-box" x="502" y="28" width="150" height="48" rx="24" />
        <text x="577" y="57" text-anchor="middle" class="d-t">success</text>
        <line class="d-stroke" x1="386" y1="116" x2="500" y2="150" marker-end={`url(#${a})`} />
        <text x="446" y="150" text-anchor="middle" class="d-ts">REJECT</text>
        <rect class="d-box" x="502" y="128" width="150" height="48" rx="24" />
        <text x="577" y="157" text-anchor="middle" class="d-t">error</text>
        <text x="360" y="192" text-anchor="middle" class="d-ts">only declared transitions are allowed (type-safe)</text>
      </svg>
    )
  }

  {
    kind === 'proxy-di' && (
      <svg viewBox="0 0 720 240" role="img" aria-label={caption ?? 'Proxy and Dependency Injection'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <text x="20" y="20" class="d-title">PROXY</text>
        <rect class="d-box" x="20" y="30" width="120" height="46" rx="5" />
        <text x="80" y="58" text-anchor="middle" class="d-t">Client</text>
        <line class="d-stroke" x1="140" y1="53" x2="196" y2="53" marker-end={`url(#${a})`} />
        <rect class="d-accent" x="198" y="30" width="180" height="46" rx="5" />
        <text x="288" y="50" text-anchor="middle" class="d-ta">Proxy</text>
        <text x="288" y="67" text-anchor="middle" class="d-ts">check · cache · lazy</text>
        <line class="d-stroke" x1="378" y1="53" x2="434" y2="53" marker-end={`url(#${a})`} />
        <rect class="d-box2" x="436" y="30" width="180" height="46" rx="5" />
        <text x="526" y="58" text-anchor="middle" class="d-t">Real subject</text>
        <text x="650" y="56" text-anchor="middle" class="d-ts">same API</text>

        <text x="20" y="124" class="d-title">DEPENDENCY INJECTION</text>
        <rect class="d-accent" x="20" y="134" width="180" height="56" rx="5" />
        <text x="110" y="160" text-anchor="middle" class="d-ta">Composition root</text>
        <text x="110" y="178" text-anchor="middle" class="d-ts">wires deps</text>
        {['Service(repo)', 'Repo(db)', 'Logger'].map((t, i) => (
          <g>
            <rect class="d-box2" x="320" y={120 + i * 38} width="240" height="32" rx="4" />
            <text x="440" y={141 + i * 38} text-anchor="middle" class="d-t">{t}</text>
            <line class="d-stroke" x1="200" y1="162" x2="318" y2={136 + i * 38} marker-end={`url(#${a})`} />
          </g>
        ))}
        <text x="440" y="232" text-anchor="middle" class="d-ts">inject from outside → swap for tests</text>
      </svg>
    )
  }

  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .diagram {
    margin: 1.5rem 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg);
    padding: 0.85rem 0.9rem 0.6rem;
  }
  .diagram svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .diagram figcaption {
    margin-top: 0.5rem;
    font-size: 0.72rem;
    color: var(--color-fg-muted);
    text-align: center;
    letter-spacing: 0.02em;
  }
  .diagram :global(text) {
    font-family: var(--font-mono);
  }
  .diagram :global(.d-box) {
    fill: var(--color-surface);
    stroke: var(--color-border);
    stroke-width: 1;
  }
  .diagram :global(.d-box2) {
    fill: var(--color-surface-2);
    stroke: var(--color-border);
    stroke-width: 1;
  }
  .diagram :global(.d-accent) {
    fill: color-mix(in srgb, var(--color-accent) 12%, transparent);
    stroke: var(--color-accent);
    stroke-width: 1;
  }
  .diagram :global(.d-stroke) {
    fill: none;
    stroke: var(--color-border-strong);
    stroke-width: 1.4;
  }
  .diagram :global(.d-arrowhead) {
    fill: var(--color-border-strong);
  }
  .diagram :global(.d-t) {
    fill: var(--color-fg);
    font-size: 13px;
  }
  .diagram :global(.d-tm) {
    fill: var(--color-fg-muted);
    font-size: 12px;
  }
  .diagram :global(.d-ts) {
    fill: var(--color-fg-subtle);
    font-size: 11px;
  }
  .diagram :global(.d-ta) {
    fill: var(--color-accent);
    font-size: 12.5px;
  }
  .diagram :global(.d-title) {
    fill: var(--color-fg-muted);
    font-size: 12px;
    letter-spacing: 0.1em;
  }
</style>
