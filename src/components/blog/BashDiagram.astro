---
/**
 * Inline-SVG diagrams for the "Bash & Shell Scripting" series.
 * Self-hosted, theme-aware (design tokens), one diagram per `kind`.
 */
type BashKind =
  | 'shell-process'
  | 'expansion'
  | 'conditional'
  | 'loop'
  | 'function'
  | 'array'
  | 'redirection'
  | 'pipe'
  | 'error-trap'
  | 'automation';

interface Props {
  kind: BashKind;
  caption?: string;
}

const { kind, caption } = Astro.props;
const a = `bd-arrow-${kind}`;
---

<figure class="diagram">
  {
    kind === 'shell-process' && (
      <svg viewBox="0 0 720 180" role="img" aria-label={caption ?? 'How the shell runs a command'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        {[
          ['You type', 'ls -l /tmp'],
          ['Shell (bash)', 'parse · expand'],
          ['fork + exec', 'new process'],
          ['Kernel', 'runs /bin/ls'],
        ].map((t, i) => (
          <g>
            <rect class={i === 1 ? 'd-accent' : 'd-box'} x={16 + i * 178} y="56" width="150" height="58" rx="6" />
            <text x={91 + i * 178} y="82" text-anchor="middle" class={i === 1 ? 'd-ta' : 'd-t'}>{t[0]}</text>
            <text x={91 + i * 178} y="100" text-anchor="middle" class="d-ts">{t[1]}</text>
            {i < 3 && (
              <line class="d-stroke" x1={166 + i * 178} y1="85" x2={194 + i * 178} y2="85" marker-end={`url(#${a})`} />
            )}
          </g>
        ))}
        <text x="360" y="150" text-anchor="middle" class="d-ts">exit code flows back ← ($? = 0 means success)</text>
      </svg>
    )
  }

  {
    kind === 'expansion' && (
      <svg viewBox="0 0 720 210" role="img" aria-label={caption ?? 'Bash expansion order'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <rect class="d-box" x="20" y="20" width="680" height="40" rx="5" />
        <text x="36" y="45" class="d-ta">echo "$USER has $(ls | wc -l) files, $((2+3)) done"</text>
        {[
          ['"$USER"', 'variable → vinxi'],
          ['$(ls | wc -l)', 'command → 12'],
          ['$((2+3))', 'math → 5'],
        ].map((t, i) => (
          <g>
            <rect class="d-box2" x={20 + i * 232} y="96" width="216" height="56" rx="5" />
            <text x={128 + i * 232} y="120" text-anchor="middle" class="d-ta">{t[0]}</text>
            <text x={128 + i * 232} y="138" text-anchor="middle" class="d-ts">{t[1]}</text>
            <line class="d-stroke" x1={128 + i * 232} y1="62" x2={128 + i * 232} y2="94" marker-end={`url(#${a})`} />
          </g>
        ))}
        <rect class="d-accent" x="170" y="170" width="380" height="34" rx="5" />
        <text x="360" y="192" text-anchor="middle" class="d-ta">vinxi has 12 files, 5 done</text>
      </svg>
    )
  }

  {
    kind === 'conditional' && (
      <svg viewBox="0 0 720 200" role="img" aria-label={caption ?? 'if / test / exit code flow'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <rect class="d-box" x="20" y="80" width="180" height="48" rx="5" />
        <text x="110" y="109" text-anchor="middle" class="d-t">[[ -f file.txt ]]</text>
        <line class="d-stroke" x1="200" y1="104" x2="248" y2="104" marker-end={`url(#${a})`} />
        <polygon class="d-accent" points="330,72 400,104 330,136 260,104" />
        <text x="330" y="108" text-anchor="middle" class="d-ta">$? = 0 ?</text>
        <line class="d-stroke" x1="400" y1="104" x2="470" y2="60" marker-end={`url(#${a})`} />
        <line class="d-stroke" x1="400" y1="104" x2="470" y2="148" marker-end={`url(#${a})`} />
        <rect class="d-box2" x="472" y="36" width="228" height="48" rx="5" />
        <text x="586" y="60" text-anchor="middle" class="d-t">then (true / exists)</text>
        <text x="586" y="76" text-anchor="middle" class="d-ts">exit code 0 = success</text>
        <rect class="d-box2" x="472" y="124" width="228" height="48" rx="5" />
        <text x="586" y="148" text-anchor="middle" class="d-t">else (false / missing)</text>
        <text x="586" y="164" text-anchor="middle" class="d-ts">non-zero = failure</text>
      </svg>
    )
  }

  {
    kind === 'loop' && (
      <svg viewBox="0 0 720 200" role="img" aria-label={caption ?? 'for / while loop flow'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <rect class="d-box" x="40" y="80" width="150" height="48" rx="5" />
        <text x="115" y="109" text-anchor="middle" class="d-t">next item?</text>
        <line class="d-stroke" x1="190" y1="104" x2="248" y2="104" marker-end={`url(#${a})`} />
        <rect class="d-accent" x="250" y="80" width="200" height="48" rx="5" />
        <text x="350" y="104" text-anchor="middle" class="d-ta">do … body …</text>
        <text x="350" y="120" text-anchor="middle" class="d-ts">use "$item"</text>
        <line class="d-stroke" x1="450" y1="104" x2="508" y2="104" marker-end={`url(#${a})`} />
        <rect class="d-box2" x="510" y="80" width="170" height="48" rx="5" />
        <text x="595" y="109" text-anchor="middle" class="d-t">done?</text>
        <path class="d-stroke" d="M350,128 L350,168 L115,168 L115,130" marker-end={`url(#${a})`} />
        <text x="232" y="186" text-anchor="middle" class="d-ts">loop back for each of: file1 file2 file3 …</text>
      </svg>
    )
  }

  {
    kind === 'function' && (
      <svg viewBox="0 0 720 200" role="img" aria-label={caption ?? 'function call & arguments'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <rect class="d-box" x="20" y="80" width="230" height="52" rx="5" />
        <text x="135" y="104" text-anchor="middle" class="d-t">greet "Alice" 42</text>
        <text x="135" y="122" text-anchor="middle" class="d-ts">call with args</text>
        <line class="d-stroke" x1="250" y1="106" x2="298" y2="106" marker-end={`url(#${a})`} />
        <rect class="d-accent" x="300" y="40" width="400" height="120" rx="6" />
        <text x="318" y="66" class="d-ta">greet() {'{'}</text>
        <text x="338" y="90" class="d-t">local name="$1"   # Alice</text>
        <text x="338" y="112" class="d-t">local age="$2"    # 42</text>
        <text x="338" y="134" class="d-ts">echo "Hi $name"   # output / return via echo</text>
        <text x="318" y="156" class="d-ta">{'}'}</text>
      </svg>
    )
  }

  {
    kind === 'array' && (
      <svg viewBox="0 0 720 200" role="img" aria-label={caption ?? 'indexed and associative arrays'}>
        <rect class="d-box" x="20" y="24" width="680" height="30" rx="4" />
        <text x="36" y="45" class="d-ta">arr=(apple banana cherry)</text>
        {['apple', 'banana', 'cherry'].map((t, i) => (
          <g>
            <rect class="d-box2" x={20 + i * 150} y="74" width="140" height="46" rx="5" />
            <text x={90 + i * 150} y="100" text-anchor="middle" class="d-t">{t}</text>
            <text x={90 + i * 150} y="138" text-anchor="middle" class="d-ts">index {i} → ${`{arr[${i}]}`}</text>
          </g>
        ))}
        <rect class="d-accent" x="478" y="74" width="222" height="46" rx="5" />
        <text x="589" y="103" text-anchor="middle" class="d-ta">${'{#arr[@]}'} = 3</text>
        <text x="360" y="172" text-anchor="middle" class="d-ts">associative: declare -A m; m[user]=vinxi → ${'{m[user]}'}</text>
      </svg>
    )
  }

  {
    kind === 'redirection' && (
      <svg viewBox="0 0 720 210" role="img" aria-label={caption ?? 'stdin / stdout / stderr redirection'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <rect class="d-accent" x="280" y="80" width="160" height="58" rx="6" />
        <text x="360" y="106" text-anchor="middle" class="d-ta">command</text>
        <text x="360" y="124" text-anchor="middle" class="d-ts">a process</text>
        <rect class="d-box" x="40" y="86" width="170" height="46" rx="5" />
        <text x="125" y="108" text-anchor="middle" class="d-t">stdin (0)</text>
        <text x="125" y="124" text-anchor="middle" class="d-ts">&lt; input.txt</text>
        <line class="d-stroke" x1="210" y1="109" x2="278" y2="109" marker-end={`url(#${a})`} />
        <rect class="d-box2" x="510" y="28" width="180" height="46" rx="5" />
        <text x="600" y="50" text-anchor="middle" class="d-t">stdout (1)</text>
        <text x="600" y="66" text-anchor="middle" class="d-ts">&gt; out.txt</text>
        <line class="d-stroke" x1="440" y1="100" x2="508" y2="58" marker-end={`url(#${a})`} />
        <rect class="d-box2" x="510" y="142" width="180" height="46" rx="5" />
        <text x="600" y="164" text-anchor="middle" class="d-t">stderr (2)</text>
        <text x="600" y="180" text-anchor="middle" class="d-ts">2&gt; err.txt</text>
        <line class="d-stroke" x1="440" y1="118" x2="508" y2="160" marker-end={`url(#${a})`} />
      </svg>
    )
  }

  {
    kind === 'pipe' && (
      <svg viewBox="0 0 720 170" role="img" aria-label={caption ?? 'pipes connect stdout to stdin'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        {[
          ['cat log.txt', 'whole file'],
          ['grep ERROR', 'keep matches'],
          ['sort', 'order them'],
          ['uniq -c', 'count dupes'],
        ].map((t, i) => (
          <g>
            <rect class={i % 2 === 0 ? 'd-box' : 'd-accent'} x={12 + i * 178} y="58" width="150" height="54" rx="6" />
            <text x={87 + i * 178} y="82" text-anchor="middle" class={i % 2 === 0 ? 'd-t' : 'd-ta'}>{t[0]}</text>
            <text x={87 + i * 178} y="100" text-anchor="middle" class="d-ts">{t[1]}</text>
            {i < 3 && (
              <line class="d-stroke" x1={162 + i * 178} y1="85" x2={190 + i * 178} y2="85" marker-end={`url(#${a})`} />
            )}
            {i < 3 && <text x={176 + i * 178} y="76" text-anchor="middle" class="d-ta">|</text>}
          </g>
        ))}
        <text x="360" y="146" text-anchor="middle" class="d-ts">each | sends the left command's stdout into the right command's stdin</text>
      </svg>
    )
  }

  {
    kind === 'error-trap' && (
      <svg viewBox="0 0 720 210" role="img" aria-label={caption ?? 'set -euo pipefail and trap'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <rect class="d-accent" x="20" y="20" width="680" height="40" rx="5" />
        <text x="36" y="45" class="d-ta">set -euo pipefail   # -e exit on error · -u unset = error · -o pipefail</text>
        {[
          ['-e', 'any command fails → stop now'],
          ['-u', 'using $UNSET → error, not ""'],
          ['-o pipefail', 'a | b fails if a fails too'],
        ].map((t, i) => (
          <g>
            <rect class="d-box" x="20" y={78 + i * 42} width="160" height="34" rx="4" />
            <text x="100" y={100 + i * 42} text-anchor="middle" class="d-ta">{t[0]}</text>
            <text x="196" y={100 + i * 42} class="d-ts">{t[1]}</text>
          </g>
        ))}
        <rect class="d-box2" x="430" y="78" width="270" height="118" rx="6" />
        <text x="446" y="102" class="d-t">trap cleanup EXIT</text>
        <text x="446" y="126" class="d-ts">runs on any exit —</text>
        <text x="446" y="146" class="d-ts">success, error, or Ctrl-C</text>
        <text x="446" y="172" class="d-ts">→ remove temp files, unlock</text>
      </svg>
    )
  }

  {
    kind === 'automation' && (
      <svg viewBox="0 0 720 200" role="img" aria-label={caption ?? 'a production script pipeline'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        {[
          ['parse args', 'getopts'],
          ['validate', 'inputs + deps'],
          ['do work', 'main logic'],
          ['log + exit', 'status code'],
        ].map((t, i) => (
          <g>
            <rect class={i === 2 ? 'd-accent' : 'd-box'} x={14 + i * 178} y="50" width="156" height="58" rx="6" />
            <text x={92 + i * 178} y="76" text-anchor="middle" class={i === 2 ? 'd-ta' : 'd-t'}>{t[0]}</text>
            <text x={92 + i * 178} y="94" text-anchor="middle" class="d-ts">{t[1]}</text>
            {i < 3 && (
              <line class="d-stroke" x1={170 + i * 178} y1="79" x2={190 + i * 178} y2="79" marker-end={`url(#${a})`} />
            )}
          </g>
        ))}
        <rect class="d-box2" x="14" y="138" width="688" height="42" rx="5" />
        <text x="360" y="164" text-anchor="middle" class="d-ts">trap cleanup EXIT wraps the whole run · ShellCheck guards quality</text>
      </svg>
    )
  }

  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .diagram {
    margin: 1.5rem 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg);
    padding: 0.85rem 0.9rem 0.6rem;
  }
  .diagram svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .diagram figcaption {
    margin-top: 0.5rem;
    font-size: 0.72rem;
    color: var(--color-fg-muted);
    text-align: center;
    letter-spacing: 0.02em;
  }
  .diagram :global(text) {
    font-family: var(--font-mono);
  }
  .diagram :global(.d-box) {
    fill: var(--color-surface);
    stroke: var(--color-border);
    stroke-width: 1;
  }
  .diagram :global(.d-box2) {
    fill: var(--color-surface-2);
    stroke: var(--color-border);
    stroke-width: 1;
  }
  .diagram :global(.d-accent) {
    fill: color-mix(in srgb, var(--color-accent) 12%, transparent);
    stroke: var(--color-accent);
    stroke-width: 1;
  }
  .diagram :global(.d-stroke) {
    fill: none;
    stroke: var(--color-border-strong);
    stroke-width: 1.4;
  }
  .diagram :global(.d-arrowhead) {
    fill: var(--color-border-strong);
  }
  .diagram :global(.d-t) {
    fill: var(--color-fg);
    font-size: 13px;
  }
  .diagram :global(.d-tm) {
    fill: var(--color-fg-muted);
    font-size: 12px;
  }
  .diagram :global(.d-ts) {
    fill: var(--color-fg-subtle);
    font-size: 11px;
  }
  .diagram :global(.d-ta) {
    fill: var(--color-accent);
    font-size: 12.5px;
  }
  .diagram :global(.d-title) {
    fill: var(--color-fg-muted);
    font-size: 12px;
    letter-spacing: 0.1em;
  }
</style>
