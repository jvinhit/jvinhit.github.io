---
/**
 * Theme-aware architecture diagrams for the Domain, DNS & Hosting series.
 *
 * The diagrams deliberately use documentation-only domains and IP ranges:
 * `example.com`, TEST-NET IPv4, and documentation IPv6. They are safe to copy
 * into explanations without accidentally targeting a real production system.
 */
type HostingDiagramKind =
  | 'mental-model'
  | 'dns-delegation'
  | 'migration-flow'
  | 'cloudflare-proxy'
  | 'github-pages'
  | 'cloudflare-pages'
  | 'vps-origin'
  | 'tls-modes'
  | 'email-dns'
  | 'debug-tree';

interface Props {
  kind: HostingDiagramKind;
  caption?: string;
}

const { kind, caption } = Astro.props;
const arrowId = `hosting-arrow-${kind}`;
---

<figure class="diagram">
  {
    kind === 'mental-model' && (
      <svg
        viewBox="0 0 760 270"
        role="img"
        aria-label={caption ?? 'Domain, DNS, CDN and hosting request path'}
      >
        <defs>
          <marker
            id={arrowId}
            markerWidth="9"
            markerHeight="9"
            refX="6.5"
            refY="3"
            orient="auto"
          >
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>

        <text x="20" y="24" class="d-title">
          CONTROL PLANE — ai quản lý tên và cấu hình?
        </text>
        {[
          ['Registrar', 'đăng ký · gia hạn · delegation'],
          ['Authoritative DNS', 'giữ DNS zone'],
          ['Hosting / origin', 'giữ file và app'],
        ].map((item, i) => (
          <g>
            <rect
              class={i === 1 ? 'd-accent' : 'd-box'}
              x={20 + i * 246}
              y="38"
              width="226"
              height="58"
              rx="6"
            />
            <text
              x={133 + i * 246}
              y="62"
              text-anchor="middle"
              class={i === 1 ? 'd-ta' : 'd-t'}
            >
              {item[0]}
            </text>
            <text x={133 + i * 246} y="80" text-anchor="middle" class="d-ts">
              {item[1]}
            </text>
            {i < 2 && (
              <line
                class="d-stroke"
                x1={246 + i * 246}
                y1="67"
                x2={264 + i * 246}
                y2="67"
                marker-end={`url(#${arrowId})`}
              />
            )}
          </g>
        ))}

        <text x="20" y="136" class="d-title">
          DATA PLANE — request của người đọc đi đường nào?
        </text>
        {[
          ['Browser', 'example.com'],
          ['DNS resolver', 'hỏi IP'],
          ['CDN / proxy', 'optional'],
          ['Origin', 'HTML · API'],
        ].map((item, i) => (
          <g>
            <rect
              class={i === 3 ? 'd-accent' : 'd-box2'}
              x={20 + i * 185}
              y="152"
              width="164"
              height="60"
              rx="6"
            />
            <text
              x={102 + i * 185}
              y="177"
              text-anchor="middle"
              class={i === 3 ? 'd-ta' : 'd-t'}
            >
              {item[0]}
            </text>
            <text x={102 + i * 185} y="196" text-anchor="middle" class="d-ts">
              {item[1]}
            </text>
            {i < 3 && (
              <line
                class="d-stroke"
                x1={184 + i * 185}
                y1="182"
                x2={203 + i * 185}
                y2="182"
                marker-end={`url(#${arrowId})`}
              />
            )}
          </g>
        ))}
        <text x="380" y="250" text-anchor="middle" class="d-note">
          Đổi nameserver chỉ đổi nơi quản lý DNS; nó không tự chuyển source
          code, database hay email.
        </text>
      </svg>
    )
  }

  {
    kind === 'dns-delegation' && (
      <svg
        viewBox="0 0 760 286"
        role="img"
        aria-label={caption ?? 'DNS delegation from registry to records'}
      >
        <defs>
          <marker
            id={arrowId}
            markerWidth="9"
            markerHeight="9"
            refX="6.5"
            refY="3"
            orient="auto"
          >
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <rect class="d-box" x="20" y="34" width="174" height="64" rx="6" />
        <text x="107" y="59" text-anchor="middle" class="d-t">
          Registrar / registry
        </text>
        <text x="107" y="78" text-anchor="middle" class="d-ts">
          NS delegation
        </text>

        <line
          class="d-stroke"
          x1="194"
          y1="66"
          x2="244"
          y2="66"
          marker-end={`url(#${arrowId})`}
        />
        <text x="219" y="54" text-anchor="middle" class="d-ts">
          NS
        </text>

        <rect class="d-accent" x="246" y="20" width="250" height="92" rx="6" />
        <text x="371" y="47" text-anchor="middle" class="d-ta">
          Authoritative nameservers
        </text>
        <text x="371" y="68" text-anchor="middle" class="d-ts">
          assigned nameserver #1
        </text>
        <text x="371" y="87" text-anchor="middle" class="d-ts">
          assigned nameserver #2
        </text>

        <line
          class="d-stroke"
          x1="496"
          y1="66"
          x2="546"
          y2="66"
          marker-end={`url(#${arrowId})`}
        />
        <text x="521" y="54" text-anchor="middle" class="d-ts">
          answers
        </text>

        <rect class="d-box" x="548" y="34" width="192" height="64" rx="6" />
        <text x="644" y="59" text-anchor="middle" class="d-t">
          Recursive resolver
        </text>
        <text x="644" y="78" text-anchor="middle" class="d-ts">
          cache theo TTL
        </text>

        <text x="20" y="150" class="d-title">
          DNS ZONE CỦA example.com
        </text>
        {[
          ['A', '@', '203.0.113.10'],
          ['CNAME', 'www', 'example.com'],
          ['MX', '@', 'mail provider'],
          ['TXT', '_dmarc', 'policy / verify'],
        ].map((row, i) => (
          <g>
            <rect
              class="d-box2"
              x="20"
              y={164 + i * 27}
              width="720"
              height="25"
              rx="3"
            />
            <text x="38" y={181 + i * 27} class="d-ta">
              {row[0]}
            </text>
            <text x="142" y={181 + i * 27} class="d-t">
              {row[1]}
            </text>
            <text x="300" y={181 + i * 27} class="d-ts">
              {row[2]}
            </text>
          </g>
        ))}
      </svg>
    )
  }

  {
    kind === 'migration-flow' && (
      <svg
        viewBox="0 0 760 280"
        role="img"
        aria-label={caption ?? 'Safe DNS migration flow with rollback'}
      >
        <defs>
          <marker
            id={arrowId}
            markerWidth="9"
            markerHeight="9"
            refX="6.5"
            refY="3"
            orient="auto"
          >
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        {[
          ['1 · Inventory', 'A · MX · TXT · CAA'],
          ['2 · Rebuild zone', 'new DNS, not active yet'],
          ['3 · Verify direct', 'query new authority'],
          ['4 · Cut over', 'change NS or A/AAAA'],
          ['5 · Observe', 'web · mail · TLS · logs'],
        ].map((item, i) => (
          <g>
            <rect
              class={i === 3 ? 'd-accent' : 'd-box'}
              x={12 + i * 150}
              y="54"
              width="136"
              height="70"
              rx="6"
            />
            <text
              x={80 + i * 150}
              y="80"
              text-anchor="middle"
              class={i === 3 ? 'd-ta' : 'd-t'}
            >
              {item[0]}
            </text>
            <text x={80 + i * 150} y="101" text-anchor="middle" class="d-ts">
              {item[1]}
            </text>
            {i < 4 && (
              <line
                class="d-stroke"
                x1={148 + i * 150}
                y1="89"
                x2={163 + i * 150}
                y2="89"
                marker-end={`url(#${arrowId})`}
              />
            )}
          </g>
        ))}

        <path
          class="d-rollback"
          d="M680 136 C680 224, 230 232, 90 144"
          marker-end={`url(#${arrowId})`}
        />
        <text x="380" y="226" text-anchor="middle" class="d-warn">
          Rollback còn khả thi khi origin cũ, zone cũ và dữ liệu vẫn được giữ
          nguyên.
        </text>
        <text x="380" y="256" text-anchor="middle" class="d-note">
          Không xóa hệ thống cũ ngay sau khi một máy của bạn thấy DNS mới.
        </text>
      </svg>
    )
  }

  {
    kind === 'cloudflare-proxy' && (
      <svg
        viewBox="0 0 760 270"
        role="img"
        aria-label={caption ?? 'Cloudflare DNS-only versus proxied traffic'}
      >
        <defs>
          <marker
            id={arrowId}
            markerWidth="9"
            markerHeight="9"
            refX="6.5"
            refY="3"
            orient="auto"
          >
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <text x="20" y="28" class="d-title">
          DNS ONLY — cloud xám
        </text>
        {[
          ['Browser', 'request'],
          ['Cloudflare DNS', 'trả origin IP'],
          ['Hostinger / VPS', 'nhận trực tiếp'],
        ].map((item, i) => (
          <g>
            <rect
              class="d-box"
              x={20 + i * 250}
              y="44"
              width="210"
              height="58"
              rx="6"
            />
            <text x={125 + i * 250} y="68" text-anchor="middle" class="d-t">
              {item[0]}
            </text>
            <text x={125 + i * 250} y="87" text-anchor="middle" class="d-ts">
              {item[1]}
            </text>
            {i < 2 && (
              <line
                class="d-stroke"
                x1={230 + i * 250}
                y1="73"
                x2={267 + i * 250}
                y2="73"
                marker-end={`url(#${arrowId})`}
              />
            )}
          </g>
        ))}

        <text x="20" y="154" class="d-title">
          PROXIED — cloud cam
        </text>
        {[
          ['Browser', 'HTTPS'],
          ['Cloudflare edge', 'WAF · CDN · TLS'],
          ['Hostinger / VPS', 'origin'],
        ].map((item, i) => (
          <g>
            <rect
              class={i === 1 ? 'd-accent' : 'd-box2'}
              x={20 + i * 250}
              y="170"
              width="210"
              height="58"
              rx="6"
            />
            <text
              x={125 + i * 250}
              y="194"
              text-anchor="middle"
              class={i === 1 ? 'd-ta' : 'd-t'}
            >
              {item[0]}
            </text>
            <text x={125 + i * 250} y="213" text-anchor="middle" class="d-ts">
              {item[1]}
            </text>
            {i < 2 && (
              <line
                class="d-stroke"
                x1={230 + i * 250}
                y1="199"
                x2={267 + i * 250}
                y2="199"
                marker-end={`url(#${arrowId})`}
              />
            )}
          </g>
        ))}
        <text x="380" y="258" text-anchor="middle" class="d-note">
          MX, mail host và record xác minh thường phải để DNS only.
        </text>
      </svg>
    )
  }

  {
    kind === 'github-pages' && (
      <svg
        viewBox="0 0 760 276"
        role="img"
        aria-label={caption ?? 'Custom domain pointing to GitHub Pages'}
      >
        <defs>
          <marker
            id={arrowId}
            markerWidth="9"
            markerHeight="9"
            refX="6.5"
            refY="3"
            orient="auto"
          >
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <rect class="d-box" x="20" y="26" width="190" height="74" rx="6" />
        <text x="115" y="52" text-anchor="middle" class="d-t">
          DNS provider
        </text>
        <text x="115" y="72" text-anchor="middle" class="d-ts">
          apex: A / ALIAS
        </text>
        <text x="115" y="89" text-anchor="middle" class="d-ts">
          www: CNAME
        </text>

        <line
          class="d-stroke"
          x1="210"
          y1="63"
          x2="280"
          y2="63"
          marker-end={`url(#${arrowId})`}
        />
        <rect class="d-accent" x="282" y="26" width="198" height="74" rx="6" />
        <text x="381" y="52" text-anchor="middle" class="d-ta">
          GitHub Pages
        </text>
        <text x="381" y="72" text-anchor="middle" class="d-ts">
          custom domain binding
        </text>
        <text x="381" y="89" text-anchor="middle" class="d-ts">
          certificate + redirect
        </text>

        <line
          class="d-stroke"
          x1="480"
          y1="63"
          x2="548"
          y2="63"
          marker-end={`url(#${arrowId})`}
        />
        <rect class="d-box" x="550" y="26" width="190" height="74" rx="6" />
        <text x="645" y="52" text-anchor="middle" class="d-t">
          Published site
        </text>
        <text x="645" y="72" text-anchor="middle" class="d-ts">
          https://example.com
        </text>
        <text x="645" y="89" text-anchor="middle" class="d-ts">
          base path: /
        </text>

        <text x="20" y="146" class="d-title">
          SAFE ORDER
        </text>
        {[
          ['1', 'Verify owner', 'TXT at profile'],
          ['2', 'Bind domain', 'repo Settings → Pages'],
          ['3', 'Publish DNS', 'A + CNAME'],
          ['4', 'Enforce HTTPS', 'after certificate'],
        ].map((item, i) => (
          <g>
            <rect
              class="d-box2"
              x={20 + i * 185}
              y="164"
              width="166"
              height="66"
              rx="5"
            />
            <text x={38 + i * 185} y="188" class="d-ta">
              {item[0]}
            </text>
            <text x={62 + i * 185} y="188" class="d-t">
              {item[1]}
            </text>
            <text x={103 + i * 185} y="211" text-anchor="middle" class="d-ts">
              {item[2]}
            </text>
          </g>
        ))}
        <text x="380" y="262" text-anchor="middle" class="d-note">
          CNAME của www trỏ tới &lt;user&gt;.github.io — không thêm tên
          repository.
        </text>
      </svg>
    )
  }

  {
    kind === 'cloudflare-pages' && (
      <svg
        viewBox="0 0 760 260"
        role="img"
        aria-label={caption ?? 'Cloudflare Pages build and custom domain flow'}
      >
        <defs>
          <marker
            id={arrowId}
            markerWidth="9"
            markerHeight="9"
            refX="6.5"
            refY="3"
            orient="auto"
          >
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        {[
          ['Git repository', 'source + lockfile'],
          ['Pages build', 'install → build'],
          ['Deployment', 'immutable assets'],
          ['Cloudflare edge', 'custom domain'],
        ].map((item, i) => (
          <g>
            <rect
              class={i === 3 ? 'd-accent' : 'd-box'}
              x={15 + i * 188}
              y="54"
              width="170"
              height="70"
              rx="6"
            />
            <text
              x={100 + i * 188}
              y="81"
              text-anchor="middle"
              class={i === 3 ? 'd-ta' : 'd-t'}
            >
              {item[0]}
            </text>
            <text x={100 + i * 188} y="102" text-anchor="middle" class="d-ts">
              {item[1]}
            </text>
            {i < 3 && (
              <line
                class="d-stroke"
                x1={185 + i * 188}
                y1="89"
                x2={202 + i * 188}
                y2="89"
                marker-end={`url(#${arrowId})`}
              />
            )}
          </g>
        ))}
        <rect class="d-box2" x="130" y="170" width="214" height="48" rx="5" />
        <text x="237" y="190" text-anchor="middle" class="d-t">
          Production branch
        </text>
        <text x="237" y="207" text-anchor="middle" class="d-ts">
          example.com
        </text>
        <rect class="d-box2" x="416" y="170" width="214" height="48" rx="5" />
        <text x="523" y="190" text-anchor="middle" class="d-t">
          Preview branch / PR
        </text>
        <text x="523" y="207" text-anchor="middle" class="d-ts">
          unique preview URL
        </text>
        <text x="380" y="248" text-anchor="middle" class="d-note">
          Build success creates a new deployment; DNS does not move for every
          commit.
        </text>
      </svg>
    )
  }

  {
    kind === 'vps-origin' && (
      <svg
        viewBox="0 0 760 292"
        role="img"
        aria-label={caption ?? 'VPS hosting stack behind Nginx'}
      >
        <defs>
          <marker
            id={arrowId}
            markerWidth="9"
            markerHeight="9"
            refX="6.5"
            refY="3"
            orient="auto"
          >
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <rect class="d-box" x="18" y="102" width="132" height="56" rx="6" />
        <text x="84" y="126" text-anchor="middle" class="d-t">
          Internet
        </text>
        <text x="84" y="145" text-anchor="middle" class="d-ts">
          80 / 443 only
        </text>
        <line
          class="d-stroke"
          x1="150"
          y1="130"
          x2="202"
          y2="130"
          marker-end={`url(#${arrowId})`}
        />

        <rect
          class="d-stroke"
          x="204"
          y="28"
          width="538"
          height="238"
          rx="8"
          stroke-dasharray="6 5"
        />
        <text x="222" y="50" class="d-title">
          VPS · 203.0.113.10
        </text>

        <rect class="d-accent" x="228" y="84" width="170" height="92" rx="6" />
        <text x="313" y="111" text-anchor="middle" class="d-ta">
          Nginx
        </text>
        <text x="313" y="132" text-anchor="middle" class="d-ts">
          TLS termination
        </text>
        <text x="313" y="151" text-anchor="middle" class="d-ts">
          reverse proxy
        </text>

        <line
          class="d-stroke"
          x1="398"
          y1="130"
          x2="454"
          y2="130"
          marker-end={`url(#${arrowId})`}
        />
        <text x="426" y="119" text-anchor="middle" class="d-ts">
          127.0.0.1:3000
        </text>

        <rect class="d-box" x="456" y="84" width="170" height="92" rx="6" />
        <text x="541" y="111" text-anchor="middle" class="d-t">
          Application
        </text>
        <text x="541" y="132" text-anchor="middle" class="d-ts">
          systemd / container
        </text>
        <text x="541" y="151" text-anchor="middle" class="d-ts">
          health: /healthz
        </text>

        <line
          class="d-stroke"
          x1="541"
          y1="176"
          x2="541"
          y2="210"
          marker-end={`url(#${arrowId})`}
        />
        <rect class="d-box2" x="456" y="212" width="170" height="36" rx="5" />
        <text x="541" y="235" text-anchor="middle" class="d-t">
          Database · private
        </text>

        <rect class="d-box2" x="646" y="84" width="76" height="164" rx="5" />
        <text x="684" y="111" text-anchor="middle" class="d-t">
          FW
        </text>
        <text x="684" y="136" text-anchor="middle" class="d-ts">
          22
        </text>
        <text x="684" y="155" text-anchor="middle" class="d-ts">
          80
        </text>
        <text x="684" y="174" text-anchor="middle" class="d-ts">
          443
        </text>
        <text x="684" y="214" text-anchor="middle" class="d-warn">
          no DB
        </text>
        <text x="380" y="286" text-anchor="middle" class="d-note">
          App và database không cần lộ port trực tiếp ra Internet.
        </text>
      </svg>
    )
  }

  {
    kind === 'tls-modes' && (
      <svg
        viewBox="0 0 760 300"
        role="img"
        aria-label={caption ?? 'Cloudflare TLS encryption modes'}
      >
        <defs>
          <marker
            id={arrowId}
            markerWidth="9"
            markerHeight="9"
            refX="6.5"
            refY="3"
            orient="auto"
          >
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        {[
          ['Flexible', 'HTTPS', 'HTTP', 'Không mã hóa tới origin'],
          ['Full', 'HTTPS', 'HTTPS', 'Mã hóa, không xác minh cert'],
          ['Full (strict)', 'HTTPS', 'HTTPS ✓', 'Verify hạn + hostname + CA'],
        ].map((row, i) => (
          <g>
            <rect
              class={i === 2 ? 'd-accent' : 'd-box'}
              x="18"
              y={24 + i * 84}
              width="724"
              height="68"
              rx="6"
            />
            <text x="38" y={52 + i * 84} class={i === 2 ? 'd-ta' : 'd-t'}>
              {row[0]}
            </text>
            <text x="218" y={52 + i * 84} text-anchor="middle" class="d-ts">
              Visitor
            </text>
            <text x="218" y={73 + i * 84} text-anchor="middle" class="d-t">
              {row[1]}
            </text>
            <line
              class="d-stroke"
              x1="258"
              y1={59 + i * 84}
              x2="334"
              y2={59 + i * 84}
              marker-end={`url(#${arrowId})`}
            />
            <text x="382" y={52 + i * 84} text-anchor="middle" class="d-ts">
              Cloudflare → origin
            </text>
            <text
              x="382"
              y={73 + i * 84}
              text-anchor="middle"
              class={i === 2 ? 'd-ta' : 'd-t'}
            >
              {row[2]}
            </text>
            <text
              x="720"
              y={64 + i * 84}
              text-anchor="end"
              class={i === 0 ? 'd-warn' : 'd-note'}
            >
              {row[3]}
            </text>
          </g>
        ))}
        <text x="380" y="294" text-anchor="middle" class="d-note">
          Mục tiêu production: Full (strict), với certificate khớp hostname ở
          origin.
        </text>
      </svg>
    )
  }

  {
    kind === 'email-dns' && (
      <svg
        viewBox="0 0 760 292"
