---
import { withBase } from '~/lib/site-config';
import type { SeriesContext } from '~/lib/series';

interface Props {
  context: SeriesContext;
}

const { context } = Astro.props;
const { id, meta, parts, total, current, prev, next } = context;
---

<nav
  aria-label={`${meta.title} series navigation`}
  class="not-prose my-10 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-5"
>
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <p class="terminal-label">Series · Part {current} / {total}</p>
    <a
      href={withBase(`/series/${id}`)}
      class="text-xs tracking-wider text-[var(--color-fg-subtle)] uppercase hover:text-[var(--color-accent)]"
    >
      View series overview {'>'}
    </a>
  </div>

  <a
    href={withBase(`/series/${id}`)}
    class="mt-1 inline-block text-lg font-semibold tracking-tight hover:text-[var(--color-accent)]"
  >
    {meta.title}
  </a>

  <ol class="mt-4 space-y-1">
    {
      parts.map((part) => {
        const isCurrent = part.id === parts[current - 1]?.id;
        const order = part.data.seriesOrder;
        return (
          <li>
            {isCurrent ? (
              <span class="flex items-baseline gap-2 rounded-sm bg-[var(--color-bg)] px-2 py-1.5 text-sm">
                <span class="shrink-0 font-mono text-[var(--color-accent)]">
                  {String(order).padStart(2, '0')}
                </span>
                <span class="font-medium text-[var(--color-fg)]">
                  {part.data.title}
                </span>
                <span class="ml-auto shrink-0 text-xs text-[var(--color-fg-subtle)] uppercase">
                  You are here
                </span>
              </span>
            ) : (
              <a
                href={withBase(`/blog/${part.id}`)}
                class="group flex items-baseline gap-2 rounded-sm px-2 py-1.5 text-sm hover:bg-[var(--color-bg)]"
              >
                <span class="shrink-0 font-mono text-[var(--color-fg-subtle)] group-hover:text-[var(--color-accent)]">
                  {String(order).padStart(2, '0')}
                </span>
                <span class="text-[var(--color-fg-muted)] group-hover:text-[var(--color-fg)]">
                  {part.data.title}
                </span>
              </a>
            )}
          </li>
        );
      })
    }
  </ol>

  {
    (prev || next) && (
      <div class="mt-4 flex items-stretch justify-between gap-3 border-t border-dashed border-[var(--color-border-strong)] pt-4">
        {prev ? (
          <a
            href={withBase(`/blog/${prev.id}`)}
            class="group flex max-w-[48%] flex-col gap-0.5 text-left"
          >
            <span class="text-xs tracking-wider text-[var(--color-fg-subtle)] uppercase">
              {'<'} Previous
            </span>
            <span class="text-sm text-[var(--color-fg-muted)] group-hover:text-[var(--color-accent)]">
              {prev.data.title}
            </span>
          </a>
        ) : (
          <span />
        )}
        {next ? (
          <a
            href={withBase(`/blog/${next.id}`)}
            class="group flex max-w-[48%] flex-col gap-0.5 text-right"
          >
            <span class="text-xs tracking-wider text-[var(--color-fg-subtle)] uppercase">
              Next {'>'}
            </span>
            <span class="text-sm text-[var(--color-fg-muted)] group-hover:text-[var(--color-accent)]">
              {next.data.title}
            </span>
          </a>
        ) : (
          <span />
        )}
      </div>
    )
  }
</nav>
