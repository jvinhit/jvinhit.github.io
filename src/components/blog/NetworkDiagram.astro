---
/**
 * Inline-SVG diagrams for the "Network Programming" series.
 * Self-hosted, theme-aware (design tokens), one diagram per `kind`.
 */
type NetworkKind =
  | 'layers'
  | 'tcp-handshake'
  | 'udp'
  | 'dns'
  | 'http'
  | 'websocket'
  | 'tls'
  | 'framing'
  | 'scaling'
  | 'debugging';

interface Props {
  kind: NetworkKind;
  caption?: string;
}

const { kind, caption } = Astro.props;
const a = `nd-arrow-${kind}`;
---

<figure class="diagram">
  {
    kind === 'layers' && (
      <svg viewBox="0 0 720 240" role="img" aria-label={caption ?? 'TCP/IP model layers'}>
        {[
          ['Application', 'HTTP · DNS · WebSocket · TLS', 'what your code speaks'],
          ['Transport', 'TCP · UDP · ports', 'process-to-process'],
          ['Internet', 'IP · routing · addresses', 'host-to-host'],
          ['Link', 'Ethernet · Wi-Fi · frames', 'wire / radio'],
        ].map((t, i) => (
          <g>
            <rect class={i === 1 ? 'd-accent' : 'd-box'} x="40" y={16 + i * 54} width="640" height="46" rx="5" />
            <text x="58" y={38 + i * 54} class={i === 1 ? 'd-ta' : 'd-t'}>{t[0]}</text>
            <text x="58" y={54 + i * 54} class="d-ts">{t[1]}</text>
            <text x="662" y={45 + i * 54} text-anchor="end" class="d-ts">{t[2]}</text>
          </g>
        ))}
        <text x="360" y="234" text-anchor="middle" class="d-ts">data goes down the stack to send, up the stack to receive</text>
      </svg>
    )
  }

  {
    kind === 'tcp-handshake' && (
      <svg viewBox="0 0 720 220" role="img" aria-label={caption ?? 'TCP three-way handshake'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <rect class="d-box" x="40" y="20" width="150" height="40" rx="5" />
        <text x="115" y="45" text-anchor="middle" class="d-t">Client</text>
        <rect class="d-box" x="530" y="20" width="150" height="40" rx="5" />
        <text x="605" y="45" text-anchor="middle" class="d-t">Server</text>
        <line class="d-stroke" x1="115" y1="60" x2="115" y2="200" />
        <line class="d-stroke" x1="605" y1="60" x2="605" y2="200" />
        <line class="d-stroke" x1="120" y1="90" x2="600" y2="90" marker-end={`url(#${a})`} />
        <text x="360" y="82" text-anchor="middle" class="d-ta">SYN</text>
        <line class="d-stroke" x1="600" y1="130" x2="120" y2="130" marker-end={`url(#${a})`} />
        <text x="360" y="122" text-anchor="middle" class="d-ta">SYN + ACK</text>
        <line class="d-stroke" x1="120" y1="170" x2="600" y2="170" marker-end={`url(#${a})`} />
        <text x="360" y="162" text-anchor="middle" class="d-ta">ACK</text>
        <text x="360" y="200" text-anchor="middle" class="d-ts">connection established → reliable, ordered byte stream</text>
      </svg>
    )
  }

  {
    kind === 'udp' && (
      <svg viewBox="0 0 720 200" role="img" aria-label={caption ?? 'UDP connectionless datagrams'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <rect class="d-box" x="30" y="78" width="150" height="48" rx="5" />
        <text x="105" y="107" text-anchor="middle" class="d-t">Sender</text>
        <rect class="d-box" x="540" y="78" width="150" height="48" rx="5" />
        <text x="615" y="107" text-anchor="middle" class="d-t">Receiver</text>
        {[40, 90, 140].map((y, i) => (
          <g>
            <line class="d-stroke" x1="182" y1={y} x2="538" y2={y} marker-end={`url(#${a})`} />
            <rect class="d-accent" x={300 + i * 6} y={y - 12} width="60" height="22" rx="3" />
            <text x={330 + i * 6} y={y + 4} text-anchor="middle" class="d-ta">pkt {i + 1}</text>
          </g>
        ))}
        <text x="360" y="184" text-anchor="middle" class="d-ts">fire-and-forget · no handshake, no guarantee of order or delivery</text>
      </svg>
    )
  }

  {
    kind === 'dns' && (
      <svg viewBox="0 0 720 200" role="img" aria-label={caption ?? 'DNS resolution'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        {[
          ['Your app', 'example.com?'],
          ['Resolver', 'recursive cache'],
          ['Root + TLD', '.com servers'],
          ['Authoritative', '93.184.216.34'],
        ].map((t, i) => (
          <g>
            <rect class={i === 3 ? 'd-accent' : 'd-box'} x={12 + i * 178} y="56" width="156" height="58" rx="6" />
            <text x={90 + i * 178} y="82" text-anchor="middle" class={i === 3 ? 'd-ta' : 'd-t'}>{t[0]}</text>
            <text x={90 + i * 178} y="100" text-anchor="middle" class="d-ts">{t[1]}</text>
            {i < 3 && (
              <line class="d-stroke" x1={168 + i * 178} y1="85" x2={190 + i * 178} y2="85" marker-end={`url(#${a})`} />
            )}
          </g>
        ))}
        <text x="360" y="150" text-anchor="middle" class="d-ts">name → IP, so the socket knows where to connect (cached at each hop)</text>
      </svg>
    )
  }

  {
    kind === 'http' && (
      <svg viewBox="0 0 720 220" role="img" aria-label={caption ?? 'HTTP request and response over TCP'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <rect class="d-box" x="30" y="20" width="150" height="40" rx="5" />
        <text x="105" y="45" text-anchor="middle" class="d-t">Client</text>
        <rect class="d-box" x="540" y="20" width="150" height="40" rx="5" />
        <text x="615" y="45" text-anchor="middle" class="d-t">Server</text>
        <rect class="d-box2" x="200" y="74" width="320" height="58" rx="5" />
        <text x="216" y="96" class="d-ta">GET /users HTTP/1.1</text>
        <text x="216" y="114" class="d-ts">Host: api.example.com · headers · body</text>
        <line class="d-stroke" x1="180" y1="103" x2="538" y2="103" marker-end={`url(#${a})`} />
        <rect class="d-accent" x="200" y="142" width="320" height="58" rx="5" />
        <text x="216" y="164" class="d-ta">HTTP/1.1 200 OK</text>
        <text x="216" y="182" class="d-ts">Content-Type · headers · JSON body</text>
        <line class="d-stroke" x1="520" y1="171" x2="182" y2="171" marker-end={`url(#${a})`} />
        <text x="360" y="216" text-anchor="middle" class="d-ts">request/response text framed over one TCP connection (keep-alive reuses it)</text>
      </svg>
    )
  }

  {
    kind === 'websocket' && (
      <svg viewBox="0 0 720 220" role="img" aria-label={caption ?? 'WebSocket upgrade then bidirectional frames'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <rect class="d-box" x="40" y="20" width="150" height="40" rx="5" />
        <text x="115" y="45" text-anchor="middle" class="d-t">Client</text>
        <rect class="d-box" x="530" y="20" width="150" height="40" rx="5" />
        <text x="605" y="45" text-anchor="middle" class="d-t">Server</text>
        <line class="d-stroke" x1="115" y1="60" x2="115" y2="200" />
        <line class="d-stroke" x1="605" y1="60" x2="605" y2="200" />
        <line class="d-stroke" x1="120" y1="88" x2="600" y2="88" marker-end={`url(#${a})`} />
        <text x="360" y="80" text-anchor="middle" class="d-ts">GET … Upgrade: websocket</text>
        <line class="d-stroke" x1="600" y1="118" x2="120" y2="118" marker-end={`url(#${a})`} />
        <text x="360" y="110" text-anchor="middle" class="d-ts">101 Switching Protocols</text>
        <line class="d-accent" x1="120" y1="156" x2="600" y2="156" marker-end={`url(#${a})`} style="stroke:var(--color-accent)" />
        <line class="d-accent" x1="600" y1="180" x2="120" y2="180" marker-end={`url(#${a})`} style="stroke:var(--color-accent)" />
        <text x="360" y="148" text-anchor="middle" class="d-ta">frames ↔ frames (full-duplex)</text>
        <text x="360" y="200" text-anchor="middle" class="d-ts">one handshake, then both sides push messages anytime</text>
      </svg>
    )
  }

  {
    kind === 'tls' && (
      <svg viewBox="0 0 720 230" role="img" aria-label={caption ?? 'TLS handshake'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <rect class="d-box" x="40" y="20" width="150" height="40" rx="5" />
        <text x="115" y="45" text-anchor="middle" class="d-t">Client</text>
        <rect class="d-box" x="530" y="20" width="150" height="40" rx="5" />
        <text x="605" y="45" text-anchor="middle" class="d-t">Server</text>
        <line class="d-stroke" x1="115" y1="60" x2="115" y2="210" />
        <line class="d-stroke" x1="605" y1="60" x2="605" y2="210" />
        <line class="d-stroke" x1="120" y1="86" x2="600" y2="86" marker-end={`url(#${a})`} />
        <text x="360" y="78" text-anchor="middle" class="d-ts">ClientHello (ciphers)</text>
        <line class="d-stroke" x1="600" y1="116" x2="120" y2="116" marker-end={`url(#${a})`} />
        <text x="360" y="108" text-anchor="middle" class="d-ts">ServerHello + certificate</text>
        <line class="d-stroke" x1="120" y1="146" x2="600" y2="146" marker-end={`url(#${a})`} />
        <text x="360" y="138" text-anchor="middle" class="d-ts">key exchange · verify cert</text>
        <rect class="d-accent" x="200" y="166" width="320" height="34" rx="5" />
        <text x="360" y="188" text-anchor="middle" class="d-ta">encrypted channel ready</text>
        <text x="360" y="222" text-anchor="middle" class="d-ts">certificate proves identity; keys encrypt everything after</text>
      </svg>
    )
  }

  {
    kind === 'framing' && (
      <svg viewBox="0 0 720 210" role="img" aria-label={caption ?? 'Message framing over a TCP byte stream'}>
        <text x="40" y="34" class="d-title">TCP delivers a BYTE STREAM — no message boundaries</text>
        {Array.from({ length: 14 }).map((_, i) => (
          <rect class="d-box2" x={40 + i * 44} y="46" width="40" height="34" rx="3" />
        ))}
        <text x="360" y="68" text-anchor="middle" class="d-ts">…bytes keep arriving in arbitrary chunks…</text>
        <text x="40" y="124" class="d-title">YOU add framing — e.g. length prefix</text>
        {[
          ['len=5', 'HELLO'],
          ['len=3', 'BYE'],
          ['len=4', 'PING'],
        ].map((t, i) => (
          <g>
            <rect class="d-accent" x={40 + i * 210} y="136" width="60" height="40" rx="4" />
            <text x={70 + i * 210} y="161" text-anchor="middle" class="d-ta">{t[0]}</text>
            <rect class="d-box" x={102 + i * 210} y="136" width="96" height="40" rx="4" />
            <text x={150 + i * 210} y="161" text-anchor="middle" class="d-t">{t[1]}</text>
          </g>
        ))}
        <text x="360" y="200" text-anchor="middle" class="d-ts">buffer partial reads until a full frame arrives, then dispatch</text>
      </svg>
    )
  }

  {
    kind === 'scaling' && (
      <svg viewBox="0 0 720 220" role="img" aria-label={caption ?? 'Scaling network servers with workers'}>
        <defs>
          <marker id={a} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>
        <rect class="d-accent" x="280" y="20" width="160" height="50" rx="6" />
        <text x="360" y="42" text-anchor="middle" class="d-ta">listener :8080</text>
        <text x="360" y="60" text-anchor="middle" class="d-ts">accept + balance</text>
        {['worker 1', 'worker 2', 'worker 3', 'worker 4'].map((t, i) => (
          <g>
            <rect class="d-box" x={30 + i * 178} y="120" width="150" height="46" rx="5" />
            <text x={105 + i * 178} y="148" text-anchor="middle" class="d-t">{t}</text>
            <line class="d-stroke" x1="360" y1="70" x2={105 + i * 178} y2="118" marker-end={`url(#${a})`} />
          </g>
        ))}
        <text x="360" y="200" text-anchor="middle" class="d-ts">one event loop per core (cluster/workers) · spread connections across cores</text>
      </svg>
    )
  }

  {
    kind === 'debugging' && (
      <svg viewBox="0 0 720 220" role="img" aria-label={caption ?? 'Layered networking debug tools'}>
        {[
          ['curl · httpie', 'application requests'],
          ['nc (netcat) · openssl s_client', 'raw sockets & TLS'],
          ['tcpdump · Wireshark', 'packets on the wire'],
          ['ss · netstat · ping · traceroute', 'sockets & reachability'],
        ].map((t, i) => (
          <g>
            <rect class={i === 2 ? 'd-accent' : 'd-box'} x="40" y={16 + i * 48} width="640" height="40" rx="5" />
            <text x="58" y={41 + i * 48} class={i === 2 ? 'd-ta' : 'd-t'}>{t[0]}</text>
            <text x="662" y={41 + i * 48} text-anchor="end" class="d-ts">{t[1]}</text>
          </g>
        ))}
        <text x="360" y="214" text-anchor="middle" class="d-ts">pick the tool at the layer where the problem lives</text>
      </svg>
    )
  }

  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .diagram {
    margin: 1.5rem 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg);
    padding: 0.85rem 0.9rem 0.6rem;
  }
  .diagram svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .diagram figcaption {
    margin-top: 0.5rem;
    font-size: 0.72rem;
    color: var(--color-fg-muted);
    text-align: center;
    letter-spacing: 0.02em;
  }
  .diagram :global(text) {
    font-family: var(--font-mono);
  }
  .diagram :global(.d-box) {
    fill: var(--color-surface);
    stroke: var(--color-border);
    stroke-width: 1;
  }
  .diagram :global(.d-box2) {
    fill: var(--color-surface-2);
    stroke: var(--color-border);
    stroke-width: 1;
  }
  .diagram :global(.d-accent) {
    fill: color-mix(in srgb, var(--color-accent) 12%, transparent);
    stroke: var(--color-accent);
    stroke-width: 1;
  }
  .diagram :global(.d-stroke) {
    fill: none;
    stroke: var(--color-border-strong);
    stroke-width: 1.4;
  }
  .diagram :global(.d-arrowhead) {
    fill: var(--color-border-strong);
  }
  .diagram :global(.d-t) {
    fill: var(--color-fg);
    font-size: 13px;
  }
  .diagram :global(.d-tm) {
    fill: var(--color-fg-muted);
    font-size: 12px;
  }
  .diagram :global(.d-ts) {
    fill: var(--color-fg-subtle);
    font-size: 11px;
  }
  .diagram :global(.d-ta) {
    fill: var(--color-accent);
    font-size: 12.5px;
  }
  .diagram :global(.d-title) {
    fill: var(--color-fg-muted);
    font-size: 12px;
    letter-spacing: 0.1em;
  }
</style>
