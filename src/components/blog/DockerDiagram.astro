---
/**
 * Inline-SVG architecture diagrams for the Docker → Compose → Kubernetes series.
 * Self-hosted, theme-aware (uses design tokens), and crisp at any width.
 * Pick a diagram via the `kind` prop.
 */
type DiagramKind =
  | 'vm-vs-container'
  | 'engine'
  | 'image-layers'
  | 'compose-stack'
  | 'k8s-cluster'
  | 'k8s-objects'
  | 'storage-mounts'
  | 'networking'
  | 'debug-flow'
  | 'probes';

interface Props {
  kind: DiagramKind;
  caption?: string;
}

const { kind, caption } = Astro.props;
const arrowId = `dd-arrow-${kind}`;
---

<figure class="diagram">
  {
    kind === 'vm-vs-container' && (
      <svg viewBox="0 0 720 300" role="img" aria-label={caption ?? 'Virtual machines vs containers'}>
        <text x="175" y="20" text-anchor="middle" class="d-title">VIRTUAL MACHINES</text>
        <text x="545" y="20" text-anchor="middle" class="d-title">CONTAINERS</text>

        {/* shared base — VM */}
        <rect class="d-box2" x="12" y="262" width="326" height="26" rx="3" />
        <text x="175" y="279" text-anchor="middle" class="d-tm">Hardware</text>
        <rect class="d-box2" x="12" y="234" width="326" height="26" rx="3" />
        <text x="175" y="251" text-anchor="middle" class="d-tm">Host OS</text>
        <rect class="d-box" x="12" y="206" width="326" height="26" rx="3" />
        <text x="175" y="223" text-anchor="middle" class="d-t">Hypervisor</text>

        {/* VM columns: App / Bins / Guest OS */}
        {[12, 119, 226].map((x) => (
          <g>
            <rect class="d-accent" x={x} y="44" width="103" height="48" rx="3" />
            <text x={x + 51} y="73" text-anchor="middle" class="d-ta">App</text>
            <rect class="d-box2" x={x} y="96" width="103" height="48" rx="3" />
            <text x={x + 51} y="125" text-anchor="middle" class="d-ts">Bins/Libs</text>
            <rect class="d-box2" x={x} y="148" width="103" height="52" rx="3" />
            <text x={x + 51} y="178" text-anchor="middle" class="d-tm">Guest OS</text>
          </g>
        ))}

        {/* shared base — Containers */}
        <rect class="d-box2" x="382" y="262" width="326" height="26" rx="3" />
        <text x="545" y="279" text-anchor="middle" class="d-tm">Hardware</text>
        <rect class="d-box2" x="382" y="234" width="326" height="26" rx="3" />
        <text x="545" y="251" text-anchor="middle" class="d-tm">Host OS</text>
        <rect class="d-box" x="382" y="206" width="326" height="26" rx="3" />
        <text x="545" y="223" text-anchor="middle" class="d-t">Docker Engine (shared kernel)</text>

        {/* Container columns: App / Bins only — no guest OS, lighter */}
        {[382, 489, 596].map((x) => (
          <g>
            <rect class="d-accent" x={x} y="96" width="103" height="48" rx="3" />
            <text x={x + 51} y="125" text-anchor="middle" class="d-ta">App</text>
            <rect class="d-box2" x={x} y="148" width="103" height="52" rx="3" />
            <text x={x + 51} y="178" text-anchor="middle" class="d-ts">Bins/Libs</text>
          </g>
        ))}
      </svg>
    )
  }

  {
    kind === 'engine' && (
      <svg viewBox="0 0 720 230" role="img" aria-label={caption ?? 'Docker engine architecture'}>
        <defs>
          <marker id={arrowId} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>

        {/* client */}
        <rect class="d-box" x="14" y="70" width="156" height="92" rx="5" />
        <text x="92" y="100" text-anchor="middle" class="d-t">Docker CLI</text>
        <text x="92" y="122" text-anchor="middle" class="d-ts">docker build</text>
        <text x="92" y="138" text-anchor="middle" class="d-ts">docker run / pull</text>

        <line class="d-stroke" x1="170" y1="116" x2="214" y2="116" marker-end={`url(#${arrowId})`} />
        <text x="192" y="108" text-anchor="middle" class="d-ts">REST API</text>

        {/* daemon */}
        <rect class="d-box" x="216" y="26" width="318" height="178" rx="6" />
        <text x="375" y="48" text-anchor="middle" class="d-ta">Docker daemon (dockerd)</text>
        <rect class="d-box2" x="236" y="86" width="128" height="56" rx="4" />
        <text x="300" y="118" text-anchor="middle" class="d-t">Images</text>
        <rect class="d-accent" x="386" y="86" width="128" height="56" rx="4" />
        <text x="450" y="114" text-anchor="middle" class="d-ta">Containers</text>
        <text x="450" y="130" text-anchor="middle" class="d-ts">(running)</text>
        <line class="d-stroke" x1="364" y1="114" x2="384" y2="114" marker-end={`url(#${arrowId})`} />
        <text x="374" y="160" text-anchor="middle" class="d-ts">run</text>

        {/* registry */}
        <rect class="d-box" x="566" y="70" width="142" height="92" rx="5" />
        <text x="637" y="106" text-anchor="middle" class="d-t">Registry</text>
        <text x="637" y="126" text-anchor="middle" class="d-ts">Docker Hub</text>
        <line class="d-stroke" x1="534" y1="116" x2="564" y2="116" marker-end={`url(#${arrowId})`} />
        <line class="d-stroke" x1="564" y1="132" x2="536" y2="132" marker-end={`url(#${arrowId})`} />
        <text x="549" y="156" text-anchor="middle" class="d-ts">pull / push</text>
      </svg>
    )
  }

  {
    kind === 'image-layers' && (
      <svg viewBox="0 0 720 290" role="img" aria-label={caption ?? 'Image layers and the writable layer'}>
        <defs>
          <marker id={arrowId} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>

        <text x="150" y="22" text-anchor="middle" class="d-title">DOCKERFILE</text>
        <text x="540" y="22" text-anchor="middle" class="d-title">IMAGE LAYERS</text>

        {/* Dockerfile instructions (top→bottom) mapping to layers (bottom→top) */}
        {[
          { t: 'FROM node:24-alpine', y: 56 },
          { t: 'WORKDIR /app', y: 94 },
          { t: 'COPY package*.json .', y: 132 },
          { t: 'RUN npm ci', y: 170 },
          { t: 'COPY . .', y: 208 },
        ].map((row, i) => (
          <g>
            <rect class="d-box" x="14" y={row.y} width="272" height="30" rx="4" />
            <text x="26" y={row.y + 20} class="d-ts">{row.t}</text>
            <line class="d-stroke" x1="288" y1={row.y + 15} x2="406" y2={246 - i * 38 + 15} marker-end={`url(#${arrowId})`} />
          </g>
        ))}

        {/* writable layer on top */}
        <rect class="d-accent" x="408" y="46" width="300" height="34" rx="4" stroke-dasharray="5 4" />
        <text x="558" y="68" text-anchor="middle" class="d-ta">writable layer (per container)</text>
        {/* read-only layers */}
        {[
          { t: 'COPY . .', y: 86 },
          { t: 'RUN npm ci', y: 124 },
          { t: 'COPY package*.json .', y: 162 },
          { t: 'WORKDIR /app', y: 200 },
          { t: 'FROM node:24-alpine (base)', y: 238 },
        ].map((row) => (
          <g>
            <rect class="d-box2" x="408" y={row.y} width="300" height="34" rx="4" />
            <text x="558" y={row.y + 22} text-anchor="middle" class="d-tm">{row.t}</text>
          </g>
        ))}
        <text x="558" y="284" text-anchor="middle" class="d-ts">read-only, cached &amp; shared ↑</text>
      </svg>
    )
  }

  {
    kind === 'compose-stack' && (
      <svg viewBox="0 0 720 280" role="img" aria-label={caption ?? 'A Docker Compose stack on one network'}>
        <defs>
          <marker id={arrowId} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>

        <rect class="d-box" x="14" y="20" width="150" height="58" rx="5" />
        <text x="89" y="46" text-anchor="middle" class="d-ta">compose.yaml</text>
        <text x="89" y="64" text-anchor="middle" class="d-ts">3 services</text>
        <line class="d-stroke" x1="89" y1="78" x2="89" y2="108" marker-end={`url(#${arrowId})`} />
        <text x="150" y="98" text-anchor="middle" class="d-ts">up</text>

        {/* network boundary */}
        <rect class="d-stroke" x="40" y="110" width="668" height="150" rx="8" stroke-dasharray="6 5" />
        <text x="56" y="130" class="d-tm">network: appnet (auto-created)</text>

        {/* services */}
        <rect class="d-accent" x="64" y="150" width="150" height="64" rx="5" />
        <text x="139" y="178" text-anchor="middle" class="d-ta">web</text>
        <text x="139" y="196" text-anchor="middle" class="d-ts">build: .</text>

        <rect class="d-box2" x="285" y="150" width="150" height="64" rx="5" />
        <text x="360" y="178" text-anchor="middle" class="d-t">db</text>
        <text x="360" y="196" text-anchor="middle" class="d-ts">postgres</text>

        <rect class="d-box2" x="506" y="150" width="150" height="64" rx="5" />
        <text x="581" y="178" text-anchor="middle" class="d-t">redis</text>
        <text x="581" y="196" text-anchor="middle" class="d-ts">cache</text>

        {/* talk by service name */}
        <line class="d-stroke" x1="214" y1="174" x2="283" y2="174" marker-end={`url(#${arrowId})`} />
        <text x="248" y="166" text-anchor="middle" class="d-ts">db</text>
        <line class="d-stroke" x1="214" y1="196" x2="504" y2="196" marker-end={`url(#${arrowId})`} />
        <text x="430" y="212" text-anchor="middle" class="d-ts">redis</text>

        {/* volume under db */}
        <line class="d-stroke" x1="360" y1="214" x2="360" y2="236" marker-end={`url(#${arrowId})`} />
        <rect class="d-box" x="300" y="236" width="120" height="30" rx="14" />
        <text x="360" y="256" text-anchor="middle" class="d-ts">named volume</text>

        {/* host port to web */}
        <text x="139" y="138" text-anchor="middle" class="d-ts">:8080 → host</text>
      </svg>
    )
  }

  {
    kind === 'k8s-cluster' && (
      <svg viewBox="0 0 720 300" role="img" aria-label={caption ?? 'A Kubernetes cluster'}>
        <defs>
          <marker id={arrowId} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>

        {/* kubectl */}
        <rect class="d-box" x="14" y="40" width="120" height="48" rx="5" />
        <text x="74" y="69" text-anchor="middle" class="d-ta">kubectl</text>
        <line class="d-stroke" x1="134" y1="64" x2="178" y2="64" marker-end={`url(#${arrowId})`} />
        <text x="156" y="56" text-anchor="middle" class="d-ts">apply</text>

        {/* control plane */}
        <rect class="d-box" x="180" y="20" width="526" height="92" rx="6" />
        <text x="196" y="40" class="d-ta">Control plane</text>
        {[
          { t: 'api-server', x: 196 },
          { t: 'scheduler', x: 326 },
          { t: 'controller-mgr', x: 456 },
          { t: 'etcd', x: 596 },
        ].map((b) => (
          <g>
            <rect class="d-box2" x={b.x} y="52" width="118" height="44" rx="4" />
            <text x={b.x + 59} y="79" text-anchor="middle" class="d-tm">{b.t}</text>
          </g>
        ))}

        {/* worker nodes */}
        {[14, 366].map((nx) => (
          <g>
            <rect class="d-box" x={nx} y="140" width="340" height="146" rx="6" />
            <text x={nx + 16} y="162" class="d-t">Worker node</text>
            <text x={nx + 16} y="180" class="d-ts">kubelet · kube-proxy · runtime</text>
            <rect class="d-accent" x={nx + 16} y="194" width="148" height="74" rx="4" />
            <text x={nx + 90} y="226" text-anchor="middle" class="d-ta">Pod</text>
            <text x={nx + 90} y="244" text-anchor="middle" class="d-ts">container(s)</text>
            <rect class="d-accent" x={nx + 176} y="194" width="148" height="74" rx="4" />
            <text x={nx + 250} y="226" text-anchor="middle" class="d-ta">Pod</text>
            <text x={nx + 250} y="244" text-anchor="middle" class="d-ts">container(s)</text>
          </g>
        ))}
        <line class="d-stroke" x1="300" y1="112" x2="220" y2="138" marker-end={`url(#${arrowId})`} />
        <line class="d-stroke" x1="500" y1="112" x2="560" y2="138" marker-end={`url(#${arrowId})`} />
        <text x="360" y="128" text-anchor="middle" class="d-ts">schedule pods → nodes</text>
      </svg>
    )
  }

  {
    kind === 'k8s-objects' && (
      <svg viewBox="0 0 720 250" role="img" aria-label={caption ?? 'Deployment, ReplicaSet, Pods and Service'}>
        <defs>
          <marker id={arrowId} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>

        <rect class="d-box" x="14" y="96" width="132" height="56" rx="5" />
        <text x="80" y="120" text-anchor="middle" class="d-t">Deployment</text>
        <text x="80" y="138" text-anchor="middle" class="d-ts">replicas: 3</text>
        <line class="d-stroke" x1="146" y1="124" x2="186" y2="124" marker-end={`url(#${arrowId})`} />

        <rect class="d-box" x="188" y="96" width="132" height="56" rx="5" />
        <text x="254" y="120" text-anchor="middle" class="d-t">ReplicaSet</text>
        <text x="254" y="138" text-anchor="middle" class="d-ts">keeps 3 alive</text>

        {/* pods */}
        {[40, 112, 184].map((py, i) => (
          <g>
            <rect class="d-accent" x="372" y={py} width="120" height="52" rx="5" />
            <text x="432" y={py + 31} text-anchor="middle" class="d-ta">{`Pod ${i + 1}`}</text>
            <line class="d-stroke" x1="320" y1="124" x2="370" y2={py + 26} marker-end={`url(#${arrowId})`} />
          </g>
        ))}

        {/* service */}
        <rect class="d-box" x="556" y="96" width="148" height="56" rx="5" />
        <text x="630" y="120" text-anchor="middle" class="d-ta">Service</text>
        <text x="630" y="138" text-anchor="middle" class="d-ts">stable VIP · LB</text>
        {[66, 138, 210].map((py) => (
          <line class="d-stroke" x1="554" y1="124" x2="494" y2={py} marker-end={`url(#${arrowId})`} />
        ))}
        <text x="630" y="186" text-anchor="middle" class="d-ts">traffic in →</text>
      </svg>
    )
  }

  {
    kind === 'storage-mounts' && (
      <svg viewBox="0 0 720 250" role="img" aria-label={caption ?? 'Volumes vs bind mounts vs tmpfs'}>
        <defs>
          <marker id={arrowId} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>

        <rect class="d-box" x="12" y="18" width="696" height="56" rx="6" />
        <text x="26" y="40" class="d-t">Container</text>
        <text x="130" y="60" text-anchor="middle" class="d-ta">/data</text>
        <text x="360" y="60" text-anchor="middle" class="d-ta">/app</text>
        <text x="590" y="60" text-anchor="middle" class="d-ta">/tmp</text>

        {[130, 360, 590].map((x) => (
          <line class="d-stroke" x1={x} y1="74" x2={x} y2="148" marker-end={`url(#${arrowId})`} />
        ))}

        <rect class="d-accent" x="30" y="150" width="200" height="72" rx="5" />
        <text x="130" y="180" text-anchor="middle" class="d-ta">Named volume</text>
        <text x="130" y="200" text-anchor="middle" class="d-ts">Docker-managed</text>

        <rect class="d-box2" x="260" y="150" width="200" height="72" rx="5" />
        <text x="360" y="180" text-anchor="middle" class="d-t">Bind mount</text>
        <text x="360" y="200" text-anchor="middle" class="d-ts">./src on host</text>

        <rect class="d-box2" x="490" y="150" width="200" height="72" rx="5" />
        <text x="590" y="180" text-anchor="middle" class="d-t">tmpfs</text>
        <text x="590" y="200" text-anchor="middle" class="d-ts">RAM only</text>

        <text x="130" y="240" text-anchor="middle" class="d-ts">persists ✓</text>
        <text x="360" y="240" text-anchor="middle" class="d-ts">persists ✓ · live edit</text>
        <text x="590" y="240" text-anchor="middle" class="d-ts">gone on stop ✗</text>
      </svg>
    )
  }

  {
    kind === 'networking' && (
      <svg viewBox="0 0 720 250" role="img" aria-label={caption ?? 'Default bridge vs user-defined bridge'}>
        <defs>
          <marker id={arrowId} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>

        <text x="175" y="18" text-anchor="middle" class="d-title">DEFAULT BRIDGE (docker0)</text>
        <text x="545" y="18" text-anchor="middle" class="d-title">USER-DEFINED: appnet</text>

        <rect class="d-stroke" x="12" y="30" width="326" height="200" rx="8" stroke-dasharray="6 5" />
        <rect class="d-box2" x="44" y="92" width="110" height="58" rx="5" />
        <text x="99" y="126" text-anchor="middle" class="d-t">app</text>
        <rect class="d-box2" x="196" y="92" width="110" height="58" rx="5" />
        <text x="251" y="126" text-anchor="middle" class="d-t">db</text>
        <line class="d-stroke" x1="154" y1="121" x2="194" y2="121" stroke-dasharray="4 4" />
        <text x="174" y="84" text-anchor="middle" class="d-ts">name? ✗</text>
        <text x="175" y="200" text-anchor="middle" class="d-ts">no DNS — must use container IPs</text>

        <rect class="d-stroke" x="382" y="30" width="326" height="200" rx="8" stroke-dasharray="6 5" />
        <rect class="d-accent" x="414" y="92" width="110" height="58" rx="5" />
        <text x="469" y="126" text-anchor="middle" class="d-ta">web</text>
        <rect class="d-box2" x="566" y="92" width="110" height="58" rx="5" />
        <text x="621" y="126" text-anchor="middle" class="d-t">db</text>
        <line class="d-stroke" x1="524" y1="121" x2="564" y2="121" marker-end={`url(#${arrowId})`} />
        <text x="544" y="84" text-anchor="middle" class="d-ta">db ✓</text>
        <text x="545" y="200" text-anchor="middle" class="d-ts">embedded DNS — reach by service name</text>
        <line class="d-stroke" x1="469" y1="60" x2="469" y2="90" marker-end={`url(#${arrowId})`} />
        <text x="469" y="52" text-anchor="middle" class="d-ts">:8080 host</text>
      </svg>
    )
  }

  {
    kind === 'debug-flow' && (
      <svg viewBox="0 0 720 175" role="img" aria-label={caption ?? 'Docker debugging method'}>
        <defs>
          <marker id={arrowId} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>

        {[
          { t: 'Observe', s: 'logs · ps · inspect', x: 14, accent: true },
          { t: 'Isolate', s: 'exec · events', x: 192, accent: false },
          { t: 'Reproduce', s: 'run --rm', x: 370, accent: false },
          { t: 'Fix', s: 'rebuild · config', x: 548, accent: true },
        ].map((b) => (
          <g>
            <rect class={b.accent ? 'd-accent' : 'd-box'} x={b.x} y="36" width="158" height="58" rx="5" />
            <text x={b.x + 79} y="64" text-anchor="middle" class={b.accent ? 'd-ta' : 'd-t'}>{b.t}</text>
            <text x={b.x + 79} y="82" text-anchor="middle" class="d-ts">{b.s}</text>
          </g>
        ))}
        <line class="d-stroke" x1="172" y1="65" x2="190" y2="65" marker-end={`url(#${arrowId})`} />
        <line class="d-stroke" x1="350" y1="65" x2="368" y2="65" marker-end={`url(#${arrowId})`} />
        <line class="d-stroke" x1="528" y1="65" x2="546" y2="65" marker-end={`url(#${arrowId})`} />
        <path class="d-stroke" d="M 627 94 C 627 145, 93 145, 93 96" marker-end={`url(#${arrowId})`} />
        <text x="360" y="162" text-anchor="middle" class="d-ts">verify → repeat until green</text>
      </svg>
    )
  }

  {
    kind === 'probes' && (
      <svg viewBox="0 0 720 220" role="img" aria-label={caption ?? 'Liveness and readiness probes'}>
        <defs>
          <marker id={arrowId} markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto">
            <path d="M0,0 L7,3 L0,6 Z" class="d-arrowhead" />
          </marker>
        </defs>

        <rect class="d-box" x="14" y="84" width="120" height="58" rx="5" />
        <text x="74" y="110" text-anchor="middle" class="d-ta">Service</text>
        <text x="74" y="128" text-anchor="middle" class="d-ts">traffic in</text>

        <line class="d-stroke" x1="134" y1="113" x2="316" y2="113" marker-end={`url(#${arrowId})`} />
        <text x="226" y="100" text-anchor="middle" class="d-ts">Ready? → traffic</text>
        <text x="226" y="132" text-anchor="middle" class="d-ts">(readiness gate)</text>

        <rect class="d-accent" x="318" y="40" width="220" height="150" rx="6" />
