    background: var(--color-surface-2) !important; border: 1px solid var(--color-border);
    border-radius: var(--radius-sm); padding: 11px 14px; font-family: var(--font-mono);
    font-size: 0.75rem; color: var(--color-fg); white-space: pre; overflow-x: auto;
