---
import '~/styles/global.css';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import ScrollToTop from '~/components/ui/ScrollToTop.astro';
import { SITE, withBase } from '~/lib/site-config';

interface Props {
  title?: string;
  description?: string;
  /** Ngôn ngữ của trang; fallback về SITE.lang. */
  lang?: 'en' | 'vi';
  /** Ảnh OG (absolute URL hoặc path tương đối với site) */
  ogImage?: string;
  /** Disable indexing cho drafts hoặc utility pages */
  noindex?: boolean;
  /** Canonical URL override — mặc định tính từ current path */
  canonical?: string;
  /** OG type — `article` cho bài viết, mặc định `website` cho page thường */
  ogType?: 'website' | 'article';
  /** Metadata cho og:type=article (chỉ render khi ogType === 'article') */
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    tags?: readonly string[];
  };
  /** JSON-LD structured data — 1 object hoặc mảng object, serialize ra <script> */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  lang = SITE.lang,
  ogImage,
  noindex = false,
  canonical,
  ogType = 'website',
  article,
  jsonLd,
} = Astro.props;

const pageLocale = lang === 'vi' ? 'vi_VN' : SITE.locale;

const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
// JSON-LD do chính site dựng (trusted). Escape `<` → `\u003c` để chuỗi không
// thể đóng sớm thẻ <script> (vd nếu title chứa "</script>").
const serializeJsonLd = (data: Record<string, unknown>): string =>
  JSON.stringify(data).replace(/</g, '\\u003c');

const pageTitle = title ? `${title} — ${SITE.name}` : SITE.name;
// Astro.url.pathname đã chứa base path, nên khi ghép vào Astro.site
// ta không prepend base thêm lần nữa để tránh double base.
const canonicalURL = canonical
  ? new URL(withBase(canonical), Astro.site).toString()
  : new URL(Astro.url.pathname, Astro.site).toString();
const ogImageURL = ogImage
  ? new URL(withBase(ogImage), Astro.site).toString()
  : new URL(withBase('/og-default.png'), Astro.site).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    {
      /* Sync flag để CSS/script biết môi trường client capabilities trước
       * khi paint đầu tiên — tránh FOUC cho hero typing animation VÀ theme.
       * Phải chạy blocking, trước khi <body> render, để class theme có mặt
       * ngay từ paint đầu tiên (không nhấp nháy dark↔light). */
    }
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
            d.classList.add('reduced-motion');
          }
        } catch (_) {
          /* matchMedia not available — leave default */
        }

        // Resolve theme: lựa chọn đã lưu > OS preference > fallback dark.
        var theme = 'dark';
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            theme = stored;
          } else if (matchMedia('(prefers-color-scheme: light)').matches) {
            theme = 'light';
          }
        } catch (_) {
          /* localStorage/matchMedia bị chặn → giữ dark default */
        }
        d.classList.add(theme);

        // Tạo meta theme-color khớp theme cho thanh địa chỉ mobile. Script
        // chạy trước khi meta tĩnh được parse, nên ta tự tạo & quản 1 thẻ
        // duy nhất (id) để toggle cập nhật sau này.
        var meta = document.createElement('meta');
        meta.name = 'theme-color';
        meta.id = 'meta-theme-color';
        meta.content = theme === 'light' ? '#ffffff' : '#0a0a0a';
        document.head.appendChild(meta);
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="canonical" href={canonicalURL} />

    {
      /* Warm up the GA4 connection early. `preconnect` opens DNS+TLS to the
       * tag-manager origin before the async gtag script requests it;
       * `dns-prefetch` is the fallback for browsers that ignore preconnect. */
    }
    <link
      rel="preconnect"
      href="https://www.googletagmanager.com"
      crossorigin
    />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {/* theme-color được inject động theo theme bởi inline script ở trên */}

    {
      /* Search engine ownership verification — tokens lấy từ Search Console
       * tương ứng. Render only-if-defined để dễ thêm/bớt provider sau này. */
    }
    {
      SITE.verification?.google && (
        <meta
          name="google-site-verification"
          content={SITE.verification.google}
        />
      )
    }

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author.name} />

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content={pageLocale} />

    {
      /* Article-specific OG — chỉ render cho bài viết để search engine &
       * social biết ngày đăng/cập nhật, tác giả và chủ đề. */
    }
    {
      ogType === 'article' && article && (
        <>
          {article.publishedTime && (
            <meta
              property="article:published_time"
              content={article.publishedTime}
            />
          )}
          {article.modifiedTime && (
            <meta
              property="article:modified_time"
              content={article.modifiedTime}
            />
          )}
          <meta property="article:author" content={SITE.author.name} />
          {article.tags?.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {/* Structured data (JSON-LD) */}
    {
      jsonLdBlocks.map((block) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={serializeJsonLd(block)}
        />
      ))
    }

    {/* RSS */}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} — RSS`}
      href={withBase('/rss.xml')}
    />

    <slot name="head" />

    {/* Google Analytics (GA4) */}
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-ETDF9RRP8D"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-ETDF9RRP8D');
    </script>
  </head>

  <body class="flex min-h-dvh flex-col">
    <Header pathname={Astro.url.pathname} />

    <main class="flex-1">
      <slot />
    </main>

    <Footer />

    <ScrollToTop />

    {
      /* Scroll & page-init reveal. The script itself opts into the hidden
       * initial state (adds `.reveal-ready`), so no-JS / blocked-JS keeps all
       * content visible. Skips entirely under prefers-reduced-motion. */
    }
    <script>
      (() => {
        const root = document.documentElement;
        const targets = Array.from(
          document.querySelectorAll<HTMLElement>(
            '[data-reveal], [data-reveal-group]'
          )
        );
        if (targets.length === 0) return;

        const prefersReduced =
          root.classList.contains('reduced-motion') ||
          window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // No IntersectionObserver or reduced motion → leave everything visible.
        if (prefersReduced || !('IntersectionObserver' in window)) return;

        // Opt in to the hidden-until-revealed CSS only now that we can reveal.
        root.classList.add('reveal-ready');

        const observer = new IntersectionObserver(
          (entries, obs) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              obs.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.1 }
        );

        for (const el of targets) observer.observe(el);
      })();
    </script>
  </body>
</html>
