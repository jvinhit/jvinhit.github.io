---
/**
 * PregnancyLayout — shell dùng chung cho khu private `/be-yeu-dotro/`
 * (spec 009-pregnancy-tracker): theo dõi thai kỳ của hai vợ chồng.
 *
 * Cố ý KHÔNG dùng BaseLayout, cùng lý do với love board (spec 005): tránh
 * GA4, nav/footer của site và OG/JSON-LD — khu này không muốn được track hay
 * share. Layout tự render full HTML shell + meta noindex; mọi route con bị
 * loại khỏi sitemap trong astro.config.mjs.
 *
 * Khác love board (một page tự chứa), khu này có nhiều route con nên phần
 * dùng chung — cổng đăng nhập, header với bộ đếm tuần, thanh điều hướng,
 * theme — sống ở layout; mỗi page chỉ render nội dung của mình trong <slot />
 * và tự có đúng một <h1>. Theme pastel scoped bằng CSS custom property
 * `--by-*` (bé yêu), không thêm token vào @theme của global.css.
 *
 * global.css vẫn được import để có Tailwind engine + focus ring; nền/font
 * dark-terminal của nó bị override trong <style> bên dưới.
 */
import '~/styles/global.css';
import { withBase } from '~/lib/site-config';

type NavKey =
  | 'home'
  | 'weeks'
  | 'journal'
  | 'appointments'
  | 'checklist'
  | 'guides'
  | 'settings';

interface Props {
  /** Tiêu đề tab trình duyệt — page tự render <h1> của nó trong slot. */
  title: string;
  /** Mục đang mở trên thanh điều hướng (`aria-current="page"`). */
  nav: NavKey;
}

const { title, nav } = Astro.props;

// Sáu mục chính của thanh điều hướng; Cài đặt đi bằng nút bánh răng ở header
// để thanh đáy ở 375px không quá chật (AC-19).
const NAV_ITEMS: { key: NavKey; href: string; label: string; icon: string }[] =
  [
    { key: 'home', href: '/be-yeu-dotro/', label: 'Hôm nay', icon: '🏡' },
    { key: 'weeks', href: '/be-yeu-dotro/tuan/', label: 'Tuần', icon: '🗓️' },
    {
      key: 'journal',
      href: '/be-yeu-dotro/nhat-ky/',
      label: 'Nhật ký',
      icon: '📝',
    },
    {
      key: 'appointments',
      href: '/be-yeu-dotro/lich-kham/',
      label: 'Lịch khám',
      icon: '🩺',
    },
    {
      key: 'checklist',
      href: '/be-yeu-dotro/checklist/',
      label: 'Checklist',
      icon: '✅',
    },
    {
      key: 'guides',
      href: '/be-yeu-dotro/cam-nang/',
      label: 'Cẩm nang',
      icon: '📖',
    },
  ];

// Favicon riêng dạng data URI — không đụng favicon.svg của site, không cần
// thêm asset vào public/.
const favicon =
  'data:image/svg+xml,' +
  encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16"><text x="0" y="13" font-size="13">🤰</text></svg>`
  );
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f3faf6" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Pacifico&family=Quicksand:wght@400;500;600;700&display=swap"
    />
    <!--
      Tải SDK Firebase SONG SONG với bundle của trang thay vì đợi script
      chạy xong mới import (mạng chậm tiết kiệm được cả một vòng round-trip).
      URL phải khớp TỪNG KÝ TỰ với src/lib/love-firebase.ts — nâng version
      SDK thì sửa cả ở đây.
    -->
    <link rel="preconnect" href="https://www.gstatic.com" />
    <link rel="preconnect" href="https://firestore.googleapis.com" />
    <link
      rel="modulepreload"
      href="https://www.gstatic.com/firebasejs/12.12.0/firebase-app.js"
    />
    <link
      rel="modulepreload"
      href="https://www.gstatic.com/firebasejs/12.12.0/firebase-auth.js"
    />
    <link
      rel="modulepreload"
      href="https://www.gstatic.com/firebasejs/12.12.0/firebase-firestore.js"
    />
    <title>{title} · Bé yêu nhà mình</title>
    <script is:inline>
      // Trạng thái khởi động, đặt trên <html> TRƯỚC first paint:
      // - by-booting: đang tải SDK + xác nhận phiên → thanh tiến trình đỉnh.
      // - by-pending: máy này từng đăng nhập (flag `love-session`, DÙNG CHUNG
      //   với love board vì cùng phiên Auth — AC-2 spec 009) → hiện luôn
      //   khung trang + nội dung tĩnh, phần dữ liệu là skeleton; chỉ quay về
      //   form login nếu Firebase báo đã đăng xuất.
      // Script layout gỡ hai class ở mọi nhánh kết thúc chờ.
      document.documentElement.classList.add('by-booting');
      try {
        if (localStorage.getItem('love-session') === '1') {
          document.documentElement.classList.add('by-pending');
        }
      } catch (_) {
        /* localStorage bị chặn — hiện form login như thường. */
      }
    </script>
  </head>

  <body>
    <!-- Thanh tiến trình mảnh khi đang kết nối (html.by-booting) -->
    <div class="by-topbar" aria-hidden="true"></div>
    <p class="sr-only" role="status" data-by-status></p>

    <div class="by-app">
      <header class="by-header">
        <a class="by-brand" href={withBase('/be-yeu-dotro/')}>
          Bé yêu nhà mình
        </a>
        <div class="by-header-actions" data-by-authed>
          <a
            class="by-icon-button"
            href={withBase('/be-yeu-dotro/cai-dat/')}
            aria-label="Cài đặt"
            aria-current={nav === 'settings' ? 'page' : undefined}
          >
            <span aria-hidden="true">⚙️</span>
          </a>
          <button
            class="by-icon-button"
            type="button"
            data-by-logout
            aria-label="Đăng xuất"
            disabled
          >
            <span aria-hidden="true">🔒</span>
          </button>
        </div>
      </header>

      <!-- Mạng chậm quá vài giây: nói rõ là vẫn đang kết nối, không phải treo -->
      <p class="by-slow-note" data-by-slow hidden>
        Mạng hơi chậm 🐢 vẫn đang kết nối, chờ chút nhé…
      </p>

      <!-- Cổng đăng nhập (AC-1) — cùng tài khoản với love board -->
      <section id="by-gate" class="by-card" aria-label="Đăng nhập">
        <p class="by-lock" aria-hidden="true">🔐</p>
        <form data-by-login>
          <label class="by-label" for="by-email">Email của nhà mình</label>
          <input
            id="by-email"
            class="by-input"
            type="email"
            name="email"
            autocomplete="username"
            required
          />
          <label class="by-label" for="by-passphrase">Mật mã</label>
          <input
            id="by-passphrase"
            class="by-input"
            type="password"
            name="passphrase"
            autocomplete="current-password"
            required
          />
          <p class="by-error" data-by-error aria-live="polite"></p>
          <!-- disabled tới khi SDK sẵn sàng: Enter lúc này không được submit
               form kiểu GET (sẽ đẩy mật mã lên URL). -->
          <button class="by-button" type="submit" disabled>
            Đang chuẩn bị…
          </button>
        </form>
      </section>

      <!-- Hiện thay cho gate khi love-config.ts còn placeholder -->
      <section
        id="by-setup"
        class="by-card by-center"
        aria-label="Chưa cấu hình Firebase"
      >
        <p class="by-lock" aria-hidden="true">🛠️</p>
        <h2 class="by-subtitle">Chưa nối với Firebase</h2>
        <p class="mt-3">
          Khu này dùng chung cấu hình với love board. Làm theo
          <code>docs/specs/005-daily-love-board/firebase-setup.md</code>
          rồi điền <code>src/lib/love-config.ts</code> nhé.
        </p>
      </section>

      <!-- Nội dung thật — mở sau khi đăng nhập; phần tham khảo tĩnh nằm
           sẵn trong HTML là chấp nhận được (AC-1 spec 009). -->
      <div class="by-shell" data-by-app data-by-nav={nav}>
        <!-- Bộ đếm tuần thai / tuổi bé (AC-5, AC-7). Mặc định là skeleton giữ
             chỗ để nội dung bên dưới không bị đẩy khi số liệu về. -->
        <p class="by-counter" data-by-counter data-state="loading">
          <span class="by-skel by-skel-pill" aria-hidden="true"></span>
        </p>
        <!-- SDK không tải được khi đang hiện khung (by-pending) -->
        <p class="by-banner by-banner-error" data-by-net-error hidden>
          Không kết nối được 📡 nội dung tham khảo vẫn đọc được, còn dữ liệu của
          nhà mình cần mạng.
          <button
            class="by-ghost-button by-banner-btn"
            type="button"
            data-by-retry
          >
            Thử lại
          </button>
        </p>
        <!-- Tài khoản login được nhưng UID chưa có trong LOVE_CONFIG.profiles:
             báo rõ, page tự khóa ghi vì whileSignedIn không chạy (spec 007). -->
        <p
          class="by-error by-inline-error"
          data-by-identity-error
          aria-live="polite"
        >
        </p>
        <p
          class="by-error by-inline-error"
          data-by-settings-error
          aria-live="polite"
        >
        </p>
        <p class="by-banner" data-by-no-settings hidden>
          Chưa có ngày dự sinh nên chưa tính được tuần thai —
          <a href={withBase('/be-yeu-dotro/')}>nhập ở trang Hôm nay</a> nhé.
        </p>

        <main id="by-main" class="by-main">
          <slot />
        </main>

        <nav class="by-nav" aria-label="Các mục">
          {
            NAV_ITEMS.map((item) => (
              <a
                class="by-nav-link"
                href={withBase(item.href)}
                aria-current={item.key === nav ? 'page' : undefined}
                data-by-nav-key={item.key}
              >
                <span class="by-nav-icon" aria-hidden="true">
                  {item.icon}
                </span>
                <span data-by-nav-label>{item.label}</span>
              </a>
            ))
          }
        </nav>
      </div>

      <noscript>
        <p class="by-card by-center mt-6">
          Trang này cần JavaScript để mở khóa và tải dữ liệu 🥺
        </p>
      </noscript>
    </div>

    <script is:inline>
      // Phản hồi chạm NGAY khi chuyển trang (mạng chậm / điện thoại yếu).
      // Cố ý is:inline: bundle module của layout là một request riêng, trên
      // mạng chậm có thể chưa chạy xong lúc người dùng đã bấm — đoạn này nằm
      // sẵn trong HTML nên luôn kịp. Chỉ đụng class/thuộc tính, không logic.
      (function () {
        var root = document.documentElement;
        var prefetched = {};

        function isPlainNav(event, link) {
          return (
            link &&
            link.target !== '_blank' &&
            !event.defaultPrevented &&
            event.button === 0 &&
            !event.metaKey &&
            !event.ctrlKey &&
            !event.shiftKey &&
            !event.altKey &&
            link.origin === location.origin &&
            !(link.pathname === location.pathname && link.hash)
          );
        }

        // Bấm link nội bộ: mục nav sáng lên ngay + thanh tiến trình chạy,
        // không đợi trang mới tải xong mới đổi.
        document.addEventListener('click', function (event) {
          var link = event.target.closest && event.target.closest('a[href]');
          if (!isPlainNav(event, link)) return;
          if (link.pathname === location.pathname) return;
          root.classList.add('by-navigating');
          link.setAttribute('data-by-pressed', '');
          if (link.classList.contains('by-nav-link')) {
            var current = document.querySelectorAll(
              '.by-nav-link[aria-current="page"]'
            );
            for (var i = 0; i < current.length; i++) {
              current[i].removeAttribute('aria-current');
            }
            link.setAttribute('aria-current', 'page');
          }
        });

        // Mở tab nav: tải trước HTML ngay lúc ngón tay chạm / chuột rê vào,
        // sớm hơn sự kiện click ~100ms+ (Safari bỏ qua rel=prefetch, vô hại).
        function prefetch(event) {
          var link =
            event.target.closest && event.target.closest('a.by-nav-link');
          if (
            !link ||
            prefetched[link.href] ||
            link.pathname === location.pathname
          )
            return;
          prefetched[link.href] = true;
          var hint = document.createElement('link');
          hint.rel = 'prefetch';
          hint.href = link.href;
          document.head.appendChild(hint);
        }
        document.addEventListener('touchstart', prefetch, { passive: true });
        document.addEventListener('mouseover', prefetch);

        // Quay lại bằng nút Back (trang lấy từ bfcache): trả nav về đúng mục
        // của trang này, tắt thanh tiến trình.
        window.addEventListener('pageshow', function (event) {
          if (!event.persisted) return;
          root.classList.remove('by-navigating');
          var pressed = document.querySelectorAll('[data-by-pressed]');
          for (var i = 0; i < pressed.length; i++) {
            pressed[i].removeAttribute('data-by-pressed');
          }
          var shell = document.querySelector('[data-by-app]');
          var key = shell && shell.getAttribute('data-by-nav');
          var links = document.querySelectorAll('.by-nav-link');
          for (var j = 0; j < links.length; j++) {
            if (links[j].getAttribute('data-by-nav-key') === key) {
              links[j].setAttribute('aria-current', 'page');
            } else {
              links[j].removeAttribute('aria-current');
            }
          }
        });
      })();
    </script>
  </body>
</html>

<script>
  import { isLoveConfigured } from '~/lib/love-config';
  import { firebaseErrorCode, type LoveFirebase } from '~/lib/love-firebase';
  import { loginErrorMessage, todayKeyVN } from '~/lib/love-board';
  import {
    babyAge,
    formatBabyAge,
    formatGa,
    gestationalAge,
  } from '~/lib/pregnancy';
  import { getFirebase, onAuth, onSettings } from '~/lib/pregnancy-session';
  import { withBase } from '~/lib/site-config';

  const root = document.documentElement;

  /**
   * Kết thúc giai đoạn khởi động do inline script trong <head> set — gọi ở
   * MỌI nhánh (auth resolve, SDK fail, chưa config). `keepShell` = vẫn hiện
   * khung trang (SDK lỗi khi máy từng đăng nhập: cho đọc nội dung tĩnh).
   */
  function endBoot(keepShell = false): void {
    root.classList.remove('by-booting');
    if (!keepShell) root.classList.remove('by-pending');
    window.clearTimeout(slowTimer);
    slowNote.hidden = true;
    statusEl.textContent = '';
  }

  /** querySelector bắt buộc — layout tự sở hữu markup nên thiếu là bug. */
  function must<T extends HTMLElement>(selector: string): T {
    const node = document.querySelector<T>(selector);
    if (!node) throw new Error(`be-yeu: thiếu phần tử ${selector}`);
    return node;
  }

  const app = must<HTMLDivElement>('[data-by-app]');
  const counter = must<HTMLParagraphElement>('[data-by-counter]');
  const counterSkeleton = counter.innerHTML;
  const slowNote = must<HTMLParagraphElement>('[data-by-slow]');
  const statusEl = must<HTMLParagraphElement>('[data-by-status]');
  const netError = must<HTMLParagraphElement>('[data-by-net-error]');
  const retryButton = must<HTMLButtonElement>('[data-by-retry]');
  const identityError = must<HTMLParagraphElement>('[data-by-identity-error]');
  const settingsError = must<HTMLParagraphElement>('[data-by-settings-error]');
  const noSettings = must<HTMLParagraphElement>('[data-by-no-settings]');
  const loginForm = must<HTMLFormElement>('[data-by-login]');
  const emailInput = must<HTMLInputElement>('#by-email');
  const passInput = must<HTMLInputElement>('#by-passphrase');
  const loginError = must<HTMLParagraphElement>('[data-by-error]');
  const loginButton = must<HTMLButtonElement>('[data-by-login] button');
  const logoutButton = must<HTMLButtonElement>('[data-by-logout]');
  // Trang Hôm nay tự hiện form onboarding khi chưa có settings → không
  // chồng thêm banner ở đó.
  const isHome = app.dataset.byNav === 'home';

  /**
   * Bé chào đời (AC-7): mục "Cẩm nang" trên thanh điều hướng thành "Sơ sinh"
   * trỏ thẳng cẩm nang sơ sinh và nhảy lên đầu; bỏ ngày sinh thì trả về
   * nguyên trạng (mục này vốn đứng cuối).
   */
  const navEl = document.querySelector<HTMLElement>('.by-nav');
  const guidesLink = document.querySelector<HTMLAnchorElement>(
    '[data-by-nav-key="guides"]'
  );
  const guidesLabel = guidesLink?.querySelector<HTMLElement>(
    '[data-by-nav-label]'
  );
  const guidesIcon = guidesLink?.querySelector<HTMLElement>('.by-nav-icon');
  function applyBornNav(born: boolean): void {
    if (!navEl || !guidesLink || !guidesLabel || !guidesIcon) return;
    if (born) {
      guidesLink.href = withBase('/be-yeu-dotro/cam-nang/so-sinh/');
      guidesLabel.textContent = 'Sơ sinh';
      guidesIcon.textContent = '👶';
      navEl.prepend(guidesLink);
    } else {
      guidesLink.href = withBase('/be-yeu-dotro/cam-nang/');
      guidesLabel.textContent = 'Cẩm nang';
      guidesIcon.textContent = '📖';
      navEl.append(guidesLink);
    }
  }

  // Quá 4 giây chưa xong khởi động → nói rõ là mạng chậm, không phải treo.
  const slowTimer = window.setTimeout(() => {
    slowNote.hidden = false;
  }, 4000);
  statusEl.textContent = 'Đang kết nối…';

  /** fb sẵn sàng hay chưa — submit trước lúc đó thì bỏ qua (không GET). */
  let fbReady: LoveFirebase | null = null;
  let sdkFailed = false;

  // Gắn NGAY (không chờ SDK) để Enter sớm không bao giờ submit form thật.
  loginForm.addEventListener('submit', (event) => {
    event.preventDefault();
    if (sdkFailed) window.location.reload();
    else if (fbReady) void signIn(fbReady);
  });
  retryButton.addEventListener('click', () => window.location.reload());

  if (!isLoveConfigured()) {
    // Config còn placeholder → thay gate bằng màn hướng dẫn, không load SDK.
    endBoot();
    root.classList.add('by-setup');
  } else {
    // Email không hardcode trong repo — nhớ theo máy, DÙNG CHUNG key với
    // love board vì là cùng tài khoản.
    try {
      const savedEmail = localStorage.getItem('love-email');
      if (savedEmail) emailInput.value = savedEmail;
    } catch {
      // localStorage bị chặn — người dùng gõ tay.
    }
    void init();
  }

  async function init(): Promise<void> {
    let fb: LoveFirebase;
    try {
      fb = await getFirebase();
    } catch (err) {
      // SDK không tải được (mất mạng lúc mở trang). Máy từng đăng nhập →
      // giữ khung trang để đọc nội dung tĩnh + banner thử lại; chưa từng →
      // báo trên gate, nút submit thành "Thử lại" (reload, vì loadFirebase
      // không cache rejection).
      sdkFailed = true;
      const hadSession = root.classList.contains('by-pending');
      endBoot(hadSession);
      netError.hidden = !hadSession;
      counter.hidden = true;
      loginError.textContent =
        'Không tải được Firebase 📡 kiểm tra mạng rồi thử lại nhé.';
      loginButton.disabled = false;
      loginButton.textContent = 'Thử lại 🔄';
      console.error('be-yeu: load SDK fail', err);
      return;
    }
    fbReady = fb;
    loginButton.disabled = false;
    loginButton.textContent = 'Mở cửa 🌱';
    logoutButton.disabled = false;

    // Nguồn sự thật duy nhất cho khóa/mở là auth state (AC-1..2). Firebase
    // tự giữ phiên trong storage nên chuyển route không phải nhập lại.
    onAuth(({ user, me }) => {
      const loggedIn = user !== null;
      endBoot();
      root.classList.toggle('by-authed', loggedIn);
      // Flag cho inline script ở <head> (và của love board) — xem comment
      // trong <head> về việc dùng chung `love-session`.
      try {
        if (loggedIn) localStorage.setItem('love-session', '1');
        else localStorage.removeItem('love-session');
      } catch {
        // localStorage bị chặn — lần sau lại thấy form trước, vô hại.
      }
      identityError.textContent =
        loggedIn && !me
          ? 'Tài khoản này chưa được gán tên 🥺 dán UID của nó vào `profiles` trong src/lib/love-config.ts (firebase-setup.md, Bước 7).'
          : '';
      if (loggedIn) {
        passInput.value = '';
      } else {
        // Về lại skeleton để lần đăng nhập sau không chớp số của phiên trước.
        counter.dataset.state = 'loading';
        counter.innerHTML = counterSkeleton;
        counter.hidden = false;
        noSettings.hidden = true;
        settingsError.textContent = '';
      }
    });

    // Bộ đếm header: tuần thai (AC-5) hoặc tuổi bé khi đã có ngày sinh (AC-7).
    onSettings((settings, error) => {
      settingsError.textContent = error;
      applyBornNav(Boolean(settings?.birthDate));
      if (error || !settings) {
        counter.dataset.state = 'ready';
        counter.hidden = true;
        noSettings.hidden = Boolean(error) || isHome;
        return;
      }
      noSettings.hidden = true;
      const today = todayKeyVN();
      let text = '';
      if (settings.birthDate) {
        const age = babyAge(settings.birthDate, today);
        const name = settings.babyName ?? 'Bé';
        text = age
          ? `👶 ${name} được ${formatBabyAge(age)}`
          : `👶 ${name} đã chào đời`;
      } else {
        const ga = gestationalAge(settings.dueDate, today);
        if (ga) {
          text =
            ga.overdueDays > 0
              ? `🤰 ${formatGa(ga)} · quá dự sinh ${ga.overdueDays} ngày`
              : `🤰 ${formatGa(ga)} · còn ${ga.daysLeft} ngày`;
        }
      }
      counter.dataset.state = 'ready';
      counter.textContent = text;
      counter.hidden = text === '';
    });

    logoutButton.addEventListener('click', () => {
      logoutButton.disabled = true;
      logoutButton.setAttribute('aria-busy', 'true');
      void fb.authApi.signOut(fb.auth).finally(() => {
        logoutButton.disabled = false;
        logoutButton.removeAttribute('aria-busy');
      });
    });
  }

  async function signIn(fb: LoveFirebase): Promise<void> {
    loginError.textContent = '';
    loginButton.disabled = true;
    loginButton.setAttribute('aria-busy', 'true');
    loginButton.textContent = 'Đang mở cửa…';
    const email = emailInput.value.trim();
    try {
      await fb.authApi.signInWithEmailAndPassword(
        fb.auth,
        email,
        passInput.value
      );
      try {
        localStorage.setItem('love-email', email);
      } catch {
        // Không nhớ được thì lần sau gõ lại — không chặn login.
      }
    } catch (err) {
      loginError.textContent = loginErrorMessage(firebaseErrorCode(err));
    } finally {
      loginButton.disabled = false;
      loginButton.removeAttribute('aria-busy');
      loginButton.textContent = 'Mở cửa 🌱';
    }
  }
</script>

<style is:global>
