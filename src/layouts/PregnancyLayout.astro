---
/**
 * PregnancyLayout — shell dùng chung cho khu private `/be-yeu-dotro/`
 * (spec 009-pregnancy-tracker): theo dõi thai kỳ của hai vợ chồng.
 *
 * Cố ý KHÔNG dùng BaseLayout, cùng lý do với love board (spec 005): tránh
 * GA4, nav/footer của site và OG/JSON-LD — khu này không muốn được track hay
 * share. Layout tự render full HTML shell + meta noindex; mọi route con bị
 * loại khỏi sitemap trong astro.config.mjs.
 *
 * Khác love board (một page tự chứa), khu này có nhiều route con nên phần
 * dùng chung — cổng đăng nhập, header với bộ đếm tuần, thanh điều hướng,
 * theme — sống ở layout; mỗi page chỉ render nội dung của mình trong <slot />
 * và tự có đúng một <h1>. Theme pastel scoped bằng CSS custom property
 * `--by-*` (bé yêu), không thêm token vào @theme của global.css.
 *
 * global.css vẫn được import để có Tailwind engine + focus ring; nền/font
 * dark-terminal của nó bị override trong <style> bên dưới.
 */
import '~/styles/global.css';
import { withBase } from '~/lib/site-config';

type NavKey =
  | 'home'
  | 'weeks'
  | 'journal'
  | 'appointments'
  | 'checklist'
  | 'guides'
  | 'settings';

interface Props {
  /** Tiêu đề tab trình duyệt — page tự render <h1> của nó trong slot. */
  title: string;
  /** Mục đang mở trên thanh điều hướng (`aria-current="page"`). */
  nav: NavKey;
}

const { title, nav } = Astro.props;

// Sáu mục chính của thanh điều hướng; Cài đặt đi bằng nút bánh răng ở header
// để thanh đáy ở 375px không quá chật (AC-19).
const NAV_ITEMS: { key: NavKey; href: string; label: string; icon: string }[] =
  [
    { key: 'home', href: '/be-yeu-dotro/', label: 'Hôm nay', icon: '🏡' },
    { key: 'weeks', href: '/be-yeu-dotro/tuan/', label: 'Tuần', icon: '🗓️' },
    {
      key: 'journal',
      href: '/be-yeu-dotro/nhat-ky/',
      label: 'Nhật ký',
      icon: '📝',
    },
    {
      key: 'appointments',
      href: '/be-yeu-dotro/lich-kham/',
      label: 'Lịch khám',
      icon: '🩺',
    },
    {
      key: 'checklist',
      href: '/be-yeu-dotro/checklist/',
      label: 'Checklist',
      icon: '✅',
    },
    {
      key: 'guides',
      href: '/be-yeu-dotro/cam-nang/',
      label: 'Cẩm nang',
      icon: '📖',
    },
  ];

// Favicon riêng dạng data URI — không đụng favicon.svg của site, không cần
// thêm asset vào public/.
const favicon =
  'data:image/svg+xml,' +
  encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16"><text x="0" y="13" font-size="13">🤰</text></svg>`
  );
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f3faf6" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Pacifico&family=Quicksand:wght@400;500;600;700&display=swap"
    />
    <title>{title} · Bé yêu nhà mình</title>
    <script is:inline>
      // Chống chớp form login khi đã có phiên: flag `love-session` là của
      // love board — cố ý DÙNG CHUNG vì hai khu private cùng một Firebase
      // project trên cùng origin nên cùng một phiên Auth (AC-2 spec 009).
      // Script chính của layout gỡ class ở mọi nhánh sau khi Firebase xác
      // nhận. is:inline để chạy trước first paint.
      try {
        if (localStorage.getItem('love-session') === '1') {
          document.documentElement.classList.add('by-pending');
        }
      } catch (_) {
        /* localStorage bị chặn — hiện form login như thường. */
      }
    </script>
  </head>

  <body>
    <div class="by-app">
      <header class="by-header">
        <a class="by-brand" href={withBase('/be-yeu-dotro/')}>
          Bé yêu nhà mình
        </a>
        <div class="by-header-actions" data-by-authed hidden>
          <a
            class="by-icon-button"
            href={withBase('/be-yeu-dotro/cai-dat/')}
            aria-label="Cài đặt"
            aria-current={nav === 'settings' ? 'page' : undefined}
          >
            <span aria-hidden="true">⚙️</span>
          </a>
          <button
            class="by-icon-button"
            type="button"
            data-by-logout
            aria-label="Đăng xuất"
          >
            <span aria-hidden="true">🔒</span>
          </button>
        </div>
      </header>

      <!-- Bộ đếm tuần thai / tuổi bé — script điền từ settings (AC-5, AC-7) -->
      <p class="by-counter" data-by-counter hidden></p>

      <!-- Màn chờ xác nhận phiên — chỉ hiện khi <html> có .by-pending -->
      <section
        id="by-loading"
        class="by-card by-center"
        aria-label="Đang mở cửa"
      >
        <p class="by-lock" aria-hidden="true">🗝️</p>
        <p class="by-muted">Đang mở cửa cho nhà mình…</p>
      </section>

      <!-- Cổng đăng nhập (AC-1) — cùng tài khoản với love board -->
      <section id="by-gate" class="by-card" aria-label="Đăng nhập">
        <p class="by-lock" aria-hidden="true">🔐</p>
        <form data-by-login>
          <label class="by-label" for="by-email">Email của nhà mình</label>
          <input
            id="by-email"
            class="by-input"
            type="email"
            name="email"
            autocomplete="username"
            required
          />
          <label class="by-label" for="by-passphrase">Mật mã</label>
          <input
            id="by-passphrase"
            class="by-input"
            type="password"
            name="passphrase"
            autocomplete="current-password"
            required
          />
          <p class="by-error" data-by-error aria-live="polite"></p>
          <button class="by-button" type="submit">Mở cửa 🌱</button>
        </form>
      </section>

      <!-- Hiện thay cho gate khi love-config.ts còn placeholder -->
      <section
        id="by-setup"
        class="by-card by-center"
        aria-label="Chưa cấu hình Firebase"
        hidden
      >
        <p class="by-lock" aria-hidden="true">🛠️</p>
        <h2 class="by-subtitle">Chưa nối với Firebase</h2>
        <p class="mt-3">
          Khu này dùng chung cấu hình với love board. Làm theo
          <code>docs/specs/005-daily-love-board/firebase-setup.md</code>
          rồi điền <code>src/lib/love-config.ts</code> nhé.
        </p>
      </section>

      <!-- Nội dung thật — mở sau khi đăng nhập; phần tham khảo tĩnh nằm
           sẵn trong HTML là chấp nhận được (AC-1 spec 009). -->
      <div class="by-shell" data-by-app data-by-nav={nav} hidden>
        <!-- Tài khoản login được nhưng UID chưa có trong LOVE_CONFIG.profiles:
             báo rõ, page tự khóa ghi vì whileSignedIn không chạy (spec 007). -->
        <p
          class="by-error by-inline-error"
          data-by-identity-error
          aria-live="polite"
        >
        </p>
        <p
          class="by-error by-inline-error"
          data-by-settings-error
          aria-live="polite"
        >
        </p>
        <p class="by-banner" data-by-no-settings hidden>
          Chưa có ngày dự sinh nên chưa tính được tuần thai —
          <a href={withBase('/be-yeu-dotro/')}>nhập ở trang Hôm nay</a> nhé.
        </p>

        <main id="by-main" class="by-main">
          <slot />
        </main>

        <nav class="by-nav" aria-label="Các mục">
          {
            NAV_ITEMS.map((item) => (
              <a
                class="by-nav-link"
                href={withBase(item.href)}
                aria-current={item.key === nav ? 'page' : undefined}
                data-by-nav-key={item.key}
              >
                <span class="by-nav-icon" aria-hidden="true">
                  {item.icon}
                </span>
                <span data-by-nav-label>{item.label}</span>
              </a>
            ))
          }
        </nav>
      </div>

      <noscript>
        <p class="by-card by-center mt-6">
          Trang này cần JavaScript để mở khóa và tải dữ liệu 🥺
        </p>
      </noscript>
    </div>
  </body>
</html>

<script>
  import { isLoveConfigured } from '~/lib/love-config';
  import { firebaseErrorCode, type LoveFirebase } from '~/lib/love-firebase';
  import { loginErrorMessage, todayKeyVN } from '~/lib/love-board';
  import {
    babyAge,
    formatBabyAge,
    formatGa,
    gestationalAge,
  } from '~/lib/pregnancy';
  import { getFirebase, onAuth, onSettings } from '~/lib/pregnancy-session';
  import { withBase } from '~/lib/site-config';

  /**
   * Gỡ trạng thái "đang mở cửa" do inline script trong <head> set — phải
   * gọi ở MỌI nhánh kết thúc chờ (auth resolve, SDK fail, chưa config), nếu
   * không gate bị CSS giấu vĩnh viễn.
   */
  function clearPending(): void {
    document.documentElement.classList.remove('by-pending');
  }

  /** querySelector bắt buộc — layout tự sở hữu markup nên thiếu là bug. */
  function must<T extends HTMLElement>(selector: string): T {
    const node = document.querySelector<T>(selector);
    if (!node) throw new Error(`be-yeu: thiếu phần tử ${selector}`);
    return node;
  }

  const gate = must<HTMLElement>('#by-gate');
  const setup = must<HTMLElement>('#by-setup');
  const app = must<HTMLDivElement>('[data-by-app]');
  const authedBits = must<HTMLDivElement>('[data-by-authed]');
  const counter = must<HTMLParagraphElement>('[data-by-counter]');
  const identityError = must<HTMLParagraphElement>('[data-by-identity-error]');
  const settingsError = must<HTMLParagraphElement>('[data-by-settings-error]');
  const noSettings = must<HTMLParagraphElement>('[data-by-no-settings]');
  const loginForm = must<HTMLFormElement>('[data-by-login]');
  const emailInput = must<HTMLInputElement>('#by-email');
  const passInput = must<HTMLInputElement>('#by-passphrase');
  const loginError = must<HTMLParagraphElement>('[data-by-error]');
  const loginButton = must<HTMLButtonElement>('[data-by-login] button');
  const logoutButton = must<HTMLButtonElement>('[data-by-logout]');
  // Trang Hôm nay tự hiện form onboarding khi chưa có settings → không
  // chồng thêm banner ở đó.
  const isHome = app.dataset.byNav === 'home';

  /**
   * Bé chào đời (AC-7): mục "Cẩm nang" trên thanh điều hướng thành "Sơ sinh"
   * trỏ thẳng cẩm nang sơ sinh và nhảy lên đầu; bỏ ngày sinh thì trả về
   * nguyên trạng (mục này vốn đứng cuối).
   */
  const navEl = document.querySelector<HTMLElement>('.by-nav');
  const guidesLink = document.querySelector<HTMLAnchorElement>(
    '[data-by-nav-key="guides"]'
  );
  const guidesLabel = guidesLink?.querySelector<HTMLElement>(
    '[data-by-nav-label]'
  );
  const guidesIcon = guidesLink?.querySelector<HTMLElement>('.by-nav-icon');
  function applyBornNav(born: boolean): void {
    if (!navEl || !guidesLink || !guidesLabel || !guidesIcon) return;
    if (born) {
      guidesLink.href = withBase('/be-yeu-dotro/cam-nang/so-sinh/');
      guidesLabel.textContent = 'Sơ sinh';
      guidesIcon.textContent = '👶';
      navEl.prepend(guidesLink);
    } else {
      guidesLink.href = withBase('/be-yeu-dotro/cam-nang/');
      guidesLabel.textContent = 'Cẩm nang';
      guidesIcon.textContent = '📖';
      navEl.append(guidesLink);
    }
  }

  if (!isLoveConfigured()) {
    // Config còn placeholder → thay gate bằng màn hướng dẫn, không load SDK.
    clearPending();
    gate.hidden = true;
    setup.hidden = false;
  } else {
    // Email không hardcode trong repo — nhớ theo máy, DÙNG CHUNG key với
    // love board vì là cùng tài khoản.
    try {
      const savedEmail = localStorage.getItem('love-email');
      if (savedEmail) emailInput.value = savedEmail;
    } catch {
      // localStorage bị chặn — người dùng gõ tay.
    }
    void init();
  }

  async function init(): Promise<void> {
    let fb: LoveFirebase;
    try {
      fb = await getFirebase();
    } catch (err) {
      // SDK không tải được (mất mạng lúc mở trang) — báo trên gate;
      // loadFirebase không cache rejection nên reload sẽ retry.
      clearPending();
      loginError.textContent =
        'Không tải được Firebase 📡 kiểm tra mạng rồi tải lại trang nhé.';
      console.error('be-yeu: load SDK fail', err);
      return;
    }

    // Nguồn sự thật duy nhất cho khóa/mở là auth state (AC-1..2). Firebase
    // tự giữ phiên trong storage nên chuyển route không phải nhập lại.
    onAuth(({ user, me }) => {
      const loggedIn = user !== null;
      clearPending();
      // Flag cho inline script ở <head> (và của love board) — xem comment
      // trong <head> về việc dùng chung `love-session`.
      try {
        if (loggedIn) localStorage.setItem('love-session', '1');
        else localStorage.removeItem('love-session');
      } catch {
        // localStorage bị chặn — lần sau lại thấy form trước, vô hại.
      }
      gate.hidden = loggedIn;
      app.hidden = !loggedIn;
      authedBits.hidden = !loggedIn;
      identityError.textContent =
        loggedIn && !me
          ? 'Tài khoản này chưa được gán tên 🥺 dán UID của nó vào `profiles` trong src/lib/love-config.ts (firebase-setup.md, Bước 7).'
          : '';
      if (loggedIn) {
        passInput.value = '';
      } else {
        counter.hidden = true;
        noSettings.hidden = true;
        settingsError.textContent = '';
      }
    });

    // Bộ đếm header: tuần thai (AC-5) hoặc tuổi bé khi đã có ngày sinh (AC-7).
    onSettings((settings, error) => {
      settingsError.textContent = error;
      applyBornNav(Boolean(settings?.birthDate));
      if (error || !settings) {
        counter.hidden = true;
        noSettings.hidden = Boolean(error) || isHome;
        return;
      }
      noSettings.hidden = true;
      const today = todayKeyVN();
      let text = '';
      if (settings.birthDate) {
        const age = babyAge(settings.birthDate, today);
        const name = settings.babyName ?? 'Bé';
        text = age
          ? `👶 ${name} được ${formatBabyAge(age)}`
          : `👶 ${name} đã chào đời`;
      } else {
        const ga = gestationalAge(settings.dueDate, today);
        if (ga) {
          text =
            ga.overdueDays > 0
              ? `🤰 ${formatGa(ga)} · quá dự sinh ${ga.overdueDays} ngày`
              : `🤰 ${formatGa(ga)} · còn ${ga.daysLeft} ngày`;
        }
      }
      counter.textContent = text;
      counter.hidden = text === '';
    });

    loginForm.addEventListener('submit', (event) => {
      event.preventDefault();
      void signIn();
    });

    logoutButton.addEventListener('click', () => {
      void fb.authApi.signOut(fb.auth);
    });

    async function signIn(): Promise<void> {
      loginError.textContent = '';
      loginButton.disabled = true;
      loginButton.textContent = 'Đang mở… 🗝️';
      const email = emailInput.value.trim();
      try {
        await fb.authApi.signInWithEmailAndPassword(
          fb.auth,
          email,
          passInput.value
        );
        try {
          localStorage.setItem('love-email', email);
        } catch {
          // Không nhớ được thì lần sau gõ lại — không chặn login.
        }
      } catch (err) {
        loginError.textContent = loginErrorMessage(firebaseErrorCode(err));
      } finally {
        loginButton.disabled = false;
        loginButton.textContent = 'Mở cửa 🌱';
      }
    }
  }
</script>

<style is:global>
  /* is:global BẮT BUỘC: nhiều phần (timeline, checklist, lịch hẹn) được
     script của từng page dựng bằng createElement nên không có scope
     attribute của Astro. An toàn vì Astro chỉ bundle CSS này cho các page
     dùng layout, và mọi selector đều prefix .by-*. */

  /* Palette pastel mint/peach cục bộ — độc lập với --color-* của site.
     Mọi màu chữ nhỏ đạt ≥ 4.5:1 trên nền trắng/tint (kiểm bằng script
     contrast khi viết, xem T1). */
  html {
    --by-bg: #f3faf6;
    --by-bg-accent: #fff3ea;
    --by-card: #ffffff;
    --by-border: #d2e8dc;
    --by-border-strong: #a9d3bf;
    --by-fg: #22423a;
    --by-fg-muted: #4d6b5f;
    --by-green: #3aa17e; /* decor: viền active, progress */
    --by-green-deep: #1e6e54; /* chữ nhỏ trên nền sáng + nền nút chữ trắng */
    --by-green-darker: #175943; /* hover của nút */
    --by-green-soft: #e3f4ec;
    --by-peach: #f5a989; /* decor */
    --by-peach-deep: #b24a22; /* chữ trên nền sáng */
    --by-peach-soft: #ffe9df;
    --by-danger: #b3261e;
    --by-danger-soft: #fdecea;
    --by-on-dark: #ffffff;
    --by-radius: 20px;
    --by-font:
      'Quicksand', ui-rounded, 'SF Pro Rounded', 'Segoe UI', system-ui,
      sans-serif;
    --by-font-display: 'Pacifico', 'Quicksand', ui-rounded, cursive;

    /* Override nền/font dark-terminal của global.css cho riêng khu này. */
    background: linear-gradient(
      180deg,
      var(--by-bg) 0%,
      var(--by-bg-accent) 100%
    );
    color: var(--by-fg);
    font-family: var(--by-font);
    color-scheme: light;
  }

  body {
    background: transparent;
    min-height: 100dvh;
  }

  /* Focus ring của global.css dùng accent lime của site — đổi sang xanh lá. */
  :focus-visible {
    outline-color: var(--by-green-deep);
  }

  ::selection {
    background: var(--by-green);
    color: var(--by-on-dark);
  }

  /* ---- Khung trang ------------------------------------------------------ */

  .by-app {
    max-width: 42rem;
    margin: 0 auto;
    /* Chừa chỗ cho thanh điều hướng cố định đáy ở mobile (+ safe area). */
    padding: 0 1rem calc(5.5rem + env(safe-area-inset-bottom));
  }

  .by-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem 0 0.5rem;
  }

  .by-brand {
    font-family: var(--by-font-display);
    font-size: 1.4rem;
    line-height: 1.3;
    color: var(--by-green-deep);
    text-decoration: none;
  }

  .by-header-actions {
    display: flex;
    gap: 0.5rem;
  }

  /* Nút icon-only 44×44 (AC-19) — luôn kèm aria-label ở markup. */
  .by-icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 2px solid var(--by-border);
    border-radius: 999px;
    background: var(--by-card);
    color: inherit;
    font: inherit;
    font-size: 1.1rem;
    text-decoration: none;
    cursor: pointer;
  }

  .by-icon-button:hover,
  .by-icon-button[aria-current='page'] {
    border-color: var(--by-green);
    background: var(--by-green-soft);
  }

  /* Bộ đếm tuần thành pill nổi — điểm nhấn dưới header. */
  .by-counter {
    display: inline-block;
    margin-top: 0.25rem;
    padding: 0.5rem 1.25rem;
    border: 2px solid var(--by-border);
    border-radius: 999px;
    background: var(--by-card);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--by-green-deep);
    box-shadow: 0 6px 18px rgb(30 110 84 / 0.1);
  }

  .by-shell {
    display: flex;
    flex-direction: column;
  }

  .by-main {
    padding-top: 0.75rem;
  }

  /* ---- Thanh điều hướng -------------------------------------------------- */

  /* Mobile: cố định đáy để ngón cái với tới (AC-19). */
  .by-nav {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 20;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.125rem;
    padding: 0.35rem 0.25rem calc(0.35rem + env(safe-area-inset-bottom));
    border-top: 2px solid var(--by-border);
    background: rgb(255 255 255 / 0.94);
    backdrop-filter: blur(8px);
  }

  .by-nav-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.1rem;
    min-height: 44px;
    padding: 0.25rem 0.125rem;
